  "cards": [
    {
      "dot": "cyan",
      "title": "Hard rules",
      "items": [
        "Only <context> differs between levels; the prompt never mentions reuse",
        "A prompt that doesn't fit is a no_fit result, never truncated",
        "Hidden tests live outside the repo; the judge never learns a patch's origin"
      ]
    },
    {
      "dot": "violet",
      "title": "Two modes",
      "items": [
        "Development: thinking off, 4 runs at a time on one server",
        "Final round: cbench run --clean --thinking, one run at a time, server restarted before each"
      ]
    },
    {
      "dot": "slate",
      "title": "Maintenance",
      "items": [
        "cbench rescore recomputes format, visibility and dead-code metrics from saved bundles (no model calls)",
        "Archived results stay readable: older rows are labelled by prompt version"
      ]
    }
