--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,11 @@
+"""On-hand stock ledger per SKU, with reservation for in-flight orders."""
+from shopkit.errors import Conflict
+
+
+class NotEnoughStock(Conflict):
+    pass
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +17,12 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order. Raises NotEnoughStock (409) without changing
+        anything if there isn't enough stock."""
+        have = self._on_hand.get(sku, 0)
+        if have < qty:
+            raise NotEnoughStock(f"not enough {sku} to reserve", sku=sku, requested=qty,
+                                 available=have)
+        self._on_hand[sku] = have - qty
