+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per week, in chronological order.
+
+    Weeks are keyed by the ISO week labels the other dashboards use.
+    """
+    totals: dict[str, int] = {}
+    week_key: dict[str, tuple[int, int]] = {}
+    for t in transfers:
+        day = t.at.date()
+        label = iso_week_label(day)
+        totals[label] = totals.get(label, 0) + t.qty
+        if label not in week_key:
+            iso_year, iso_week, _ = day.isocalendar()
+            week_key[label] = (iso_year, iso_week)
+    return {label: totals[label] for label in sorted(totals, key=week_key.__getitem__)}
