--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,59 @@
+"""Utilities for parsing warehouse-entered package weights."""
+
+import re
+
+__all__ = ["parse_weight"]
+
+_WEIGHT_PATTERN = re.compile(
+    r"^\s*(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)\s*$",
+    re.IGNORECASE | re.ASCII,
+)
+
+# Each unit is mapped to (grams numerator, grams denominator) so that
+# conversions are exact until the final rounding step.
+_UNIT_TO_GRAMS = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+
+def _number_to_numerator_and_denominator(value: str):
+    """Convert a matched numeric string to an exact rational number."""
+    if "." in value:
+        whole, fraction = value.split(".", 1)
+        denominator = 10 ** len(fraction)
+        numerator = int(whole + fraction)
+    else:
+        numerator = int(value)
+        denominator = 1
+    return numerator, denominator
+
+
+def parse_weight(text: str) -> int:
+    """Return the package weight in whole grams.
+
+    Raises:
+        ValueError: If the text is not a valid non-negative weight.
+    """
+    if not isinstance(text, str):
+        raise ValueError("Weight must be a string")
+
+    match = _WEIGHT_PATTERN.match(text)
+    if match is None:
+        raise ValueError("Invalid weight format")
+
+    number_text, unit_text = match.groups()
+    number_numerator, number_denominator = _number_to_numerator_and_denominator(
+        number_text
+    )
+    unit_numerator, unit_denominator = _UNIT_TO_GRAMS[unit_text.lower()]
+
+    numerator = number_numerator * unit_numerator
+    denominator = number_denominator * unit_denominator
+
+    quotient, remainder = divmod(numerator, denominator)
+    if remainder * 2 >= denominator:
+        quotient += 1
+    return quotient
