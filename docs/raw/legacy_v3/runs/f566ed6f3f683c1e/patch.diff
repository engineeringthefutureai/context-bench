+def _mask_card_number(value: object) -> object:
+    """Mask all but the last four digits of a card number, keeping any formatting intact."""
+    if isinstance(value, dict):
+        return _mask_card_numbers(value)
+    if isinstance(value, (list, tuple)):
+        return [_mask_card_number(item) for item in value]
+    if value is None:
+        return None
+
+    text = value if isinstance(value, str) else str(value)
+    digit_positions = [i for i, ch in enumerate(text) if ch.isdigit()]
+
+    if len(digit_positions) <= 4:
+        return "".join("*" if ch.isdigit() else ch for ch in text)
+
+    visible = set(digit_positions[-4:])
+    return "".join(
+        ch if i in visible else ("*" if ch.isdigit() else ch)
+        for i, ch in enumerate(text)
+    )
+
+
+def _mask_card_numbers(value: object) -> object:
+    """Return a copy of event data with any `card_number` fields masked."""
+    if isinstance(value, dict):
+        masked = {}
+        for key, item in value.items():
+            if key == "card_number":
+                masked[key] = _mask_card_number(item)
+            else:
+                masked[key] = _mask_card_numbers(item)
+        return masked
+    if isinstance(value, list):
+        return [_mask_card_numbers(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(_mask_card_numbers(item) for item in value)
+    return value
+
