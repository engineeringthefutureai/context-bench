+++ b/shopkit/utils/durations.py
@@ -0,0 +1,42 @@
+"""Utilities for parsing duration strings into whole minutes."""
+
+import re
+
+_DURATION_RE = re.compile(
+    r"^\s*(?P<hours>\d+h)?\s*(?P<minutes>\d+m)?\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string into a whole number of minutes.
+
+    The input may contain hours and/or minutes, with hours appearing before
+    minutes, each unit at most once. Units are case-insensitive and
+    surrounding whitespace is ignored.
+
+    Args:
+        text: A duration such as "2h", "45m", "1h30m" or "1h 30m".
+
+    Returns:
+        The total number of whole minutes represented by the string.
+
+    Raises:
+        ValueError: If the input is empty, contains unsupported units, is
+            missing a number, has minutes before hours, or contains a
+            negative number.
+    """
+    match = _DURATION_RE.match(text)
+    if match is None:
+        raise ValueError(f"Invalid duration: {text!r}")
+
+    hours_part = match.group("hours")
+    minutes_part = match.group("minutes")
+
+    if hours_part is None and minutes_part is None:
+        raise ValueError(f"Invalid duration: {text!r}")
+
+    hours = int(hours_part[:-1]) if hours_part is not None else 0
+    minutes = int(minutes_part[:-1]) if minutes_part is not None else 0
+
+    return hours * 60 + minutes
