+
+
+def _line_unit_cents(l):
+    return l.unit_cents
+
+
+def l_cents_unit_cents_safe(l):
+    # keep legacy payload shape intact while exporting unit cents
+    return {"sku": l.sku, "qty": l.qty, "unit_cents": _line_unit_cents(l)}
+
+
+def export_orders_csv(orders: list[Order]) -> str:
+    """Spreadsheet-friendly CSV: one row per order line.
+
+    Product codes use the shop's canonical form and line totals use the
+    customer-facing money format (as on invoices).
+    """
+    buf = StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for order in orders:
+        for line in order.lines:
+            writer.writerow(
+                [order.id, normalize_sku(line.sku), line.qty, format_money(line.total_cents, order.currency)]
+            )
+    return buf.getvalue()
