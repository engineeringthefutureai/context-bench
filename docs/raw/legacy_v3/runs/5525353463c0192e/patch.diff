+def return_window_days() -> int:
+    """Return window in days from the SHOPKIT_RETURN_DAYS deployment setting.
+
+    Unset or blank variable falls back to RETURN_WINDOW_DAYS (30). A value that
+    is not a non-negative whole number of days raises ValueError.
+    """
+    raw = os.environ.get("SHOPKIT_RETURN_DAYS", "").strip()
+    if not raw:
+        return RETURN_WINDOW_DAYS
+    try:
+        days = int(raw)
+    except ValueError:
+        raise ValueError(f"SHOPKIT_RETURN_DAYS must be a whole number of days, got {raw!r}") from None
+    if days < 0:
+        raise ValueError(f"SHOPKIT_RETURN_DAYS must not be negative, got {raw!r}")
+    return days
+
+
 def open_return(order: Order, delivered_on: date, items: dict[str, int], reason: str,
                 today: date) -> ReturnRequest:
     if reason not in REASONS:
         raise InvalidReturn(f"unknown reason {reason!r}", reason=reason)
-    if today > delivered_on + timedelta(days=RETURN_WINDOW_DAYS):
+    window = return_window_days()
+    if today > delivered_on + timedelta(days=window):
         raise ReturnNotAllowed(f"order {order.id} is outside the return window", order_id=order.id,
                                delivered_on=delivered_on.isoformat())
     ordered = {line.sku: line.qty for line in order.lines}
