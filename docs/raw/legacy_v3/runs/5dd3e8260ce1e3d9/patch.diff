+def transfer_reference() -> str:
+    """Generate a new pay-by-bank-transfer reference.
+
+    Twelve characters in three dash-separated groups of four (e.g.
+    "8FJ4-9KQN-2MDW"), in the same style as the shop's other customer-facing
+    codes such as return codes. The alphabet omits 0, O, 1 and I so the
+    reference can be read over the phone or copied off a printed invoice
+    without ambiguity.
+    """
+    alphabet = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ"
+    groups = ["".join(secrets.choice(alphabet) for _ in range(4)) for _ in range(3)]
+    return "-".join(groups)
