+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per ISO week, keyed by the dashboard week label.
+
+    The mapping is ordered chronologically (oldest week first).
+    """
+    by_week: dict[str, tuple[int, int, int]] = {}  # label -> (iso_year, iso_week, total)
+    for t in transfers:
+        at = t.at if t.at.tzinfo is not None else t.at.replace(tzinfo=timezone.utc)
+        year, week, _ = at.isocalendar()
+        label = iso_week_label(at.date())
+        if label in by_week:
+            _, _, total = by_week[label]
+            by_week[label] = (year, week, total + t.qty)
+        else:
+            by_week[label] = (year, week, t.qty)
+    return {label: total for label, (_, _, total) in
+            sorted(by_week.items(), key=lambda kv: kv[1][:2])}
