--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,24 @@
+import re
+
+# Case-insensitive: one optional "hours" part then one optional "minutes" part,
+# each with a positive integer and its unit letter.
+_DURATION_RE = re.compile(r"(?i)^\s*(?:(\d+)h\s*)?(?:(\d+)m\s*)?$")
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string of hours and/or minutes into whole minutes.
+
+    Hours must precede minutes and each unit may appear at most once, e.g.
+    "2h", "45m", "1h30m" or "1h 30m". Units are case-insensitive and
+    surrounding whitespace is ignored. Anything else raises ValueError.
+    """
+    if not isinstance(text, str) or not text.strip():
+        raise ValueError(f"invalid duration: {text!r}")
+    match = _DURATION_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1)) if match.group(1) else 0
+    minutes = int(match.group(2)) if match.group(2) else 0
+    if hours == 0 and minutes == 0:
+        raise ValueError(f"invalid duration: {text!r}")
+    return hours * 60 + minutes
