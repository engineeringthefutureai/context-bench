--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,41 @@
+class BusinessRuleError(Exception):
+    """Base class for business-rule failures that should answer with 409."""
+
+    status_code = 409
+
+    @property
+    def message(self) -> str:
+        return self.args[0] if self.args else ""
+
+    @property
+    def details(self) -> dict[str, object]:
+        return {}
+
+
+class StockError(BusinessRuleError):
+    """Stock business-rule failure with requested and available quantities."""
+
+    def __init__(self, message: str, requested: int, available: int) -> None:
+        super().__init__(message)
+        self.requested = requested
+        self.available = available
+
+    @property
+    def details(self) -> dict[str, int]:
+        return {"requested": self.requested, "available": self.available}
+
+
+class InsufficientStockError(StockError):
+    """Raised when a reservation asks for more stock than is available."""
+
+    def __init__(self, sku: str, requested: int, available: int) -> None:
+        super().__init__(
+            f"Cannot reserve {requested} units of {sku}; only {available} available",
+            requested,
+            available,
+        )
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +47,18 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for checkout.
+
+        Raises ValueError if `qty` is negative, and InsufficientStockError if
+        `qty` exceeds the available quantity. On failure, stock is unchanged.
+        """
+        available = self.available(sku)
+        if qty < 0:
+            raise ValueError("qty must be non-negative")
+        if qty == 0:
+            return
+        if qty > available:
+            raise InsufficientStockError(sku, qty, available)
+        self._on_hand[sku] = available - qty
