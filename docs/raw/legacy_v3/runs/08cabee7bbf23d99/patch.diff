+from __future__ import annotations
+
+import re
+
+_OZ_TO_G = 28.349523125
+_LB_TO_G = _OZ_TO_G * 16
+_KG_TO_G = 1000.0
+_G_TO_G = 1.0
+
+_UNIT_TO_FACTOR = {
+    "g": _G_TO_G,
+    "kg": _KG_TO_G,
+    "lb": _LB_TO_G,
+    "oz": _OZ_TO_G,
+}
+
+# Number may be an integer or decimal with ".", optional whitespace, then a unit.
+# The number must not start with "-" to reject negative values.
+_WEIGHT_RE = re.compile(
+    r"\s*(?P<number>\d+(?:\.\d+)?)[ \t]*(?P<unit>g|kg|lb|oz)\b",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a human-typed weight string into whole grams.
+
+    Accepts an integer or decimal (with "." as separator) followed by a unit:
+    g, kg, lb or oz (case-insensitive). Leading and trailing whitespace is
+    ignored. Returns the weight rounded to the nearest whole gram.
+
+    Raises ValueError for missing number, missing or unknown unit, negative
+    values, comma decimal separators or any other malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"Expected a string, got {type(text).__name__}")
+
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"Invalid weight string: {text!r}")
+
+    number_str = match.group("number")
+    unit = match.group("unit").lower()
+
+    value = float(number_str)
+    grams = value * _UNIT_TO_FACTOR[unit]
+
+    return round(grams)
