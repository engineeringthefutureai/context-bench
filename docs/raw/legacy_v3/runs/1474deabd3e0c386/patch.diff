+def _mask_card_number(value: object) -> object:
+    """Mask a card number so only its last four digits remain visible."""
+    if value is None:
+        return value
+    number = str(value)
+    if len(number) <= 4:
+        return "*" * len(number)
+    return "****" + number[-4:]
+
+
+def _sanitize_payload(value: object) -> object:
+    """Return event data with any card_number fields masked."""
+    if isinstance(value, dict):
+        return {
+            key: _mask_card_number(item) if key == "card_number" else _sanitize_payload(item)
+            for key, item in value.items()
+        }
+    if isinstance(value, list):
+        return [_sanitize_payload(item) for item in value]
+    return value
+
