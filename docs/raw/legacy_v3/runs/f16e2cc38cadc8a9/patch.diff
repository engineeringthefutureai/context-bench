+def transfers_by_week(transfers) -> dict[str, int]:
+    """Total units moved per ISO week, in chronological order.
+
+    Each transfer's `at` timestamp is bucketed by the week label used by the other
+    dashboards (``iso_week_label``, e.g. ``"2026-W47"``); the weeks are ordered from
+    oldest to newest.
+    """
+    totals: "OrderedDict[str, int]" = OrderedDict()
+    for t in transfers:
+        week = iso_week_label(t.at)
+        totals[week] = totals.get(week, 0) + t.qty
+    # Re-key in chronological order (the labels sort the same as their weeks).
+    return dict.fromkeys(sorted(totals), [totals[w] for w in sorted(totals)])
