+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per week, keyed by ISO week label (e.g. ``2025-W03``) as used by the
+    other dashboards, in chronological order."""
+    totals: dict[tuple[int, int], int] = {}
+    for t in transfers:
+        iso = t.at.isocalendar()
+        key = (iso.year, iso.week)
+        totals[key] = totals.get(key, 0) + t.qty
+    return {f"{year}-W{week:02d}": total for (year, week), total in sorted(totals.items())}
