--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,22 @@
+"""Duration parsing for human-written "hours/minutes" input such as "2h" or "1h 30m"."""
+import re
+
+# Hours (optional) before minutes (optional); each unit at most once, case-insensitive,
+# only optional whitespace between the two parts. Anything outside this shape is invalid.
+_DURATION_RE = re.compile(r"\b(?P<hours>\d+)h\b( \s*(?P<minutes>\d+)m\b)?\Z")
+
+
+def parse_duration(text: str) -> int:
+    """Total whole minutes in `text`.
+
+    Accepts hours and/or minutes, hours always before minutes, each unit at most once,
+    units case-insensitive, surrounding whitespace ignored: "2h", "45m", "1h30m",
+    "1h 30m" -> 120. Anything else (empty text, other units, a missing number, minutes
+    before hours, negative or zero-length values) raises ValueError.
+    """
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group("hours") or 0)
+    minutes = int(match.group("minutes") or 0)
+    return hours * 60 + minutes
