+"""Utilities for parsing and formatting time durations."""
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string into total minutes.
+
+    Supports formats like '2h', '45m', '1h30m', '1h 30m', etc.
+    Hours must come before minutes if both are present.
+    """
+    s = text.strip()
+    if not s:
+        raise ValueError("Empty duration string")
+
+    # Use a regular expression to parse the duration
+    import re
+    pattern = r'^(?:(\d+)h)?(?:(\d+)m)?$'
+    match = re.match(pattern, s, re.IGNORECASE)
+
+    if not match:
+        raise ValueError(f"Invalid duration format: {text}")
+
+    hours_str, minutes_str = match.groups()
+
+    # If both hours and minutes are missing, it's an invalid format
+    if hours_str is None and minutes_str is None:
+        raise ValueError(f"Missing number in duration: {text}")
+
+    hours = int(hours_str) if hours_str else 0
+    minutes = int(minutes_str) if minutes_str else 0
+
+    # Check for negative values (already validated by regex, but being explicit)
+    if hours < 0 or minutes < 0:
+        raise ValueError(f"Negative values not allowed in duration: {text}")
+
+    return hours * 60 + minutes
