+def _weight_line(grams: int, country: str) -> str:
+    """Weight line for a label. US destinations (who keep asking what "kg" means) get pounds with
+    two decimals (1500 g -> "3.31 lb"); every other destination keeps the shop's standard
+    kilogram display so labels match the packing slips (1500 g -> "1.5 kg")."""
+    if country == "US":
+        return f"Weight: {grams / _GRAMS_PER_POUND:.2f} lb"
+    return f"Weight: {format_weight(grams)}"
+
+
+def label_text(parcel: Parcel, to: Address, parcels_total: int, weight_g: int | None = None) -> str:
     lines = [format_address(to), "", f"Order {parcel.order_id}  parcel {parcel.number}/{parcels_total}"]
+    if weight_g is not None:
