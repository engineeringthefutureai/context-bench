+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Total units moved in each ISO week, keyed by `iso_week_label` in chronological order."""
+    totals: dict[str, int] = {}
+    for t in transfers:
+        label = iso_week_label(t.at.date())
+        totals[label] = totals.get(label, 0) + t.qty
+    return {label: totals[label] for label in sorted(totals)}
