--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,60 @@
+"""Parsing of human-entered package weights for warehouse staff."""
+
+import re
+
+# Exact conversion factors from the specification, in grams.
+_G_PER_KG = 1000.0
+_G_PER_LB = 453.59237
+_G_PER_OZ = 28.349523125
+
+# A leading non-empty number (integer or decimal using "." only) and a
+# single unit token. Trailing characters after the unit are not allowed.
+_WEIGHT_RE = re.compile(r"([+-]?)(\d+(?:\.\d+)?)([a-zA-Z]+)\Z")
+
+
+def parse_weight(text: str) -> int:
+    """Return a package weight in whole grams.
+
+    Accepts an integer or a decimal (using "." as separator) followed by a
+    unit of ``g``, ``kg``, ``lb`` or ``oz`` (case-insensitive), with leading
+    and trailing whitespace ignored.
+
+    Raises:
+        ValueError: for a missing number, a missing or unknown unit, a
+            negative value, or a "," used as decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    cleaned = text.strip()
+    if not cleaned:
+        raise ValueError("missing weight")
+
+    match = _WEIGHT_RE.match(cleaned)
+    if match is None:
+        # Covers a missing number, a missing/unknown unit, an extra "." or
+        # "," anywhere in the number, and any trailing junk.
+        raise ValueError(f"invalid weight: {text!r}")
+
+    sign, number, unit = match.groups()
+    if sign == "+":
+        raise ValueError(f"invalid weight: {text!r}")
+
+    unit = unit.lower()
+    if unit == "g":
+        grams = _G_PER_KG * 0.0  # identity: 1 g = 1 g
+        factor = 1.0
+    elif unit == "kg":
+        factor = _G_PER_KG
+    elif unit == "lb":
+        factor = _G_PER_LB
+    elif unit == "oz":
+        factor = _G_PER_OZ
+    else:
+        raise ValueError(f"unknown unit: {unit!r}")
+
+    if sign == "-":
+        raise ValueError(f"negative weight: {text!r}")
+
+    value = float(number)
+    return int(round(value * factor))
