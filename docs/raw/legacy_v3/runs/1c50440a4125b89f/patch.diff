+def parcel_weight_g(parcel: Parcel, products: dict[str, Product]) -> int:
+    """Total weight in grams of a parcel's contents: each unit's weight, summed over quantities.
+    An unknown SKU is an error rather than a silently under-weighted parcel."""
+    total = 0
+    for sku, qty in parcel.items:
+        if sku not in products:
+            raise ValueError(f"no product for sku {sku!r}")
+        total += products[sku].weight_g * qty
+    return total
+
