+"""Deployment settings.
+
+Values that differ between deployments (e.g. how long customers have to return a
+delivered order) live here so every module reads one canonical source. Environment
+overrides keep the defaults sensible for local development while letting an
+operator tune the behaviour of a deployment without a code change.
+"""
+import os
+
+_DEFAULTS = {
+    "return_window_days": "30",
+}
+
+
+def _int_env(name: str, default: int) -> int:
+    raw = os.environ.get(name)
+    if raw is None:
+        return default
+    raw = raw.strip()
+    if not raw:
+        return default
+    try:
+        return int(raw)
+    except ValueError as e:
+        raise ValueError(f"environment variable {name!r} must be an integer, got {raw!r}") from e
+
+
+def get(name: str) -> int:
+    if name not in _DEFAULTS:
+        raise KeyError(name)
+    env = f"SHOPKIT_{name.upper()}"
+    return _int_env(env, int(_DEFAULTS[name]))
+
+
+def return_window_days() -> int:
+    """Number of days a customer has to return a delivered order."""
+    return get("return_window_days")
