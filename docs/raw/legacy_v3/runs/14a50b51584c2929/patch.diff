+def transfers_by_week(transfers) -> dict[str, int]:
+    """Total units moved per week, keyed by the ISO week label dashboards use.
+
+    Weeks are in chronological order (insertion order of the returned dict).
+    """
+    per_week: dict[str, int] = {}
+    for t in transfers:
+        per_week[iso_week_label(t.at.date())] = per_week.get(iso_week_label(t.at.date()), 0) + t.qty
+    return {week: per_week[week] for week in sorted(per_week)}
