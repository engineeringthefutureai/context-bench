--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,50 @@
+import re
+
+# Exact conversions from the US customary units to grams.
+_LB_TO_GRAMS = 453.59237
+_OZ_TO_GRAMS = 28.349523125
+
+# A positive integer or decimal (with "." separator) immediately followed (optionally with
+# a single space) by a unit. The number must not be zero (0 / 0.0 / 00.5 are invalid).
+_WEIGHT_RE = re.compile(
+    r"^\s*(?P<number>(?:[1-9]\d*|0*\d*[1-9])(?:\.(?!\s*0+$)\d+)?)\s*(?P<unit>g|kg|lb|oz)\s*$",
+    re.IGNORECASE,
+)
+
+
+def _parse_number(text: str) -> float:
+    """Parse a positive decimal number whose trailing zeros have been stripped."""
+    if "." not in text:
+        return float(text)
+    whole, frac = text.split(".", 1)
+    return float(whole) + float(frac) / (10 ** len(frac))
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight typed in by warehouse staff and return the weight in whole grams.
+
+    The input is a positive integer or decimal (using "." as the decimal separator),
+    optional whitespace, then a unit of g, kg, lb or oz (case-insensitive).
+    Leading and trailing whitespace is ignored. The result is rounded to the nearest gram.
+
+    Raises:
+        ValueError: if the text is not in the expected form, is missing a number or unit,
+            names an unknown unit, uses "," as a decimal separator, or is zero or negative.
+    """
+    match = _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    number = _parse_number(match.group("number"))
+    unit = match.group("unit").lower()
+
+    if unit == "g":
+        grams = number
+    elif unit == "kg":
+        grams = number * 1000.0
+    elif unit == "lb":
+        grams = number * _LB_TO_GRAMS
+    else:  # oz
+        grams = number * _OZ_TO_GRAMS
+
+    return int(round(grams))
