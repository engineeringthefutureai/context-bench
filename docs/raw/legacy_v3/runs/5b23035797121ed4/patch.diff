--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,18 @@
+"""Duration parsing. Durations are stored and returned as whole minutes."""
+import re
+
+# Hours before minutes, each unit at most once, units case-insensitive, optional
+# whitespace between the parts. Anything the fullmatch rejects is an error.
+_DURATION_RE = re.compile(r"\s*(?:(\d+)[hH])?(?:(\d+)[mM])?\s*")
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration such as "2h", "45m", "1h30m" or "1h 30m" into whole minutes.
+    Raises ValueError for empty text, other units, a missing number, minutes before
+    hours, negative numbers or any other malformed input."""
+    if not _DURATION_RE.fullmatch(text):
+        raise ValueError(f"invalid duration: {text!r}")
+    m = _DURATION_RE.fullmatch(text)
+    hours = int(m.group(1)) if m.group(1) is not None else 0
+    minutes = int(m.group(2)) if m.group(2) is not None else 0
+    return hours * 60 + minutes
