+def export_orders_csv(orders: list[Order]) -> str:
+    """Spreadsheet export for finance: one row per order line.
+
+    Product codes are normalized the shop-wide way, and line totals are rendered exactly as on
+    customer invoices (e.g. "$1,234.56")."""
+    rows = [
+        [o.id, normalize_sku(l.sku), l.qty, format_money(l.total_cents, o.currency)]
+        for o in orders
+        for l in o.lines
+    ]
+    return to_csv(("order_id", "product_code", "quantity", "line_total"), rows)
