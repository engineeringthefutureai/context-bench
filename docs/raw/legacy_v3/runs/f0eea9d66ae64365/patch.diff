--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,39 @@
+"""Parsing of human-entered package weights.
+
+Warehouse staff type weights with a unit suffix (e.g. ``"2.5 kg"``); this
+module turns them into whole grams for the rest of the system.
+"""
+
+import re
+
+# Exact factors: 1 lb = 453.59237 g, 1 oz = 28.349523125 g.
+_G_PER_UNIT: dict[str, int | float] = {
+    "g": 1,
+    "kg": 1000,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+# A number is an integer or a "."-decimal, directly followed (after optional
+# whitespace) by one of the known units. Anything else fails to match.
+_WEIGHT_RE = re.compile(
+    r"^(?P<number>\d+(?:\.\d+)?)\s*(?P<unit>g|kg|lb|oz)$",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a typed-in weight into whole grams.
+
+    Accepts an integer or a "."-decimal, optional whitespace, then one of
+    ``g``, ``kg``, ``lb`` or ``oz`` (case-insensitive). Leading and trailing
+    whitespace is ignored. The result is rounded to the nearest whole gram.
+
+    Raises ``ValueError`` for anything else, including a missing number, a
+    missing or unknown unit, negative values and "," as the decimal separator.
+    """
+    m = _WEIGHT_RE.match(text.strip())
+    if m is None:
+        raise ValueError(f"cannot parse weight: {text!r}")
+    value = float(m["number"]) * _G_PER_UNIT[m["unit"].lower()]
+    return int(value + 0.5)
