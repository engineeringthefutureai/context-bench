+def export_orders_csv(orders: list[Order]) -> str:
+    """Finance CSV export: one row per order line, with customer-facing totals."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for order in orders:
+        for line in order.lines:
+            writer.writerow(
+                [
+                    order.id,
+                    cleanSKU(line.sku),
+                    line.qty,
+                    format_money(line.total_cents, order.currency),
+                ]
+            )
+    return buf.getvalue()
