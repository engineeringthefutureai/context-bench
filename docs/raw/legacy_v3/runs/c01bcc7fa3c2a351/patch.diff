--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,17 @@
+class InsufficientStockError(Exception):
+    """Raised when a reservation cannot be fulfilled from available stock.
+
+    Carries the quantities the API echoes back in its 409 error body.
+    """
+
+    def __init__(self, requested: int, available: int):
+        self.requested = requested
+        self.available = available
+        super().__init__(
+            f"insufficient stock: requested {requested}, available {available}"
+        )
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +23,14 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Lower the available quantity of ``sku`` by ``qty``.
+
+        Raises ``InsufficientStockError`` if less than ``qty`` is on hand; in
+        that case the available quantity is left unchanged.
+        """
+        current = self._on_hand.get(sku, 0)
+        if current < qty:
+            raise InsufficientStockError(requested=qty, available=current)
+        self._on_hand[sku] = current - qty
