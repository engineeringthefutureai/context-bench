+def _mask_card_numbers(value):
+    """Recursively replace any `card_number` field with its redacted form.
+
+    Other fields are returned unchanged.
+    """
+    if isinstance(value, dict):
+        return {
+            k: redact_pan(v) if k == "card_number" else _mask_card_numbers(v)
+            for k, v in value.items()
+        }
+    if isinstance(value, list):
+        return [_mask_card_numbers(item) for item in value]
+    return value
+
