+def _redact(value: object) -> object:
+    """Copy of event data with every card_number field masked via redact_pan, the same
+    masking the shop uses when it stores or shows card numbers. Other values unchanged."""
+    if isinstance(value, dict):
+        return {k: (redact_pan(v) if k == "card_number" and isinstance(v, str) else _redact(v))
+                for k, v in value.items()}
+    if isinstance(value, list):
+        return [_redact(v) for v in value]
+    return value
+
