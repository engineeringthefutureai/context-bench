+def _mask_card_numbers(data):
+    """Return a copy of *data* with every ``card_number`` field masked using the shop's standard
+    redaction (``redact_pan``). All other fields are left unchanged. Nested dicts and lists are
+    recursed into so the field is caught at any depth. A value that already contains ``*`` is
+    assumed to be masked and left as-is, so masking is not applied twice (which would corrupt an
+    already-redacted number)."""
+    if isinstance(data, dict):
+        out = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, str) and "*" not in value:
+                out[key] = redact_pan(value)
+            else:
+                out[key] = _mask_card_numbers(value)
+        return out
+    if isinstance(data, list):
+        return [_mask_card_numbers(item) for item in data]
+    return data
+
