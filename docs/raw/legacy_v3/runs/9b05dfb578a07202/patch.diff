+    def restocking_fee_cents(self, order: Order) -> int:
+        """Restocking fee: 12.5% of the refund for changed-mind returns, 0 for every other reason.
+
+        Rounded half-up to the nearest cent, like the shop's other percentage amounts (tax, discounts).
+        """
+        if self.reason != "changed_mind":
+            return 0
+        fee = Decimal(self.refund_cents(order)) * RESTOCKING_FEE_PERCENT / Decimal(100)
+        return int(fee.to_integral_value(rounding=ROUND_HALF_UP))
