--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,58 @@
+"""Unit conversion and parsing helpers shared across the system."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact conversion factors to grams.
+GRAMS_PER_KG = Decimal(1000)
+GRAMS_PER_LB = Decimal("453.59237")
+GRAMS_PER_OZ = Decimal("28.349523125")
+
+_UNITS = {
+    "g": Decimal(1),
+    "kg": GRAMS_PER_KG,
+    "lb": GRAMS_PER_LB,
+    "oz": GRAMS_PER_OZ,
+}
+
+_WEIGHT_RE = re.compile(r"^(?P<num>\d+(?:\.\d+)?)[ \t]*([a-zA-Z]+)$")
+
+
+def parse_weight(text: str) -> int:
+    """Parse a typed-in package weight like "1.5 kg" or "2 LB" and return whole grams.
+
+    The number must be a non-negative integer or decimal using "." as the separator; "," is
+    rejected. The unit is one of g, kg, lb, oz (case-insensitive). Leading/trailing whitespace
+    is ignored, and whitespace between the number and the unit is allowed. The result is rounded
+    to the nearest whole gram (halves away from zero).
+
+    Raises ValueError for a missing number, a missing or unknown unit, negative values, a comma
+    decimal separator, or any other malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+    stripped = text.strip()
+    match = _WEIGHT_RE.match(stripped)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    value = Decimal(match.group("num"))
+    factor = _UNITS.get(match.group(2).lower())
+    if factor is None:
+        raise ValueError(f"unknown weight unit: {text!r}")
+    return int((value * factor).quantize(Decimal(1), rounding=ROUND_HALF_UP))
+
+
+def to_grams(value: int, unit: str) -> int:
+    """Whole grams for an integer amount in `unit` (g, kg, lb or oz). Unknown units raise ValueError."""
+    factor = _UNITS.get(unit.lower())
+    if factor is None:
+        raise ValueError(f"unknown weight unit: {unit!r}")
+    return int((Decimal(value) * factor).quantize(Decimal(1), rounding=ROUND_HALF_UP))
+
+
+def grams_to(value: int, unit: str) -> Decimal:
+    """`value` whole grams converted to `unit` (g, kg, lb or oz), as a Decimal.
+    Unknown units raise ValueError."""
+    factor = _UNITS.get(unit.lower())
+    if factor is None:
+        raise ValueError(f"unknown weight unit: {unit!r}")
+    return Decimal(value) / factor
