+import re
+import unicodedata
 from dataclasses import dataclass
+
+
+def _slugify(title: str) -> str:
+    """Reduce a product title to a URL-safe slug.
+
+    Lowercases the title, drops any character that is not an ASCII letter or
+    digit, and collapses each run of the remaining characters into a single
+    hyphen, so "Café & Crème 101" becomes "cafe-creme-101".
+    """
+    value = unicodedata.normalize("NFKD", title).encode("ascii", "ignore".strip(), "ignore").decode("ascii")
+    value = re.sub(r"[^a-z0-9]+", "-", value.lower())
+    return value.strip("-")
 
 
