--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,46 @@
+import re
+
+_WEIGHT_RE = re.compile(
+    r"\s*(?P<number>[0-9]+(?:\.[0-9]+)?|\.[0-9]+)\s*(?P<unit>[a-zA-Z]+)\s*"
+)
+
+# Grams per unit as exact rational numbers: (numerator, denominator).
+_GRAMS_PER_UNIT = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45_359_237, 100_000),
+    "oz": (28_349_523_125, 1_000_000_000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-typed package weight into whole grams.
+
+    Accepts a non-negative integer or decimal number followed by g, kg, lb or
+    oz, case-insensitively, with optional whitespace. Raises ValueError for
+    negative values, unknown units, commas, or any other malformed input.
+    """
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError("invalid weight")
+
+    factor = _GRAMS_PER_UNIT.get(match["unit"].lower())
+    if factor is None:
+        raise ValueError("unknown weight unit")
+
+    number_text = match["number"]
+    if "." in number_text:
+        whole, frac = number_text.split(".", 1)
+        number = int(whole + frac)
+        scale = 10 ** len(frac)
+    else:
+        number = int(number_text)
+        scale = 1
+
+    unit_numerator, unit_denominator = factor
+    numerator = number * unit_numerator
+    denominator = scale * unit_denominator
+
+    # Round the non-negative rational value to the nearest whole gram,
+    # with ties rounding up.
+    return (2 * numerator + denominator) // (2 * denominator)
