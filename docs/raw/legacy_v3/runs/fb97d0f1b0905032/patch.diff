+def transfer_reference() -> str:
+    """Generate a 12-character pay-by-bank transfer reference in XXXX-XXXX-XXXX format."""
+    alphabet = string.ascii_uppercase + string.digits
+    groups = [
+        ''.join(secrets.choice(alphabet) for _ in range(4))
+        for _ in range(3)
+    ]
+    return '-'.join(groups)
