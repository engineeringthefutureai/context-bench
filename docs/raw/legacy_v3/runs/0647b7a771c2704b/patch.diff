+def expected_arrival(refund: Refund, business_days: int = 5) -> date:
+    """Date the refunded money is expected to reach the customer's card.
+
+    Banks need ``business_days`` business days, counted from the day after the refund
+    was issued, on the shop's usual business-day calendar (weekends and shop-closed
+    days don't count).
+    """
+    current = refund.at.date()
+    remaining = business_days
+    while remaining > 0:
+        current += timedelta(days=1)
+        if business_days(current):
+            remaining -= 1
+    return current
+
+
