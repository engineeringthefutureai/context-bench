--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,31 @@
+"""Weights for shipping: parse staff-typed weights into whole grams."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact gram equivalents; conversions stay in Decimal and never pass through binary floats.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# Integer or decimal ("." separator only), optional whitespace, then the unit.
+_WEIGHT_RE = re.compile(r"(\d+(?:\.\d*)?|\.\d+)[ \t]*(kg|g|lb|oz)", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight typed by warehouse staff, in whole grams: a number (integer or decimal
+    using "."), optional whitespace, then a unit g, kg, lb or oz, case-insensitive,
+    e.g. parse_weight(" 2 lb ") -> 907, parse_weight("8 oz") -> 227.
+    Rounds half-up to the nearest gram. Raises ValueError for a missing number or
+    unit, an unknown unit, negative values and "," as decimal separator."""
+    s = text.strip()
+    if s.startswith("-"):
+        raise ValueError(f"weight must not be negative: {text!r}")
+    m = _WEIGHT_RE.fullmatch(s)
+    if m is None:
+        raise ValueError(f"invalid weight (expected a number and a g/kg/lb/oz unit): {text!r}")
+    number, unit = m.group(1), m.group(2).lower()
+    grams = Decimal(number) * _GRAMS_PER_UNIT[unit]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
