+from .parcels import Parcel
+
+
+def packing_slip(parcel: Parcel, weight_g: int) -> str:
+    """Return the text of the packing slip for *parcel*.
+
+    The gift message (if any) is printed on this slip; only the first
+    parcel of an order carries it.
+    """
+    lines = [f"Order {parcel.order_id}"]
+    for line in parcel.lines:
+        lines.append(f"  {line.sku} x{line.qty}  {line.unit_cents}c")
+    lines.append(f"Weight: {weight_g}g")
+    if parcel.gift_message:
+        lines.append(f"Gift message: {parcel.gift_message}")
+    return "\n".join(lines)
