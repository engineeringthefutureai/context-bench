+from .models import Order
+
+
+def generate_invoice(order: Order) -> str:
+    """Return the customer-facing invoice text for *order*.
+
+    Gift messages are intentionally omitted from customer invoices.
+    """
+    lines = [f"Invoice — Order {order.id}"]
+    for line in order.lines:
+        lines.append(f"  {line.sku} x{line.qty}  {line.unit_cents}c  =  {line.total_cents}c")
+    lines.append(f"Total: {order.total_cents}c {order.currency}")
+    return "\n".join(lines)
