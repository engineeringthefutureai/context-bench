--- a/shopkit/orders/models.py
+++ b/shopkit/orders/models.py
@@ -21,3 +21,21 @@
     @property
     def total_cents(self) -> int:
         return sum(line.total_cents for line in self.lines)
+
+    def add_line(self, sku: str, qty: int, unit_cents: int) -> OrderLine:
+        """Add a line to the order, merging with an existing line of the same SKU
+        and unit price by increasing its quantity.
+
+        Returns the (possibly updated) order line that was touched.
+        """
+        for line in self.lines_lookup(self.lines):
+            if line.sku == sku and line.unit_cents == unit_cents:
+                line.qty += qty
+                return line
+        new_line = OrderLine(sku=sku, qty=qty, unit_cents=unit_cents)
+        self.lines.append(new_line)
+        return new_line
+
+
+def lines_lookup(lines: list[OrderLine]) -> list[OrderLine]:
+    return lines
