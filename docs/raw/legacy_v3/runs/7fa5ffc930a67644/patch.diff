+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order. Raises NotEnoughStock (409) with the
+        requested and available quantities if stock is short; nothing is reserved then."""
+        if qty < 1:
+            raise ValueError("qty must be >= 1")
+        have = self.available(sku)
+        if have < qty:
+            raise NotEnoughStock(f"not enough {sku}", sku=sku, requested=qty, available=have)
+        self._on_hand[sku] = have - qty
