+
+# Alphabet for transfer references: uppercase letters and digits minus the
+# lookalikes (I/O and 0/1), so customers can transcribe a reference from a
+# printed invoice or over the phone without guessing.
+_REFERENCE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+
+
+def transfer_reference() -> str:
+    """New bank transfer reference in the shop's customer-facing code style:
+    twelve characters in three dash-separated groups of four (e.g. "7K2P-M3X9-B6A4")."""
+    chars = [secrets.choice(_REFERENCE_ALPHABET) for _ in range(12)]
+    return "-".join("".join(chars[i:i + 4]) for i in (0, 4, 8))
 
 
