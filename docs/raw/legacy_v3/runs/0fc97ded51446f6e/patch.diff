--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,61 @@
+"""Utilities for parsing physical-unit values."""
+
+import re
+
+_WEIGHT_RE = re.compile(
+    r"(?P<number>[+-]?(?:[0-9]+(?:\.[0-9]+)?|\.[0-9]+))\s*(?P<unit>kg|g|lb|oz)",
+    re.IGNORECASE,
+)
+
+_GRAM_FACTORS = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Return the weight described by *text* in whole grams.
+
+    The input must be a non-negative integer or decimal number using "." as
+    the decimal separator, followed by optional whitespace and one of the
+    units ``g``, ``kg``, ``lb``, or ``oz``. The unit is case-insensitive.
+
+    Raises:
+        ValueError: If the input is not a valid non-negative weight.
+    """
+    if not isinstance(text, str):
+        raise ValueError("Weight must be a string")
+
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"Invalid weight: {text!r}")
+
+    number = match.group("number")
+    if number.startswith("-"):
+        raise ValueError("Weight must be non-negative")
+    if number.startswith("+"):
+        number = number[1:]
+
+    unit = match.group("unit").lower()
+
+    if "." in number:
+        integer_part, fractional_part = number.split(".")
+        numerator = int((integer_part or "0") + fractional_part)
+        denominator = 10 ** len(fractional_part)
+    else:
+        numerator = int(number)
+        denominator = 1
+
+    if numerator == 0:
+        return 0
+
+    factor_numerator, factor_denominator = _GRAM_FACTORS[unit]
+    grams_numerator = numerator * factor_numerator
+    grams_denominator = denominator * factor_denominator
+
+    whole, remainder = divmod(grams_numerator, grams_denominator)
+    if remainder * 2 >= grams_denominator:
+        whole += 1
+    return whole
