--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,35 @@
+"""Weight parsing and conversion helpers for warehouse staff input and carrier rates."""
+import re
+
+POUND_TO_GRAMS = 453.59237
+OUNCE_TO_GRAMS = 28.349523125
+
+_WEIGHT_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)\s*$", re.IGNORECASE)
+
+_UNIT_TO_GRAMS = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": POUND_TO_GRAMS,
+    "oz": OUNCE_TO_GRAMS,
+}
+
+
+def parse_weight(text: str) -> int:
+    """Convert a staff-typed weight like "1.5 kg" or " 2 lb " to whole grams.
+
+    Accepts an integer or decimal (with "." as the separator) followed by a
+    unit: g, kg, lb or oz (case-insensitive), with optional surrounding
+    whitespace. 1 lb = 453.59237 g and 1 oz = 28.349523125 g; the result is
+    rounded to the nearest gram. Raises ValueError for any other input,
+    including missing numbers or units, negative values and "," as the
+    decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"cannot parse {text!r} as a weight")
+    match = _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f"cannot parse {text!r} as a weight")
+    number = float(match.group(1))
+    unit = match.group(2).lower()
+    grams = number * _UNIT_TO_GRAMS[unit]
+    return int(round(grams))
