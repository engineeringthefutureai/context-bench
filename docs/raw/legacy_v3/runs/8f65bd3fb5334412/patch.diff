--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,33 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"(?:(?P<hours>[0-9]+)h(?:\s*(?P<minutes>[0-9]+)m)?"
+    r"|(?P<minutes_only>[0-9]+)m)",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration in hours and/or minutes into whole minutes.
+
+    Valid forms include "2h", "45m", "1h30m", and "1h 30m". Hours must come
+    before minutes, each unit may appear at most once, and units are
+    case-insensitive. Surrounding whitespace is ignored.
+
+    Raises ValueError for empty text, other units, missing numbers,
+    minutes before hours, or negative numbers.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("duration must not be empty")
+
+    match = _DURATION_RE.fullmatch(stripped)
+    if match is None:
+        raise ValueError(f"invalid duration: {stripped!r}")
+
+    hours = int(match.group("hours") or 0)
+    minutes = int(match.group("minutes") or match.group("minutes_only") or 0)
+    return hours * 60 + minutes
