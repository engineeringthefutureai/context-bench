@@ -0,0 +1,19 @@
+import re
+
+# Hours before minutes, each unit at most once: "2h", "45m", "1h30m", "1h 30m".
+_DURATION_RE = re.compile(r"^(?:(\d+)h)?\s*(?:(\d+)m)?$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes from a duration string, e.g. "1h 30m" -> 90.
+
+    Units are case-insensitive and surrounding whitespace is ignored. Raises
+    ValueError for empty text, other units, a missing number, minutes before
+    hours, a repeated unit or a negative number.
+    """
+    match = _DURATION_RE.match(text.strip())
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
