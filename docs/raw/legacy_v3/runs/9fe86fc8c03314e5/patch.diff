+def _mask_cards(data):
+    """Return a copy of data with every card_number field redacted the way the shop redacts
+    card numbers (payments.reconciliation.redact_pan). All other fields are unchanged."""
+    if isinstance(data, dict):
+        return {k: (redact_pan(v) if k == "card_number" else _mask_cards(v))
+                for k, v in data.items()}
+    if isinstance(data, list):
+        return [_mask_cards(v) for v in data]
+    return data
