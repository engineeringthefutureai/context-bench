--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,20 @@
+"""Duration parsing for human-entered times such as "2h", "45m" or "1h 30m"."""
+import re
+
+_DURATION = re.compile(
+    r"^\s*(?:(?P<hours>\d+)h)?\s*(?:(?P<minutes>\d+)m)?\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes in a duration like "2h", "45m", "1h30m" or "1h 30m".
+
+    Hours come before minutes, each unit at most once, units case-insensitive,
+    surrounding whitespace ignored. Raises ValueError for anything else."""
+    m = _DURATION.match(text)
+    if m is None or (m["hours"] is None and m["minutes"] is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(m["hours"]) if m["hours"] is not None else 0
+    minutes = int(m["minutes"]) if m["minutes"] is not None else 0
+    return hours * 60 + minutes
