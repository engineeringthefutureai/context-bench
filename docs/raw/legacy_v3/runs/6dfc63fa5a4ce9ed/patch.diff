+def _redact_card_numbers(value):
+    """Mask any card_number field in the event data before it leaves the shop, matching the redaction
+    used elsewhere (payments.reconciliation.redact_pan). Other values are returned
+    unchanged."""
+    if isinstance(value, dict):
+        return {k: (_redact_card_numbers(v) if k != "card_number" else
+                    (redact_pan(v) if isinstance(v, str) else v))
+                for k, v in value.items()}
+    if isinstance(value, list):
+        return [_redact_card_numbers(v) for v in value]
+    return value
+
