 """Shipping label content handed to the label printer service."""
+from decimal import Decimal, ROUND_HALF_UP
+from typing import Optional
+
 from shopkit.customers.addresses import format_address
 from shopkit.customers.models import Address
 from shopkit.orders.fulfillment import Parcel
+
+_GRAMS_PER_KILOGRAM = Decimal(1000)
+_GRAMS_PER_POUND = Decimal("453.59237")
+_US_COUNTRY_NAMES = {"US", "USA", "U.S.", "UNITED STATES", "UNITED STATES OF AMERICA"}
 
 
 def label_code(sku: str) -> str:
@@ -9,7 +16,31 @@
     return sku.replace(" ", "").replace("-", "").upper()
 
 
-def label_text(parcel: Parcel, to: Address, parcels_total: int) -> str:
+def _is_us_address(address: Address) -> bool:
+    """Return True when the label destination is the United States."""
+    for name in ("country_code", "country", "country_name"):
+        value = str(getattr(address, name, "") or "").strip().upper()
+        if value in _US_COUNTRY_NAMES:
+            return True
+    return False
+
+
+def _format_weight(weight_g: int, address: Address) -> str:
+    """Format a parcel weight using pounds for US labels and kilograms elsewhere."""
+    if weight_g < 0:
+        raise ValueError("weight_g must be non-negative")
+
+    if _is_us_address(address):
+        pounds = (Decimal(weight_g) / _GRAMS_PER_POUND).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+        return f"{pounds} lb"
+
+    kilograms = (Decimal(weight_g) / _GRAMS_PER_KILOGRAM).quantize(Decimal("0.1"), rounding=ROUND_HALF_UP)
+    return f"{kilograms} kg"
+
+
+def label_text(parcel: Parcel, to: Address, parcels_total: int, weight_g: Optional[int] = None) -> str:
     lines = [format_address(to), "", f"Order {parcel.order_id}  parcel {parcel.number}/{parcels_total}"]
+    if weight_g is not None:
+        lines.append(f"Weight: {_format_weight(weight_g, to)}")
     lines += [f"{label_code(sku)} x{qty}" for sku, qty in parcel.items]
     return "\n".join(lines)
