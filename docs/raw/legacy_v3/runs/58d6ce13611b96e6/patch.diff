+def _mask_card_number(payload: dict) -> dict:
+    """Copy of the event data with `card_number` masked via redact_pan (the same masking the shop
+    uses when it stores or displays card numbers); full PANs never leave the service."""
+    data = dict(payload)
+    if "card_number" in data and data["card_number"] is not None:
+        data["card_number"] = redact_pan(str(data["card_number"]))
+    return data
