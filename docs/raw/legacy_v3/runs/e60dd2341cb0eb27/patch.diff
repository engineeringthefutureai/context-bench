+from shopkit.errors import InsufficientStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,19 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Holds `qty` units of `sku` for a checkout order.
+
+        Lowers the available quantity of `sku` by `qty`. If there isn't enough
+        stock, nothing changes and an `InsufficientStock` conflict is raised so
+        the API answers 409 with the requested and available quantities.
+        """
+        avail = self.available(sku)
+        if qty > avail:
+            raise InsufficientStock(
+                f"only {avail} of {sku} available, {qty} requested",
+                requested=qty,
+                available=avail,
+            )
+        self._on_hand[sku] = avail - qty
