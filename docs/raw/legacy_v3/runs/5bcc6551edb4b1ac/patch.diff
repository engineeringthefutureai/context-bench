+def _mask_card_numbers(value: Any) -> Any:
+    """Deep copy of an event payload with every card_number field masked (redact_pan), the same
+    way card numbers are stored and shown elsewhere. All other fields pass through unchanged."""
+    if isinstance(value, dict):
+        masked = {}
+        for key, val in value.items():
+            if key == "card_number" and isinstance(val, str):
+                masked[key] = redact_pan(val)
+            else:
+                masked[key] = _mask_card_numbers(val)
+        return masked
+    if isinstance(value, list):
+        return [_mask_card_numbers(item) for item in value]
+    return value
+
