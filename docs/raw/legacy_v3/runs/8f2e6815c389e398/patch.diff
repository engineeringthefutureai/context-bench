--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+"""Duration parsing. Durations are always stored as whole minutes."""
+import re
+
+# Hours before minutes, each unit at most once, optional space between parts,
+# units case-insensitive, surrounding whitespace ignored.
+_DURATION_RE = re.compile(r"\s*(?:(\d+)h\s*)?(?:(\d+)m)?\s*")
+
+
+def parse_duration(text: str) -> int:
+    """Parse a human duration like "2h", "45m", "1h30m" or "1h 30m" into whole minutes.
+    Hours come before minutes, each unit at most once, units are case-insensitive and
+    surrounding whitespace is ignored. Anything else (empty text, other units, a
+    missing number, minutes before hours, negative numbers) raises ValueError."""
+    if not _DURATION_RE.fullmatch(text):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours_text, minutes_text = _DURATION_RE.fullmatch(text).groups()
+    if hours_text is None and minutes_text is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(hours_text) if hours_text is not None else 0
+    minutes = int(minutes_text) if minutes_text is not None else 0
+    return hours * 60 + minutes
