+def _mask_card_numbers(data: object) -> object:
+    """Copy of event data with every card_number field masked the way the shop stores and shows
+    card numbers (payments.reconciliation.redact_pan); all other values pass through unchanged."""
+    if isinstance(data, dict):
+        masked = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, str):
+                masked[key] = redact_pan(value)
+            else:
+                masked[key] = _mask_card_numbers(value)
+        return masked
+    if isinstance(data, list):
+        return [_mask_card_numbers(value) for value in data]
+    return data
+
