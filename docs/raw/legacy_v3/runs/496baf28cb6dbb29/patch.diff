+def _format_label_weight(grams: int, country: str) -> str:
+    """Weight for the label in the destination's customary unit.
+
+    US destinations show pounds with two decimals; every other destination keeps the
+    shop's standard kilogram display (matching the packing slips)."""
+    if country in ("US", "USA"):
+        return f"{kgToLbs(grams / 1000):.2f} lb"
+    return format_weight(grams, "kg")
