+import csv
+import io
 import json
 
 from shopkit.orders.models import Order
+
+
+def _clean_product_code(sku: str) -> str:
+    """Normalize product codes the same way they are shown elsewhere in the shop."""
+    return "".join(sku.split()).upper()
+
+
+def _format_line_total_cents(cents: int) -> str:
+    """Format line totals the same way they appear on customer invoices."""
+    sign = "-" if cents < 0 else ""
+    dollars, remainder = divmod(abs(cents), 100)
+    return f"{sign}${dollars}.{remainder:02d}"
 
 
