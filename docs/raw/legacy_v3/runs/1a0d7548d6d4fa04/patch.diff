+def export_orders_csv(orders: list[Order]) -> str:
+    """Spreadsheet export for finance: one row per order line.
+
+    Product codes are normalized the way invoices display them, and line
+    totals are formatted exactly as they appear on customer invoices.
+    """
+    rows = [
+        [o.id, normalize_sku(line.sku), line.qty, format_money(line.total_cents, o.currency)]
+        for o in orders
+        for line in o.lines
+    ]
+    return to_csv(["order_id", "product_code", "quantity", "line_total"], rows)
