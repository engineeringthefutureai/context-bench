--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,40 @@
+import re
+
+# Exact conversion factors to grams: 1 lb = 453.59237 g and
+# 1 oz = 28.349523125 g are the definitions given for this feature.
+_GRAMS_PER_UNIT = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+# <number><optional spaces><unit>. The number must be a plain "."-separated
+# integer or decimal; no sign, thousands separators or "," is allowed, which
+# makes negative values and "," decimal separators rejected outright.
+_WEIGHT_RE = re.compile(
+    r"^(\d+(?:\.\d+)?)(?:\s+([A-Za-z]+))?$"
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight such as ``"1.5 kg"`` into whole grams, rounded.
+
+    Accepts an integer or decimal (using ``"."`` as the separator) followed by
+    an optional amount of whitespace and a unit of ``g``, ``kg``, ``lb`` or
+    ``oz``, case-insensitively. Leading and trailing whitespace around the
+    whole input is ignored.
+
+    Raises ``ValueError`` for a missing number, a missing or unknown unit, a
+    negative value, or a "," used as the decimal separator.
+    """
+    match = _WEIGHT_RE.match(text.strip())
+    if not match:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    value = float(match.group(1))
+    unit = match.group(2).lower() if match.group(2) else None
+    if unit not in _GRAMS_PER_UNIT:
+        raise ValueError(f"invalid weight unit: {text!r}")
+
+    return round(value * _GRAMS_PER_UNIT[unit])
