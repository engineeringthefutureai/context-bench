--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,19 @@
+import re
+
+_DURATION = re.compile(r"(?P<hours>\d+h)?\s*(?P<minutes>\d+m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration such as "2h", "45m", "1h30m" or "1h 30m" into whole minutes.
+
+    Hours must come before minutes, and each unit may appear at most once.
+    Units are case-insensitive and surrounding whitespace is ignored. Raises ValueError
+    for empty text, other units, missing numbers, minutes before hours, or negative numbers.
+    """
+    m = _DURATION.fullmatch(text.strip())
+    if m is None or not (m["hours"] or m["minutes"]):
+        raise ValueError(f"bad duration {text!r}")
+
+    hours = int(m["hours"][:-1]) if m["hours"] else 0
+    minutes = int(m["minutes"][:-1]) if m["minutes"] else 0
+    return hours * 60 + minutes
