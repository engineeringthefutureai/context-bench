+def _mask_card_number(value):
+    """Return value with every "card_number" field redacted, the same way the shop masks card
+    numbers everywhere else it stores or shows them (payments.reconciliation.redact_pan).
+    Other fields are returned unchanged; the input is never mutated."""
+    if isinstance(value, dict):
+        return {k: (redact_pan(v) if k == "card_number" and isinstance(v, str)
+                    else _mask_card_number(v))
+                for k, v in value.items()}
+    if isinstance(value, list):
+        return [_mask_card_number(item) for item in value]
+    return value
