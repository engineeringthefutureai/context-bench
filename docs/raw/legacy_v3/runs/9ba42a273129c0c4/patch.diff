+def parcel_weight_g(parcel: Parcel, products: dict[str, Product]) -> int:
+    """Total weight in grams: each unit's weight (Product.weight_g) times its quantity. Unknown SKUs
+    are a data error and fail rather than underreporting the parcel's weight."""
+    for sku, _ in parcel.items:
+        if sku not in products:
+            raise NotFound(f"no product for sku {sku!r}")
+    return sum(products[sku].weight_g * qty for sku, qty in parcel.items)
