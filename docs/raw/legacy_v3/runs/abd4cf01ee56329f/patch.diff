+def export_orders_csv(orders: list[Order]) -> str:
+    """CSV export for finance: one row per-line spreadsheet review.
+
+    One row per order line: order_id,product_code,quantity,line_total.
+    Product codes are normalized with normalize_sku and line totals are
+    formatted exactly as on customer invoices (format_money, in the
+    order's currency).
+    """
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for order in orders:
+        for line in order.lines:
+            writer.writerow([
+                order.id,
+                normalize_sku(line.sku),
+                line.qty,
+                format_money(line.total_cents, order.currency),
+            ])
+    return buf.getvalue()
