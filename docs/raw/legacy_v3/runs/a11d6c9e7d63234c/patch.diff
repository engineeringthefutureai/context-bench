--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,47 @@
+import re
+
+# Exact conversions from the US customary base unit (the pound) to grams.
+_GRAMS_PER_LB = 453.59237
+_GRAMS_PER_OZ = 28.349523125
+_GRAMS_PER_KG = 1000.0
+
+_UNIT_FACTORS = {
+    "g": 1.0,
+    "kg": _GRAMS_PER_KG,
+    "lb": _GRAMS_PER_LB,
+    "oz": _GRAMS_PER_OZ,
+}
+
+# Number is an integer or a decimal using "." as separator; the unit is a
+# bare token, so the match must end at the end of the string.
+_WEIGHT_RE = re.compile(
+    r"^(?P<value>\d+(?:\.\d+)?)(?P<unit>[a-zA-Z]+)$"
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a package weight typed by warehouse staff.
+
+    Accepts a number (integer or "."-separated decimal), optional whitespace,
+    then a unit: g, kg, lb or oz (case-insensitive). Leading and trailing
+    whitespace is ignored. Returns the weight rounded to the nearest whole
+    gram.
+
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    cleaned = text.strip()
+    # A bare unit such as "kg" or whitespace between number and unit must be
+    # rejected, so require exactly one optional space in between.
+    m = re.fullmatch(r"(\d+(?:\.\d+)?) ?([a-zA-Z]+)", cleaned)
+    if not m:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    value_text, unit = m.group(1), m.group(2).lower()
+    factor = _UNIT_FACTORS.get(unit)
+    if factor is None:
+        raise ValueError(f"unknown unit in weight: {text!r}")
+
+    value = float(value_text)
+    return int(round(value * factor))
