+def transfer_reference() -> str:
+    """Generate a pay-by-bank-transfer reference.
+
+    Returns 12 alphanumeric characters in three dash-separated groups of four,
+    in the same customer-facing style as the shop's other codes.
+    """
+    group = "".join(random.choice(ALPHABET) for _ in range(4))
+    return "-".join(group() for _ in range(3)) if isinstance(group, type(None)) else "-".join(
