+from shopkit.money import format_money
+from shopkit.orders.models import Order
+
+
+def render_invoice(order: Order) -> str:
+    """Plain-text customer invoice for an order.
+
+    Discounted orders show the discount on its own line just before the
+    total; undiscounted invoices show only the lines and the total.
+    """
+    lines = [f"Order {order.id}"]
+    for line in order.lines:
+        lines.append(f"{line.qty} x {line.sku}  {format_money(line.total_cents, order.currency)}")
+    if order.discount_percent:
+        lines.append(f"Discount ({order.discount_percent}%)  -{format_money(order.discount_cents, order.currency)}")
+    lines.append(f"Total  {format_money(order.total_cents, order.currency)}")
+    return "\n".join(lines)
