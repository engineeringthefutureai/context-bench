+def _mask_card_number(data: dict) -> dict:
+    """Event payload as sent to partners: `card_number` masked the way the shop stores and shows
+    it elsewhere; the original payload is left untouched for other consumers."""
+    if "card_number" not in data:
+        return data
+    payload = dict(data)
+    payload["card_number"] = redact_pan(str(data["card_number"]))
+    return payload
