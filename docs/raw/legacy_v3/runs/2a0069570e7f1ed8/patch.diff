--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,18 @@
+"""Duration parsing for human-written values like "2h", "45m" or "1h 30m"."""
+import re
+
+_DURATION_RE = re.compile(r"(?:(\d+)\s*h)?(?:(\d+)\s*m)?")
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes for a duration written as hours and/or minutes: "2h", "45m", "1h30m", "1h 30m".
+    Hours come before minutes, each unit at most once, units are case-insensitive, surrounding
+    whitespace is ignored. Anything else (empty text, other units, a missing number, minutes before
+    hours, a negative number) raises ValueError."""
+    stripped = text.strip()
+    match = _DURATION_RE.fullmatch(stripped)
+    if not match or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1)) if match.group(1) is not None else 0
+    minutes = int(match.group(2)) if match.group(2) is not None else 0
+    return hours * 60 + minutes
