+def parcel_weight_g(parcel: Parcel, products: dict[str, Product]) -> int:
+    """Total shipping weight in grams of a parcel's contents. `products` maps SKU to product."""
+    total = 0
+    for sku, qty in parcel.items:
+        product = products.get(sku)
+        if product is None:
+            raise NotFound(f"unknown sku {sku!r}")
+        total += product.weight_g * qty
+    return total
+
