+    def restocking_fee_cents(self, order: Order) -> int:
+        # Changed-mind returns carry a 12.5% restocking fee; every other reason is free.
+        if self.reason != "changed_mind":
+            return 0
+        refund = self.refund_cents(order)
+        # 12.5% is 125/1000; round to the nearest cent, half up, like tax and discounts.
+        return (refund * 125 + 500) // 1000
