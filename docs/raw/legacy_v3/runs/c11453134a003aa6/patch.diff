--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+import re
+
+# Hours first, then optional minutes; each unit appears at most once.
+_DURATION_RE = re.compile(r"^\s*(?:(\d+)h)?\s*(?:(\d+)m)?\s*$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse an hours/minutes string such as "2h", "45m" or "1h 30m" into whole minutes.
+
+    Raises ValueError for anything else (empty text, other units, missing number,
+    minutes before hours, negative numbers, etc.).
+    """
+    match = _DURATION_RE.match(text)
+    if not match:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours_part, minutes_part = match.groups()
+    if hours_part is None and minutes_part is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(hours_part) if hours_part is not None else 0
+    minutes = int(minutes_part) if minutes_part is not None else 0
+    return hours * 60 + minutes
