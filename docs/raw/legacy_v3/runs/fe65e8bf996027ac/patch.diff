+def _mask_card_number(number: str) -> str:
+    if not number or not isinstance(number, str):
+        return number
+    if len(number) <= 4:
+        return "****"
+    return "**** **** **** " + number[-4:]
+
+
+def _mask_card_data(data: any) -> any:
+    if isinstance(data, dict):
+        masked = {}
+        for k, v in data.items():
+            if k == "card_number" and isinstance(v, str):
+                masked[k] = _mask_card_number(v)
+            else:
+                masked[k] = _mask_card_data(v)
+        return masked
+    elif isinstance(data, list):
+        return [_mask_card_data(item) for item in data]
+    else:
+        return data
+
