+def _redact_cards(data: object) -> object:
+    """Copy of `data` with every string `card_number` masked the way the shop stores card numbers
+    (see redact_pan), so full card numbers never reach a partner; all other fields pass through
+    unchanged."""
+    if isinstance(data, dict):
+        masked = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, str):
+                masked[key] = redact_pan(value)
+            else:
+                masked[key] = _redact_cards(value)
+        return masked
+    if isinstance(data, list):
+        return [_redact_cards(item) for item in data]
+    return data
+
