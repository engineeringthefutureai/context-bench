+def sanitize(value):
+    """Recursively mask any ``card_number`` field in an event payload before it leaves the shop.
+
+    ``card_number`` values are redacted the same way the shop masks card numbers everywhere else
+    (see ``redact_pan``); every other field passes through unchanged.
+    """
+    if isinstance(value, dict):
+        return {
+            k: redact_pan(str(v)) if k == "card_number" else sanitize(v)
+            for k, v in value.items()
+        }
+    if isinstance(value, (list, tuple)):
+        return [sanitize(v) for v in value]
+    return value
+
