+def export_orders_csv(orders: list[Order]) -> str:
+    """One row per order line, for finance's spreadsheet."""
+    rows = []
+    for o in orders:
+        for l in o.lines:
+            rows.append([o.id, cleanSKU(l.sku), l.qty, format_money(l.total_cents, o.currency)])
+    return to_csv(["order_id", "product_code", "quantity", "line_total"], rows)
