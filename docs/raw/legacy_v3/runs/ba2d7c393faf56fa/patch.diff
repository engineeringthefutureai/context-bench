+def export_orders_csv(orders: list[Order]) -> str:
+    """Spreadsheets of order lines for finance.
+
+    One row per order line, with line totals formatted like customer invoices.
+    """
+    buffer = io.StringIO()
+    writer = csv.writer(buffer)
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for o in orders:
+        for line in o.lines:
+            writer.writerow(
+                [
+                    o.id,
+                    normalize_sku(line.sku),
+                    line.qty,
+                    format_money(line.total_cents, o.currency),
+                ]
+            )
+    return buffer.getvalue()
