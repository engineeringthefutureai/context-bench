--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,47 @@
+import re
+from fractions import Fraction
+
+_WEIGHT_RE = re.compile(
+    r"(?P<number>[0-9]+(?:\.[0-9]+)?|\.[0-9]+)"
+    r"\s*"
+    r"(?P<unit>[A-Za-z]+)"
+)
+
+_GRAMS_PER = {
+    "g": Fraction(1, 1),
+    "kg": Fraction(1000, 1),
+    "lb": Fraction(45359237, 100000),
+    "oz": Fraction(28349523125, 1000000000),
+}
+
+
+def _number_to_fraction(number_text: str) -> Fraction:
+    """Convert the validated numeric part to an exact Fraction."""
+    if "." in number_text:
+        _, frac = number_text.split(".", 1)
+        denominator = 10 ** len(frac)
+    else:
+        denominator = 1
+    return Fraction(int(number_text.replace(".", "")), denominator)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-entered weight into whole grams.
+
+    Accepts an integer or decimal number ('.' as separator), optional whitespace,
+    and a unit of g, kg, lb or oz. Raises ValueError for invalid input.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"invalid weight: {text!r}")
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    unit = match.group("unit").lower()
+    factor = _GRAMS_PER.get(unit)
+    if factor is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    grams = _number_to_fraction(match.group("number")) * factor
+    # Valid weights are non-negative; add half a gram and truncate for round-half-up.
+    return int(grams + Fraction(1, 2))
