+def _mask_card_numbers(value):
+    """Event data with every `card_number` field masked by redact_pan, the same way the shop
+    stores and shows card numbers. Other fields are returned unchanged; a value that already
+    contains '*' is already masked, so it is left as-is rather than masked twice."""
+    if isinstance(value, dict):
+        out = {}
+        for key, v in value.items():
+            if key == "card_number" and isinstance(v, str) and "*" not in v:
+                out[key] = redact_pan(v)
+            else:
+                out[key] = _mask_card_numbers(v)
+        return out
+    if isinstance(value, list):
+        return [_mask_card_numbers(v) for v in value]
+    return value
+
