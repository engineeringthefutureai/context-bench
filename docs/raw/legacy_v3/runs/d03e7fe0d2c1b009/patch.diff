+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """
+    Total units moved per ISO week, keyed by week label (e.g., '2023-W01'),
+    in chronological order.
+    """
+    totals: dict[str, int] = {}
+    for t in transfers:
+        iso = t.at.isocalendar()
+        week_label = f"{iso.year}-W{iso.week:02d}"
+        totals[week_label] = totals.get(week_label, 0) + t.qty
+    return dict(sorted(totals.items()))
