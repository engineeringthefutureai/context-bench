@@ -6,7 +7,25 @@
 from shopkit.orders.models import Order
 from shopkit.utils.ids import short_code
 
-RETURN_WINDOW_DAYS = 30
+
+def return_window_days() -> int:
+    """Deployment setting: how many days after delivery a return can be opened.
+
+    Defaults to 30; override with the ``SHOPKIT_RETURN_DAYS`` environment
+    variable (positive whole number of days).
+    """
+    raw = os.environ.get("SHOPKIT_RETURN_DAYS")
+    if raw is None:
+        return 30
+    try:
+        days = int(raw)
+    except ValueError:
+        raise ShopError(f"SHOPKIT_RETURN_DAYS must be an integer, got {raw!r}", value=raw)
+    if days < 0:
+        raise ShopError(f"SHOPKIT_RETURN_DAYS must be non-negative, got {days}", value=days)
+    return days
+
+
 REASONS = ("damaged", "wrong_item", "not_as_described", "changed_mind")
 
 
