+def export_orders_csv(orders: list[Order]) -> str:
+    """CSV export for finance: one row per order line, totals as shown on customer invoices."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for o in orders:
+        for l in o.lines:
+            writer.writerow([o.id, normalize_sku(l.sku), l.qty, format_money(l.total_cents, o.currency)])
+    return buf.getvalue()
