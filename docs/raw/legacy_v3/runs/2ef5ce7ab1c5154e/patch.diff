+def return_window_days() -> int:
+    """Return window in days. Deployment setting: SHOPKIT_RETURN_DAYS when set,
+    otherwise the default RETURN_WINDOW_DAYS."""
+    raw = os.environ.get("SHOPKIT_RETURN_DAYS")
+    if raw is None:
+        return RETURN_WINDOW_DAYS
+    try:
+        days = int(raw)
+    except ValueError:
+        raise ValueError(f"SHOPKIT_RETURN_DAYS must be an integer, got {raw!r}") from None
+    if days < 0:
+        raise ValueError(f"SHOPKIT_RETURN_DAYS must not be negative, got {days}")
+    return days
+
+
