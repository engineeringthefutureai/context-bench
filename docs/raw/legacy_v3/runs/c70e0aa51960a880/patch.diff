+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Units moved per ISO week (same week labels as the sales dashboards), in chronological
+    order. Weeks without transfers are absent, not zero."""
+    totals: dict[str, int] = {}
+    for t in transfers:
+        week = iso_week_label(t.at.date())
+        totals[week] = totals.get(week, 0) + t.qty
+    return dict(sorted(totals.items()))
