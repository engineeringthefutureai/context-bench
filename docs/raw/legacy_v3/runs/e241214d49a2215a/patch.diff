+def return_window_days() -> int:
+    """Return window in days, from the SHOPKIT_RETURN_DAYS deployment setting (default 30)."""
+    raw = os.environ.get("SHOPKIT_RETURN_DAYS")
+    if raw is None:
+        return DEFAULT_RETURN_WINDOW_DAYS
+    try:
+        return int(raw)
+    except ValueError:
+        raise ShopError(f"SHOPKIT_RETURN_DAYS must be an integer, got {raw!r}") from None
