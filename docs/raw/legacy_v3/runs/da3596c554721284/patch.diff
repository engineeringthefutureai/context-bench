+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Total units moved per week, in chronological order.
+
+    Keys are the ``YYYY-Www`` ISO week labels (e.g. ``2024-W05``) shared
+    by the other dashboards; values are the sum of ``qty`` over every
+    transfer that week.
+    """
+    totals: dict[str, int] = {}
+    for t in sorted(transfers, key=lambda t: t.at):
+        iso_year, iso_week, _ = t.at.isocalendar()
+        label = f"{iso_year}-W{iso_week:02d}"
+        totals[label] = totals.get(label, 0) + t.qty
+    return totals
