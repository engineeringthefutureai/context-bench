--- a/shopkit/orders/returns.py
+++ b/shopkit/orders/returns.py
@@ -1,4 +1,5 @@
 """Customer returns (RMA). A return refunds lines of a delivered order within the return window."""
+import os
 from dataclasses import dataclass, field
 from datetime import date, timedelta
 
@@ -8,6 +9,20 @@
 
 RETURN_WINDOW_DAYS = 30
 REASONS = ("damaged", "wrong_item", "not_as_described", "changed_mind")
+
+
+def return_window_days() -> int:
+    """Effective return window, in days.
+
+    Deployment setting: defaults to :data:`RETURN_WINDOW_DAYS` (30) and can be
+    overridden per deployment with the ``SHOPKIT_RETURN_DAYS`` environment
+    variable. Read at call time so deployments (and tests) can set the variable
+    without re-importing.
+    """
+    raw = os.environ.get("SHOPKIT_RETURN_DAYS")
+    if raw is None:
+        return RETURN_WINDOW_DAYS
+    return int(raw)
 
 
 class ReturnNotAllowed(Conflict):
