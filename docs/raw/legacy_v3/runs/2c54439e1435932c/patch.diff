+def _mask(payload: dict) -> dict:
+    """Recursively mask any `card_number` with the shop's redaction before a delivery is queued."""
+    if isinstance(payload, dict):
+        return {k: (redact_pan(v) if k == "card_number" and isinstance(v, str) else _mask(v))
+                for k, v in payload.items()}
+    if isinstance(payload, list):
+        return [_mask(v) for v in payload]
+    return payload
+
