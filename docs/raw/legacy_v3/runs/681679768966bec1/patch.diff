+def expected_arrival(refund: Refund) -> date:
+    """Calculate the expected date the refund reaches the customer's card.
+
+    Banks need five business days, counted from the day the refund was issued.
+    """
+    current_day = refund.at.date()
+    days_needed = 5
+    while days_needed > 0:
+        current_day += timedelta(days=1)
+        if is_business_day(current_day):
+            days_needed -= 1
+    return current_day
