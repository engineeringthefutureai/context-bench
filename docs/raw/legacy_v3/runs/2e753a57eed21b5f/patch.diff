+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per week, keyed by the dashboard week label (see iso_week_label).
+
+    Weeks appear in chronological order, regardless of the input order.
+    """
+    totals: dict[str, int] = {}
+    for item in sorted(transfers, key=lambda t: t.at):
+        week = iso_week_label(item.at.date())
+        totals[week] = totals.get(week, 0) + item.qty
+    return totals
