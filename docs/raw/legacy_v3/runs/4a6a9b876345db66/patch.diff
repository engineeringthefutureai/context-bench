+def _mask_card_numbers(value):
+    """Recursively replace any `card_number`/`card_number` string value with its masked form."""
+    if isinstance(value, dict):
+        return {k: (redact_pan(v) if (k in ("card_number", "card") and isinstance(v, str))
+                    else _mask_card_numbers(v)) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_mask_card_numbers(v) for v in value]
+    return value
