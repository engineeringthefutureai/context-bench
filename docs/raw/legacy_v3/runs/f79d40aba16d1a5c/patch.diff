+def _mask_pan(value):
+    """Return *value* with every ``card_number`` field masked the way the shop stores and shows
+    card numbers (see redact_pan); all other fields pass through unchanged."""
+    if isinstance(value, dict):
+        return {k: (redact_pan(v) if k == "card_number" and isinstance(v, str) else _mask_pan(v))
+                for k, v in value.items()}
+    if isinstance(value, list):
+        return [_mask_pan(v) for v in value]
+    return value
+
