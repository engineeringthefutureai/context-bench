--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,34 @@
+"""Weight parsing for shipping labels: warehouse staff type a number and a unit; we need whole grams."""
+import re
+from decimal import Decimal
+
+# Exact factors to grams. Defined as strings so the conversion stays exact; a float factor would
+# turn "1.00 lb" into 453.59237000000004 g and round a true .5 boundary to the wrong gram.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# Number (digits, one optional "."-separated decimal part) then a single unit token. Case-insensitive.
+_WEIGHT_RE = re.compile(r"(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)\Z", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a human-typed weight such as "2.5 kg" or "12 lb" into whole grams (rounded).
+
+    Accepts an integer or a "."-separated decimal, optional whitespace between the number and the
+    unit, and a unit of g, kg, lb or oz (case-insensitive). Leading/trailing whitespace is ignored.
+    Raises ValueError for a missing or non-decimal number, a missing or unknown unit, a negative
+    value, or a "," decimal separator."""
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if not match:
+        raise ValueError(f"invalid weight: {text!r}")
+    value = Decimal(match.group(1))
+    if value < 0:
+        raise ValueError(f"weight must be non-negative: {text!r}")
+    grams = value * _GRAMS_PER_UNIT[match.group(2).lower()]
+    return int(grams.to_integral_value(rounding="ROUND_HALF_UP"))
