--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,22 @@
+"""Duration parsing. Durations are whole minutes; the only units accepted are hours and minutes."""
+import re
+
+# Hours first, each unit at most once, optional whitespace between, case-insensitive.
+_DURATION_RE = re.compile(r"\A(\d+h)?\s*(\d+m)?\Z")
+
+
+def parse_duration(text: str) -> int:
+    """Total whole minutes in minutes, e.g. "2h" -> 120, "45m" -> 45, "1h30m" / "1h 30m" -> 90.
+
+    Either unit may be omitted; both must not be. Anything else (empty text, other
+    units, a missing number, minutes before hours, negative or non-integer numbers,
+    extra units or characters) raises ValueError."""
+    hours = minutes = 0
+    found = False
+    for raw in _DURATION_RE.fullmatch(text.strip()).groups():
+        if raw:
+            hours, minutes = (int(raw[:-1]), 0) if raw.endswith("h") else (0, int(raw[:-1]))
+            found = True
+    if not found:
+        raise ValueError(f"invalid duration: {text!r}")
+    return hours * 60 + minutes
