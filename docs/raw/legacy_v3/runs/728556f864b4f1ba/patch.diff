+"""Unit parsing for warehouse weight entry. Weights flow through shipping as whole grams."""
+import re
+
+from decimal import Decimal
+
+# Exact international conversions: gram is the base unit, so the factor is grams per unit.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.3.49523125"),
+}
+
+_WEIGHT_RE = re.compile(r"^(?P<number>\d+(?:\.\d+)?)(?P<unit>g|kg|lb|oz)$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight typed by warehouse staff into whole grams.
+
+    Accepts a number (int or decimal with "." separator), optional spaces, then g/kg/lb/oz
+    (case-insensitive), with surrounding whitespace ignored: "2 kg" -> 2000, "1 lb" -> 454,
+    "12.5 oz" -> 354. Negative values, a missing number or unit, and "," as a decimal
+    separator all raise ValueError.
+    """
+    match = _WEIGHT_RE.match(text.strip())
+    if not match:
+        raise ValueError(f"invalid weight: {text!r}")
+    grams = Decimal(match.group("number")) * _GRAMS_PER_UNIT[match.group("unit").lower()]
+    return int(grams.quantize(Decimal(1)))
