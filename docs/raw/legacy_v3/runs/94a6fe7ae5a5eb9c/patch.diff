--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,52 @@
+import re
+
+_UNIT_FACTORS = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+_WEIGHT_PATTERN = re.compile(
+    r"^(\d+(?:\.\d+)?)"   # number: one or more digits, optional decimal part using '.'
+    r"[ ]*"                # optional whitespace between number and unit
+    r"(g|kg|lb|oz)"        # unit (lowercase in pattern, matched case-insensitively)
+    r"[ ]*$",              # optional trailing whitespace
+    re.IGNORECASE
+)
+
+
+def parse_weight(text: str) -> int:
+    """
+    Parse a weight string into whole grams.
+
+    Accepts a number (integer or decimal using '.'), optional whitespace,
+    and a unit (g, kg, lb, or oz), case-insensitive.
+
+    Raises ValueError for malformed input, missing number/unit, negative values,
+    or use of ',' as a decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"Expected string, got {type(text).__name__}")
+
+    # Reject strings containing ',' — prevents silent misinterpretation of European-style decimals
+    if "," in text:
+        raise ValueError("Comma is not allowed as a decimal separator")
+
+    match = _WEIGHT_PATTERN.match(text.strip())
+    if not match:
+        raise ValueError(f"Invalid weight format: {text!r}")
+
+    number_str = match.group(1)
+    unit = match.group(2).lower()
+
+    try:
+        number = float(number_str)
+    except (ValueError, OverflowError):
+        raise ValueError(f"Invalid number: {number_str!r}")
+
+    if number < 0:
+        raise ValueError("Weight cannot be negative")
+
+    grams = number * _UNIT_FACTORS[unit]
+    return int(round(grams))
