+def _mask_payload(payload):
+    """Mask any ``card_number`` value in the event payload before it leaves the shop.
+
+    Only string ``card_number`` fields are touched, and each is masked with the
+    same ``redact_pan`` routine used everywhere else a card number is stored or
+    shown. Other fields are left unchanged."""
+    if not isinstance(payload, dict):
+        return payload
+    masked = {}
+    for k, v in payload.items():
+        if k == "card_number" and isinstance(v, str):
+            masked[k] = redact_pan(v)
+        else:
+            masked[k] = v
+    return masked
+
