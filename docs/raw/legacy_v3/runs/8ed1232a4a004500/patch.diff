+def _redact_card_numbers(data):
+    """Replace any "card_number" value with the standard redacted form (see redact_pan) so full
+    card numbers never reach the wire; everything else is left untouched."""
+    if not isinstance(data, dict):
+        return data
+    redacted = {}
+    for key, value in data.items():
+        if key == "card_number" and isinstance(value, str):
+            redacted[key] = redact_pan(value)
+        else:
+            redacted[key] = value
+    return redacted
+
