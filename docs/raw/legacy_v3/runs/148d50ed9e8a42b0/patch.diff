+def export_orders_csv(orders: list[Order]) -> str:
+    """Spreadsheet export, one row per order line, matching customer invoice formatting."""
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for o in orders:
+        for line in o.lines:
+            writer.writerow(
+                [
+                    o.id,
+                    normalize_sku(line.sku),
+                    line.qty,
+                    format_money(line.total_cents, o.currency),
+                ]
+            )
+    return buf.getvalue()
