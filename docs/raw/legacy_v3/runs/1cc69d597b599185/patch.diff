+from shopkit.errors import OutOfStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,18 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order.
+
+        Leaves stock unchanged and raises OutOfStock (HTTP 409) when fewer units than
+        `qty` are available, or when `qty` is negative.
+        """
+        on_hand = self._on_hand.get(sku, 0)
+        if qty < 0 or qty > on_hand:
+            raise OutOfStock(
+                f"not enough stock of {sku}: requested {qty}, available {on_hand}",
+                requested=qty,
+                available=on_hand,
+            )
+        self._on_hand[sku] = on_hand - qty
