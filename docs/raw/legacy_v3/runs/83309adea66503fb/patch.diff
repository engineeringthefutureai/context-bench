+def _mask_card_numbers(data: object) -> object:
+    """Copy of the event data with every card_number redacted the way the shop stores and shows
+    card numbers (see payments.reconciliation.redact_pan); all other fields are left unchanged."""
+    if isinstance(data, dict):
+        return {
+            key: redact_pan(value) if key == "card_number" and isinstance(value, str)
+            else _mask_card_numbers(value)
+            for key, value in data.items()
+        }
+    if isinstance(data, list):
+        return [_mask_card_numbers(item) for item in data]
+    return data
+
