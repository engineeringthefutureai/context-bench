+++ b/shopkit/utils/units.py
@@ -0,0 +1,36 @@
+"""Helpers for weights and other physical units typed in by people (warehouse, shipping)."""
+
+import re
+
+# Exact conversion factors to grams.
+_LB_TO_G = 453.59237
+_OZ_TO_G = 28.349523125
+
+# A number (digits, with at most one "." decimal point and digits on at least one side),
+# optional surrounding whitespace, then a unit. Matched case-insensitively.
+_WEIGHT_RE = re.compile(r'^\s*(\d+(?:\.\d+)?|\.\d+)\s*(g|kg|lb|oz)\s*$', re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a human-typed weight and return it in whole grams.
+
+    Accepts an integer or decimal (using "." as the separator) followed by a
+    unit of g, kg, lb or oz (case-insensitive), with optional surrounding
+    whitespace. 1 lb = 453.59237 g and 1 oz = 28.349523125 g. The result is
+    rounded to the nearest gram.
+
+    Raises ValueError for a missing number, a missing or unknown unit, a
+    comma as decimal separator, or any other malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f'weight must be a string, not {type(text).__name__}')
+
+    match = _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f'invalid weight: {text!r}')
+
+    number, unit = match.groups()
+    grams = float(number) * {'g': 1.0, 'kg': 1000.0, 'lb': _LB_TO_G, 'oz': _OZ_TO_G}[unit.lower()]
+
+    # Round half-up to the nearest gram (values are non-negative here).
+    return int(grams + 0.5)
