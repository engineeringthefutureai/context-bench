--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,60 @@
+"""Read-only preview of where a refund would go, for the support agent's Refund screen.
+
+Mirrors the destination logic in payments.settlement.settle_refund so the numbers shown before the
+agent presses Refund are exactly the cents the refund would be split into. Nothing here mutates
+any payment, ledger or store credit.
+"""
+
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.utils.dates import utc_now
+
+# Must match payments.settlement.CARD_REFUND_MAX_AGE_DAYS (180: older card refunds go to store credit)
+CARD_REFUND_MAX_AGE_DAYS = 180
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment], today: date | None = None) -> dict[str, int]:
+    """Cents of an ``amount_cents`` refund for ``order_id`` that would go back to the card, to store
+    credit and to a new gift card, following the same split as settle_refund.
+
+    Returns a dict with the keys "card", "store_credit" and "gift_card". Pure: performs no refund.
+    """
+    dest = {"card": 0, "store_credit": 0, "gift_card": 0}
+    if not payments or amount_cents <= 0:
+        return dest
+    today = today or utc_now().date()
+
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        return dest
+
+    # Same allocation as settle_refund: proportional to what is still refundable on each payment, card payments
+    # first so the leftover cents can never push a gift card past its share.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    if total_weight <= 0:
+        return dest
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            dest["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            dest["store_credit"] += share
+        else:
+            dest["card"] += share
+    return dest
