+# -*- coding: utf-8 -*-
+#
+# Cash till: the amount the cashier asks the customer to pay at the pop-up stores.
+#
+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+from shopkit.errors import ShopError
+
+
+class InvalidPayment(ShopError):
+    http_status = 422
+
+
+PAID_BY = ("card", "cash")
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Amount the cashier asks for: the exact total on card, the till amount for cash.
+
+    Cash follows the national cash rules (in CAD that means rounding to the nearest
+    5 cents, the same way the shop already treats cash elsewhere); card is never
+    rounded."""
+    if paid_by not in PAID_BY:
+        raise InvalidPayment(f"paid_by must be one of {PAID_BY}", paid_by=paid_by)
+    cents = int(total_cents)
+    if paid_by == "cash":
+        return cashRoundCents(cents, currency)
+    return cents
