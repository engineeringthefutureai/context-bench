+def expected_arrival(refund: Refund) -> date:
+    """When the refund is expected to show on the customer's card.
+
+    Five business days after the refund was issued, on the shop's business-day calendar
+    (weekends and HOLIDAYS don't count). Issuing on Friday, the money arrives the following
+    Thursday; issuing on a holiday, the first business day is the next working day.
+    """
