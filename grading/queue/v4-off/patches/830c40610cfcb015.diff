--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,15 @@
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: list[str], sites: list[Site], hazmat_skus: frozenset[str] = frozenset()) -> bool:
+    """Would the warehouse put an order containing these SKUs into an express wave?
+
+    Express leaves by air, so an order that contains any hazmat SKU is never express: it is
+    downgraded to standard (see waves.allocate_wave). An express wave can only be built at a site
+    that offers air service, so at least one site must have it.
+    """
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in site.services for site in sites)
