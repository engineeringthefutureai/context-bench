--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,24 @@
+"""Which delivery speeds the warehouse can actually honour for a given cart, so checkout stops
+offering express for orders it will send by ground. Mirrors the express decision in
+warehouse.waves.allocate_wave, which is where orders actually get put into express waves."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+# The dock service express leaves by. Hazmat never goes express (it is ground-only), and a site with
+# no air service can't ship by express.
+_EXPRESS_SERVICE = "air"
+
+
+def express_available(skus, sites, hazmat_skus) -> bool:
+    """True if the warehouse would put an order with `skus` into an express wave.
+
+    skus: the cart's SKUs (any iterable). sites: the warehouse sites (warehouse.sites.Site) that
+    could ship it. hazmat_skus: SKUs classed as dangerous goods.
+
+    The order can go express only when it has no dangerous goods (express leaves by air, so
+    hazmat is downgraded to a standard wave) and at least one site that ships by air."""
+    hazmat = set(hazmat_skus)
+    if any(s in hazmat for s in skus):
+        return False
+    return any(_EXPRESS_SERVICE in site.services for site in sites)
