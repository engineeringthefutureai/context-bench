--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,24 @@
+"""Delivery options offered at checkout, kept in sync with how the warehouse actually waves orders."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+from shopkit.warehouse.waves import EXPRESS, STANDARD
+
+
+def express_available(skus, sites: list[Site], hazmat_skus) -> bool:
+    """Whether the warehouse would really put an order with these SKUs into an express wave.
+
+    `skus` is the cart's SKUs, `sites` the warehouse sites that could ship the order
+    (warehouse.sites.Site) and `hazmat_skus` the SKUs classed as dangerous goods.
+
+    Mirrors warehouse.waves.allocate_wave: an order lands in an express wave only when it is
+    allocated with the express service. A cart containing any hazmat SKU is downgraded to the
+    standard service (express leaves by air, hazmat only goes ground), so it is never an express
+    candidate. An empty cart ships nothing. Everything else ships by express whenever checkout
+    marks it express, regardless of which sites end up allocating it."""
+    if not skus:
+        return False
+    hazmat = hazmat_skus or frozenset()
+    if any(sku in hazmat for sku in skus):
+        return False
+    return bool(sites)
