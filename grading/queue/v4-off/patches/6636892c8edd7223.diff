--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,28 @@
+import re
+
+_PATTERN = re.compile(
+    r"^\s*(?:(\d+)h)?\s*(?:(\d+)m)?\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes from an hours/minutes string, e.g. "1h 30m" -> 90.
+
+    Hours and minutes are each optional but at most one of each, hours before
+    minutes, units case-insensitive, surrounding whitespace ignored.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a string, got {type(text).__name__}")
+
+    match = _PATTERN.match(text)
+    if not match:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours_str, minutes_str = match.groups()
+    if hours_str is None and minutes_str is None:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours = int(hours_str) if hours_str is not None else 0
+    minutes = int(minutes_str) if minutes_str is not None else 0
+    return hours * 60 + minutes
