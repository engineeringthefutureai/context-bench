--- /dev/null
+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,14 @@
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Label for the warehouse pallet scanner, which reads finance item numbers rather than SKUs.
+
+    First line is ``PALLET <pallet_id>``, then one ``<item number> x<qty>`` line per item in the
+    order given, where the item number is the product's identifier in the finance (ERP) system.
+    """
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
