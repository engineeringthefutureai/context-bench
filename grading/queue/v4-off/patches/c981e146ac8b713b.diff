--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,37 @@
+"""Package weight parsing for warehouse staff input.
+
+Weights are stored as whole grams; conversions use exact decimal factors so
+repeated rounding never drifts the totals.
+"""
+import re
+from decimal import Decimal
+
+# Grams per unit, as exact decimals. 453.59237 / 28.349523125 are the official
+# avoirdupois conversions and divide evenly at this precision.
+_GRAMS_PER_UNIT = {
+    "g": Decimal("1"),
+    "kg": Decimal("1000"),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+_WEIGHT_RE = re.compile(r"^(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight typed by warehouse staff into whole grams.
+
+    Accepts a non-negative number (integer or "."-decimal) and a unit of g, kg,
+    lb or oz, case-insensitive, with optional whitespace between them. Raises
+    ValueError for a missing number, a missing or unknown unit, a negative
+    value or "," as decimal separator.
+    """
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    number, unit = match.groups()
+    grams = Decimal(number) * _GRAMS_PER_UNIT[unit.lower()]
+    return int(grams)
+
+
+__all__ = ["parse_weight"]
