+def expected_arrival(refund: Refund) -> date:
+    """When the customer can expect the money on their card.
+
+    Banks need five business days from the day the refund was issued; weekends and shop
+    holidays (utils.dates.HOLIDAYS) do not count. A refund issued on a non-business day
+    starts counting from the next business day."""
+    issued = refund.at.date()
+    if not is_business_day(issued):
+        issued = add_business_days(issued, 0)
+    return add_business_days(issued, CARD_REFUND_BUSINESS_DAYS)
+
