--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,32 @@
+"""Weight helpers for the shipping warehouse tools."""
+import re
+
+# Exact conversions: 1 lb = 453.59237 g, 1 oz = 28.349523125 g.
+_GRAMS_PER_UNIT = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+_WEIGHT_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*([a-z]+)\s*$")
+
+
+def parse_weight(text: str) -> int:
+    """Package weight typed in by warehouse staff, in whole grams.
+
+    Accepts an integer or a decimal (with "." as separator), optional whitespace,
+    then the unit g, kg, lb or oz (case-insensitive), e.g. "1.5 kg", " 2 lb ".
+    Returns the weight rounded to the nearest gram. Raises ValueError for
+    anything else: missing or unknown units, missing or negative numbers,
+    "," as decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+
+    match = _WEIGHT_RE.search(text.strip().lower())
+    if not match or match.group(2) not in _GRAMS_PER_UNIT:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    value = float(match.group(1)) * _GRAMS_PER_UNIT[match.group(2)]
+    return round(value)
