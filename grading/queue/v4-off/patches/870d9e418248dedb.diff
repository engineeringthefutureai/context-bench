--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,45 @@
+"""Parsing helpers for quantities typed in by warehouse staff."""
+
+import re
+
+_GRAMS_PER_LB = 453.59237
+_GRAMS_PER_OZ = 28.349523125
+_GRAMS_PER_KG = 1000
+
+# A weight typed in by hand: number (integer or "."-decimal, no thousands
+# separators) then a unit. Whitespace around the value is ignored by the caller.
+_WEIGHT_RE = re.compile(r"(?P<number>\d+(?:\.\d+)?)\s*(?P<unit>[a-z]+)", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Convert a weight typed by warehouse staff to whole grams.
+
+    Accepts a number (integer or decimal using "." as separator), optional
+    whitespace, then a unit: g, kg, lb or oz (case-insensitive).
+    Leading and trailing whitespace is ignored. Rounds to the nearest gram.
+    Raises ValueError for a missing or unknown unit, a negative value, or a
+    "," decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("weight is empty")
+
+    match = _WEIGHT_RE.fullmatch(stripped)
+    if match is None:
+        raise ValueError(f"unrecognized weight {text!r}")
+
+    unit = match["unit"].lower()
+    factor = {
+        "g": 1,
+        "kg": _GRAMS_PER_KG,
+        "lb": _GRAMS_PER_LB,
+        "oz": _GRAMS_PER_OZ,
+    }.get(unit)
+    if factor is None:
+        raise ValueError(f"unknown weight unit {match['unit']!r}")
+
+    grams = float(match["number"]) * factor
+    return int(grams + 0.5)
