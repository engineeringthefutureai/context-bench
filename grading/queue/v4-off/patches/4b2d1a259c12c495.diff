--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,36 @@
+"""Partner-facing explanation for why an order event is (or is not) delayed.
+
+The delivery worker holds back events about orders in fraud review (see
+shopkit.api.webhook_delivery.deliver_pending): partners such as ERPs and 3PLs
+must not start fulfilling an order that may still be cancelled. This module
+answers the partner's "why is this late?" question the same way the worker
+decides it, for the event about to be queued."""
+from __future__ import annotations
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+__all__ = ["explain_delay"]
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Why the webhook worker would hold `event` for `order_id` right now.
+
+    `under_review` is a callable like the one the delivery worker takes:
+    ``under_review(order_id)`` says whether that order is in fraud review.
+
+    Returns a short reason when the worker would hold the event back, or None
+    when it would send it normally. Mirrors the worker's review-hold rules:
+    cancellations and refunds always go out, orders without an order id are
+    never held, and a failed review lookup fails closed (held, not shipped).
+    """
+    if event in ALWAYS_DELIVER:
+        return None
+    if not order_id or under_review is None:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        return "order status lookup failed, holding until it succeeds"
+    if reviewing:
+        return "order is in fraud review; held until the review clears"
+    return None
