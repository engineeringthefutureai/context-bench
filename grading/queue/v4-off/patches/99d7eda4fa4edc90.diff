--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,69 @@
+"""Parsing and formatting of physical units for warehouse staff input."""
+
+import re
+
+# Exact conversion factors to grams.
+_G_PER_KG = 1000
+_G_PER_LB = 453.59237
+_G_PER_OZ = 28.349523125
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight typed by warehouse staff and return whole grams.
+
+    Accepts an integer or a decimal (using "." as the separator) optionally
+    followed by whitespace and a unit: g, kg, lb or oz (case-insensitive).
+    Leading and trailing whitespace is ignored. The value is rounded to the
+    nearest gram.
+
+    Raises ValueError for anything else, including a missing number, a missing
+    or unknown unit, negative values, and "," as a decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("weight must not be empty")
+
+    # "," is not accepted as a decimal separator.
+    if "," in stripped:
+        raise ValueError('"," is not a valid decimal separator')
+
+    # Number: integer or decimal using ".". Capture it so we can validate
+    # that a non-empty, finite value was provided.
+    match = re.match(r"^(?P<number>\d+(?:\.\d+)?)\s*(?P<unit>[A-Za-z]+)$", stripped)
+    if not match:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    number = match.group("number")
+    unit = match.group("unit").lower()
+
+    # Ensure the numeric part is a valid, finite value.
+    try:
+        value = float(number)
+    except ValueError:
+        raise ValueError(f"invalid weight: {text!r}") from None
+    if not _is_finite(value):
+        raise ValueError(f"invalid weight: {text!r}")
+    if value < 0:
+        raise ValueError("weight must not be negative")
+
+    factor = _UNIT_GRAMS.get(unit)
+    if factor is None:
+        raise ValueError(f"unknown unit: {match.group('unit')!r}")
+
+    return int(value * factor + 0.5)
+
+
+_UNIT_GRAMS = {
+    "g": 1.0,
+    "kg": _G_PER_KG,
+    "lb": _G_PER_LB,
+    "oz": _G_PER_OZ,
+}
+
+
+def _is_finite(value: float) -> bool:
+    """Return True if value is a finite float (not NaN or inf)."""
+    return value == value and value not in (float("inf"), float("-inf"))
