--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,41 @@
+"""Partner-facing explanation of why order webhook events are being held back.
+
+Partners ask why some order events arrive late. The webhook worker
+(`shopkit.api.webhook_delivery`) holds an event back when the order it is about
+is in fraud review: partners (ERP, 3PL) must not start fulfilling an order we
+may still cancel. This module turns that behaviour into a short human-readable
+reason a support agent can paste into a partner reply.
+"""
+from __future__ import annotations
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Say why the webhook worker would hold `event` for `order_id` right now.
+
+    `under_review(order_id)` reports whether the order is in fraud review; it
+    may be None when no review state is available. Returns a short reason when
+    the worker would hold the event back, and None when it would send the event
+    normally. Mirrors the review hold in `shopkit.api.webhook_delivery.deliver_pending`,
+    so an event this function explains as held is exactly one the worker holds.
+    """
+    if not order_id:
+        return None
+    if event in ALWAYS_DELIVER:
+        # Cancellations and refunds go out regardless of review state: partners
+        # must learn that an order is off.
+        return None
+    if under_review is None:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        # The worker fails closed: a failed review lookup holds the delivery.
+        return "our fraud-review lookup failed, so the event is held until it recovers"
+    if reviewing:
+        return (
+            f"the webhook is held because order {order_id} is in fraud review; "
+            "it is re-checked every minute and delivered as soon as the review clears"
+        )
+    return None
