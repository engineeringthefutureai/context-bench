+
+def _mask_card_numbers(data: dict) -> dict:
+    """Card numbers never leave the shop raw: mask the ``card_number`` field (top level or nested
+    inside a dict) the same way as everywhere else (redact_pan); other fields go out unchanged."""
+    if not isinstance(data, dict):
+        return data
+    masked = {}
+    for key, value in data.items():
+        if key == "card_number" and isinstance(value, str):
+            masked[key] = redact_pan(value)
+        elif isinstance(value, dict):
+            masked[key] = _mask_card_numbers(value)
+        else:
+            masked[key] = value
+    return masked
 
 
