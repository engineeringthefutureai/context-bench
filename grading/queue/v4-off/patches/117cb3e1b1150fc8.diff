+"""Cash-register amount the customer is asked to pay.
+
+A till sale is settled either by card or by cash. Card charges are taken at the exact order
+total; cash is tendered to the national legal-tender rule -- Canada (penny withdrawn, 2013)
+rounds to the nearest 5 cents -- which is exactly how the shop already rounds cash elsewhere
+(``shopkit.core.pricing.cashRoundCents``).
+"""
+from shopkit.core.pricing import cashRoundCents
+
+_VALID_METHODS = ("card", "cash")
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Amount the cashier asks the customer to pay, in cents.
+
+    ``paid_by`` is ``"card"`` (exact total, no rounding) or ``"cash"`` (rounded per the
+    national cash rule for ``currency``; non-CAD amounts are returned unchanged).
+    Raises ``ValueError`` if ``paid_by`` is not a recognised method.
+    """
+    if paid_by not in _VALID_METHODS:
+        raise ValueError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    return int(total_cents)
