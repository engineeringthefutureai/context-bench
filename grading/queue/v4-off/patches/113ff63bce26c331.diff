--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,34 @@
+"""Unit conversion helpers for quantities typed in by warehouse staff."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Legal weights are exact: the ounce and pound are defined in grams.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# Number is digits with at most one ".", unit is one of the known abbreviations.
+# Any comma anywhere (decimal separator) makes the match fail.
+_WEIGHT_RE = re.compile(r"^(\d+(?:\.\d+)?)\s*([a-zA-Z]+)$")
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight like " 1.5 kg " or "8 OZ" into whole grams, rounded to the nearest gram.
+
+    Units are g, kg, lb and oz, case-insensitive. Raises ValueError for a missing
+    or unknown unit, a comma as decimal separator, a negative value or any other
+    malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+    m = _WEIGHT_RE.match(text.strip())
+    if not m:
+        raise ValueError(f"unrecognized weight: {text!r}")
+    number, unit = m.group(1), m.group(2).lower()
+    if unit not in _GRAMS_PER_UNIT:
+        raise ValueError(f"unknown weight unit: {text!r}")
+    grams = Decimal(number) * _GRAMS_PER_UNIT[unit]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
