--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,23 @@
+"""Duration parsing helpers. Durations are always stored as whole minutes."""
+import re
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration written as hours and/or minutes into whole minutes.
+
+    Accepted forms: "2h", "45m", "1h30m", "1h 30m". Hours come before minutes,
+    each unit at most once, units are case-insensitive, surrounding whitespace
+    is ignored. Raises ValueError for anything else.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+    match = re.fullmatch(
+        r"(?:(\d+)\s*h)?\s*(?:(\d+)\s*m)?",
+        text.strip(),
+        re.IGNORECASE,
+    )
+    if not match or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1)) if match.group(1) is not None else 0
+    minutes = int(match.group(2)) if match.group(2) is not None else 0
+    return hours * 60 + minutes
