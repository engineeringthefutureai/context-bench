+def _mask_card_numbers(data):
+    """Copy of `data` with every `card_number` key masked with redact_pan, at any nesting depth.
+    Other keys pass through unchanged; non-dict values are returned as-is."""
+    if isinstance(data, dict):
+        return {k: (redact_pan(v) if k == "card_number" and isinstance(v, str)
+                    else _mask_card_numbers(v)) for k, v in data.items()}
+    if isinstance(data, (list, tuple)):
+        return type(data)(_mask_card_numbers(v) for v in data)
+    return data
+
