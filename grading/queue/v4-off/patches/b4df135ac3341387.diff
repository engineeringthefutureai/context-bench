+# short English labels for the phone-order screen
+WMS_STATUS_LABELS = {
+    WMS_STATUS_RECEIVED: "Received",
+    WMS_STATUS_ALLOCATED: "Allocated",
+    WMS_STATUS_PICKING: "Picking",
+    WMS_STATUS_PACKED: "Packed",
+    WMS_STATUS_DISPATCHED: "Dispatched",
+    WMS_STATUS_SHORT: "Short pick",
+    WMS_STATUS_CANCELLED: "Cancelled",
+    WMS_STATUS_HOLD: "On hold",
+}
+
+
+def wmsStatusLabel(code):
+    """short English label for a WMS status code (as sent in callbacks).
+
+    Codes are matched case-insensitively and surrounding spaces are ignored; anything else
+    (including None) gives 'Unknown'."""
+    if code is None:
+        return "Unknown"
+    return WMS_STATUS_LABELS.get(str(code).strip().upper(), "Unknown")
+
