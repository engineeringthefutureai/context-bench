--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,14 @@
+"""Delivery options shown at checkout, checked against what the warehouse will actually do."""
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus, sites, hazmat_skus) -> bool:
+    """Whether an order with these SKUs would go into an express wave.
+
+    Mirrors warehouse.waves.allocate_wave: express leaves by air, so it needs a candidate site
+    with air service; dangerous goods go by ground only and are downgraded to standard there."""
+    if not sites:
+        return False
+    if hazmat_skus and any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in site.services for site in sites)
