+def wmsStatusLabel(code):
+    """short English label for a WMS status code, for the phone-order screen.
+
+    Case-insensitive and surrounding spaces are ignored; None or anything not sent by the
+    warehouse gives 'Unknown'."""
+    if code is None:
+        return "Unknown"
+    return WMS_STATUS_LABELS.get(code.strip().upper(), "Unknown")
