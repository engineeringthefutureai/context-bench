--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,40 @@
+"""Parsing of weights typed in by warehouse staff (e.g. from a label gun or the receiving form).
+
+Staff type a number and a unit, in whatever case and with whatever spacing their habits bring;
+the shop works in whole grams everywhere else, so this is the one place that turns that free text
+into grams.
+"""
+import re
+
+# Exact definitions of the imperial units, in grams (1 lb = 16 oz, 1 oz = 28.349523125 g).
+_GRAMS_PER = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+# A number (integer or dotted decimal, "." only), whitespace, then a unit. Case-insensitive.
+# A leading "-" would make the group non-digit and fail to match, so negatives are rejected.
+_WEIGHT_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)[ \t]*([a-zA-Z]+)\s*$")
+
+
+def parse_weight(text: str) -> int:
+    """Weight typed by warehouse staff, in whole grams.
+
+    A number (integer or dotted decimal, "." as separator) followed by a unit g, kg, lb or oz
+    (case-insensitive); surrounding whitespace is ignored. 1 lb = 453.59237 g and 1 oz =
+    28.349523125 g. The result is rounded to the nearest gram (half rounds up).
+
+    Raises ValueError for anything else: missing number, missing or unknown unit, a "," as
+    decimal separator, negatives, extra characters.
+    """
+    m = _WEIGHT_RE.match(text or "")
+    if m is None:
+        raise ValueError(f"bad weight {text!r}")
+    number, unit = m.group(1), m.group(2).lower()
+    if unit not in _GRAMS_PER:
+        raise ValueError(f"unknown unit {m.group(2)!r} in {text!r}")
+    value = float(number) * _GRAMS_PER[unit]
+    # Half rounds up: int(x + 0.5) is exact for these unit factors (no value lands on a half).
+    return int(value + 0.5)
