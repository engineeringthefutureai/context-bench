--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,61 @@
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                       today: date | None = None) -> dict[str, int]:
+    """Preview where a refund of ``amount_cents`` for ``order_id`` would go, without doing it.
+
+    Returns a dict with keys "card", "store_credit" and "gift_card" holding the cents that a real
+    settlement of that amount would send to each. The split matches ``settle_refund`` exactly:
+    proportional to each captured payment's remaining refundable amount (leftover cents to the
+    cards first), then per payment gift cards go back as a gift card, card payments older than
+    ``CARD_REFUND_MAX_AGE_DAYS`` become store credit, and the rest goes back to the card.
+    """
+    from shopkit.utils.dates import utc_now
+
+    today = today or utc_now().date()
+
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        return {"card": 0, "store_credit": 0, "gift_card": 0}
+
+    result = {"card": 0, "store_credit": 0, "gift_card": 0}
+    if amount_cents <= 0:
+        return result
+
+    refundable = sum(p.refundable_cents for p in captured)
+    amount_cents = min(amount_cents, refundable)
+    if amount_cents <= 0:
+        return result
+
+    # Same split as settle_refund: proportional to what is still refundable on each payment,
+    # cards first, leftover cents to the first payment that has room.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            result["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            result["store_credit"] += share
+        else:
+            result["card"] += share
+
+    return result
