+"""Amounts the cashier asks the customer to pay at a till.
+
+Cash totals follow the national rules for cash amounts, the same way the shop
+already treats cash elsewhere (``shopkit.core.pricing.cashRoundCents``: CAD
+amounts are rounded to the nearest nickel from 2013). Card payments always pay
+the exact total to the cent.
+"""
+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """The amount the cashier asks the customer to pay, in cents.
+
+    ``paid_by`` is "card" or "cash". Card pays the exact ``total_cents``;
+    cash is rounded to the nearest legal cash amount for ``currency``.
+    Unknown ``paid_by`` values raise ``ValueError``.
+    """
+    if paid_by == "card":
+        return total_cents
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    raise ValueError(f"unknown payment method: {paid_by!r}")
