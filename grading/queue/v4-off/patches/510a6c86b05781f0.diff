--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,16 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold stock for an order, lowering the available quantity of ``sku``.
+
+        Raises ``Conflict`` (409) with ``requested`` and ``available`` quantities when
+        not enough stock is on hand; nothing changes in that case.
+        """
+        in_hand = self._on_hand.get(sku, 0)
+        if qty > in_hand:
+            raise Conflict(
+                f"not enough stock for {sku}", requested=qty, available=in_hand
+            )
+        self._on_hand[sku] = in_hand - qty
