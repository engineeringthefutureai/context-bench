+def export_orders_csv(orders: list[Order]) -> str:
+    """One row per order line for finance: normalized product code and invoice-style line total."""
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for o in orders:
+        for line in o.lines:
+            writer.writerow([o.id, normalize_sku(line.sku), line.qty,
+                             format_money(line.total_cents, o.currency)])
+    return buf.getvalue()
