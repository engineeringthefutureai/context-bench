+"""Pallet labels for the warehouse's new pallet scanner.
+
+The scanner reads the item numbers the finance system (the ERP) knows each product by, not the
+shop's SKUs, so the lines carry the ERP item number for every item on the pallet."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Label text for a pallet: the first line is `PALLET <pallet_id>`, then one line per item in
+    the order given, `<item number> x<qty>`. The item number is the one the finance system (the
+    ERP) knows the product by (toErpSku), since the scanner reads those, not our SKUs."""
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
