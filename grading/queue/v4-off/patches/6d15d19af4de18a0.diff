     }.get((wmsCode or "").upper(), STATUS_ERROR)
+
+
+_WMS_STATUS_LABELS = {
+    WMS_STATUS_RECEIVED: "Received",
+    WMS_STATUS_ALLOCATED: "Allocated",
+    WMS_STATUS_PICKING: "Picking",
+    WMS_STATUS_PACKED: "Packed",
+    WMS_STATUS_DISPATCHED: "Dispatched",
+    WMS_STATUS_SHORT: "Short pick",
+    WMS_STATUS_CANCELLED: "Cancelled",
+    WMS_STATUS_HOLD: "On hold",
+}
+
+
+def wmsStatusLabel(code):
+    """Short English label for a WMS status code (case-insensitive, spaces ignored);
+    anything else (including None) gives 'Unknown'."""
+    if code is None:
+        return "Unknown"
+    if not isinstance(code, str):
+        return "Unknown"
+    return _WMS_STATUS_LABELS.get(code.strip().upper(), "Unknown")
 
 
