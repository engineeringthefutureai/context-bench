--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,100 @@
+"""Read-only preview of a seller's next payout.
+
+`preview_payout` runs the same period rules the weekly batch uses (holds, released holds,
+adjustments, reserve, rollover, backup withholding, minimum payout) but is a pure
+computation: it never places or releases holds and never moves balances in the
+`Rollover` book. It returns the status and net cents the seller's payout would get.
+"""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from shopkit.config import SETTINGS
+from shopkit.payouts.batching import (BACKUP_WITHHOLDING_BP, DRIFT_TOLERANCE_CENTS, MIN_PAYOUT_CENTS,
+                                      Rollover, _commission)
+from shopkit.payouts.holds import RETURN_WINDOW_DAYS, HoldBook
+from shopkit.payouts.models import (CLOSING, DRAFT, ROLLED_OVER, SUSPENDED, Adjustment, Earning, Payout,
+                                    PayoutLine, Seller)
+from shopkit.pricing.currency import RateUnavailable, RateTable
+from shopkit.utils.numbers import apply_rate
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment],
+                   period_start: date, period_end: date, holds: HoldBook, rollover: Rollover,
+                   rates: RateTable | None = None, seller_country: dict[str, str] | None = None,
+                   ) -> tuple[str, int]:
+    """Compute the status and net cents of `seller`'s payout for [period_start, period_end].
+
+    Mirrors build_payout_batch exactly (same holds, rollover, reserve, withholding, minimum
+    and currency rules) but without side effects: no holds are placed or released and the
+    rollover balance is read, not consumed.
+    """
+    if seller.status in (SUSPENDED, "closed"):
+        return (seller.status, 0)
+
+    payout = Payout("preview", seller.id, period_start, period_end, seller.payout_currency)
+
+    # --- lines (holds placed are tracked locally, never on the shared book) ---------------------------
+    held_now = 0
+    for e in sorted(earnings, key=lambda e: (e.order_id, e.sku)):
+        if e.gross_cents < 0 or e.refunded_cents < 0:
+            continue
+        if e.refunded_cents > e.gross_cents:
+            continue
+        if e.delivered_on is not None and not (
+                period_start - timedelta(days=366) <= e.delivered_on <= period_end):
+            continue
+        commission = _commission(e.gross_cents, seller.commission_bp)
+        net = e.gross_cents - commission - e.refunded_cents
+        if e.refunded_cents and e.refunded_cents == e.gross_cents:
+            net = 0
+            commission = 0
+        payout.lines.append(PayoutLine(e.order_id, e.gross_cents, commission, e.refunded_cents, net))
+        within_window = e.delivered_on is None or e.delivered_on + timedelta(days=RETURN_WINDOW_DAYS) > period_end
+        if within_window and net > 0:
+            held_now += net
+    payout.held_cents = held_now
+
+    # --- released holds (read-only) / adjustments / reserve / rollover in --------------------------------
+    released = sum(h.amount_cents for h in holds.releasable(seller.id, period_end))
+    adj_total = sum(a.amount_cents for a in adjustments if a.seller_id == seller.id)
+    payout.adjustments_cents = adj_total + released
+    if seller.reserve_bp:
+        payout.reserve_cents = apply_rate(payout.gross_cents, seller.reserve_bp / 100)
+    # read (not take): the preview must leave the balance in place
+    payout.carried_in_cents = rollover.balances.get(seller.id, 0)
+
+    # --- backup withholding -----------------------------------------------------------------------------
+    country = (seller_country or {}).get(seller.id, "US")
+    if country == "US" and not seller.tax_id.strip():
+        line_net = sum(l.net_cents for l in payout.lines) - payout.held_cents
+        if line_net > 0:
+            payout.adjustments_cents -= apply_rate(line_net, BACKUP_WITHHOLDING_BP / 100)
+
+    # --- minimum payout and negative balances ------------------------------------------------------------
+    net = payout.net_cents
+    if net < 0:
+        status = ROLLED_OVER
+    elif net < MIN_PAYOUT_CENTS and seller.status != CLOSING:
+        status = ROLLED_OVER
+    else:
+        status = DRAFT
+
+    # --- currency (only the DRAFT amount is converted, like the batch) ------------------------------------
+    if status == DRAFT and seller.payout_currency != SETTINGS.default_currency:
+        if rates is None:
+            return ("no rates", net)
+        converted = None
+        for _attempt in range(3):
+            try:
+                converted = rates.convert(net, SETTINGS.default_currency, seller.payout_currency, period_end)
+                break
+            except RateUnavailable:
+                continue
+        if converted is None:
+            return ("rate unavailable", net)
+        fee = apply_rate(converted, 25)
+        net = converted - fee
+
+    return (status, net)
