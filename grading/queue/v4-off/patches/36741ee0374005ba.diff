--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,39 @@
+"""Find order references in free text so support can link a customer's message to an order.
+
+Customers type references in all sorts of ways -- "so 2019 123", "SO-2019-000123",
+"ORD_1A2B3C4D5E6F" -- so the raw text is scanned for candidate tokens and each one is
+validated and canonicalised through the same order-reference parser the rest of the shop
+uses (shopkit.core.order_engine). Anything that doesn't parse is left out."""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# A candidate reference in a wall of text: a storefront id or a sales-order ref with any mix
+# of dashes or spaces between its parts, in either case.
+_REF_CANDIDATE = re.compile(
+    r"\b(SOB?)[\s-]+(\d{4})[\s-]+(\d{1,6})\b|\bORD_[0-9a-fA-F]{12}\b", re.IGNORECASE
+)
+
+
+def order_refs(text: str) -> list[str]:
+    """Return the order references mentioned in *text*, canonicalised the way the shop writes
+    them, in the order they first appear and without duplicates.
+
+    'so 2019 123' -> ['SO-2019-000123']; 'ORD_1A2B3C4D5E6F' -> ['ord_1a2b3c4d5e6f'];
+    'so-2019-000123 (and so 2019 123 again)' -> ['SO-2019-000123']. Text with no valid order
+    reference -- or text that is not a string -- returns []."""
+    if not isinstance(text, str):
+        return []
+    found: list[str] = []
+    seen: set[str] = set()
+    for m in _REF_CANDIDATE.finditer(text):
+        parsed = parseOrderRef(m.group(0))
+        if parsed is None:
+            continue
+        ref = formatOrderRef(*parsed)
+        if ref not in seen:
+            seen.add(ref)
+            found.append(ref)
+    return found
