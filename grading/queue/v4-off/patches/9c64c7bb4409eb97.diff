+"""How much a cashier asks the customer to pay at the till.
+
+Card payments are charged at the exact total; cash payments follow the national
+rules for cash amounts (the same rounding the shop already applies to cash
+elsewhere: pennies have been withdrawn in Canada, so CAD cash rounds to the
+nearest 5 cents).
+"""
+
+from shopkit.core.pricing import cashRoundCents
+
+VALID_PAY_BY = ("card", "cash")
+
+
+def amount_due(total_cents, currency, paid_by):
+    """The amount the cashier asks the customer to pay, in cents.
+
+    ``card`` pays the exact total; ``cash`` follows the national rules for cash
+    amounts (other currencies come back unchanged). Negative totals (refunds at
+    the till) round symmetrically, matching the shop's existing cash handling.
+    """
+    if paid_by not in VALID_PAY_BY:
+        raise ValueError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
+    total = int(total_cents)
+    if paid_by == "cash":
+        return cashRoundCents(total, currency)
+    return total
