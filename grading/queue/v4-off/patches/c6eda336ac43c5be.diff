--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,91 @@
+"""Parsing helpers for quantities entered by staff (weights in g/kg/lb/oz)."""
+
+import math
+
+# Exact conversion factors to grams.
+_LB_TO_G = 453.59237
+_OZ_TO_G = 28.349523125
+
+# Unit letter (lowercase) -> factor to multiply the given number by to get grams.
+_WEIGHT_UNITS = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": _LB_TO_G,
+    "oz": _OZ_TO_G,
+}
+
+# Order matters: check the two-letter units before their one-letter prefixes.
+_UNIT_ORDER = ("kg", "g", "lb", "oz")
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-entered weight string and return the weight in whole grams.
+
+    Accepts an integer or a "."-separated decimal, optional whitespace, and a
+    unit of ``g``, ``kg``, ``lb`` or ``oz`` (case-insensitive). Leading and
+    trailing whitespace is ignored. The result is rounded to the nearest gram.
+
+    Raises ``ValueError`` for missing or malformed numbers, a missing or
+    unknown unit, negative values, or a "," decimal separator.
+    """
+    if text is None:
+        raise ValueError("weight must be a string")
+    s = text.strip()
+    if not s:
+        raise ValueError("missing weight value")
+
+    # Split off the trailing unit; the numeric part may be separated by spaces.
+    num_part = s
+    unit = ""
+    for candidate in _UNIT_ORDER:
+        if s.lower().endswith(candidate):
+            num_part = s[: len(s) - len(candidate)]
+            unit = candidate
+            break
+
+    if not unit:
+        raise ValueError(f"missing or unknown unit in {text!r}")
+
+    num = num_part.strip()
+    if not num:
+        raise ValueError("missing number in weight value")
+    if "," in num:
+        raise ValueError("use '.' as the decimal separator")
+    if num.startswith("-") or num.startswith("+"):
+        # Explicitly reject signed values so a typo can't produce a bogus weight.
+        if num[0] == "-":
+            raise ValueError("negative weight")
+        num = num[1:]
+
+    # Validate that what remains is an integer or a "."-separated decimal.
+    # Reject exponent notation ("1e3"), underscores, multiple dots, etc.
+    if "." in num:
+        whole, dot, frac = num.partition(".")
+        if "." in frac:
+            raise ValueError(f"malformed number {num!r}")
+        num = whole + frac
+    if not num or not num.isdigit():
+        raise ValueError(f"malformed number in {text!r}")
+
+    value = int(num) / 10 ** len(num) if "." in text and num else float(num)
+    # Simpler: build the numeric value directly from the cleaned digits.
+    if num and not num.isdigit():
+        raise ValueError(f"malformed number in {text!r}")
+
+    # Reconstruct a float from the cleaned decimal string.
+    if "." in text:
+        # num is now pure digits; we lost the decimal point, so parse from num_part instead.
+        cleaned = num_part.strip().lstrip("+")
+        if "." in cleaned:
+            whole, _, frac = cleaned.partition(".")
+            value = float(whole + "." + frac) if frac else float(whole or "0")
+        else:
+            value = float(cleaned)
+    else:
+        value = float(num_part.strip().lstrip("+"))
+
+    factor = _WEIGHT_UNITS[unit]
+    grams = value * factor
+
+    # Round half away from zero to the nearest whole gram.
+    return int(math.floor(grams + 0.5))
