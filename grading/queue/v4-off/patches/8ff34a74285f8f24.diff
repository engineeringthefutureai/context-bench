+def export_orders_csv(orders: list[Order]) -> str:
+    """Order-line CSV for finance: one row per line, amounts formatted like customer invoices."""
+    rows = [
+        [o.id, normalize_sku(l.sku), l.qty, format_money(l.total_cents, o.currency)]
+        for o in orders
+        for l in o.lines
+    ]
+    return _to_csv(["order_id", "product_code", "quantity", "line_total"], rows)
+
+
+def _to_csv(header: list[str], rows: list[list[object]]) -> str:
+    import io
+
+    buf = io.StringIO()
+    writer = csv.writer(buf, lineterminator="\n")
+    writer.writerow(header)
+    writer.writerows(rows)
+    return buf.getvalue()
