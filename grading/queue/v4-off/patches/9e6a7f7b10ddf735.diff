--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,23 @@
+"""On-hand quantities per SKU."""
+from __future__ import annotations
+
+from shopkit.errors import Conflict
+
+
+class NotEnoughStock(Conflict):
+    """Raised when a reservation exceeds the on-hand quantity for a SKU."""
+
+    def __init__(self, sku: str, requested: int, available: int) -> None:
+        super().__init__(
+            f"Not enough stock for {sku}: requested {requested}, available {available}",
+            requested=requested,
+            available=available,
+        )
+        self.sku = sku
+        self.requested = requested
+        self.available = available
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +29,15 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Lower the on-hand quantity of ``sku`` by ``qty``.
+
+        If the SKU has fewer than ``qty`` units available, the stock is left
+        unchanged and :class:`NotEnoughStock` (a :class:`Conflict`) is raised so
+        the API answers with 409 and includes ``requested`` and ``available``.
+        """
+        avail = self._on_hand.get(sku, 0)
+        if qty > avail:
+            raise NotEnoughStock(sku, qty, avail)
+        self._on_hand[sku] = avail - qty
