--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,33 @@
+"""Why a partner webhook is (or isn't) being held back right now.
+
+Partners see some order events arrive late. The one reason the delivery worker holds an event
+before it ever tries to send it is fraud review: events about an order that is still under review
+are kept back until the review clears (api.webhook_delivery). This explains that case so a support
+agent can tell a partner what is delaying their event.
+"""
+from __future__ import annotations
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Why the webhook worker would hold this event back right now, or None when it would send it.
+
+    Mirrors the hold in deliver_pending exactly: the event is held when it is about an order
+    (`order_id` set), the event is not one we always deliver even under review, and `under_review`
+    says that order is still in fraud review. If the review lookup itself fails we fail closed (the
+    worker holds, too). Cancellations and refunds always go out, and events with no order are never
+    held, so both return None.
+    """
+    if not order_id:
+        return None
+    from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+    if event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        return "The fraud-review status for this order could not be read, so delivery is held until it is."
+    if reviewing:
+        return (
+            f"{event} is held because {order_id} is in fraud review; it will be sent once the review clears."
+        )
+    return None
