+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """
+    Aggregate stock transfer quantities by ISO week.
+
+    Args:
+        transfers: A list of Transfer objects.
+
+    Returns:
+        A dictionary mapping week labels (format: YYYY-Www) to the total
+        number of units transferred in that week. The keys are ordered
+        chronologically.
+    """
+    if not transfers:
+        return {}
+
+    weekly_totals: dict[str, int] = {}
+    for t in transfers:
+        iso_year, iso_week, _ = t.at.isocalendar()
+        week_label = f"{iso_year}-W{iso_week:02d}"
+        weekly_totals[week_label] = weekly_totals.get(week_label, 0) + t.qty
+
+    # Sort by label to ensure chronological order
+    return dict(sorted(weekly_totals.items()))
