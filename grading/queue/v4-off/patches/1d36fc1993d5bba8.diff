--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+
+def _iter_matches(text: str):
+    """Yield each potential order reference in the text, in order of appearance.
+
+    Matches the old-style 'PREFIX YEAR SEQUENCE' form (separator is a run of
+    non-alphanumeric characters, case-insensitive) and the new-style 'ord_<hex>'
+    form (case-insensitive, the sequence is at least one hex digit).
+    """
+    if not text:
+        return
+    lower = text.lower()
+    # (position, span, normalized token)
+    found: list[tuple[int, int, str]] = []
+    for m in re.finditer(
+        r"(?:so|sob|po|ro|ord)(?:[ \t\r\n-]*[0-9]{4}[ \t\r\n-]*[0-9]+)", text, re.I
+    ):
+        span = m.span()
+        token = m.group(0).upper().replace(" ", "-")
+        while "--" in token:
+            token = token.replace("--", "-")
+        # Drop any leading/trailing '-' the run of separators may have produced.
+        token = token.strip("-")
+        found.append((span[0], span[1], token))
+    for m in re.finditer(r"ord_[0-9a-f]+", lower):
+        span = m.span()
+        found.append((span[0], span[1], m.group(0)))
+    found.sort(key=lambda item: item[0])
+    for _start, _end, token in found:
+        yield token
+
+
+def order_refs(text: str) -> list[str]:
+    """Return the order references mentioned in ``text``.
+
+    Each reference is written the way the shop writes that kind of reference
+    everywhere else (canonical form). References appear in the order they first
+    appear in the text, without duplicates. Anything that is not a valid order
+    reference is left out.
+    """
+    seen: set[str] = set()
+    out: list[str] = []
+    for token in _iter_matches(text or ""):
+        parsed = parseOrderRef(token)
+        if parsed is None:
+            continue
+        kind, year, seq = parsed
+        ref = formatOrderRef(kind, year, seq)
+        if ref in seen:
+            continue
+        seen.add(ref)
+        out.append(ref)
+    return out
