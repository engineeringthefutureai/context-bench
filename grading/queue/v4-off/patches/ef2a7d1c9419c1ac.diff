--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,34 @@
+import re
+
+
+def parse_duration(text: str) -> int:
+    """Duration in whole minutes from a string of hours and/or minutes.
+
+    Hours come before minutes, each unit at most once, units are
+    case-insensitive and surrounding whitespace is ignored:
+    "2h", "45m", "1h30m" or "1h 30m". Anything else raises ValueError."""
+    cleaned = text.strip()
+    if not cleaned:
+        raise ValueError(f"invalid duration: {text!r}")
+    matches = re.findall(r"(\d+)([a-zA-Z]+)", cleaned)
+    rest = re.sub(r"\d+[a-zA-Z]+", "", cleaned)
+    if rest.strip():
+        raise ValueError(f"invalid duration: {text!r}")
+    if not matches:
+        raise ValueError(f"invalid duration: {text!r}")
+    units = [u.lower() for _, u in matches]
+    if "m" in units and "h" in units and units.index("h") > units.index("m"):
+        raise ValueError(f"invalid duration: {text!r}")
+    if units != sorted(units):
+        raise ValueError(f"invalid duration: {text!r}")
+    if any(u not in ("h", "m") for u in units):
+        raise ValueError(f"invalid duration: {text!r}")
+    if any(cleaned.count(u) > 1 for u in ("h", "m")):
+        raise ValueError(f"invalid duration: {text!r}")
+    minutes = 0
+    for value, unit in matches:
+        if unit.lower() == "h":
+            minutes += int(value) * 60
+        else:
+            minutes += int(value)
+    return minutes
