+def parcel_weight_g(parcel: Parcel, products: dict[str, object]) -> int:
+    """Total weight in grams of a parcel's contents; `products` maps SKU to product.
+    Raises UnknownSku if the parcel holds a SKU that is not in `products`."""
+    total = 0
+    for sku, qty in parcel.items:
+        if sku not in products:
+            raise UnknownSku(f"product for SKU {sku!r} not found", sku=sku)
+        total += qty * products[sku].weight_g
+    return total
+
