+"""Package-dimension and weight helpers for the shipping and warehouse modules."""
+import re
+
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact conversion factors to grams, kept as Decimal so rounding is exact.
+_GRAM_PER_LB = Decimal("453.59237")
+_GRAM_PER_OZ = Decimal("28.349523125")
+
+_WEIGHT_RE = re.compile(r"([0-9]+(?:\.[0-9]+)?)\s*(g|kg|lb|oz)\Z", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight typed in by warehouse staff and return the weight in whole grams.
+
+    The input is a number (integer or decimal using "." as separator), optional whitespace,
+    then one of the units g, kg, lb or oz (case-insensitive). Leading and trailing whitespace
+    is ignored. 1 lb = 453.59237 g and 1 oz = 28.349523125 g; the result is rounded to the
+    nearest gram. Anything else — a missing number or unit, an unknown unit, a negative value,
+    a "," decimal separator, or extra characters — raises ValueError.
+    """
+    match = _WEIGHT_RE.match(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    number, unit = Decimal(match.group(1)), match.group(2).lower()
+    if unit == "g":
+        factor = Decimal(1)
+    elif unit == "kg":
+        factor = Decimal(1000)
+    elif unit == "lb":
+        factor = _GRAM_PER_LB
+    else:  # oz
+        factor = _GRAM_PER_OZ
+    return int((number * factor).quantize(Decimal(1), rounding=ROUND_HALF_UP))
