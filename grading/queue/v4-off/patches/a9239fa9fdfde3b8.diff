--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,27 @@
+"""Partner-facing explanation of why an order's webhook events are reaching them late.
+
+Mirrors the fraud-review hold in the delivery worker (api.webhook_delivery.deliver_pending): an
+event about an order in review is held back until the review clears, but ALWAYS_DELIVER events
+go out regardless so partners still learn when an order is off.
+"""
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event, order_id, under_review):
+    """Why the webhook worker would hold `event` back for `order_id` right now.
+
+    Returns a short reason string when the worker would keep the event in HELD status, or None
+    when it would send it normally. `under_review(order_id)` reports whether the order is in fraud
+    review; if that lookup fails the worker holds the event (fail closed), so this does too.
+    """
+    if not order_id:
+        return None
+    if event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        return "fraud review lookup failed, holding the event until it clears"
+    if not reviewing:
+        return None
+    return "order is in fraud review; event is held until the review clears"
