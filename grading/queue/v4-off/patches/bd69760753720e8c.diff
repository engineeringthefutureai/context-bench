--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,28 @@
+"""Why a partner has not received an event yet.
+
+Reuses the webhook worker's hold logic (fraud review) so this answer matches what
+``deliver_pending`` would actually do on the next run."""
+from __future__ import annotations
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Reason this event is held back for the partner right now, or ``None`` if it
+    would be delivered normally.
+
+    Only the fraud-review hold delays an order's events; the other things the
+    worker skips for (circuit breaker, rate limit, ordering, duplicates) clear on
+    their own and are not an "explanation" a partner would act on.
+    """
+    if order_id and event not in _ALWAYS_DELIVER:
+        try:
+            if under_review(order_id):
+                return f"order in fraud review ({event})"
+        except Exception:
+            # fail closed, same as the worker: a broken review lookup holds the event
+            return f"order in fraud review (lookup failed, {event})"
+    return None
+
+
+# Mirror of webhook_delivery.ALWAYS_DELIVER: cancellations and refunds always
+# reach the partner, even while the order is under review.
+_ALWAYS_DELIVER = {"order.cancelled", "refund.settled"}
