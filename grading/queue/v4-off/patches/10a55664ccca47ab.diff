--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,29 @@
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+_REF_RE = re.compile(r"[\w][\w-]*")
+
+
+def order_refs(text: str) -> list[str]:
+    """Extract the order references mentioned in *text*.
+
+    Returns them in the order they first appear, without duplicates, each written
+    the way the shop writes that kind of reference (see :func:`formatOrderRef`).
+    Anything that does not parse as a valid order reference is left out.
+    """
+    found: list[str] = []
+    seen: set[str] = set()
+    for token in _REF_RE.findall(text or ""):
+        parsed = parseOrderRef(token)
+        if parsed is None:
+            continue
+        kind, year, seq = parsed
+        ref = formatOrderRef(kind, year, seq)
+        if ref in seen:
+            continue
+        seen.add(ref)
+        found.append(ref)
+    return found
