@@ -1,3 +1,6 @@
+from shopkit.errors import StockReservationError
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,18 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Lower the on-hand quantity of `sku` by `qty`.
+
+        Fails with StockReservationError if there is not enough stock; in that case
+        nothing is changed.
+        """
+        have = self._on_hand.get(sku, 0)
+        if qty > have:
+            raise StockReservationError(
+                f"cannot reserve {qty} of {sku}: only {have} available",
+                requested=qty,
+                available=have,
+            )
+        self._on_hand[sku] = have - qty
