+def wmsStatusLabel(code):
+    """short English label for a WMS status code, for the phone-order screen.
+    Matched case-insensitively with surrounding spaces ignored; anything else (incl. None) is 'Unknown'."""
+    labels = {
+        WMS_STATUS_RECEIVED: "Received",
+        WMS_STATUS_ALLOCATED: "Allocated",
+        WMS_STATUS_PICKING: "Picking",
+        WMS_STATUS_PACKED: "Packed",
+        WMS_STATUS_DISPATCHED: "Dispatched",
+        WMS_STATUS_SHORT: "Short pick",
+        WMS_STATUS_CANCELLED: "Cancelled",
+        WMS_STATUS_HOLD: "On hold",
+    }
+    if code is None:
+        return "Unknown"
+    return labels.get(code.strip().upper(), "Unknown")
 
 
