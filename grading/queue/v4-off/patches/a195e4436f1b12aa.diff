+++ b/shopkit/utils/durations.py
@@ -0,0 +1,29 @@
+import re
+
+# Duration: whole hours and/or minutes, hours before minutes, each unit at most
+# once, optional whitespace between parts, e.g. "2h", "45m", "1h30m", "1h 30m".
+_DURATION_RE = re.compile(
+    r"(?:(\d+)h)?\s*(?:(\d+)m)?",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration like "2h", "45m" or "1h 30m" into whole minutes.
+
+    Hours come before minutes, each unit appears at most once, units are
+    case-insensitive and surrounding whitespace is ignored. Anything else
+    (empty text, other units, a missing number, minutes before hours,
+    negative numbers) raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"not a duration: {text!r}")
+
+    candidate = text.strip()
+    match = _DURATION_RE.fullmatch(candidate)
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"not a duration: {text!r}")
+
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
