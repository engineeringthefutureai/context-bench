--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,26 @@
+"""Which delivery options checkout may offer for a cart, matched to what the warehouse can actually
+do (see warehouse.waves.allocate_wave): express only if the order would end up in an express wave."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus, sites, hazmat_skus) -> bool:
+    """Return True when the warehouse would put an order with ``skus`` into an express wave.
+
+    ``skus`` are the cart's SKUs, ``sites`` the warehouse sites that could ship the order and
+    ``hazmat_skus`` the SKUs classed as dangerous goods.
+
+    An order only goes into an express wave when it is allocated as express. The warehouse
+    (warehouse.waves.allocate_wave) downgrades any order that contains a hazmat SKU from express to
+    standard (hazmat leaves by ground only), so such an order is never express. With no hazmat SKU an
+    order keeps its express service and is put into an express wave, provided at least one of the
+    given sites can ship it.
+    """
+    if not sites:
+        return False
+    if hazmat_skus:
+        for sku in skus:
+            if sku in hazmat_skus:
+                return False
+    return True
