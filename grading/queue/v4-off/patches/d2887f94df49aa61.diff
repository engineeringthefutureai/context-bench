--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,17 @@
+"""Delivery options shown at checkout, checked against what the warehouse will actually do."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus, sites, hazmat_skus) -> bool:
+    """Whether the warehouse would put this cart into an express wave.
+
+    Mirrors the rules in warehouse.waves.allocate_wave: express leaves by air, so dangerous goods
+    never go express; an order only ships express when at least one of its candidate sites has air
+    service at the dock."""
+    if not skus or not sites:
+        return False
+    if hazmat_skus and any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in s.services for s in sites)
