--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,54 @@
+"""Preview of where a refund would go, before it is actually settled (no side effects).
+
+Support agents use this to tell a customer where their money is going back to. The split is
+worked out exactly the way payments.settlement.settle_refund() would settle it, so the
+preview matches what the Refund button will actually do: proportional to what is still
+refundable on each captured payment (leftover cents to card payments first), then per
+payment gift card -> new gift card, card -> card, old card -> store credit."""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment], today: date) -> dict[str, int]:
+    """Cents of a refund for `order_id` that would go back to the card, to store credit and to a
+    gift card, split the same way settle_refund() would settle it. Refunds nothing."""
+    if amount_cents <= 0:
+        raise ShopError("refund amount must be positive", order_id=order_id)
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}", order_id=order_id,
+                             requested=amount_cents, refundable=refundable)
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))      # cards first
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = []
+    for w in weights:
+        shares.append(amount_cents * w // total_weight)
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+    out = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            out["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            out["store_credit"] += share
+        else:
+            out["card"] += share
+    return out
