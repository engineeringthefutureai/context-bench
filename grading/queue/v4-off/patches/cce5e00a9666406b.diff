--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,16 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold stock for an order, lowering available quantity by qty.
+
+        If not enough is on hand, nothing is reserved and a Conflict is raised
+        so the API answers 409 with the requested and available quantities.
+        """
+        on_hand = self._on_hand.get(sku, 0)
+        if qty > on_hand:
+            raise Conflict(
+                "not enough stock", requested=qty, available=on_hand
+            )
+        self._on_hand[sku] = on_hand - qty
