+def transfers_by_week(transfers) -> dict[str, int]:
+    """Units moved per week, keyed by the same week labels the other dashboards use
+    (iso_week_label, e.g. "2026-W47"), in chronological order. Weeks without
+    transfers are absent, not zero."""
+    totals: dict[str, int] = {}
+    week_start: dict[str, int] = {}
+    for t in transfers:
+        day = t.at.date()
+        label = iso_week_label(day)
+        # Monday of the ISO week (weekday 0 = Monday); used only to order the weeks.
+        start = day.toordinal() - day.weekday()
+        week_start[label] = min(week_start.get(label, start), start)
+        totals[label] = totals.get(label, 0) + t.qty
+    return {label: totals[label] for label in sorted(totals, key=lambda w: week_start[w])}
