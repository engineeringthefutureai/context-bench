+"""Cash-till helpers for the pop-up stores.
+
+The till only deals with whole-cent amounts. Card payments settle for exactly
+what the sale total is; cash payments are rounded the way cash totals must be
+(the national
+penny-withdrawal rule for Canadian cash), so the cashier tells the customer the
+rounded figure.
+"""
+
+from shopkit.core.pricing import cashRoundCents
+from shopkit.errors import ShopError
+
+_VALID_PAYMENT_METHODS = ("card", "cash")
+
+
+def amount_due(total_cents, currency, paid_by):
+    """The amount the cashier asks the customer to pay, in cents.
+
+    Card payments pay the exact total; cash payments are rounded the way the
+    shop treats cash elsewhere (cashRoundCents). Unknown payment methods and
+    non-positive totals are rejected rather than silently producing a figure
+    the till could charge.
+    """
+    if paid_by not in _VALID_PAYMENT_METHODS:
+        raise ShopError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
+    if not isinstance(total_cents, int) or total_cents <= 0:
+        raise ShopError("total_cents must be a positive integer")
+
+    if paid_by == "card":
+        return total_cents
+    return cashRoundCents(total_cents, currency)
