+from shopkit.errors import InsufficientStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,24 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Lower the available quantity of `sku` by `qty`.
+
+        Raises `InsufficientStock` (a 409) if `qty` is negative or exceeds the available
+        quantity, leaving stock unchanged.
+        """
+        if qty < 0:
+            raise InsufficientStock(
+                f"cannot reserve negative quantity for {sku}",
+                requested=qty,
+                available=self.available(sku),
+            )
+        current = self.available(sku)
+        if qty > current:
+            raise InsufficientStock(
+                f"cannot reserve {qty} of {sku}: only {current} available",
+                requested=qty,
+                available=current,
+            )
+        self._on_hand[sku] = current - qty
