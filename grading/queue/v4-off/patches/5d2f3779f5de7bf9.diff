+from shopkit.core.pricing import cashRoundCents
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """
+    Calculate the amount the cashier asks the customer to pay.
+
+    Card payments pay the exact total. Cash payments are rounded according to
+    the national rules for cash amounts (e.g., CAD to the nearest 5 cents).
+    """
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    return total_cents
