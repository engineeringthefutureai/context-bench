--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,33 @@
+import re
+
+_PATTERN = re.compile(r"^(?:(\d+)h)?\s*(?:(\d+)m)?$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string like "2h", "45m", "1h30m" into whole minutes.
+
+    Hours must come before minutes, each unit at most once, units are
+    case-insensitive and surrounding whitespace is ignored. Raises ValueError
+    for anything else (empty text, unknown units, missing numbers, minutes
+    before hours, negative numbers).
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("empty duration")
+
+    match = _PATTERN.match(stripped)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    if hours == 0 and minutes == 0:
+        # Distinguish a real "0m"/"0h" from an empty/bare string that still
+        # matches the all-optional pattern.
+        if stripped.lower() not in ("0", "0h", "0m"):
+            raise ValueError(f"invalid duration: {text!r}")
+
+    return hours * 60 + minutes
