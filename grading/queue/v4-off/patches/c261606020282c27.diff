--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,27 @@
+"""Why the webhook worker is (or isn't) holding a partner event back.
+
+Partners ask why some order events reach them late; the answer lives in the delivery worker's
+fraud-review hold (see api.webhook_delivery.deliver_pending). This explains it without queueing
+anything: same rules, on a single (event, order) pair.
+"""
+from __future__ import annotations
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Reason the webhook worker would hold `event` for `order_id` right now, or None if it would send.
+
+    Mirrors the delivery worker's fraud-review hold: an event about an order that is in fraud review
+    is held until the review clears, so partners don't act on an order we may still cancel. Cancellations
+    and refunds (ALWAYS_DELIVER) go out regardless. If `under_review` raises we fail closed and report
+    a hold, exactly as the worker does."""
+    # No order to hold on, or an event that is never held (ALWAYS_DELIVER): it goes out normally.
+    if not order_id or event in ALWAYS_DELIVER:
+        return None
+    try:
+        if bool(under_review(order_id)):
+            return "Order is in fraud review; events are held until the review clears."
+    except Exception:
+        return "Fraud review lookup failed; holding to be safe."
+    return None
