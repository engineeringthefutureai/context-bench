+def by_email(customers: list[Customer]) -> dict[str, Customer]:
+    """Customers keyed by email address, trimmed and lowercased, for the CRM sync.
+
+    Built with the same index_by helper the shop uses for its other lookup tables, so a
+    duplicate (case-insensitive) email raises ValueError instead of silently keeping one.
+    """
+    return index_by(customers, key=lambda c: c.email.strip().lower())
