+def mask_card_number(card_number: str) -> str:
+    """Card number safe to send to partners: all but the last four digits masked with '*'."""
+    digits = re.sub(r"\D", "", card_number)
+    if len(digits) <= 4:
+        return "*" * len(digits)
+    return "*" * (len(digits) - 4) + digits[-4:]
