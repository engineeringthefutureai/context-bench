--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,17 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order, lowering its available quantity.
+
+        Raises Conflict without changing stock when not enough is available.
+        """
+        avail = self.available(sku)
+        if qty > avail:
+            raise Conflict(
+                f"not enough stock for {sku}: requested {qty}, available {avail}",
+                requested=qty,
+                available=avail,
+            )
+        self._on_hand[sku] = avail - qty
