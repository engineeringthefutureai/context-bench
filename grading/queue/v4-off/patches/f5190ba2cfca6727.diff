--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,32 @@
+import re
+
+_PATTERN = re.compile(
+    r"^\s*(?:(\d+)h)?\s*(?:(\d+)m)?\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string of hours and/or minutes into whole minutes.
+
+    Hours must come before minutes, each unit at most once, units are
+    case-insensitive and surrounding whitespace is ignored. Raises
+    ``ValueError`` for empty text, unknown units, a missing number, minutes
+    before hours, or negative numbers.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+
+    match = _PATTERN.match(text)
+    if match is None:
+        # Distinguishes an actual unit (with no number) from an empty string:
+        # "h"/"m" alone must raise, while "" / whitespace-only is also invalid.
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours_text, minutes_text = match.groups()
+    if hours_text is None and minutes_text is None:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours = int(hours_text) if hours_text is not None else 0
+    minutes = int(minutes_text) if minutes_text is not None else 0
+    return hours * 60 + minutes
