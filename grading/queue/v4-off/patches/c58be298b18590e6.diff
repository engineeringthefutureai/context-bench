--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,19 @@
+import re
+
+_PATTERN = re.compile(r"^(?:(\d+)h)?\s*(?:(\d+)m)?$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration like "2h", "45m", "1h30m" or "1h 30m" into whole minutes.
+
+    Hours come before minutes, each unit at most once, units are
+    case-insensitive and surrounding whitespace is ignored. Raises ValueError
+    for anything else (empty input, unknown units, missing numbers, minutes
+    before hours, or negative numbers).
+    """
+    m = _PATTERN.match(text.strip())
+    if m is None or (m.group(1) is None and m.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(m.group(1)) if m.group(1) is not None else 0
+    minutes = int(m.group(2)) if m.group(2) is not None else 0
+    return hours * 60 + minutes
