--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,24 @@
+import re
+
+_DURATION = re.compile(
+    r"^(?:(\d+)h)?(?:\s*(\d+)m)?$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Duration in whole minutes, from hours and/or minutes.
+
+    Hours come before minutes, each unit at most once; units are case-insensitive
+    and surrounding whitespace is ignored. Examples: "2h", "45m", "1h30m", "1h 30m".
+    Empty text, a missing number, minutes before hours, negative numbers and any
+    other unit raise ValueError."""
+    if text is None or not text.strip():
+        raise ValueError("empty duration")
+    m = _DURATION.match(text.strip())
+    if not m:
+        raise ValueError(f"bad duration {text!r}")
+    h, minn = m.groups()
+    if h is None and minn is None:
+        raise ValueError(f"bad duration {text!r}")
+    return int(h or 0) * 60 + int(minn or 0)
