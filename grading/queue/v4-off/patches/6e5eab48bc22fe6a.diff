+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,19 @@
+"""Labels printed for pallets that move through the warehouse.
+
+The warehouse's pallet scanner reads the finance system's item numbers rather
+than our SKUs, so these labels must present every line item that way.
+"""
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Label for a warehouse pallet.
+
+    First line is ``PALLET <pallet_id>``; then one line per item, in the order
+    given, ``<item number> x<qty>`` where the item number is the one the
+    finance system (ERP) knows that product by.
+    """
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
