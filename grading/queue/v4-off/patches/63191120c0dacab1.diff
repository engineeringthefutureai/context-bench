--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,33 @@
+"""Weight parsing for package weights typed in by warehouse staff."""
+import re
+from decimal import Decimal, ROUND_HALF_UP
+
+# Grams per unit as exact decimals, so the conversion and the final round-to-a-whole-gram
+# carry no float error (see shopkit.utils.numbers for the "no lossy float" convention).
+_GRAMS_PER = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# A non-negative integer or decimal ("." as separator), optional whitespace, then a unit
+# (g, kg, lb, oz). Case-insensitive; leading/trailing whitespace allowed. Anything else --
+# a missing number, a missing or unknown unit, a sign, a "," separator, trailing junk --
+# does not match and is rejected.
+_WEIGHT_RE = re.compile(r"\s*(\d+\.\d+|\.\d+|\d+)\s*(g|kg|lb|oz)\s*$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-typed weight into whole grams, e.g. "1.5 kg" -> 1500, " 2 lb " -> 907,
+    "8 oz" -> 227. Units are g, kg, lb or oz (case-insensitive); 1 lb = 453.59237 g and
+    1 oz = 28.349523125 g. The result is rounded to the nearest gram (half up).
+
+    Raises ValueError for a missing or malformed number, a missing or unknown unit, a negative
+    value, or a "," decimal separator."""
+    match = _WEIGHT_RE.match(text)
+    if not match:
+        raise ValueError(f"invalid weight {text!r}")
+    number, unit = match.group(1), match.group(2).lower()
+    grams = Decimal(number) * _GRAMS_PER[unit]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
