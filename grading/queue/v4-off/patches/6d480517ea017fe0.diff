--- /dev/null
+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,22 @@
+"""Pallet labels for the warehouse's new pallet scanner.
+
+The scanner reads the finance system's item numbers, not our SKUs, so each
+line of the label carries the ERP item number for the product (see
+``shopkit.core.erp.toErpSku``).
+"""
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items):
+    """Build the printable label for a pallet.
+
+    ``items`` is a list of ``(sku, qty)`` pairs, in the order the label should
+    show them. The first line is ``PALLET <pallet_id>``; each item contributes
+    one line ``<item number> x<qty>`` where the item number is the finance
+    system's (ERP) identifier for the product.
+    """
+    lines = ["PALLET " + str(pallet_id)]
+    for sku, qty in items:
+        lines.append("%s x%d" % (toErpSku(sku), qty))
+    return "\n".join(lines)
