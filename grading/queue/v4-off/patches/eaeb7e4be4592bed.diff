--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,37 @@
+"""Extract order references from customer messages so they can be turned into links."""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# Matches the reference formats customers type, on word boundaries:
+# the new 'ord_1a2b3c4d5e6f' form and the old SO/SOB form with dashes,
+# spaces or no separator at all.
+_REF_CANDIDATE = re.compile(
+    r"\b(?:ord_[0-9a-f]{12}|SOB?(?:-|\s)?\d{4}(?:-|\s)?\d{1,6})\b",
+    re.I,
+)
+
+
+def order_refs(text):
+    """Return the order references mentioned in *text*.
+
+    References are returned in the order they first appear, without
+    duplicates, and written in the canonical shop format (e.g.
+    "SO-2019-000123", "ord_1a2b3c4d5e6f"). Anything that is not a valid
+    order reference -- wrong shape, letters in the year, a year before
+    2017 -- is left out."""
+    if text is None:
+        return []
+    refs = []
+    seen = set()
+    for m in _REF_CANDIDATE.finditer(text):
+        parsed = parseOrderRef(m.group(0))
+        if parsed is None:
+            continue
+        ref = formatOrderRef(*parsed)
+        if ref not in seen:
+            seen.add(ref)
+            refs.append(ref)
+    return refs
