--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,17 @@
+from dataclasses import dataclass
+
+from shopkit.errors import Conflict
+
+
+@dataclass
+class InsufficientStock(Conflict):
+    """There is not enough stock on hand to fulfil the request."""
+
+    def __init__(self, message: str, sku: str, requested: int, available: int) -> None:
+        super().__init__(message)
+        self.details = {"sku": sku, "requested": requested, "available": available}
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +23,14 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Lower the available quantity of `sku` by `qty`, holding it for an order.
+
+        If there is not enough stock, nothing changes and an InsufficientStock is raised so the
+        API can answer 409 with the requested and available quantities."""
+        on_hand = self.available(sku)
+        if on_hand < qty:
+            raise InsufficientStock(f"not enough {sku} in stock", sku=sku, requested=qty,
+                                    available=on_hand)
+        self._on_hand[sku] = on_hand - qty
