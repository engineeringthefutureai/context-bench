--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class ReservationFailed(Conflict):
+    """A reservation asked for more stock than is available."""
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,11 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order. If there isn't enough stock, nothing changes
+        and the request fails the way other business-rule failures do."""
+        avail = self.available(sku)
+        if avail < qty:
+            raise ReservationFailed(f"not enough {sku}", sku=sku, requested=qty, available=avail)
+        self._on_hand[sku] = avail - qty
