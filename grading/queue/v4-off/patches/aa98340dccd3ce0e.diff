+# -*- coding: utf-8 -*-
+#
+# Cash till: the amount the cashier asks the customer to pay at a pop-up store.
+#
+from shopkit.core.pricing import cashRoundCents
+
+_PAID_BY = ("card", "cash")
+
+
+def amount_due(total_cents, currency, paid_by):
+    """Amount the cashier asks the customer to pay, in cents.
+
+    `paid_by` is "card" or "cash". Card payments pay the exact total. Cash payments
+    follow the national cash rules the shop already uses elsewhere
+    (see shopkit.core.pricing.cashRoundCents: CAD is rounded to the nearest 5 cents
+    after the penny withdrawal, other currencies come back unchanged)."""
+    if paid_by not in _PAID_BY:
+        raise ValueError("paid_by must be 'card' or 'cash', got %r" % (paid_by,))
+    total = int(total_cents)
+    if paid_by == "cash":
+        return cashRoundCents(total, currency)
+    return total
