@@ -0,0 +1,15 @@
+"""Delivery options offered at checkout."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: list[str], sites: list[Site], hazmat_skus: frozenset[str]) -> bool:
+    """Whether checkout should offer express delivery for these SKUs.
+
+    Mirrors warehouse.waves.allocate_wave: an express order only lands in an express wave when
+    none of its SKUs is hazmat (hazmat leaves by air and is downgraded to a standard wave) and at
+    least one of the given sites can ship the order."""
+    if not sites:
+        return False
+    return not any(sku in hazmat_skus for sku in skus)
