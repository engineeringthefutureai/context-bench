+def transfers_by_week(transfers) -> dict[str, int]:
+    """Total units moved per week, keyed by dashboard week labels in chronological order."""
+    by_week: dict[str, list] = {}
+    for t in transfers:
+        day = t.at.date()
+        label = iso_week_label(day)
+        by_week.setdefault(label, [day, 0])
+        by_week[label][0] = min(by_week[label][0], day)
+        by_week[label][1] += t.qty
+    ordered = sorted(by_week.items(), key=lambda item: (item[1][0], item[0]))
+    return {label: total for label, (first_day, total) in ordered}
+
