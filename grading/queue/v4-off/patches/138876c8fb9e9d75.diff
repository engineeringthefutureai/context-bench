--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -7,5 +7,23 @@
     def receive(self, sku: str, qty: int) -> None:
         self._on_hand[sku] = self._on_hand.get(sku, 0) + qty
 
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an in-progress order.
+
+        Raises ``Conflict`` (with the requested and available quantities as
+        ``requested``/``available`` details) when not enough stock is on hand,
+        in which case the on-hand quantity is left unchanged.
+        """
+        from shopkit.errors import Conflict
+
+        available = self._on_hand.get(sku, 0)
+        if available < qty:
+            raise Conflict(
+                f"insufficient stock for {sku}",
+                requested=qty,
+                available=available,
+            )
+        self._on_hand[sku] = available - qty
+
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
