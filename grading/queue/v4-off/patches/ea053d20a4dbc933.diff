--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,29 @@
+import re
+
+_GRAMS_PER_UNIT = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+_WEIGHT_RE = re.compile(r"^\s*(\d+(?:\.\d*)?|\.\d+)\s*(g|kg|lb|oz)\s*$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a human-typed package weight like "2.5 kg" into whole grams.
+
+    The number may be an integer or a decimal using "." as the separator;
+    the unit is one of g, kg, lb or oz (case-insensitive). Surrounding
+    whitespace is ignored. Raises ValueError for missing/unknown numbers or
+    units, negative values, and "," used as a decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+
+    match = _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    number, unit = match.groups()
+    return round(float(number) * _GRAMS_PER_UNIT[unit.lower()])
