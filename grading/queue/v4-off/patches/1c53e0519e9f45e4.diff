--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,20 @@
+"""Duration parsing for human-written spans like "2h" or "1h 30m"."""
+import re
+
+# Hours come before minutes, each unit at most once, units case-insensitive, optional
+# whitespace around and between the parts.
+_DURATION_RE = re.compile(r"^(?:\s*(\d+)\s*h\s*)?(?:\s*(\d+)\s*m\s*)?$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse hours and/or minutes, e.g. "2h", "45m", "1h30m" or "1h 30m", into whole minutes.
+    Anything else (empty text, other units, a missing number, minutes before hours,
+    negative numbers) raises ValueError."""
+    match = _DURATION_RE.match(text)
+    hours_text = match.group(1) if match else None
+    minutes_text = match.group(2) if match else None
+    if not match or not (hours_text or minutes_text):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(hours_text) if hours_text else 0
+    minutes = int(minutes_text) if minutes_text else 0
+    return hours * 60 + minutes
