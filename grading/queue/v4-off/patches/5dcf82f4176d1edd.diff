--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,19 @@
+"""Parsing of short duration texts such as "2h", "45m" or "1h 30m"."""
+import re
+
+# Hours come before minutes, each unit at most once, case-insensitive, any whitespace between them.
+_DURATION = re.compile(r"(?:(\d+)\s*h)?(?:\s*(\d+)\s*m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """A duration in whole minutes, from hours and/or minutes like "2h", "45m", "1h30m" or "1h 30m".
+
+    Units are case-insensitive and surrounding whitespace is ignored. Anything else (empty text,
+    other units, a missing number, minutes before hours, negative numbers) raises ValueError."""
+    stripped = text.strip()
+    match = _DURATION.fullmatch(stripped)
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
