+"""Reasoning about webhook timing for the partner-facing "status" endpoint.
+
+Partners ask why an event reached them late; the most common cause is the fraud-review hold in
+`shopkit.api.webhook_delivery.deliver_pending`. This module answers "would the worker hold this
+event back right now?" with a short reason a support agent can quote, or None when the event would
+be sent normally (or has no hold reason at all, e.g. it belongs to no order).
+"""
+from __future__ import annotations
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+_HOLD_TIMEOUT_S = 5
+
+
+def explain_delay(event: str, order_id: str, under_review) -> str | None:
+    """Why the webhook worker would hold `event` for `order_id` right now, or None when it would send it.
+
+    Mirrors the fraud-review hold in deliver_pending: events about an order that is in fraud review
+    are held until the review clears, so partners (ERP, 3PL) don't start fulfilling an order we may
+    still cancel. Cancellations and refunds (ALWAYS_DELIVER) go out regardless. The lookup
+    fails closed, just like the worker: if `under_review` raises we can't prove the review is
+    cleared, so the event is treated as held.
+
+    Returns None when there is nothing to hold back: the event has no order, it is an always-
+    delivered type, or the order is not (or no longer) in review.
+    """
+    if not order_id:
+        return None
+    if event in ALWAYS_DELIVER:
+        return None
+    try:
+        if not under_review(order_id):
+            return None
+    except Exception:
+        return (f"order {order_id} is in fraud review (held while we can't confirm the review "
+                f"status); cancellations and refunds are the only events released in the meantime")
+    return f"order {order_id} is in fraud review; event {event} is held until the review clears"
+
+
+__all__ = ["explain_delay"]
