--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,31 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"^\s*(\d+)h(?:\s*(\d+)m)?\s*$|^\s*(\d+)m\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration of hours and/or minutes into whole minutes.
+
+    Accepts forms such as "2h", "45m", "1h30m" or "1h 30m". Hours must come
+    before minutes, each unit appears at most once, units are
+    case-insensitive and surrounding whitespace is ignored. Raises ValueError
+    for anything else.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    match = _DURATION_RE.match(text)
+    if not match:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    if match.group(1) is not None:
+        hours = int(match.group(1))
+        minutes = int(match.group(2) or 0)
+    else:
+        hours = 0
+        minutes = int(match.group(3))
+
+    return hours * 60 + minutes
