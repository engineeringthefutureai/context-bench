+def by_email(customers: list[Customer]) -> dict[str, Customer]:
+    """Index by email address, trimmed and lowercased.
+
+    Built with the same index helper the shop uses for its other lookup
+    tables, so two customers sharing an email raise ValueError instead of
+    one silently hiding the other.
+    """
+    return index_by(customers, key=lambda c: c.email.strip().lower())
