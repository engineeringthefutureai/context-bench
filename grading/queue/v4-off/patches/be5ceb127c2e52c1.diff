--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,52 @@
+"""Parsing helpers for quantities entered by staff (weights in whole grams)."""
+import re
+
+# 1 pound = 453.59237 g exactly; 1 ounce = 28.349523125 g exactly.
+_POUNDS_TO_GRAMS = 453.59237
+_OUNCES_TO_GRAMS = 28.349523125
+
+_WEIGHT_RE = re.compile(
+    r"^\s*"
+    r"(?P<num>\d+(?:\.\d+)?)"   # integer or decimal, "." separator only
+    r"\s*"
+    r"(?P<unit>[a-zA-Z]+)"
+    r"\s*$"
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight typed by warehouse staff into whole grams.
+
+    Accepts a number (integer or decimal with "." separator), optional
+    whitespace, then a unit: g, kg, lb or oz (case-insensitive).
+    1 lb = 453.59237 g and 1 oz = 28.349523125 g. The result is rounded
+    to the nearest gram.
+
+    Raises ValueError for a missing number, a missing or unknown unit,
+    negative values, "," as decimal separator, or any other malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+
+    match = _WEIGHT_RE.match(text)
+    if not match:
+        raise ValueError(f"unparseable weight: {text!r}")
+
+    number = float(match.group("num"))
+    unit = match.group("unit").lower()
+
+    if unit == "g":
+        grams = number
+    elif unit == "kg":
+        grams = number * 1000
+    elif unit == "lb":
+        grams = number * _POUNDS_TO_GRAMS
+    elif unit == "oz":
+        grams = number * _OUNCES_TO_GRAMS
+    else:
+        raise ValueError(f"unknown weight unit: {match.group('unit')!r}")
+
+    if grams < 0:
+        raise ValueError(f"weight must not be negative: {text!r}")
+
+    return int(round(grams))
