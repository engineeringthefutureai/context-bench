+def expected_arrival(refund: Refund) -> date:
+    """Date banks expect to have credited a refund, as a date.
+
+    Banks take five business days, counted from the day the refund was issued: the issued
+    day itself does not count, so a refund issued on a business day lands five business
+    days later. Weekends and the days the shop is closed (utils.dates.HOLIDAYS) don't count.
+    """
+    return add_business_days(refund.at.date(), ARRIVAL_BUSINESS_DAYS)
