--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,24 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"^\s*(\d+)h(?:\s*(\d+)m)?\s*$|^\s*(\d+)m\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration of hours and/or minutes (e.g. "2h", "45m", "1h 30m") into whole minutes.
+
+    Hours must come before minutes, each unit at most once, units are case-insensitive,
+    and surrounding whitespace is ignored. Raises ValueError for empty text, other
+    units, a missing number, minutes before hours, or negative numbers.
+    """
+    match = _DURATION_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = match.group(1)
+    minutes = match.group(2)
+    if hours is None:
+        minutes = match.group(3)
+    total_minutes = int(hours or 0) * 60 + int(minutes or 0)
+    return total_minutes
