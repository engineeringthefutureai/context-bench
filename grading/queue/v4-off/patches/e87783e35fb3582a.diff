--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,42 @@
+"""Extract order references from free-form customer text.
+
+Support agents paste raw customer messages into tickets; this turns the order
+references buried in them into canonical, linkable references so agents can jump
+straight to the order.
+"""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# Order references use ASCII letters (kind, and the 12-hex id for new-style refs),
+# digits (year, sequence), and either "-" or "_" as the separator. A token is a
+# run of those characters: it is maximal, so two references with no separating
+# punctuation ("SO-2019-000123SO-2019-000124") are one token and neither parses,
+# which is the safe way to handle malformed input.
+_REF_TOKEN_RE = re.compile(r"[A-Za-z0-9_-]+")
+
+
+def order_refs(text: str) -> list[str]:
+    """Return the order references mentioned in ``text``, as canonical strings.
+
+    References are returned in the order they first appear, without duplicates,
+    each written the way the shop writes that kind of reference (see
+    :func:`shopkit.core.order_engine.formatOrderRef`). Anything that does not
+    parse as a valid order reference (old-style "SO-2019-000123" / "SOB 2020 45"
+    or new-style "ord_1a2b3c4d5e6f") is left out.
+    """
+    if not text:
+        return []
+    out: list[str] = []
+    seen: set[str] = set()
+    for token in _REF_TOKEN_RE.findall(text):
+        parsed = parseOrderRef(token)
+        if parsed is None:
+            continue
+        ref = formatOrderRef(*parsed)
+        if ref not in seen:
+            seen.add(ref)
+            out.append(ref)
+    return out
