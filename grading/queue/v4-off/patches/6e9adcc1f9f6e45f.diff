@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+def coupon_savings(items, products, code, coupons, engine, ship_to, weight_g, at):
+    """The saving in cents a discount code would give on this cart before it is applied.
+
+    Uses the same order of operations and rules as the cart page (member prices, promotions,
+    on-sale exclusions, minimum order value). Returns 0 when the code wouldn't apply.
+    """
+    base = price_cart(list(items), products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at)
+    if base.subtotal_cents == 0 or not base.lines:
+        return 0
+    try:
+        with_coupon = price_cart(list(items), products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                                 coupon_code=code, coupons=coupons)
+    except Exception:
+        return 0
+    return max(0, with_coupon.coupon_discount_cents)
