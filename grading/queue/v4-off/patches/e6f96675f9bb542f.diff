--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,18 @@
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: list[str], sites: list[Site], hazmat_skus: frozenset[str] = frozenset()) -> bool:
+    """Would the warehouse put an order containing these SKUs into an express wave?
+
+    Express leaves by air, so an order that contains any hazardous-goods SKU is never express: it is
+    downgraded to a standard ground wave instead (see allocate_wave). An express wave can only be
+    built from a site that has air service, so express is available only when at least one of the
+    candidate sites ships by air and none of the SKUs is hazmat.
+    """
+    if not skus or not sites:
+        return False
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in s.services for s in sites)
