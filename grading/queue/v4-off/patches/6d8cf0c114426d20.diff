--- a/shopkit/orders/models.py
+++ b/shopkit/orders/models.py
@@ -21,3 +21,20 @@
     @property
     def total_cents(self) -> int:
         return sum(line.total_cents for line in self.lines)
+
+    def add_line(self, sku: str, qty: int, unit_cents: int) -> OrderLine:
+        """Add a line for `sku`; if one already exists at the same unit price, increase its quantity.
+
+        Returns the line touched. Same-SKU lines at different prices are kept as separate lines.
+        """
+        if qty < 1:
+            raise ValueError(f"{sku}: qty must be >= 1, got {qty}")
+        if unit_cents < 0:
+            raise ValueError(f"{sku}: unit_cents must be >= 0, got {unit_cents}")
+        for line in self.lines:
+            if line.sku == sku and line.unit_cents == unit_cents:
+                line.qty += qty
+                return line
+        line = OrderLine(sku, qty, unit_cents)
+        self.lines.append(line)
+        return line
