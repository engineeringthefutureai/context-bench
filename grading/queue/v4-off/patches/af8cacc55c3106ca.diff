--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,40 @@
+"""Parsing helpers for quantities typed in by warehouse staff (e.g. package weights)."""
+
+import re
+
+# Exact, non-abbreviated unit names so the regex is unambiguous.
+_NUMBER_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)\s*$", re.IGNORECASE)
+
+# Conversion factors from each unit to grams, as given by the spec.
+_GRAMS_PER_UNIT = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-typed package weight into whole grams.
+
+    Accepts an integer or decimal number (``.`` separator) followed by the
+    unit ``g``, ``kg``, ``lb`` or ``oz`` (case-insensitive), with optional
+    surrounding/inner whitespace.  The result is rounded to the nearest gram.
+
+    Raises ``ValueError`` for anything else: a missing number, a missing or
+    unknown unit, a negative value, a comma decimal separator, or any other
+    malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a string, got {type(text).__name__}")
+
+    match = _NUMBER_RE.match(text)
+    if match is None:
+        raise ValueError(f"cannot parse weight from {text!r}")
+
+    number, unit = match.group(1), match.group(2).lower()
+    # Avoid float precision loss for large values by doing the math in exact
+    # integer "milli-grams" arithmetic where the factor allows it, then rounding.
+    factor = _GRAMS_PER_UNIT[unit]
+    grams = float(number) * factor
+    return int(round(grams))
