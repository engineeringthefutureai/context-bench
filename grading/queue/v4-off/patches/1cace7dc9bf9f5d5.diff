+"""Cash-till helpers for pop-up stores.
+
+`amount_due` computes the amount the cashier should ask the customer to pay for a given
+total and payment method. Card payments are charged at the exact total; cash payments
+are rounded the same way the shop already rounds cash elsewhere (nearest 5 cents for CAD,
+unchanged for all other currencies).
+"""
+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+
+_VALID_METHODS = {"card", "cash"}
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Amount the cashier asks the customer to pay, in minor units (cents).
+
+    * ``paid_by == "card"`` – the exact total, no rounding.
+    * ``paid_by == "cash"`` – the total rounded per the national cash rule
+      (nearest 5 ¢ for CAD; unchanged otherwise), reusing the shop's existing
+      cash-rounding logic.
+
+    Raises ``ValueError`` if *paid_by* is not "card" or "cash".
+    """
+    if paid_by not in _VALID_METHODS:
+        raise ValueError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
+    if paid_by == "card":
+        return total_cents
+    return cashRoundCents(total_cents, currency)
