--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,35 @@
+"""Unit conversion helpers for warehouse input (weights)."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact conversions: 1 lb = 453.59237 g, 1 oz = 28.349523125 g (international).
+_GRAMS_PER_UNIT: dict[str, Decimal] = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+_WEIGHT_RE = re.compile(
+    r"^(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)$",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams from warehouse input like "1.5 kg" or "2 lb 4 oz"-style single values.
+
+    Accepted: optional surrounding whitespace, a non-negative number ("." decimal separator),
+    optional inner whitespace, and a unit of g, kg, lb or oz (case-insensitive). Rounded to the
+    nearest gram (half away from zero).
+    Raises ValueError for a missing/unknown unit, a negative value, "," as decimal separator or any
+    other malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string: {text!r}")
+    match = _WEIGHT_RE.match(text.strip())
+    if not match:
+        raise ValueError(f"invalid weight: {text!r}")
+    number = Decimal(match.group(1))
+    grams = number * _GRAMS_PER_UNIT[match.group(2).lower()]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
