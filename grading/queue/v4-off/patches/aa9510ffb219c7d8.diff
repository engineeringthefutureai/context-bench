--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,53 @@
+"""Unit parsing helpers for warehouse-entered quantities."""
+
+import re
+
+# Exact conversion factors to grams.
+_CONVERSIONS = {
+    "g": 1,
+    "kg": 1000,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+_WEIGHT_RE = re.compile(
+    r"^\s*([0-9]+(?:\.[0-9]+)?)\s*(g|kg|lb|oz)\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight entered by warehouse staff into whole grams.
+
+    The input is a number (integer or decimal with "." separator), optional
+    whitespace, then a unit: g, kg, lb or oz (case-insensitive).
+    1 lb = 453.59237 g and 1 oz = 28.349523125 g. The result is rounded
+    to the nearest gram.
+
+    Raises:
+        ValueError: if the input has no number, a missing or unknown unit,
+            a negative value, uses "," as a decimal separator, or is otherwise
+            malformed.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+
+    # Reject negative values explicitly (the regex below only accepts digits,
+    # so a "-" prefix would fail the match; this keeps the error clear).
+    stripped = text.strip()
+    if stripped.startswith("-"):
+        raise ValueError(f"negative weight is not allowed: {text!r}")
+
+    # Reject "," as a decimal separator before the unit match so the error
+    # is specific.
+    if "," in stripped:
+        raise ValueError(f"',' is not a valid decimal separator: {text!r}")
+
+    match = _WEIGHT_RE.match(text)
+    if not match:
+        raise ValueError(f"unrecognised weight: {text!r}")
+
+    number, unit = match.groups()
+    factor = _CONVERSIONS[unit.lower()]
+    grams = float(number) * factor
+    return int(round(grams))
