--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,60 @@
+"""Read-only preview of where a refund would go, before the agent presses Refund.
+
+Mirrors the split logic of payments.settlement.settle_refund (proportional to each
+captured payment's refundable balance, leftover cents to cards first, per-payment
+destination by method and card age) but never performs a refund."""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                        today: date) -> dict[str, int]:
+    """Where a refund of `amount_cents` for `order_id` would be settled.
+
+    Returns {"card": int, "store_credit": int, "gift_card": int} with the same split a
+    real refund of that amount for that order would produce. Does not refund anything.
+
+    Raises ShopError if the order has no captured payment, and RefundTooLarge if the
+    amount exceeds what is still refundable (same rules as the actual refund path)."""
+    if amount_cents <= 0:
+        raise ShopError("refund amount must be positive", order_id=order_id)
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}", order_id=order_id,
+                             requested=amount_cents, refundable=refundable)
+
+    # Same split as settle_refund: proportional to each payment's refundable balance, with
+    # the leftover cents going to card payments first so a gift card never exceeds its share.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    dest = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            dest["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            dest["store_credit"] += share
+        else:
+            dest["card"] += share
+    return dest
