+"""Parsers for weights and distances entered by warehouse and customer staff."""
+
+import re
+
+# Conversion factors from one unit to one gram.
+_LB_TO_G = 453.59237
+_OZ_TO_G = 28.349523125
+_G_TO_FT = 1 / 30.48  # 1 ft = 30.48 cm exactly
+
+# A non-negative number (digits, with an optional single fractional part) followed by
+# optional whitespace and a unit. Group 1: number, group 2: unit (lowercased).
+_WEIGHT_RE = re.compile(r"^(\d+(?:\.\d+)?)[ \t]*([a-zA-Z]+)$")
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight like "1.5 kg" or "32 oz" into whole grams, rounding to the nearest.
+
+    Accepts g, kg, lb and oz (case-insensitive). Raises ValueError for anything else:
+    a missing or non-numeric value, a missing or unknown unit, a negative sign, or a
+    "," used as the decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+    m = _WEIGHT_RE.match(text.strip())
+    if not m:
+        raise ValueError(f"cannot parse weight: {text!r}")
+
+    number = float(m.group(1))
+    unit = m.group(2).lower()
+
+    factors = {"g": 1.0, "kg": 1000.0, "lb": _LB_TO_G, "oz": _OZ_TO_G}
+    if unit not in factors:
+        raise ValueError(f"unknown unit: {m.group(2)!r}")
+
+    return int(round(number * factors[unit]))
+
+
+def parse_distance(text: str) -> int:
+    """Parse a distance like "2.5 ft" or "700 cm" into whole centimeters.
+
+    Accepts cm, m and ft (case-insensitive). Raises ValueError for anything else.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"distance must be a string, got {type(text).__name__}")
+    m = _WEIGHT_RE.match(text.strip())
+    if not m:
+        raise ValueError(f"cannot parse distance: {text!r}")
+
+    number = float(m.group(1))
+    unit = m.group(2).lower()
+
+    factors = {"cm": 1.0, "m": 100.0, "ft": 30.48}
+    if unit not in factors:
+        raise ValueError(f"unknown unit: {m.group(2)!r}")
+
+    return int(round(number * factors[unit]))
