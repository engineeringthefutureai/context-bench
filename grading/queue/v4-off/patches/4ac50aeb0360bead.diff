@@ -0,0 +1,25 @@
+import re
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string like "2h", "45m", "1h30m", "1h 30m" into whole minutes.
+
+    Hours come before minutes, each unit at most once, units case-insensitive,
+    surrounding whitespace ignored.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+    s = text.strip()
+    if not s:
+        raise ValueError("duration must be a non-empty string")
+    # Allow optional hours part and/or optional minutes part, with optional whitespace between
+    pattern = r"^(?:(\d+)h)?\s*(?:(\d+)m)?$"
+    m = re.match(pattern, s, re.IGNORECASE)
+    if not m:
+        raise ValueError(f"invalid duration: {text!r}")
+    h_str, m_str = m.group(1), m.group(2)
+    if h_str is None and m_str is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(h_str) if h_str is not None else 0
+    minutes = int(m_str) if m_str is not None else 0
+    return hours * 60 + minutes
