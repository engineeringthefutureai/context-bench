--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,21 @@
+"""Delivery options offered at checkout, kept in sync with what the pick waves will actually do
+(warehouse.waves.allocate_wave)."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: list[str], sites: list[Site], hazmat_skus: frozenset[str] = frozenset()) -> bool:
+    """Whether the warehouse would put an order with these SKUs into an express wave.
+
+    Mirrors the rules in allocate_wave: an order containing any hazmat SKU never goes into an
+    express wave (express leaves by air, hazmat only travels by ground, so such orders are
+    downgraded to standard), and the order can only ship from sites that have ground service at
+    their dock. An empty cart has nothing to deliver, so it is not express.
+    """
+    skus = list(skus)
+    if not skus:
+        return False
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("ground" in s.services for s in sites)
