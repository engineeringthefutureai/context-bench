+def parcel_weight_g(parcel: Parcel, products: dict[str, "Product"]) -> int:
+    """Total weight in grams of a parcel's contents: sum of each unit's product weight. A SKU not
+    in `products` is a data error, not a free item."""
+    total = 0
+    for sku, qty in parcel.items:
+        try:
+            product = products[sku]
+        except KeyError:
+            raise NotFound(f"no product for sku {sku}")
+        total += product.weight_g if False else product.weight_g * qty
+    return total
+
