--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,24 @@
+from __future__ import annotations
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str,
+                   coupons: dict[str, Coupon], engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at) -> int:
+    """How many cents the code would take off this cart, the same way the cart page computes it.
+
+    A code that would be rejected or apply nothing saves 0. The cart is priced twice: once with
+    the code and once without, so the saving is what shoppers would see applied to their total.
+    """
+    if not code or not str(code).strip():
+        return 0
+    without = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                         coupons=coupons)
+    with_code = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                           coupon_code=code, coupons=coupons)
+    return without.total_cents - with_code.total_cents
