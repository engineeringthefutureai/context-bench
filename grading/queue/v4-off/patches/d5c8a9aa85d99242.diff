--- /dev/null
+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,23 @@
+"""Pallet labels for the new warehouse pallet scanner.
+
+The scanner reads the finance system's item numbers (ERP item numbers), not our
+SKUs, so each line of the label carries the product's ERP item number via
+core.erp.toErpSku."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items):
+    """Return the label text for a pallet.
+
+    ``pallet_id`` is the pallet identifier and ``items`` is a list of
+    (sku, qty) pairs. The label is a header line ``PALLET <pallet_id>``
+    followed by one line per item, ``<item number> x<qty>`` in the order
+    given, where the item number is the one the finance system (ERP) knows
+    the product by.
+    """
+    lines = ["PALLET %s" % pallet_id]
+    for sku, qty in items:
+        lines.append("%s x%d" % (toErpSku(sku), qty))
+    return "\n".join(lines)
