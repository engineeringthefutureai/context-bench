--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,45 @@
+"""Parsing helpers for quantities typed in by staff, such as package weights."""
+
+import re
+
+_LB_IN_GRAMS = 453.59237
+_OZ_IN_GRAMS = 28.349523125
+
+_WEIGHT_RE = re.compile(
+    r"^(?P<value>\d+(?:\.\d+)?)\s*(?P<unit>g|kg|lb|oz)\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a package weight typed in by staff and return it in whole grams.
+
+    The input is a number (integer or a decimal using "." as the separator),
+    optional whitespace, then a unit: g, kg, lb or oz (case-insensitive).
+    Leading and trailing whitespace is ignored. lb and oz are converted at
+    1 lb = 453.59237 g and 1 oz = 28.349523125 g. The result is rounded to
+    the nearest gram.
+
+    Raises ValueError for anything else, including a missing number, a
+    missing or unknown unit, negative values and "," as the decimal
+    separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a string, got {type(text).__name__}")
+
+    match = _WEIGHT_RE.match(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    value = float(match.group("value"))
+    unit = match.group("unit").lower()
+    if unit == "g":
+        grams = value
+    elif unit == "kg":
+        grams = value * 1000
+    elif unit == "lb":
+        grams = value * _LB_IN_GRAMS
+    else:  # oz
+        grams = value * _OZ_IN_GRAMS
+
+    return int(round(grams))
