--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,26 @@
+"""Parsing of durations like "2h", "45m", "1h30m" or "1h 30m"."""
+import re
+
+_DURATION_RE = re.compile(r"(?:(\d+)h)?(?:\s*(\d+)m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Return a duration in whole minutes.
+
+    Accepts hours and/or minutes such as "2h", "45m", "1h30m" or "1h 30m":
+    hours come before minutes, each unit at most once, units are
+    case-insensitive and surrounding whitespace is ignored. Anything else
+    (empty text, other units, a missing number, minutes before hours,
+    negative numbers) raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours, minutes = match.groups()
+    if hours is None and minutes is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    total = (int(hours) if hours is not None else 0) * 60
+    total += int(minutes) if minutes is not None else 0
+    return total
