+# -*- coding: utf-8 -*-
+#
+# Small helpers for parsing human durations ("1h30m") into whole minutes.
+#
+import re
+
+# optional hours part then optional minutes part; a bare number (no unit) does not match.
+# hours must precede minutes and each unit appears at most once. Case-insensitive; whitespace
+# is allowed between a number and its unit and between the two parts.
+_DURATION_RE = re.compile(r"\s*(?:(\d+)\s*h)?\s*(?:(\d+)\s*m)?\s*", re.IGNORECASE)
+
+
+def parse_duration(text):
+    """Parse a duration in hours and/or minutes to whole minutes.
+
+    "2h" -> 120, "45m" -> 45, "1h30m" -> 90, "1h 30m" -> 90. Hours come before minutes, each
+    unit appears at most once, units are case-insensitive and surrounding whitespace is
+    ignored. Anything else (empty text, other units, a missing number, minutes before hours,
+    negative numbers) raises ValueError."""
+    if not isinstance(text, str):
+        raise ValueError("bad duration %r" % (text,))
+    m = _DURATION_RE.fullmatch(text)
+    if m is None:
+        raise ValueError("bad duration %r" % (text,))
+    hours, minutes = m.group(1), m.group(2)
+    if hours is None and minutes is None:
+        raise ValueError("bad duration %r" % (text,))
+    total = 0
+    if hours is not None:
+        total += int(hours) * 60
+    if minutes is not None:
+        total += int(minutes)
+    return total
