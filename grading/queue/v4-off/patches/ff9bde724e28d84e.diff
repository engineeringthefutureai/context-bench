--- /dev/null
+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,19 @@
+"""Pallet label content for the warehouse's pallet scanner.
+
+The scanner reads the finance ERP's item numbers, not shop SKUs, so each line is
+printed with the item number the ERP knows the product by (see core.erp.toErpSku)."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items):
+    """Build the text printed on a pallet label.
+
+    items is a list of (sku, qty) pairs in the order they should appear. The first
+    line is "PALLET <pallet_id>", then one line per item: the finance ERP's item number
+    for that SKU followed by " x<qty>". An item whose SKU can't be expressed as an ERP
+    item number fails with the ValueError from toErpSku."""
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
