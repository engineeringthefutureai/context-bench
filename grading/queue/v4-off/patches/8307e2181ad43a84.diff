+def _mask_pan(value):
+    """Redact a card number the same way the shop masks card numbers elsewhere (redact_pan).
+    Only plain strings are treated as card numbers; anything else is returned unchanged."""
+    if isinstance(value, str):
+        return redact_pan(value)
+    return value
+
+
+def _sanitize(data):
+    """Copy of the event data with any `card_number` field masked, at any depth. Other fields and
+    structure go out unchanged."""
+    if isinstance(data, dict):
+        return {k: (_mask_pan(v) if k == "card_number" else _sanitize(v)) for k, v in data.items()}
+    if isinstance(data, list):
+        return [_sanitize(item) for item in data]
+    return data
+
