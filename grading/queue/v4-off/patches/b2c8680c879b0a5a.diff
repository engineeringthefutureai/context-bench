@@ -1,3 +1,6 @@
+from shopkit.errors import InsufficientStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,20 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order.
+
+        Lowers the available quantity by `qty`. If there isn't enough stock,
+        nothing changes and an :class:`InsufficientStock` is raised so the API
+        answers with 409 and the requested and available quantities.
+        """
+        avail = self._on_hand.get(sku, 0)
+        if qty > avail:
+            raise InsufficientStock(
+                f"cannot reserve {qty} of {sku}: only {avail} available",
+                sku=sku,
+                requested=qty,
+                available=avail,
+            )
+        self._on_hand[sku] = avail - qty
