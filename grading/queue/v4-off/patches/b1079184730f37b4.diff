--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,32 @@
+"""Parsing of weights keyed in by warehouse staff (e.g. "2.5 kg", "14 OZ")."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact conversions to grams: 1 kg = 1000 g, 1 lb = 453.59237 g, 1 oz = 28.349523125 g.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# A whole or decimal number (only "." as decimal separator), optional spaces, then a unit.
+_WEIGHT_RE = re.compile(r"(?P<number>\d+(?:\.\d+)?)[ \t]*(?P<unit>g|kg|lb|oz)\b", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams, as keyed in on the packing line: a number and a unit (g, kg, lb or
+    oz), e.g. "2.5 kg" -> 2500, "14oz" -> 397, " 1 LB " -> 454. Leading and trailing whitespace
+    is ignored; the result is rounded to the nearest gram.
+
+    Raises ValueError for anything else, including a missing number, a missing or unknown unit,
+    a sign ("+5 g", "-3 g") and "," as decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if not match:
+        raise ValueError(f"cannot parse weight: {text!r}")
+    amount = Decimal(match.group("number"))
+    factor = _GRAMS_PER_UNIT[match.group("unit").lower()]
+    return int((amount * factor).quantize(Decimal(1), rounding=ROUND_HALF_UP))
