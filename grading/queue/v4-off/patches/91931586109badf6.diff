--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,104 @@
+"""Read-only preview of a seller's next payout.
+
+`preview_payout` runs the same period rules the weekly batch uses (holds, released holds,
+adjustments, reserve, rollover, backup withholding, minimum payout) but is a pure
+computation: it never places or releases holds and never moves balances in the
+`Rollover` book. It returns the status and net cents the seller's payout would get.
+"""
+
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from shopkit.payouts.batching import (BACKUP_WITHHOLDING_BP, FX_FEE_BP, MIN_PAYOUT_CENTS, Rollover,
+                                      _commission, apply_rate)
+from shopkit.payouts.holds import RETURN_WINDOW_DAYS, HoldBook
+from shopkit.payouts.models import (CLOSING, DRAFT, ROLLED_OVER, SUSPENDED, Adjustment, Earning, Payout,
+                                    PayoutLine, Seller)
+from shopkit.config import SETTINGS, Settings
+from shopkit.pricing.currency import RateTable
+from shopkit.payouts.batching import MAX_FX_ATTEMPTS
+from shopkit.pricing.currency import RateUnavailable
+from shopkit.utils.numbers import apply_rate
+
+DRIFT_TOLERANCE_CENTS = 1
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment],
+                   period_start: date, period_end: date, holds: HoldBook, rollover: Rollover,
+                   rates: RateTable | None = None, settings: Settings = SETTINGS,
+                   seller_country: dict[str, str] | None = None) -> tuple[str, int]:
+    """Return the (status, net_cents) of the payout `seller` would get for [period_start, period_end].
+
+    A preview changes nothing: it only inspects the hold book (holds due for release are read, not
+    released) and reads the carried balance from `rollover` (it does not take it).
+    """
+    next_id = lambda seller_id: f"po_{seller_id}_{period_end:%Y%m%d}"  # noqa: E731 (local, never used beyond id)
+    payout = Payout(next_id(seller.id), seller.id, period_start, period_end, seller.payout_currency)
+    shop_currency = settings.default_currency
+
+    # --- lines, held now -----------------------------------------------------------------------------------
+    in_period = [e for e in (earnings or [])
+                 if e.delivered_on is None or period_start - timedelta(days=366) <= e.delivered_on <= period_end]
+    held_now = 0
+    for e in sorted(in_period, key=lambda e: (e.order_id, e.sku)):
+        commission = _commission(e.gross_cents, seller.commission_bp)
+        net = e.gross_cents - commission - e.refunded_cents
+        if e.refunded_cents and e.refunded_cents == e.gross_cents:
+            net = 0
+            commission = 0
+        payout.lines.append(PayoutLine(e.order_id, e.gross_cents, commission, e.refunded_cents, net))
+        within_window = e.delivered_on is None or e.delivered_on + timedelta(days=RETURN_WINDOW_DAYS) > period_end
+        if within_window and net > 0:
+            # read-only: count it as held without calling holds.place (which would mutate the book)
+            held_now += net
+    payout.held_cents = held_now
+
+    # --- released holds (read-only), adjustments, reserve, rollover --------------------------------------
+    released = holds.releasable(seller.id, period_end)
+    released_total = sum(h.amount_cents for h in released)
+    adj_total = 0
+    for a in (adjustments or []):
+        adj_total += a.amount_cents
+    payout.adjustments_cents = adj_total + released_total
+    if seller.reserve_bp:
+        payout.reserve_cents = apply_rate(payout.gross_cents, seller.reserve_bp / 100)
+    payout.carried_in_cents = rollover.balances.get(seller.id, 0)  # read, not take()
+
+    # --- backup withholding ---------------------------------------------------------------------------------
+    country = (seller_country or {}).get(seller.id, "US")
+    if country == "US" and not seller.tax_id.strip():
+        line_net = sum(l.net_cents for l in payout.lines) - payout.held_cents
+        if line_net > 0:
+            withheld = apply_rate(line_net, BACKUP_WITHHOLDING_BP / 100)
+            payout.adjustments_cents -= withheld
+
+    # --- minimum payout and negative balances ---------------------------------------------------------------
+    net = payout.net_cents
+    if net < 0:
+        payout.status = ROLLED_OVER
+    elif net < MIN_PAYOUT_CENTS and seller.status != CLOSING:
+        payout.status = ROLLED_OVER
+    else:
+        payout.status = DRAFT
+
+    # --- currency --------------------------------------------------------------------------------------------
+    if payout.status == DRAFT and seller.payout_currency != shop_currency:
+        if rates is None:
+            payout.status = ROLLED_OVER
+            return payout.status, payout.net_cents
+        converted = None
+        for _ in range(1, MAX_FX_ATTEMPTS + 1):
+            try:
+                converted = rates.convert(net, shop_currency, seller.payout_currency, period_end)
+                break
+            except RateUnavailable:
+                converted = None
+                break
+        if converted is None:
+            payout.status = ROLLED_OVER
+            return payout.status, payout.net_cents
+        fee = apply_rate(converted, FX_FEE_BP / 100)
+        payout.adjustments_cents -= net - (converted - fee)
+
+    return payout.status, payout.net_cents
