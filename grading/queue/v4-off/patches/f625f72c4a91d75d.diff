+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per ISO week, keyed by the dashboards' week labels.
+
+    Weeks appear in chronological order ("2026-W47" style).
+    """
+    totals: dict[str, int] = {}
+    for t in sorted(transfers, key=lambda t: (t.at.date().isocalendar(), t.at)):
+        totals[iso_week_label(t.at.date())] = totals.get(iso_week_label(t.at.date()), 0) + t.qty
+    return totals
