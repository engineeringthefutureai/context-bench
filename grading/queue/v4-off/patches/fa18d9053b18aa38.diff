+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Total units moved per week, keyed by the week label dashboards use, in chronological order."""
+    by_week = group_by(transfers, key=lambda t: iso_week_label(t.at.date()))
+    return {week: sum(t.qty for t in group) for week, group in sorted(by_week.items())}
