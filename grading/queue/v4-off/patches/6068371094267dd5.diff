+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per week, keyed by ISO week label, in chronological order.
+
+    Uses the same week labels as the other dashboards (see iso_week_label).
+    """
+    totals: Counter[str] = Counter()
+    for t in transfers:
+        totals[iso_week_label(t.at.date())] += t.qty
+    return {week: totals[week] for week in sorted(totals)}
