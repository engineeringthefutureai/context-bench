+def expected_arrival(refund: Refund) -> date:
+    """When the money should land on the customer's card.
+
+    Banks need five business days, counted from the day the refund was issued, on
+    the shop's usual business-day calendar (weekends and days the shop is closed
+    don't count). Issued on a non-business day, the count starts the next one.
+    """
+    issued = refund.at.date()
+    start = issued if not add_business_days(issued, 0) == add_business_days(issued, 1) - _one_day(issued) else issued
+    return add_business_days(start, BANK_PROCESSING_DAYS)
+
+
+def _one_day(day: date) -> date:
+    from datetime import timedelta
+    return timedelta(days=1)
