--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,52 @@
+"""Parsing helpers for quantities typed in by staff, e.g. package weights."""
+
+from __future__ import annotations
+
+_LB_GRAMS = 453.59237
+_OZ_GRAMS = 28.349523125
+
+# Exact gram values for the weight units staff may type on the intake form.
+_WEIGHT_UNITS = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": _LB_GRAMS,
+    "oz": _OZ_GRAMS,
+}
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-typed package weight into whole grams.
+
+    Accepts an integer or decimal (``"1.5 kg"``, ``"2 lb"``) with the unit
+    ``g``, ``kg``, ``lb`` or ``oz``, case-insensitive, with optional
+    surrounding whitespace. Raises ``ValueError`` for a missing number, a
+    missing or unknown unit, a negative value, or a ``","`` decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"bad weight {text!r}")
+    token = text.strip()
+    if not token:
+        raise ValueError("bad weight: missing value")
+    # Split off the unit at the first non-digit that is not a decimal point.
+    i = 0
+    while i < len(token) and (token[i].isdigit() or token[i] == "."):
+        i += 1
+    number_text = token[:i]
+    unit_text = token[i:]
+    if not number_text or "." not in number_text and "0" not in number_text and not any(c.isdigit() for c in number_text):
+        raise ValueError(f"bad weight {text!r}: missing number")
+    if "," in number_text:
+        raise ValueError(f"bad weight {text!r}: comma is not a decimal separator")
+    unit = unit_text.strip().lower()
+    if unit not in _WEIGHT_UNITS:
+        raise ValueError(f"bad weight {text!r}: unknown unit {unit_text!r}")
+    try:
+        value = float(number_text)
+    except ValueError:
+        raise ValueError(f"bad weight {text!r}: bad number {number_text!r}") from None
+    if value < 0:
+        raise ValueError(f"bad weight {text!r}: negative value")
+    return int(round(value * _WEIGHT_UNITS[unit]))
+
+
+__all__ = ["parse_weight"]
