--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,94 @@
+"""Payout preview: show a seller what their next payout will look like before finance runs the
+weekly batch (INC-2412). The preview must not change anything: no holds are placed or released and
+no rollover balance is taken or stored, so running a preview any number of times — or a preview and
+then the real batch — gives the same result as the batch alone."""
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from shopkit.config import SETTINGS, Settings
+from shopkit.payouts.batching import (BACKUP_WITHHOLDING_BP, FX_FEE_BP, MIN_PAYOUT_CENTS,
+                                      _commission)
+from shopkit.payouts.holds import RETURN_WINDOW_DAYS, HoldBook
+from shopkit.payouts.models import (CLOSED, CLOSING, DRAFT, ROLLED_OVER, SUSPENDED, Adjustment, Earning,
+                                    Seller)
+from shopkit.pricing.currency import RateTable
+from shopkit.utils.numbers import apply_rate
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment],
+                   period_start: date, period_end: date, holds: HoldBook, rollover,
+                   rates: RateTable | None = None, settings: Settings = SETTINGS,
+                   seller_country: dict[str, str] | None = None) -> tuple[str, int]:
+    """Return `(status, net_cents)`: how the weekly payout batch would treat this seller for
+    [period_start, period_end] (inclusive), without doing it.
+
+    Earnings, adjustments, holds and rollover balances are only read, never changed: amounts inside
+    the return window are counted as held and the carried balance as carried in, but nothing is
+    placed, released, taken or rolled over.
+
+    The same rules as the batch apply: suspended/closed sellers are skipped, invalid earnings are
+    rejected, fully refunded lines give the commission back, a US seller without a tax id gets backup
+    withholding, and a seller paid in another currency is converted with the period end's rate minus
+    the FX fee (needs `rates`; without it the seller is reported rolled over, like the batch).
+    A payout under MIN_PAYOUT_CENTS (or negative) comes back rolled over, except a closing seller
+    gets their (positive) remainder."""
+    def _skipped(reason: str) -> tuple[str, int]:
+        # The batch records the skip but pays nothing: same for the preview.
+        return reason, 0
+
+    if seller.status in (SUSPENDED, CLOSED):
+        return _skipped(seller.status)
+    shop_currency = settings.default_currency
+    if rates is None and seller.payout_currency != shop_currency:
+        return _skipped("no rates")
+
+    # --- earnings in the period (same checks and filter as build_payout_batch) -------------------------
+    valid_earnings = [e for e in earnings
+                      if e.gross_cents >= 0 and 0 <= e.refunded_cents <= e.gross_cents
+                      and e.seller_id == seller.id]
+    in_period = [e for e in valid_earnings
+                 if e.delivered_on is None or period_start - timedelta(days=366) <= e.delivered_on <= period_end]
+
+    # --- lines: held amounts counted, but no holds are placed -----------------------------------------
+    line_net = 0
+    held = 0
+    for e in sorted(in_period, key=lambda e: (e.order_id, e.sku)):
+        commission = _commission(e.gross_cents, seller.commission_bp)
+        net = e.gross_cents - commission - e.refunded_cents
+        if e.refunded_cents and e.refunded_cents == e.gross_cents:
+            # full refund: the commission is given back to the seller too (marketplace terms §7.2)
+            net = 0
+            commission = 0
+        line_net += net
+        within_window = e.delivered_on is None or e.delivered_on + timedelta(days=RETURN_WINDOW_DAYS) > period_end
+        if within_window and net > 0:
+            held += net
+    gross = sum(e.gross_cents for e in in_period)
+
+    # --- released holds (read only), adjustments, reserve ---------------------------------------------
+    released = sum(h.amount_cents for h in holds.releasable(seller.id, period_end))
+    # Holds placed in the *next* run of the batch can't be released in this period, so they are held
+    # above and not added here; same for the real batch.
+    adj_total = sum(a.amount_cents for a in adjustments if a.seller_id == seller.id)
+    reserve = apply_rate(gross, seller.reserve_bp / 100) if seller.reserve_bp else 0
+
+    # --- backup withholding (on the period's net line amounts, like the batch) -------------------------
+    withheld = 0
+    country = (seller_country or {}).get(seller.id, "US")
+    if country == "US" and not seller.tax_id.strip():
+        pay_lines = line_net - held
+        if pay_lines > 0:
+            withheld = apply_rate(pay_lines, BACKUP_WITHHOLDING_BP / 100)
+
+    # --- net, minimum payout, currency -----------------------------------------------------------------
+    carried = rollover.balances.get(seller.id, 0)
+    net = line_net + adj_total + released + carried - held - reserve - withheld
+    if net < 0:
+        return ROLLED_OVER, net
+    if net < MIN_PAYOUT_CENTS and seller.status != CLOSING:
+        return ROLLED_OVER, net
+    if seller.payout_currency != shop_currency:
+        converted = rates.convert(net, shop_currency, seller.payout_currency, period_end)
+        net -= net - (converted - apply_rate(converted, FX_FEE_BP / 100))
+    return DRAFT, net
