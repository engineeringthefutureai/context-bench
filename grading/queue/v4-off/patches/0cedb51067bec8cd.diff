--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,36 @@
+"""Unit parsing for values typed in by warehouse staff.
+
+Weights are returned as whole grams so downstream packing and shipping code can
+do plain integer arithmetic."""
+import re
+from decimal import Decimal
+
+# Exact conversions to grams; g is the identity factor.
+_GRAMS_PER = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# Number: optional "-" (rejected later), digits, optional single "." decimal part.
+# Unit: g, kg, lb or oz, case-insensitive.
+_WEIGHT_RE = re.compile(r"^(-?\d+(?:\.\d+)?)\s*(g|kg|lb|oz)$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a package weight like "1.2 kg" or " 32 oz " into whole grams.
+
+    Accepts an integer or a decimal ("." separator) value, optional whitespace
+    between the number and the unit, and the unit g, kg, lb or oz in any case.
+    Raises ValueError for a missing or malformed number or unit, a missing
+    value, a negative value, or a "," decimal separator."""
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+    match = _WEIGHT_RE.match(text.strip())
+    if not match:
+        raise ValueError(f"invalid weight: {text!r}")
+    number = match.group(1)
+    if number.startswith("-"):
+        raise ValueError(f"weight must not be negative: {text!r}")
+    return int(Decimal(number) * _GRAMS_PER[match.group(2).lower()])
