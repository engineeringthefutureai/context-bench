--- a/shopkit/orders/models.py
+++ b/shopkit/orders/models.py
@@ -21,3 +21,18 @@
     @property
     def total_cents(self) -> int:
         return sum(line.total_cents for line in self.lines)
+
+    def add_line(self, sku: str, qty: int, unit_cents: int) -> OrderLine:
+        """Add or merge an order line for ``sku``.
+
+        If a line already exists with the same SKU and the same unit price, its
+        quantity is increased; otherwise a new line is appended. Returns the
+        line that was touched.
+        """
+        for line in self.lines:
+            if line.sku == sku and line.unit_cents == unit_cents:
+                line.qty += qty
+                return line
+        new_line = OrderLine(sku=sku, qty=qty, unit_cents=unit_cents)
+        self.lines.append(new_line)
+        return new_line
