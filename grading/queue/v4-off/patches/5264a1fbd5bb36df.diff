--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,77 @@
+"""Preview of where a refund would go, for support agents to quote the customer *before* they
+press Refund.
+
+Pure read-only twin of the planning step in shopkit.payments.settlement.settle_refund: it applies
+the same rules to a hypothetical refund and touches nothing (no provider call, no payment
+mutation, no ledger, no events).
+"""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+from shopkit.utils.dates import utc_now
+
+GIFT_CARD_FALLBACK_TO_STORE_CREDIT = "no gift card service: store credit instead"
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                        today: date | None = None) -> dict[str, int]:
+    """Split amount_cents for order_id the way settle_refund would, without refunding anything.
+
+    Returns {"card": int, "store_credit": int, "gift_card": int}. The parts always sum to
+    amount_cents. Rules mirror payments.settlement.settle_refund:
+    - the refund is split across the order's captured payments in proportion to what is still
+      refundable on each, with the leftover cents going to card payments first;
+    - a gift card payment's share goes to a gift card (store credit if there is no gift card
+      service, i.e. no such payment exists on the order);
+    - a card payment older than CARD_REFUND_MAX_AGE_DAYS goes to store credit; a younger one to
+      the card.
+
+    Raises ShopError for a non-positive amount and RefundTooLarge if it exceeds what the order's
+    captured payments still allow; a ShopError is raised if the order has no captured payment.
+    """
+    if amount_cents <= 0:
+        raise ShopError("refund amount must be positive", order_id=order_id)
+    today = today or utc_now().date()
+
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}",
+                             order_id=order_id, requested=amount_cents, refundable=refundable)
+
+    # Same split as settle_refund: proportional to what is still refundable, cards first so the
+    # leftover cents land on a card rather than a gift card.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    # Without a gift card service settle_refund falls back to store credit for the gift card share.
+    gift_card_fallback_to_credit = not any(p.method == "gift_card" for p in captured)
+
+    dest = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            dest["store_credit" if gift_card_fallback_to_credit else "gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            dest["store_credit"] += share
+        else:
+            dest["card"] += share
+    return dest
