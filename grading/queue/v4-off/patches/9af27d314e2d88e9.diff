@@ -0,0 +1,15 @@
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items):
+    """Render a pallet label for the warehouse scanner.
+
+    ``items`` is a list of ``(sku, qty)`` pairs, in the order they should
+    appear on the label. The first line is ``PALLET <pallet_id>``, followed by
+    one line per item of the form ``<item number> x<qty>`` where the item
+    number is the finance system's (ERP) identifier for that product.
+    """
+    lines = ["PALLET %s" % pallet_id]
+    for sku, qty in items:
+        lines.append("%s x%d" % (toErpSku(sku), qty))
+    return "\n".join(lines)
