+++ b/tests/test_add_line.py
@@ -0,0 +1,34 @@
+from shopkit.orders.models import Order, OrderLine
+
+
+def test_add_new_line():
+    order = Order("o1")
+    line = order.add_line("MUG", 2, 1000)
+    assert isinstance(line, OrderLine)
+    assert line is order.lines[0]
+    assert [(l.sku, l.qty, l.unit_cents) for l in order.lines] == [("MUG", 2, 1000)]
+    assert order.total_cents == 2000
+
+
+def test_same_sku_same_price_increases_quantity():
+    order = Order("o1", [OrderLine("MUG", 2, 1000)])
+    line = order.add_line("MUG", 3, 1000)
+    assert line is order.lines[0]
+    assert line.qty == 5
+    assert len(order.lines) == 1
+    assert order.total_cents == 5000
+
+
+def test_same_sku_different_price_adds_new_line():
+    order = Order("o1", [OrderLine("MUG", 2, 1000)])
+    line = order.add_line("MUG", 1, 900)
+    assert line is order.lines[1]
+    assert len(order.lines) == 2
+    assert [(l.sku, l.qty, l.unit_cents) for l in order.lines] == [("MUG", 2, 1000), ("MUG", 1, 900)]
+    assert order.total_cents == 2900
+
+
+def test_different_sku_adds_new_line():
+    order = Order("o1", [OrderLine("MUG", 1, 1000)])
+    order.add_line("CUP", 4, 500)
+    assert [(l.sku, l.qty, l.unit_cents) for l in order.lines] == [("MUG", 1, 1000), ("CUP", 4, 500)]
