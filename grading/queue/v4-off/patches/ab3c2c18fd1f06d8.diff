+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Total units moved per ISO week, keyed by the dashboard week label, oldest week first."""
+    per_week: dict[str, int] = {}
+    for t in transfers:
+        label = iso_week_label(t.at.date())
+        per_week[label] = per_week.get(label, 0) + t.qty
+    return dict(sorted(per_week.items(), key=lambda item: _iso_week_key(item[0])))
+
+
+def _iso_week_key(label: str) -> tuple[int, int]:
+    year, week = label.split("-W")
+    return int(year), int(week)
