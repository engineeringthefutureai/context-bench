--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,26 @@
+import re
+
+_PATTERN = re.compile(r"\s*(?:(\d+)h)?\s*(?:(\d+)m)?\s*$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string like "2h", "45m", "1h30m" into whole minutes."""
+    if not isinstance(text, str):
+        raise ValueError(f"expected str, got {type(text).__name__}")
+
+    if not text.strip():
+        raise ValueError("empty duration string")
+
+    match = _PATTERN.fullmatch(text)
+    if not match:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours = match.group(1)
+    minutes = match.group(2)
+
+    # At least one unit with a number must be present.
+    if hours is None and minutes is None:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    total = int(hours or 0) * 60 + int(minutes or 0)
+    return total
