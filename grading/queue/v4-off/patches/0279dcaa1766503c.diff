--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,35 @@
+"""Partner-facing status helpers: short explanations for why a webhook event is slow or missing.
+
+The hold logic here mirrors the fraud-review hold in the delivery worker (api.webhook_delivery):
+the worker holds back events about an order that is in fraud review until the review clears, and
+fails closed if it cannot tell. Cancellations and refunds are never held, so those events are
+never "in delay" for this reason."""
+from __future__ import annotations
+
+from shopkit.errors import ShopError
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Why the delivery worker would hold this event right now.
+
+    Returns a short reason when the webhook worker would hold the event back (the order is in
+    fraud review, or we cannot tell), and None when the worker would send it normally. `event` is
+    the event name (e.g. "order.paid"), `order_id` the order the event is about (events without an
+    order are never held), and `under_review(order_id)` says whether that order is in fraud review.
+    """
+    if not isinstance(event, str) or not event:
+        raise ShopError("an event name is required")
+    if event in ALWAYS_DELIVER:
+        return None                      # always delivered, whatever the review says
+    if not order_id:
+        return None                      # events without an order are never held back
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        # fail closed, same as the delivery worker: better late than shipped to a fraudster
+        return "the fraud-review lookup failed, so the event is held until the order can be checked"
+    if not reviewing:
+        return None
+    return "the order is in fraud review; the event is held until the review clears"
