+"""Cashier-side helpers for pop-up cash tills."""
+
+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+
+_VALID_PAID_BY = ("card", "cash")
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Amount the cashier asks the customer to pay, in cents.
+
+    Card payments are charged the exact total; cash payments are rounded
+    the way cash must be handled elsewhere in the shop (CAD to the nearest
+    5 cents; other currencies are unchanged).
+
+    Raises ValueError if ``paid_by`` is not ``"card"`` or ``"cash"``.
+    """
+    if paid_by not in _VALID_PAID_BY:
+        raise ValueError(f"paid_by must be one of {_VALID_PAID_BY}, got {paid_by!r}")
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    return total_cents
