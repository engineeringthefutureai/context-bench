--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,10 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order. Raises 409 if insufficient stock."""
+        current = self._on_hand.get(sku, 0)
+        if current < qty:
+            raise Conflict(f"only {current} of {sku} available", requested=qty, available=current)
+        self._on_hand[sku] = current - qty
