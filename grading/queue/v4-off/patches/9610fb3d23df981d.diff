--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,29 @@
+"""Parse compact human-readable durations ("1h30m") into whole minutes."""
+
+import re
+
+_DURATION_RE = re.compile(r"^\s*(?:(\d+)\s*h)?\s*(?:(\d+)\s*m)?\s*$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Return the duration described by *text* in whole minutes.
+
+    Accepts one or both of a hours and a minutes component, hours first
+    (e.g. ``"2h"``, ``"45m"``, ``"1h30m"`` or ``"1h 30m"``). Units are
+    case-insensitive and surrounding whitespace is ignored.
+
+    Raises ``ValueError`` for empty input, missing numbers, unknown units,
+    minutes before hours, negative or non-integer numbers.
+    """
+    match = _DURATION_RE.match(text)
+    if not match:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours_part, minutes_part = match.groups()
+    if hours_part is None and minutes_part is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    total = 0
+    if hours_part is not None:
+        total += int(hours_part) * 60
+    if minutes_part is not None:
+        total += int(minutes_part)
+    return total
