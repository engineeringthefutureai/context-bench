--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,64 @@
+"""Read-only preview of refund destinations.
+
+Support wants to tell a customer, before pressing Refund, where their money would go back to.
+This module mirrors the planning half of ``shopkit.payments.settlement.settle_refund`` (proportional split
+across the captured payments, card / store credit / gift card per destination) without executing
+anything: no provider calls, no ``refund()`` on payments, no journal entries.
+"""
+from __future__ import annotations
+
+from datetime import date, datetime, timezone
+
+from shopkit.payments.models import CAPTURED
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list,
+                        today: date | None = None) -> dict[str, int]:
+    """Where a refund of ``amount_cents`` for ``order_id`` would go, without refunding anything.
+
+    payments: list of Payment objects (see shopkit.payments.models); only the captured ones for
+    this order count. today: "now" for the card-age check, defaults to the current UTC date.
+    Returns {"card": int, "store_credit": int, "gift_card": int} in cents, summing to the refund
+    amount that the settlement would take on these payments.
+
+    Raises ValueError on a non-positive amount, when the order has no captured payment, or when
+    the amount exceeds what is still refundable (the same conditions settle_refund rejects on).
+    """
+    if amount_cents <= 0:
+        raise ValueError("refund amount must be positive")
+    if today is None:
+        today = datetime.now(timezone.utc).date()
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ValueError(f"order {order_id} has no captured payment")
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise ValueError(f"refund {amount_cents} exceeds refundable {refundable}")
+
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = []
+    for w in weights:
+        shares.append(amount_cents * w // total_weight)
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    out = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            out["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            out["store_credit"] += share
+        else:
+            out["card"] += share
+    return out
