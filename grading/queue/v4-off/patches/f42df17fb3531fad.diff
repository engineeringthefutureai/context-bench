+"""Cash-till helpers for pop-up stores.
+
+Defines how much a cashier should ask a customer to pay, taking into account
+how the payment is taken. Cash payments are rounded per the national cash
+rules (penny-withdrawal) convention, the same way the shop treats cash
+elsewhere; card payments are charged exactly.
+"""
+
+from shopkit.core import pricing as _pricing
+
+#: How the customer is paying the till.
+CARD = "card"
+CASH = "cash"
+
+
+def amount_due(total_cents, currency, paid_by):
+    """The amount the cashier asks the customer to pay, in cents.
+
+    Card payments pay the exact total. Cash payments are rounded per the
+    national cash rules (penny withdrawal) via
+    :func:`shopkit.core.pricing.cashRoundCents`, which applies only to
+    eligible currencies (e.g. CAD) and leaves others unchanged.
+
+    :param total_cents: the pre-payment total, in whole cents; may be
+        negative for refunds.
+    :param currency: ISO currency code, e.g. ``"CAD"`` or ``"USD"``.
+    :param paid_by: ``"card"`` or ``"cash"``.
+    :raises ValueError: if ``paid_by`` is not a recognised method.
+    """
+    if paid_by == CASH:
+        return _pricing.cashRoundCents(total_cents, currency)
+    if paid_by == CARD:
+        return total_cents
+    raise ValueError("paid_by must be 'card' or 'cash', got %r" % (paid_by,))
