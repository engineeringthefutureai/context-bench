+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Units moved per week, keyed by the ISO week label the dashboards use
+    (at's own date, no timezone conversion), in chronological order."""
+    totals: dict[str, int] = {}
+    for t in transfers:
+        week = iso_week_label(t.at.date())
+        totals[week] = totals.get(week, 0) + t.qty
+    return dict(sorted(totals.items()))
