+def _mask_card(payload):
+    """Redact card numbers before a delivery is queued: a top-level `card_number` field becomes the
+    redacted form used everywhere the shop stores or shows card numbers (payments.reconciliation
+    .redact_pan); all other fields go out unchanged."""
+    if isinstance(payload, dict) and "card_number" in payload:
+        masked = dict(payload)
+        masked["card_number"] = redact_pan(str(payload["card_number"]))
+        return masked
+    return payload
