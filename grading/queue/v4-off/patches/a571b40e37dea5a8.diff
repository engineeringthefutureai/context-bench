--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+import re
+
+_PATTERN = re.compile(r"^(?:(\d+)h)?\s*(?:(\d+)m)?$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string like "2h", "45m", "1h30m" into whole minutes."""
+    if not isinstance(text, str):
+        raise ValueError(f"expected a string, got {type(text).__name__}")
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("duration must not be empty")
+    match = _PATTERN.match(stripped)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours, minutes = match.groups()
+    if hours is None and minutes is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    total = int(hours) * 60 if hours is not None else 0
+    total += int(minutes) if minutes is not None else 0
+    return total
