--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,15 @@
+import re
+
+# Hours and/or minutes, hours before minutes, each unit at most once,
+# e.g. "2h", "45m", "1h30m" or "1h 30m".
+_DURATION_RE = re.compile(r"(?:(\d+)h)?\s*(?:(\d+)m)?")
+
+
+def parse_duration(text: str) -> int:
+    """Duration in whole minutes from "2h", "45m", "1h30m" or "1h 1h 30m " (case-insensitive)."""
+    match = _DURATION_RE.fullmatch(text.strip().lower())
+    if match is None or match.group(1) is None and match.group(2) is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1)) if match.group(1) is not None else 0
+    minutes = int(match.group(2)) if match.group(2) is not None else 0
+    return hours * 60 + minutes
