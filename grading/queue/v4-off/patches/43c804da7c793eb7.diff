+# -*- coding: utf-8 -*-
+#
+# Warehouse labels. The new pallet scanner reads the finance system's item numbers (not our SKUs),
+# so labels are printed with the ERP item number.
+#
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items):
+    """Label text for a pallet: first line 'PALLET <pallet_id>', then one line per item
+    '<item number> x<qty>' in the order given. The item number is the finance system's 12-character
+    item number for that SKU."""
+    lines = ["PALLET %s" % pallet_id]
+    for sku, qty in items:
+        lines.append("%s x%d" % (toErpSku(sku), int(qty)))
+    return "\n".join(lines)
