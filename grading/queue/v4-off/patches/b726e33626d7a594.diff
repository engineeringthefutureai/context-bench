--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+import re
+
+# Hours and/or minutes, hours first, each unit at most once, case-insensitive
+# units, optional whitespace around and between the parts.
+_DURATION_RE = re.compile(r"\s*(?:(\d+)\s*[hH])?\s*(?:(\d+)\s*[mM])?\s*")
+
+
+def parse_duration(text: str) -> int:
+    """Parse an hours/minutes string like "2h", "45m" or "1h 30m" into whole minutes.
+
+    Anything else (empty text, other units, a missing number, minutes before
+    hours, negative numbers) raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration: {text!r}")
+    match = _DURATION_RE.fullmatch(text)
+    if match is None or not any(match.groups()):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
