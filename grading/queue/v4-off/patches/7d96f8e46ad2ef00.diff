--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,30 @@
+"""Partner-facing explanation of why a webhook event about an order is being held.
+
+Mirrors the review hold in api.webhook_delivery.deliver_pending: an event is held back when it
+carries an order that is in fraud review (except the ALWAYS_DELIVER events), so partners can answer
+"why is order X late?" without reading the delivery logs."""
+from __future__ import annotations
+
+from collections.abc import Callable
+from typing import Optional
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: Optional[str], under_review: Callable[[str], bool]) -> Optional[str]:
+    """Short reason the webhook worker would hold `event` (about `order_id`) right now, or None when
+    it would send it normally. `under_review(order_id)` says whether the order is in fraud review."""
+    # Not an order event (or no order id): the worker never applies the review hold to it.
+    if not order_id:
+        return None
+    # Cancellations and refunds always go out (ALWAYS_DELIVER): partners must learn the order is off.
+    if event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        # Fail closed, matching deliver_pending: better a late event than one shipped to a fraudster.
+        reviewing = True
+    if reviewing:
+        return f"Order {order_id} is in fraud review; {event} is held until the review clears."
+    return None
