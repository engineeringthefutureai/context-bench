--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,14 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold ``qty`` units of ``sku`` for an in-progress order.
+
+        Lowers the available quantity by ``qty``. When there is not enough stock nothing is
+        changed and a :class:`Conflict` (HTTP 409) is raised carrying the requested and
+        available quantities so the API can include them in the error body."""
+        have = self.available(sku)
+        if have < qty:
+            raise Conflict("Not enough stock", requested=qty, available=have)
+        self._on_hand[sku] = have - qty
