@@ -0,0 +1,15 @@
+"""Pallet label content for the warehouse's pallet scanner.
+
+The scanner reads the finance item numbers (the ERP's 12-character codes), not shop SKUs, so each
+line is printed with the item number the finance system knows the product by."""
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Printable pallet label.
+
+    The first line is ``PALLET <pallet_id>``, then one line per item in the order given:
+    ``<item number> x<qty>``. The item number is the finance (ERP) item number for the SKU."""
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
