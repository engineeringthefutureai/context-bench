+"""Point-of-sale till amounts for pop-up stores.
+
+The till shows the cashier the amount to ask the customer for. Card payments
+are charged for the exact total; cash payments follow the national rules for
+cash amounts (in Canada the penny was withdrawn in 2013, so CAD cash totals
+are rounded to the nearest 5 cents -- see shopkit.core.pricing.cashRoundCents,
+which the shop already uses for cash everywhere else).
+"""
+
+from shopkit.core.pricing import cashRoundCents
+
+VALID_PAID_BY = ("card", "cash")
+
+
+def amount_due(total_cents, currency, paid_by):
+    """The amount, in cents, the cashier asks the customer to pay.
+
+    ``paid_by`` is "card" or "cash". Card payments pay the exact total; cash
+    payments are rounded to the nearest valid cash amount in that currency
+    (CAD cash rounds to 5-cent increments; other currencies have no rounding
+    rule and come back unchanged).
+    """
+    if paid_by not in VALID_PAID_BY:
+        raise ValueError(f"paid_by must be one of {VALID_PAID_BY}, got {paid_by!r}")
+    if paid_by == "card":
+        return int(total_cents)
+    return cashRoundCents(int(total_cents), currency)
