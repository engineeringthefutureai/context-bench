@@ -1,3 +1,6 @@
+from shopkit.errors import InsufficientStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,17 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order, lowering the available quantity.
+
+        Raises InsufficientStock (409) with the requested and available quantities when
+        there is not enough on hand; the stock is left unchanged in that case.
+        """
+        avail = self.available(sku)
+        if avail < qty:
+            raise InsufficientStock(
+                f"cannot reserve {qty} of {sku}: only {avail} available",
+                sku=sku, requested=qty, available=avail,
+            )
+        self._on_hand[sku] = avail - qty
