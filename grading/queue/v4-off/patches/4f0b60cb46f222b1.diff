--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,46 @@
+"""Turn the order references customers mention in a message into canonical links.
+
+The shop writes two kinds of reference: a storefront id (ord_<12 hex>, as produced by
+`shopkit.utils.ids.new_id`) and a sales order reference (SO-YYYY-NNNNNN, or SOB for phone/B2B
+orders). Customers type either however it is convenient to them, so this normalizes each one to
+the shop's spelling via the same `parseOrderRef`/`formatOrderRef` the lookup uses. Anything that
+isn't a valid order reference is ignored.
+"""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# The shapes a customer might type, matched in the message: a storefront id (case-insensitive hex)
+# or a sales order ref, whose separators may be dashes or spaces and whose B is optional. A ref is
+# a maximal run of [A-Za-z0-9_-], so the \b word boundaries stop us eating or being eaten by
+# adjacent words; each match is then validated and canonicalized by parseOrderRef, which is the
+# authoritative "is this a valid order reference" check (it also rejects years before 2017).
+_CANDIDATE_RE = re.compile(
+    r"\b(ord_[0-9a-f]{12}|SOB?(?:[-\s]\d{4})?(?:[-\s]\d{1,6}))\b", re.I)
+
+
+def order_refs(text: str) -> list[str]:
+    """The order references in `text`, in the order they first appear and without duplicates, each
+    written the way the shop writes that kind of reference (storefront id lowercase; sales order
+    as SO-YYYY-NNNNNN / SOB-YYYY-NNNNNN). Anything that is not a valid order reference is left out.
+
+    >>> order_refs("so 2019 123 and so 2019 123 again, also ORD_1A2B3C4D5E6F")
+    ['SO-2019-000123', 'ord_1a2b3c4d5e6f']
+    >>> order_refs("no references here")
+    []
+    """
+    if not text:
+        return []
+    out: list[str] = []
+    seen: set[str] = set()
+    for m in _CANDIDATE_RE.finditer(text):
+        parsed = parseOrderRef(m.group(1))
+        if parsed is None:
+            continue
+        canonical = formatOrderRef(*parsed)
+        if canonical not in seen:
+            seen.add(canonical)
+            out.append(canonical)
+    return out
