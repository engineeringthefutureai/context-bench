+import re
+
+# Exact conversion factors from pounds and ounces to grams.
+_LB_TO_G = 453.59237
+_OZ_TO_G = 28.349523125
+
+_WEIGHT_RE = re.compile(
+    r"^\s*([0-9]+(?:\.[0-9]+)?)\s*(g|kg|lb|oz)\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight typed in by warehouse staff into whole grams.
+
+    Accepts a number (integer or decimal using "."), optional whitespace,
+    then a unit (g, kg, lb or oz, case-insensitive). Returns the weight
+    rounded to the nearest gram. Raises ValueError for anything else,
+    including missing number/unit, negative values and "," as separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+
+    match = _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f"cannot parse weight from {text!r}")
+
+    number_text = match.group(1)
+    unit = match.group(2).lower()
+
+    value = float(number_text)
+    if value < 0:
+        raise ValueError(f"weight must be non-negative, got {text!r}")
+
+    if unit == "g":
+        grams = value
+    elif unit == "kg":
+        grams = value * 1000.0
+    elif unit == "lb":
+        grams = value * _LB_TO_G
+    else:  # oz
+        grams = value * _OZ_TO_G
+
+    return int(round(grams))
