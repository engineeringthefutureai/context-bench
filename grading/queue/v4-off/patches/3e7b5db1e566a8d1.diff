--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,16 @@
+import re
+
+_DURATION_RE = re.compile(r"\s*(?:(\d+)\s*h)?\s*(?:(\d+)\s*m)?\s*", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes from an hours/minutes string like "2h", "45m" or "1h30m"."""
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    match = _DURATION_RE.fullmatch(text)
+    if not match:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours_s, minutes_s = match.groups()
+    if hours_s is None and minutes_s is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    return int(hours_s or 0) * 60 + int(minutes_s or 0)
