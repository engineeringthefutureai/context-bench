--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,32 @@
+"""Weight parsing for the warehouse floor. Staff type weights as "1.5 kg", "2 lb" etc.; this
+turns that into the whole grams the rest of the shipping code works in."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact conversion factors to grams (1 kg = 1000 g; 1 lb and 1 oz by international definition)
+_G_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+_WEIGHT_RE = re.compile(r"\A\s*(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)\s*\Z", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams, e.g. "1.2 kg" -> 1200, "1 lb" -> 454, "2.5 OZ" -> 71.
+
+    The number is an integer or a decimal with "." as separator ("," is rejected),
+    the unit is g, kg, lb or oz, case-insensitive, and surrounding whitespace is
+    ignored. Rounds to the nearest gram. Raises ValueError for anything else:
+    a missing or negative number, a missing or unknown unit, extra characters.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+    match = _WEIGHT_RE.match(text)
+    if not match:
+        raise ValueError(f"unrecognised weight: {text!r}")
+    number, unit = match.groups()
+    grams = Decimal(number) * _G_PER_UNIT[unit.lower()]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
