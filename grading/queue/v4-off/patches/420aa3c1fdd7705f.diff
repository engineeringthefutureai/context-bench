+_TRANSFER_REF_RE = re.compile(r"^[A-HJ-KM-NP-Z2-9]{4}-[A-HJ-KM-NP-Z2-9]{4}-[A-HJ-KM-NP-Z2-9]{4}$")
+
+
+def transfer_reference() -> str:
+    """Payment reference for bank transfers: e.g. "K7QM-X2PA-9RBC".
+
+    Three dash-separated groups of four from the shop's unambiguous customer-facing
+    alphabet (no 0/O, 1/I/L): customers type these into banking apps from printed
+    invoices or from the phone, so they must be impossible to mistype into
+    something that looks valid.
+    """
+    ref = short_code(12, groups=4)
+    if not _TRANSFER_REF_RE.fullmatch(ref):
+        raise ShopError("malformed transfer reference")
+    return ref
 
 
