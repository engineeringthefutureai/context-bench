--- /dev/null
+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,12 @@
+"""Pallet labels for the warehouse pallet scanner, which reads the finance system's item
+numbers rather than our SKUs."""
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items) -> str:
+    """Label text for a pallet: 'PALLET <pallet_id>' then one '<item number> x<qty>' line per
+    item, in the order given, where the item number is the one the finance (ERP) system knows
+    the product by (raises ValueError for a SKU it can't encode)."""
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
