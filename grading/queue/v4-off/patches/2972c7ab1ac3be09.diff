--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,29 @@
+"""Duration parsing shared by SLAs, holds and shipping estimates.
+
+Durations are written as hours and/or minutes, hours first, each unit at most
+once, e.g. "2h", "45m", "1h30m". They are stored and compared as whole minutes.
+"""
+import re
+
+# "2h", "45m", "1h30m", "1h 30m" -- hours before minutes, at most once each.
+_DURATION_RE = re.compile(
+    r"\A\s*(?:(?P<hours>\d+)h)?\s*(?:(?P<minutes>\d+)m)?\s*\Z",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Duration in whole minutes.
+
+    Accepts hours and/or minutes with hours first, each unit at most once,
+    case-insensitive, surrounding whitespace ignored: "2h" -> 120, "45m" -> 45,
+    "1h30m" / "1h 30m" -> 90. Empty text, other units, a missing number,
+    minutes before hours or negative numbers raise ValueError."""
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string: {text!r}")
+    match = _DURATION_RE.match(text)
+    if not match or match.group("hours") is None and match.group("minutes") is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group("hours")) if match.group("hours") is not None else 0
+    minutes = int(match.group("minutes")) if match.group("minutes") is not None else 0
+    return hours * 60 + minutes
