+def transfers_by_week(transfers) -> dict[str, int]:
+    """Total units moved per ISO week, e.g. {"2026-W47": 120, ...}.
+
+    Keys use the same week labels as the other dashboards and are in
+    chronological order (ISO week labels sort lexicographically).
+    """
+    week_keys: dict[str, int] = {}
+    week_order: list[str] = []
+    for t in transfers:
+        week = iso_week_label(t.at.date())
+        if week not in week_keys:
+            week_keys[week] = 0
+            week_order.append(week)
+        week_keys[week] += t.qty
+    return {week: week_keys[week] for week in sorted(week_order)}
