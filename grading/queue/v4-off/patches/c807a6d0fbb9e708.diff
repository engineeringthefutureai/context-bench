+# -*- coding: utf-8 -*-
+#
+# Point of sale till: the amount a cashier asks the customer to pay.
+#
+from shopkit.core.pricing import cashRoundCents
+
+_PAID_BY = ("card", "cash")
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """The amount the cashier asks the customer to pay, in cents.
+
+    ``paid_by`` is "card" or "cash". Card payments pay the exact total; cash
+    payments follow the national rules for cash amounts (e.g. Canada's
+    penny withdrawal: CAD cash is rounded to the nearest 5 cents), the same
+    way the shop already rounds cash in ``shopkit.core.pricing``.
+    """
+    if paid_by not in _PAID_BY:
+        raise ValueError("paid_by must be 'card' or 'cash'")
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    return int(total_cents)
