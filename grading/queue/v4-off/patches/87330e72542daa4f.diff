--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,24 @@
+"""Duration helpers shared by shipping windows, SLAs and scheduled jobs."""
+import re
+
+# Hours before minutes, each unit at most once, optional whitespace between them.
+# Digits only, so negatives and unit-less text can't sneak through.
+_DURATION_RE = re.compile(r"^(?:(\d+)h(?:\s*)(\d+m)?|(?:(\d+)m))$", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes for a human duration: "2h" -> 120, "45m" -> 45, "1h30m"/"1h 30m" -> 90.
+    Hours precede minutes, each unit at most once, units are case-insensitive and surrounding
+    whitespace is ignored. Anything else (empty text, other units, a missing number, minutes
+    before hours, negatives) raises ValueError."""
+    m = _DURATION_RE.match(text.strip())
+    if not m:
+        raise ValueError(f"invalid duration: {text!r}")
+    if m.lastindex is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours_part, minutes_part, minutes_only = m.groups()
+    if hours_part is not None:
+        hours = int(hours_part)
+        extra = int(minutes_part[:-1]) if minutes_part else 0
+        return hours * 60 + extra
+    return int(minutes_only)
