+"""Point-of-sale helpers for cash and card tills.
+
+The core rounding rule for cash payments is shared with the rest of the shop via
+``shopkit.core.pricing.cashRoundCents`` so that tills and other cash handling
+never drift apart.
+"""
+
+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+
+__all__ = ["amount_due"]
+
+_VALID_PAYED_BY = ("card", "cash")
+
+
+def amount_due(total_cents, currency, paid_by):
+    """Return the amount (in whole cents) the cashier asks the customer to pay.
+
+    ``total_cents`` is the order total in the smallest unit of ``currency``.
+    ``paid_by`` is ``"card"`` or ``"cash"``:
+      * card  -> the exact total, no rounding
+      * cash  -> rounded per the national cash rules (CAD: to the nearest
+        5 cents; other currencies unchanged), the same way the shop treats
+        cash everywhere else.
+
+    Raises ``ValueError`` if ``paid_by`` is not a recognised method, or if
+    ``total_cents`` is missing/empty.
+    """
+    if total_cents is None or str(total_cents) == "":
+        raise ValueError("total_cents is required")
+
+    method = str(paid_by or "").strip().lower()
+    if method not in _VALID_PAYED_BY:
+        raise ValueError(
+            "paid_by must be 'card' or 'cash' (got %r)" % (paid_by,)
+        )
+
+    cents = int(total_cents)
+    if method == "cash":
+        return cashRoundCents(cents, currency)
+    return cents
