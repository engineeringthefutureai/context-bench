+"""Pallet labels for the pallet scanner.
+
+The scanner reads the finance ERP's item numbers, not shop SKUs, so the label
+prints each item's ERP item number (shopkit.core.erp.toErpSku)."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items):
+    """Label text for a pallet: the first line 'PALLET <pallet_id>', then one line
+    '<item number> x<qty>' per item, in the order given, where the item number is
+    the ERP item number the finance system knows the product by.
+
+    items: list of (sku, qty) tuples."""
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
