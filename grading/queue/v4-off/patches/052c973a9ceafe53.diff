+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per ISO week, keyed by the dashboards' week labels (e.g. "2026-W47"),
+    in chronological order."""
+    totals: dict[str, int] = {}
+    for t in transfers:
+        key = iso_week_label(t.at.date())
+        totals[key] = totals.get(key, 0) + t.qty
+    return dict(sorted(totals.items()))
