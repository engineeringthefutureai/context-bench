--- a/shopkit/orders/models.py
+++ b/shopkit/orders/models.py
@@ -21,3 +21,18 @@
     @property
     def total_cents(self) -> int:
         return sum(line.total_cents for line in self.lines)
+
+    def add_line(self, sku: str, qty: int, unit_cents: int) -> OrderLine:
+        """Add a product line to the order.
+
+        If a line with the same SKU and same unit price already exists,
+        its quantity is increased; otherwise a new line is appended.
+        Returns the line that was touched.
+        """
+        for line in self.lines:
+            if line.sku == sku and line.unit_cents == unit_cents:
+                line.qty += qty
+                return line
+        line = OrderLine(sku=sku, qty=qty, unit_cents=unit_cents)
+        self.lines.append(line)
+        return line
--- /dev/null
+++ b/tests/test_orders.py
@@ -0,0 +1,32 @@
+from shopkit.orders.models import Order
+
+
+def test_merge_same_sku_and_unit_price():
+    order = Order(id="o1")
+    line = order.add_line("A", 1, 1000)
+    assert line is order.lines[0]
+
+    again = order.add_line("A", 2, 1000)
+    assert again is line  # same line touched
+    assert len(order.lines) == 1
+    assert line.qty == 3
+    assert line.unit_cents == 1000
+    assert order.total_cents == 3000
+
+
+def test_append_new_line():
+    order = Order(id="o1")
+    order.add_line("A", 1, 1000)
+    line = order.add_line("B", 1, 500)
+    assert len(order.lines) == 2
+    assert line is order.lines[1]
+
+
+def test_same_sku_different_price_is_new_line():
+    order = Order(id="o1")
+    order.add_line("A", 1, 1000)
+    line = order.add_line("A", 2, 900)
+    assert len(order.lines) == 2
+    assert line.sku == "A"
+    assert line.qty == 2
+    assert line.unit_cents == 900
