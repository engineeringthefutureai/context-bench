--- /dev/null
+++ b/tests/test_newsletter.py
@@ -0,0 +1,28 @@
+from shopkit.customers.models import Customer
+from shopkit.marketing.newsletter import batches, recipients
+
+
+def _customer(cid, email, opt_in):
+    return Customer(id=cid, email=email, name=cid, marketing_opt_in=opt_in)
+
+
+def test_recipients_skips_invalid_emails():
+    customers = [
+        _customer("c1", "alice@example.com", True),
+        _customer("c2", "bob.example", True),          # no @
+        _customer("c3", "carol@example", True),        # no dotted domain
+        _customer("c4", "dave@@example.com", True),    # double @
+        _customer("c5", "erin@example.com", False),    # opted out
+    ]
+    assert [c.id for c in recipients(customers)] == ["c1"]
+
+
+def test_recipients_requires_opt_in_and_valid_email():
+    assert recipients([_customer("c1", "alice@example.com", False)]) == []
+    assert recipients([_customer("c1", "a b@example.com", True)]) == []
+
+
+def test_batches_only_contains_valid_recipients():
+    customers = [_customer("c1", "alice@example.com", True),
+                 _customer("c2", "bob.example", True)]
+    assert batches(customers) == [["alice@example.com"]]
