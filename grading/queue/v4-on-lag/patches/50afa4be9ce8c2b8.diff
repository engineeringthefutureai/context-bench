+
+
+def test_card_number_is_masked_in_delivery():
+    bodies = []
+    transport = lambda url, body, headers: (bodies.append(body), 200)[1]
+    bus = EventBus()
+    d = WebhookDispatcher([Endpoint("https://partner/pay", "k", {"payment.*"})], transport)
+    d.attach(bus)
+    bus.publish("payment.captured", order_id="o1", card_number="4242 4242 4242 4242",
+                amount_cents=1099)
+    d.flush()
+    assert d.queue == []
+    data = json.loads(bodies[0])["data"]
+    assert data["card_number"] == "************4242"
+    assert data["order_id"] == "o1" and data["amount_cents"] == 1099
