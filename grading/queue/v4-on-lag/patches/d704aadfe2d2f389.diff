+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,87 @@
+"""Read-only preview of refund destinations: before an agent presses Refund, show where each
+cent of a refund would land ("card", "store_credit", "gift_card").
+
+The split must match payments.settlement.settle_refund() exactly, so this module runs settle_refund()
+itself against stand-in provider/journal/gift-card services and a throwaway ledger: no real
+provider is called, no payment is marked refunded, no ledger entry is written. If the amount
+would be rejected at settlement time (nothing captured, more than refundable, or card
+refunds paused) the same error is raised here as well."""
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass, field, replace
+from datetime import date
+
+from shopkit.accounting.journal import Journal
+from shopkit.config import SETTINGS
+from shopkit.events import EventBus
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.settlement import (RefundRequest, RefundTooLarge,
+                                         SettlementLedger, settle_refund)
+
+
+@dataclass
+class _FakeProvider:
+    """Stands in for the payment provider so settle_refund can run to completion.
+
+    Only reachable for card destinations, which never fail here; the recorded calls are
+    discarded and never replayed, so no real refund is ever issued."""
+    calls: list[tuple[str, int, str]] = field(default_factory=list)
+
+    def refund(self, payment_id: str, amount_cents: int, idempotency_key: str) -> str:
+        self.calls.append((payment_id, amount_cents, idempotency_key))
+        return f"preview:{idempotency_key}"
+
+
+@dataclass
+class _RecordingGiftCards:
+    """Stand-in gift card service that records the amount a new gift card would carry.
+
+    settlement's "no gift card service" fallback (store credit instead) must never fire, so
+    one is always passed; `issued_cents` must equal the settlement's gift card cents or the
+    preview would silently disagree with what settlement does."""
+    issued_cents: int = 0
+
+    def issue(self, amount_cents: int, customer_id: str) -> str:
+        self.issued_cents += amount_cents
+        return f"GC-PREVIEW-{amount_cents}"
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: Iterable[Payment],
+                        today: date) -> dict[str, int]:
+    """How a refund of `amount_cents` for `order_id` would be split across destinations.
+
+    Returns {"card": int, "store_credit": int, "gift_card": int} summing to
+    `amount_cents`, computed exactly the way settle_refund() would settle it (proportional
+    to what is still refundable on each captured payment, cards first, same 180-day
+    card/store-credit rule). Nothing is refunded: no provider is called, no payment is
+    marked refunded, no ledger entry is written."""
+    payments = list(payments)
+    refundable = sum(p.refundable_cents for p in payments
+                     if p.order_id == order_id and p.status == CAPTURED)
+    if amount_cents <= 0:
+        raise RefundTooLarge(f"refund {amount_cents} must be positive", order_id=order_id,
+                             requested=amount_cents, refundable=0)
+    if not any(p.order_id == order_id and p.status == CAPTURED for p in payments):
+        raise RefundTooLarge(f"order {order_id} has no captured payment", order_id=order_id,
+                             requested=amount_cents, refundable=0)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}", order_id=order_id,
+                             requested=amount_cents, refundable=refundable)
+
+    # settle_refund() books journal lines per goods/tax/shipping; the Journal below is fresh and
+    # thrown away, so the whole amount as goods is enough for the destination split.
+    req = RefundRequest(order_id, amount_cents, 0, 0, "preview", "support:preview")
+    provider = _FakeProvider()
+    gift_cards = _RecordingGiftCards()
+    # settle_refund() books the refund against each payment it settles, which mutates the
+    # Payment's refunded_cents. Hand it copies so the caller's payments stay exactly as they were.
+    copies = [replace(p) for p in payments]
+    settlement = settle_refund(req, copies, customer_id="preview", today=today,
+                               provider=provider, journal=Journal(),
+                               ledger=SettlementLedger(), gift_cards=gift_cards,
+                               settings=SETTINGS, bus=EventBus(), sleep=lambda s: None)
+    if gift_cards.issued_cents != settlement.to_gift_card_cents:
+        raise RuntimeError("gift card preview inconsistent with settlement", order_id=order_id)
+    return {"card": settlement.to_card_cents, "store_credit": settlement.to_store_credit_cents,
+            "gift_card": settlement.to_gift_card_cents}
