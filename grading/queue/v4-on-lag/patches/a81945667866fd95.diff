--- a/tests/test_returns.py
+++ b/tests/test_returns.py
@@ -2,6 +2,7 @@
 
 import pytest
 
+from shopkit.config import Settings, load_settings
 from shopkit.orders.models import Order, OrderLine
 from shopkit.orders.returns import InvalidReturn, ReturnNotAllowed, open_return
 
@@ -24,3 +25,20 @@
         open_return(ORDER, date(2026, 9, 1), {"A": 1}, "damaged", today=date(2026, 11, 10))
     with pytest.raises(InvalidReturn):
         open_return(ORDER, date(2026, 11, 1), {"A": 3}, "damaged", today=date(2026, 11, 2))
+
+
+def test_return_window_is_a_deployment_setting():
+    # default window is 30 days
+    assert open_return(ORDER, date(2026, 11, 1), {"A": 1}, "damaged", today=date(2026, 12, 1)).approved
+    with pytest.raises(ReturnNotAllowed):
+        open_return(ORDER, date(2026, 11, 1), {"A": 1}, "damaged", today=date(2026, 12, 2))
+    # a deployment with a 7-day window accepts within the shorter window and rejects after it
+    s7 = Settings(return_window_days=7)
+    assert open_return(ORDER, date(2026, 11, 1), {"A": 1}, "damaged", today=date(2026, 11, 8), settings=s7).approved
+    with pytest.raises(ReturnNotAllowed):
+        open_return(ORDER, date(2026, 11, 1), {"A": 1}, "damaged", today=date(2026, 11, 15), settings=s7)
+
+
+def test_return_window_from_env():
+    assert load_settings({}).return_window_days == 30
+    assert load_settings({"SHOPKIT_RETURN_DAYS": "14"}).return_window_days == 14
