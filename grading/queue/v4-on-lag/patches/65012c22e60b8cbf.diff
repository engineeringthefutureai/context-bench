--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,39 @@
+"""Answer partner questions like "why did that event arrive late?".
+
+explain_delay() mirrors the webhook worker's hold decision (see deliver_pending in
+webhook_delivery.py) so we can tell a partner exactly why an event for an order
+will be held back right now, or that it goes out normally.
+"""
+from __future__ import annotations
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+HOLD_REVIEW = "order is in fraud review; delivery is held until the review clears"
+HOLD_REVIEW_LOOKUP = "fraud review lookup failed; holding to avoid shipping (fail closed)"
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Why the webhook worker would hold this event back *right now*.
+
+    Returns a short reason (non-empty string) when the delivery is held, and None
+    when the event would be sent normally.
+
+    `event` is the webhook event name (e.g. "order.paid"). `order_id` is the order the
+    event is about, or None if it isn't an order event. `under_review(order_id)` tells
+    whether the order is in fraud review (fraud.scoring.ReviewQueue.under_review).
+    """
+    # No order behind the event -> the review hold never applies, it ships normally.
+    if not order_id:
+        return None
+    # Cancellations and refunds go out regardless of a review (partners must learn the
+    # order is off): see ALWAYS_DELIVER in webhook_delivery.py.
+    if event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        # Fail closed, matching the worker: if we can't tell, better late than shipped.
+        return HOLD_REVIEW_LOOKUP
+    if reviewing:
+        return HOLD_REVIEW
+    return None
