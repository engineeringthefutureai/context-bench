@@ -0,0 +1,14 @@
+"""Pallet labels for the warehouse scanner.
+
+The scanner reads the finance ERP's item numbers, not our SKUs, so every item line
+is printed with the ERP form (core.erp.toErpSku)."""
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Label text for a pallet: 'PALLET <pallet_id>' on the first line, then one
+    '<item number> x<qty>' line per (sku, qty) in the given order. The item number
+    is the finance ERP's form of the shop SKU."""
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
