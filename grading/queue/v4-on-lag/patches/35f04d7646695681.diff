--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,30 @@
+"""Delivery options offered at checkout.
+
+Checkout may only advertise a service the warehouse will actually honour. These helpers mirror the
+allocation rules in :mod:`shopkit.warehouse.waves` so the service the storefront offers is the one
+the order really lands in (rather than being silently downgraded after payment).
+"""
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: Iterable[str], sites: list[Site],
+                      hazmat_skus: frozenset[str] = frozenset()) -> bool:
+    """Whether the warehouse would put an order with these SKUs into an express wave.
+
+    ``skus`` are the cart's SKUs (an iterable of SKU codes, or a ``{sku: qty}`` mapping whose keys
+    are the SKUs), ``sites`` the warehouse sites that could ship the order, and ``hazmat_skus`` the
+    SKUs classed as dangerous goods.
+
+    Mirrors :func:`shopkit.warehouse.waves.allocate_wave` for the express case: the order must be
+    shippable at all (at least one site can ship it, and it has lines) and it must contain no hazmat
+    SKU -- hazmat is ground-only, so an order with any hazmat SKU is downgraded to a standard wave
+    and never ships by express.
+    """
+    skus = list(skus)
+    if not skus or not sites:
+        return False
+    return not any(sku in hazmat_skus for sku in skus)
