+def mask_card_number(card_number) -> str:
+    """redact_pan for a value that may already be masked. A full card number is redacted exactly
+    like everywhere else it is stored or shown; a value that is already masked (contains '*') is
+    returned untouched, so redacting is idempotent."""
+    if not isinstance(card_number, str) or not card_number:
+        return card_number
+    if "*" in card_number:
+        return card_number
+    return redact_pan(card_number)
+
+
+def redact_payment_payload(payload: dict) -> dict:
+    """Copy of `payload` with the `card_number` field masked (redact_pan); all other fields unchanged.
+    Used before a webhook delivery is queued/sent so partners never receive a full card number."""
+    masked = dict(payload)
+    if "card_number" in masked:
+        masked["card_number"] = mask_card_number(masked["card_number"])
+    return masked
 
 
