@@ -0,0 +1,17 @@
+from shopkit.payments.gateway import transfer_reference
+from shopkit.utils.ids import is_short_code
+
+
+def test_transfer_reference_format():
+    ref = transfer_reference()
+    assert len(ref) == 14 and ref[4] == "-" and ref[8] == "-"
+    assert is_short_code(ref)
+
+
+def test_transfer_reference_unambiguous_and_unique():
+    refs = {transfer_reference() for _ in range(100)}
+    assert len(refs) == 100
+    for ref in refs:
+        for group in ref.split("-"):
+            assert len(group) == 4
+            assert all(c not in "01ILO" for c in group)
