+
+def test_label_text_omits_weight_line_when_not_given():
+    to = Address("Ann Lee", "1 Main St", "Austin", "78701", "US", region="TX")
+    text = label_text(Parcel("o1", 1, [("ab-1", 2)]), to, parcels_total=2)
+    assert "Weight:" not in text
+
+
+def test_label_text_weight_line_for_us_address_is_pounds():
+    to = Address("Ann Lee", "1 Main St", "Austin", "78701", "US", region="TX")
+    text = label_text(Parcel("o1", 1, [("ab-1", 2)]), to, parcels_total=2, weight_g=1500)
+    lines = text.splitlines()
+    weight_line = lines.index("Weight: 3.31 lb")
+    assert lines[weight_line - 1].startswith("Order o1  parcel 1/2")
+    assert lines[weight_line + 1] == "AB1 x2"
+
+
+def test_label_text_weight_line_other_countries_keep_kilograms():
+    to = Address("Bob Stone", "1 High St", "London", "SW1A 1AA", "GB")
+    text = label_text(Parcel("o2", 3, [("ab-1", 1)]), to, parcels_total=4, weight_g=1500)
+    lines = text.splitlines()
+    weight_line = lines.index("Weight: 1.5 kg")
+    assert lines[weight_line - 1].startswith("Order o2  parcel 3/4")
+    assert lines[weight_line + 1] == "AB1 x1"
