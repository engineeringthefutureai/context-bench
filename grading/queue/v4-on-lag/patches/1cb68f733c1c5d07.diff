--- /dev/null
+++ b/tests/test_newsletter.py
@@ -0,0 +1,24 @@
+from shopkit.customers.models import Customer
+from shopkit.marketing.newsletter import batches, recipients
+
+
+def _c(cid, email, opt_in=True):
+    return Customer(cid, email, f"{cid}", marketing_opt_in=opt_in)
+
+
+def test_recipients_skip_badly_typed_addresses():
+    # opted in but the address fails the signup/checkout check -> skipped
+    customers = [
+        _c("C1", "alice@example.com"),
+        _c("C2", "bob at example.com"),    # spaces / no @
+        _c("C3", "carol@example"),         # no dotted domain
+        _c("C4", "d..e@example.com"),      # ".."
+        _c("C5", "   "),                   # whitespace
+        _c("C6", "frank@example.com", opt_in=False),  # opted out
+    ]
+    assert [c.id for c in recipients(customers)] == ["C1"]
+
+
+def test_batches_only_contain_valid_opted_in_addresses():
+    customers = [_c("C1", "alice@example.com"), _c("C2", "bob at example.com")]
+    assert batches(customers) == [["alice@example.com"]]
