--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class InsufficientStock(Conflict):
+    """A reservation exceeds the on-hand quantity; nothing is reserved."""
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,11 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold qty units of sku for an order. Fails without side effects if not enough is on hand."""
+        available = self.available(sku)
+        if qty > available:
+            raise InsufficientStock(f"cannot reserve {qty} x {sku}: only {available} in stock",
+                                     sku=sku, requested=qty, available=available)
+        self._on_hand[sku] = available - qty
