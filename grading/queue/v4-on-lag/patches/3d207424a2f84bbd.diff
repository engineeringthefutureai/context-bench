+def by_email(customers: list[Customer]) -> dict[str, Customer]:
+    """Email address (trimmed, lowercased) -> customer, for the marketing CRM sync.
+
+    Built with index_by like the shop's other lookup tables, so a repeated
+    normalized email raises ValueError instead of silently picking one customer.
+    """
+    return index_by(customers, key=lambda c: c.email.strip().lower())
