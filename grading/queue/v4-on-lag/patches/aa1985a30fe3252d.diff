+++ b/tests/test_stock.py
@@ -0,0 +1,46 @@
+import pytest
+
+from shopkit.api.handlers import handle
+from shopkit.inventory.stock import NotEnoughStock, Stock
+
+
+def stock():
+    s = Stock()
+    s.receive("MILK", 10)
+    return s
+
+
+def test_reserve_lowers_available():
+    s = stock()
+    s.reserve("MILK", 4)
+    assert s.available("MILK") == 6
+
+
+def test_reserve_all_of_stock():
+    s = stock()
+    s.reserve("MILK", 10)
+    assert s.available("MILK") == 0
+
+
+def test_reserve_too_much_changes_nothing():
+    s = stock()
+    with pytest.raises(NotEnoughStock) as e:
+        s.reserve("MILK", 11)
+    assert e.value.details == {"sku": "MILK", "requested": 11, "available": 10}
+    assert s.available("MILK") == 10
+
+
+def test_reserve_unknown_sku_fails():
+    s = stock()
+    with pytest.raises(NotEnoughStock) as e:
+        s.reserve("SODA", 1)
+    assert e.value.details == {"sku": "SODA", "requested": 1, "available": 0}
+    assert s.available("SODA") == 0
+
+
+def test_api_responds_conflict_with_quantities():
+    s = stock()
+    status, body = handle(s.reserve, "MILK", 11)
+    assert status == 409
+    assert body["requested"] == 11
+    assert body["available"] == 10
