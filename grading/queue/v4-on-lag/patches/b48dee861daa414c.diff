+"""Cash till: the amount the cashier asks the customer to pay at the register.
+
+Card payments are charged the exact total; cash payments follow the national
+rules for cash amounts. Those rules live in `shopkit.core.pricing.cashRoundCents`
+(penny withdrawn in Canada, 2013: CAD cash is rounded to the nearest 5 cents) and
+are the same rule the shop already applies to cash elsewhere, so they are reused
+here rather than reimplemented."""
+from shopkit.core.pricing import cashRoundCents
+
+CARD, CASH = "card", "cash"
+_METHODS = (CARD, CASH)
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """The amount, in cents, the cashier asks the customer to pay.
+
+    `paid_by` is "card" or "cash". Card pays the exact `total_cents`. Cash pays
+    the total rounded to the nearest legal-tender increment for the currency,
+    following the shop's national cash rules: CAD is rounded to the nearest 5
+    cents (penny withdrawn, 2013), other currencies are unchanged."""
+    if paid_by not in _METHODS:
+        raise ValueError(f"paid_by must be one of {_METHODS}, got {paid_by!r}")
+    if paid_by == CASH:
+        return cashRoundCents(total_cents, currency)
+    return total_cents
