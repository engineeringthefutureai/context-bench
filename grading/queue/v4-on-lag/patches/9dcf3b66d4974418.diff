+from shopkit.utils.units import parse_weight
+
+# (input, expected)  -- expected None means expect ValueError
+cases = [
+    ("500 g", 500),
+    ("500g", 500),
+    ("  2.5 KG ", 2500),
+    ("1 lb", 454),          # 453.59237 -> 454
+    ("1 LB", 454),
+    ("0.9994 lb", 453),     # 453.351... -> 453
+    ("1oz", 28),            # 28.349523125 -> 28
+    ("16 oz", 454),         # 453.59237000 -> 454
+    ("0.5 oz", 14),         # 14.1747615625 -> 14
+    (".5 kg", 500),
+    ("0.45359237 kg", 454), # 453.59237 -> 454
+    ("10", None),           # missing unit
+    ("12.345 g", 12),
+    ("100.5 g", 101),       # round half up
+    ("2 lb", 907),          # 907.18474 -> 907
+    ("0 g", 0),
+    ("0.499 g", 0),         # -> 0
+    ("0.5 g", 1),           # half up -> 1
+    ("-5 g", None),
+    ("5,000 g", None),
+    ("5,0 g", None),
+    ("kg", None),           # missing number
+    ("", None),
+    ("   ", None),
+    ("5 stone", None),
+    ("5.2.3 g", None),
+    ("5. g", None),
+    (". g", None),
+    ("+5 g", None),
+    ("5 g extra", None),
+    ("5 kg 6 g", None),
+    ("5gb", None),
+    ("5g6", None),
+    ("5.5.", None),
+]
+
+results = []
+for text, expected in cases:
+    try:
+        got = parse_weight(text)
+    except ValueError:
+        got = "ValueError"
+    ok = (got == expected) or (expected is None and got == "ValueError")
+    results.append(("PASS" if ok else "FAIL", text, got, expected))
+
+fails = [r for r in results if r[0] == "FAIL"]
+print(f"total={len(results)} pass={len(results)-len(fails)} fail={len(fails)}")
+for status, text, got, expected in results:
+    print(f"{status}: parse_weight({text!r}) = {got!r} (expected {expected!r})")
