+def export_orders_csv(orders: list[Order]) -> str:
+    """Finance export: one row per order line with normalized product codes.
+
+    Line totals are formatted exactly like customer invoices (e.g. "$1,234.56").
+    """
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for order in orders:
+        for line in order.lines:
+            writer.writerow(
+                [
+                    order.id,
+                    normalize_sku(line.sku),
+                    line.qty,
+                    format_money(line.total_cents, order.currency),
+                ]
+            )
+    return buf.getvalue()
