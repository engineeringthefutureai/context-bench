--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,27 @@
+"""Parsing of simple duration strings such as "2h", "45m", or "1h30m"."""
+
+import re
+
+_DURATION_RE = re.compile(
+    r"^\s*(?:(\d+)h)?\s*(?:(\d+)m)?\s*$",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Return a duration in whole minutes.
+
+    Accepts hours and/or minutes, e.g. "2h", "45m", "1h30m" or "1h 30m".
+    Hours come before minutes, each unit appears at most once,
+    units are case-insensitive, and surrounding whitespace is ignored.
+
+    Raises:
+        ValueError: if the text is not a valid duration.
+    """
+    match = _DURATION_RE.match(text)
+    if match is None:
+        raise ValueError(f"Invalid duration: {text!r}")
+    hours, minutes = match.group(1), match.group(2)
+    if hours is None and minutes is None:
+        raise ValueError(f"Invalid duration: {text!r}")
+    return int(hours or 0) * 60 + int(minutes or 0)
