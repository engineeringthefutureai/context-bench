+def transfers_by_week(transfers) -> dict[str, int]:
+    """Total units moved per week (the same "YYYY-Wnn" label the dashboards use), in
+    chronological order. Weeks without transfers are absent, not zero."""
+    weeks: dict[str, int] = {}
+    for t in transfers:
+        label = iso_week_label(t.at.date())
+        weeks[label] = weeks.get(label, 0) + t.qty
+    return dict(sorted(weeks.items()))
