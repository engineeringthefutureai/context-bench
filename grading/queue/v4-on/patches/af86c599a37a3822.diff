+def _redact_payload(data: object) -> object:
+    """Copy of an event payload with any card_number field masked the way the shop stores and
+    shows card numbers (see payments.reconciliation.redact_pan); every other field passes through
+    unchanged. The original payload is never modified."""
+    if isinstance(data, dict):
+        redacted = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, (str, int)):
+                redacted[key] = redact_pan(str(value))
+            else:
+                redacted[key] = _redact_payload(value)
+        return redacted
+    if isinstance(data, (list, tuple)):
+        return [_redact_payload(item) for item in data]
+    return data
+
