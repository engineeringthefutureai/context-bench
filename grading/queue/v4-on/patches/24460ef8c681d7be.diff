+"""Point-of-sale till rules."""
+
+__all__ = ["amount_due"]
+
+_CARD = "card"
+_CASH = "cash"
+
+# National cash rounding rules, in cents. Canada rounds cash payments to the
+# nearest 5 cents. Currencies without an entry are paid exactly.
+_CASH_ROUNDING_CENTS = {
+    "CAD": 5,
+}
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Return the amount, in cents, the cashier should ask for.
+
+    Card payments are exact. Cash payments are rounded to the national cash
+    amount for ``currency``.
+    """
+    if paid_by not in (_CARD, _CASH):
+        raise ValueError("paid_by must be 'card' or 'cash'")
+
+    if not isinstance(total_cents, int):
+        raise TypeError("total_cents must be an integer number of cents")
+    if total_cents < 0:
+        raise ValueError("total_cents must be non-negative")
+
+    if not isinstance(currency, str):
+        raise ValueError("currency must be a string")
+    code = currency.strip().upper()
+
+    if paid_by == _CARD:
+        return total_cents
+
+    unit = _CASH_ROUNDING_CENTS.get(code, 1)
+    if unit == 1:
+        return total_cents
+
+    return (total_cents + unit // 2) // unit * unit
