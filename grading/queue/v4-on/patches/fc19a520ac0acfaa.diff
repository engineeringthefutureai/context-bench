--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,25 @@
+"""Durations typed as "2h" / "45m" / "1h 30m", parsed to whole minutes."""
+
+import re
+
+# Hours first, then minutes; each unit at most once; unit letters
+# case-insensitive; whitespace between the parts (and around them) ignored.
+_DURATION = re.compile(r"\s*(?:(\d+)\s*h)?\s*(?:(\d+)\s*m)?\s*", re.IGNORECASE | re.ASCII)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes in `text`: "2h" -> 120, "45m" -> 45, "1h 30m" -> 90.
+
+    Hours come before minutes and each unit appears at most once; the unit
+    letters are case-insensitive and surrounding whitespace is ignored.
+    Anything else (empty text, other units, a missing number, minutes
+    before hours, a negative number) raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration: {text!r}")
+    match = _DURATION.fullmatch(text)
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
