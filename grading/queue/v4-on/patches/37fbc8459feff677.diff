--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,53 @@
+"""Parsing for human-entered weight values."""
+
+import re
+from fractions import Fraction
+
+_WEIGHT_RE = re.compile(
+    r"(?P<number>\d+(?:\.\d+)?|\.\d+)\s*(?P<unit>g|kg|lb|oz)",
+    re.IGNORECASE,
+)
+
+_GRAMS_PER_UNIT = {
+    "g": Fraction(1, 1),
+    "kg": Fraction(1000, 1),
+    "lb": Fraction(45359237, 100000),
+    "oz": Fraction(28349523125, 1000000000),
+}
+
+_HALF_GRAM = Fraction(1, 2)
+
+
+def _parse_decimal_number(text: str) -> Fraction:
+    """Convert a validated decimal string to an exact Fraction."""
+    whole, dot, frac = text.partition(".")
+    if whole == "":
+        whole = "0"
+    value = Fraction(int(whole), 1)
+    if dot:
+        value += Fraction(int(frac), 10 ** len(frac))
+    return value
+
+
+def parse_weight(text: str) -> int:
+    """Return the weight in whole grams, rounded to the nearest gram.
+
+    The input must be an integer or decimal number, optional whitespace,
+    and one of the units g, kg, lb, or oz (case-insensitive). Negative
+    values, missing parts, unknown units, and comma decimal separators
+    are rejected with ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError("invalid weight")
+
+    number = _parse_decimal_number(match.group("number"))
+    grams = number * _GRAMS_PER_UNIT[match.group("unit").lower()]
+
+    whole_grams = grams // 1
+    if grams - whole_grams >= _HALF_GRAM:
+        whole_grams += 1
+    return int(whole_grams)
