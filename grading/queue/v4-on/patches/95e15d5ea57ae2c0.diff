--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,34 @@
+"""Preview of a single seller's weekly payout: what build_payout_batch would report for one
+seller and one period, computed without changing the holds or rollover state."""
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+from shopkit.payouts.batching import Rollover, build_payout_batch
+from shopkit.payouts.holds import HoldBook
+from shopkit.payouts.models import Adjustment, Earning, Seller
+from shopkit.pricing.currency import RateTable
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment],
+                   period_start: date, period_end: date, holds: HoldBook, rollover: Rollover,
+                   rates: RateTable | None = None) -> tuple[str, int]:
+    """(status, net_cents) of the seller's payout for [period_start, period_end] (inclusive).
+
+    Delegates to build_payout_batch with just this seller, so holds inside the return window,
+    released holds, adjustments, reserve, backup withholding, carry-in, the minimum payout and
+    currency conversion are all treated exactly as in the weekly batch; rows of other sellers
+    in earnings/adjustments are ignored. net_cents is the payout's own net: for ROLLED_OVER it
+    is the amount that would carry forward. If the batch would skip the seller (suspended, no
+    FX rate, ...), the skip reason comes back with a net 0, since no payout would be issued for the period.
+
+    Pure with respect to its inputs: the batch runs on deep copies of holds and rollover, so
+    holds it would place or release and balances it would carry stay as they were.
+    """
+    result = build_payout_batch([seller], list(earnings), list(adjustments), period_start, period_end,
+                                holds=copy.deepcopy(holds), rollover=copy.deepcopy(rollover), rates=rates)
+    for p in result.payouts:
+        if p.seller_id == seller.id:
+            return p.status, p.net_cents
+    return result.skipped.get(seller.id, "skipped"), 0
