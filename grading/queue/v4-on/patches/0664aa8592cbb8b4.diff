--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,48 @@
+"""Preview what a seller's next payout will look like, without running the batch.
+
+The weekly batch (build_payout_batch) stays the single source of truth for how a
+payout is built; the preview runs it on copies of its mutable state (holds and
+rollover balances), so looking at a payout neither releases holds nor carries
+balances between periods.
+"""
+
+from copy import deepcopy
+from datetime import date
+
+from shopkit.payouts.batching import Rollover, build_payout_batch
+from shopkit.payouts.holds import HoldBook
+from shopkit.payouts.models import Adjustment, Earning, Seller
+
+
+def preview_payout(
+    seller: Seller,
+    earnings: list[Earning],
+    adjustments: list[Adjustment],
+    period_start: date,
+    period_end: date,
+    holds: HoldBook,
+    rollover: Rollover,
+) -> tuple[str, int]:
+    """(status, net_cents) of `seller`'s payout for [period_start, period_end].
+
+    Exactly what the weekly batch would produce for this seller, but without
+    changing anything: holds and rollover are copied first, so held amounts and
+    balances carried between periods stay as they were. When the batch would
+    skip the seller (e.g. suspended or nothing to pay), the skip reason comes
+    back with a net of 0.
+    """
+    own_earnings = [e for e in earnings if e.seller_id == seller.id]
+    own_adjustments = [a for a in adjustments if a.seller_id == seller.id]
+    result = build_payout_batch(
+        [seller],
+        own_earnings,
+        own_adjustments,
+        period_start,
+        period_end,
+        holds=deepcopy(holds),
+        rollover=deepcopy(rollover),
+    )
+    payout = next((p for p in result.payouts if p.seller_id == seller.id), None)
+    if payout is not None:
+        return payout.status, payout.net_cents
+    return result.skipped.get(seller.id, "no payout"), 0
