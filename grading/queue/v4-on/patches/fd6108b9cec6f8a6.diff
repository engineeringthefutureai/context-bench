--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,22 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"(?P<hours>[0-9]+h)?\s*(?P<minutes>[0-9]+m)?",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration like "1h30m" or "1h 30m" into whole minutes.
+
+    Hours must come before minutes, and each unit may appear at most once.
+    Surrounding whitespace is ignored. Raises ValueError for empty text,
+    unknown units, missing numbers, out-of-order units, or negative numbers.
+    """
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None or (match.group("hours") is None and match.group("minutes") is None):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours = int(match.group("hours")[:-1]) if match.group("hours") is not None else 0
+    minutes = int(match.group("minutes")[:-1]) if match.group("minutes") is not None else 0
+    return hours * 60 + minutes
