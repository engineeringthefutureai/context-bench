--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,56 @@
+"""Weight parsing for warehouse input."""
+import re
+
+# Exact gram factors as numerator/denominator pairs.
+_G_PER_UNIT = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+_WEIGHT_RE = re.compile(
+    r"(?P<number>(?:[0-9]+\.[0-9]+|[0-9]+|\.[0-9]+))\s*(?P<unit>kg|g|lb|oz)",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Return the weight in whole grams for input like "1.5 kg" or "2 oz".
+
+    The number is an integer or decimal using "."; the unit is g, kg, lb or
+    oz, case-insensitive. Raises ValueError for malformed input, unknown
+    units, comma separators and negative values.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    stripped = text.strip()
+    if "," in stripped:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    match = _WEIGHT_RE.fullmatch(stripped)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    number = match.group("number")
+    unit = match.group("unit").lower()
+
+    if number.startswith("."):
+        fraction = number[1:]
+        numerator = int(fraction)
+        denominator = 10 ** len(fraction)
+    elif "." in number:
+        whole, fraction = number.split(".")
+        numerator = int(whole + fraction)
+        denominator = 10 ** len(fraction)
+    else:
+        numerator = int(number)
+        denominator = 1
+
+    factor_num, factor_den = _G_PER_UNIT[unit]
+    top = numerator * factor_num
+    bottom = denominator * factor_den
+
+    # Inputs are non-negative, so adding half a denominator gives half-up.
+    return (top + bottom // 2) // bottom
