+def _mask_card_numbers(data):
+    """Copy of the event data with every ``card_number`` field redacted with redact_pan; all other
+    fields are left untouched. The event payload itself is not modified."""
+    if isinstance(data, dict):
+        masked = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, (str, int)):
+                masked[key] = redact_pan(str(value))
+            else:
+                masked[key] = _mask_card_numbers(value)
+        return masked
+    if isinstance(data, list):
+        return [_mask_card_numbers(item) for item in data]
+    return data
+
