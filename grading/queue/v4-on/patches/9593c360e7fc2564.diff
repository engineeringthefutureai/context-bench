+def _masked_payload(payload: dict) -> dict:
+    """Event data with card_number masked the way the shop masks it everywhere else
+    (redact_pan), so partners never receive a full PAN. Only card_number is changed; the
+    original payload is copied, never mutated."""
+    if isinstance(payload, dict) and payload.get("card_number") is not None:
+        payload = dict(payload)
+        payload["card_number"] = redact_pan(str(payload["card_number"]))
+    return payload
