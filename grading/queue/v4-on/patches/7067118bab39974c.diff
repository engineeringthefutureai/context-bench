+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+from shopkit.errors import ShopError
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Return the amount the cashier asks the customer to pay, in cents.
+
+    Card payments are not rounded; cash payments follow the national cash rounding rule used
+    elsewhere in the shop (see ``cashRoundCents``).
+    """
+    if paid_by == "card":
+        return total_cents
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    raise ShopError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
