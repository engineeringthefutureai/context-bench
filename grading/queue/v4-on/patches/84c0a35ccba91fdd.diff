--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,33 @@
+"""Preview what a coupon code would save on a cart, without applying it."""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon, CouponRejected
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str,
+                   coupons: dict[str, Coupon], engine: PricingEngine, ship_to: Address | None,
+                   weight_g: int, at: datetime) -> int:
+    """Saving in cents this code would give on the cart, as the cart page computes it.
+
+    Prices the cart the same way the cart page does, once without the code and
+    once with it, and returns the difference; that is what the shopper would
+    actually pay less (including the effect on tax). Returns 0 when the code
+    wouldn't apply (unknown, inactive, or below the minimum order).
+    """
+    if not code:
+        return 0
+    plain = price_cart(items, products, coupons=coupons, engine=engine, ship_to=ship_to,
+                       weight_g=weight_g, at=at)
+    try:
+        with_code = price_cart(items, products, coupons=coupons, engine=engine, ship_to=ship_to,
+                               weight_g=weight_g, at=at, coupon_code=code)
+    except CouponRejected:
+        return 0  # the cart page would show a reason; the total is unchanged
+    return plain.total_cents - with_code.total_cents
