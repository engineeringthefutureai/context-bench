--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,33 @@
+"""Preview a discount code's saving before the shopper applies it.
+
+The cart page tells the shopper what a code is worth by re-pricing the cart with
+the code. The preview does exactly that: it prices the same cart through
+``price_cart`` and reports the coupon's share, so what the shopper is told is
+what they will get when they apply the code.
+"""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str | None,
+                   coupons: dict[str, Coupon] | None, engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """Saving in cents that ``code`` would give on this cart.
+
+    Priced exactly as the cart page (``price_cart``): percentage codes skip items
+    already on sale but the sale items still count for the minimum order value,
+    fixed-amount codes never take more than the eligible subtotal, gift cards are
+    excluded, printed codes are honoured, and rejected/unknown codes give nothing.
+    Returns 0 when the code would not apply (unknown, inactive, below its minimum,
+    nothing eligible to discount, or an empty cart).
+    """
+    priced = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g,
+                        at=at, coupon_code=code, coupons=coupons)
+    return priced.coupon_discount_cents
