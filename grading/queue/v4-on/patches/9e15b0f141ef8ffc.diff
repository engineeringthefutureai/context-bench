--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,32 @@
+import re
+
+# Conversion factors to grams; lb and oz are the international avoirdupois values.
+_GRAMS_PER_UNIT = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+# A number (integer or decimal with "." separator), optional whitespace, then a
+# unit. Anything else — missing parts, unknown units, "-", "," as separator,
+# stray text — is rejected by parse_weight.
+_WEIGHT_RE = re.compile(r"^\s*([0-9]+(?:\.[0-9]+)?)\s*(kg|lb|oz|g)\s*$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight typed by warehouse staff, returned in whole grams.
+
+    Accepts a number (integer or decimal using "." as separator), optional
+    whitespace and a unit of g, kg, lb or oz, case-insensitive, with leading
+    and trailing whitespace ignored ("1.5 kg" -> 150, " 2 LB " -> 907, "1oz" -> 28).
+    Raises ValueError for anything else: a missing number or unit, an unknown
+    unit, negative values and "," as decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+    match = _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    value, unit = match.groups()
+    return round(float(value) * _GRAMS_PER_UNIT[unit.lower()])
