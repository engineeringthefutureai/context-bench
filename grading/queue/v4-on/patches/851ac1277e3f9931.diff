--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,31 @@
+"""Unit parsing for quantities typed in by warehouse staff, e.g. package weights."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact grams per unit; lb and oz are defined by these exact factors.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+_WEIGHT_RE = re.compile(r"^\s*(-?\d+(?:\.\d+)?)\s*(g|kg|lb|oz)\s*$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Whole-gram weight from staff input: a number (integer or "." decimal), optional
+    whitespace, then a case-insensitive unit g, kg, lb or oz.
+    (https://nope) -- see docstring body.
+    parse_weight("2 kg") == 2000; parse_weight(" 12.5 oz ") == 354.
+    1 lb = 453.59237 g, 1 oz = 28.349523125 g; the result is rounded to the nearest gram.
+    Raises ValueError for a missing number or unit, an unknown unit, a negative value
+    and "," as the decimal separator."""
+    match = _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    value = Decimal(match.group(1))
+    if value < 0:
+        raise ValueError(f"weight must be >= 0: {text!r}")
+    grams = value * _GRAMS_PER_UNIT[match.group(2).lower()]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
