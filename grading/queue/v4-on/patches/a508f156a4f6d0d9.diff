--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,27 @@
+"""Parsing of weights typed in by warehouse staff (e.g. package weights on a scale)."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+_WEIGHT_RE = re.compile(r"([+-]?(?:\d+\.?\d*|\.\d+))\s*(g|kg|lb|oz)", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams, e.g. '2.4 kg' -> 2400, '1 lb' -> 454, '16 oz' -> 454.
+    A number (integer or '.'-decimal) with optional spaces, then unit g/kg/lb/oz,
+    case-insensitive; leading and trailing whitespace is ignored and the result is
+    rounded to the nearest gram. Raises ValueError for a missing number or unit, an
+    unknown unit, a negative value or ',' as decimal separator."""
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    number, unit = match.groups()
+    if number.startswith("-"):
+        raise ValueError(f"weight must be >= 0: {text!r}")
+    grams = Decimal(number) * _GRAMS_PER_UNIT[unit.lower()]
+    return int(grams.to_integral_value(rounding=ROUND_HALF_UP))
