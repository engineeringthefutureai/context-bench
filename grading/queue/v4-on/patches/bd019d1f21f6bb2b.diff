--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,37 @@
+import re
+from fractions import Fraction
+
+_WEIGHT_RE = re.compile(
+    r"\s*(\d+(?:\.\d+)?|\.\d+)\s*(kg|g|lb|oz)\s*",
+    re.IGNORECASE,
+)
+
+_UNIT_GRAMS = {
+    "g": Fraction(1),
+    "kg": Fraction(1000),
+    "lb": Fraction(45359237, 100000),
+    "oz": Fraction(28349523125, 1000000000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-entered package weight into whole grams.
+
+    Accepts a non-negative integer or decimal number, optional whitespace, and a
+    case-insensitive unit: g, kg, lb, or oz. The result is rounded to the nearest
+    gram. Any other input raises ValueError.
+    """
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    number, unit = match.groups()
+    if number.startswith("."):
+        number = f"0{number}"
+
+    try:
+        grams = Fraction(number) * _UNIT_GRAMS[unit.lower()]
+    except (ValueError, OverflowError) as exc:
+        raise ValueError(f"invalid weight: {text!r}") from exc
+
+    return (2 * grams.numerator + grams.denominator) // (2 * grams.denominator)
