+def _mask_card_numbers(data):
+    """Copy of event data with every card_number masked the way the shop stores it
+    (payments.reconciliation.redact_pan) so partners never see a full card number.
+    Other fields go out unchanged; the original payload is not modified."""
+    if isinstance(data, dict):
+        masked = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, str) and value:
+                masked[key] = redact_pan(value)
+            else:
+                masked[key] = _mask_card_numbers(value)
+        return masked
+    if isinstance(data, list):
+        return [_mask_card_numbers(value) for value in data]
+    return data
+
