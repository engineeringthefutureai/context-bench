+def transfers_by_week(transfers: Sequence[Transfer]) -> dict[str, int]:
+    """Total units moved per ISO week, keyed by week label (e.g. ``2024-W32``).
+
+    Uses the same ISO week labels as the other dashboards. The returned mapping
+    is in chronological order of the weeks.
+    """
+    totals: dict[str, int] = {}
+    order: dict[str, tuple[int, int]] = {}
+    for t in transfers:
+        iso_year, iso_week, _ = t.at.isocalendar()
+        label = f"{iso_year}-W{iso_week:02d}"
+        totals[label] = totals.get(label, 0) + t.qty
+        if label not in order:
+            order[label] = (iso_year, iso_week)
+    return {label: totals[label] for label in sorted(totals, key=order.__getitem__)}
