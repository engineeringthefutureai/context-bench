+import re
+import unicodedata
 from dataclasses import dataclass
+
+
+def _slugify(title: str) -> str:
+    """Build a URL slug from a title using the shop's title slug rules."""
+    normalized = (
+        unicodedata.normalize("NFKD", title)
+        .encode("ascii", "ignore")
+        .decode("ascii")
+    )
+    slug = re.sub(r"[^a-z0-9]+", "-", normalized.lower())
+    return slug.strip("-")
 
 
