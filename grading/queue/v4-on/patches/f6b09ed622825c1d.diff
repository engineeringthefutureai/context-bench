--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,24 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Set aside `qty` units of `sku`.
+
+        On failure the on-hand quantity is left unchanged.
+        """
+        available = self._on_hand.get(sku, 0)
+        if qty < 0:
+            raise Conflict(
+                f"invalid reservation qty for {sku}",
+                requested=qty,
+                available=available,
+            )
+        if qty > available:
+            raise Conflict(
+                f"insufficient stock for {sku}",
+                requested=qty,
+                available=available,
+            )
+        if qty:
+            self._on_hand[sku] = available - qty
