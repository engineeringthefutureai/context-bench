--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,45 @@
+import re
+from fractions import Fraction
+
+_WEIGHT_RE = re.compile(
+    r"(?P<num>[0-9]*\.?[0-9]+)\s*(?P<unit>g|kg|lb|oz)",
+    re.IGNORECASE,
+)
+
+_GRAMS_PER_UNIT = {
+    "g": Fraction(1),
+    "kg": Fraction(1000),
+    "lb": Fraction(45359237, 100000),
+    "oz": Fraction(28349523125, 1000000000),
+}
+
+
+def _number_to_fraction(number: str) -> Fraction:
+    """Convert a validated decimal string to an exact Fraction."""
+    if "." in number:
+        whole, _, frac = number.partition(".")
+        digits = whole + frac
+        return Fraction(int(digits or 0), 10 ** len(frac))
+    return Fraction(int(number), 1)
+
+
+def parse_weight(text: str) -> int:
+    """Return a package weight typed by warehouse staff in whole grams.
+
+    Accepts a non-negative integer or decimal number using '.' as the
+    separator, optional whitespace, and a unit of g, kg, lb or oz
+    (case-insensitive). Leading and trailing whitespace is ignored.
+    The result is rounded to the nearest gram.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError("invalid weight")
+
+    unit = match.group("unit").lower()
+    grams = _number_to_fraction(match.group("num")) * _GRAMS_PER_UNIT[unit]
+
+    # Inputs are non-negative, so adding 1/2 and truncating rounds half up.
+    return int(grams + Fraction(1, 2))
