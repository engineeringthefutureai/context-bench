--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,43 @@
+import re
+
+_WEIGHT_RE = re.compile(
+    r"\s*([0-9]+(?:\.[0-9]+)?)\s*(g|kg|lb|oz)\s*",
+    re.IGNORECASE,
+)
+
+_GRAMS_PER_UNIT = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (453_592_37, 100_000),
+    "oz": (28_349_523_125, 1_000_000_000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-entered weight into whole grams.
+
+    The input must be a non-negative integer or decimal using "." as the
+    decimal separator, optional whitespace, and a unit of g, kg, lb, or oz
+    (case-insensitive). The result is rounded to the nearest gram.
+    """
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError("Invalid weight format")
+
+    number, unit = match.groups()
+    whole, dot, frac = number.partition(".")
+    if dot:
+        numerator = int(whole + frac)
+        denominator = 10 ** len(frac)
+    else:
+        numerator = int(whole)
+        denominator = 1
+
+    factor_numerator, factor_denominator = _GRAMS_PER_UNIT[unit.lower()]
+    numerator *= factor_numerator
+    denominator *= factor_denominator
+
+    grams, remainder = divmod(numerator, denominator)
+    if remainder * 2 >= denominator:
+        grams += 1
+    return grams
