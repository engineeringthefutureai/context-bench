--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,30 @@
+"""Partner-facing explanation for webhook delay.
+
+Partners ask why an order event has not reached them yet; the only hold in the delivery worker
+(api/webhook_delivery.py) that applies to a queued event before it is sent is the fraud-review
+hold, so this mirrors that decision. Cancellations and refunds go out even while an order is
+under review, which is why ALWAYS_DELIVER is imported rather than re-listed here."""
+from __future__ import annotations
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Why the webhook worker would hold `event` for `order_id` right now.
+
+    `under_review(order_id)` reports whether the order is in fraud review (fraud.review), like
+    the callable the delivery worker receives. Returns a short reason when the event would be
+    held, None when it would go out normally."""
+    if not event or order_id is None or under_review is None:
+        return None
+    if event in ALWAYS_DELIVER:
+        # order.cancelled / refund.settled always go out: partners must learn the order is off
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception as e:
+        # fail closed, same as deliver_pending: a broken lookup means the event is held
+        return f"held: review status for {order_id} is unknown ({type(e).__name__})"
+    if reviewing:
+        return f"held: order {order_id} is in fraud review"
+    return None
