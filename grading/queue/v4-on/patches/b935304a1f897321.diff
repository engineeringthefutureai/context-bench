+def _mask_payload(data: object) -> object:
+    """Deep copy of the event data with every `card_number` field masked the way the shop
+    masks card numbers everywhere else (redact_pan). All other fields go out unchanged."""
+    if isinstance(data, dict):
+        return {k: (redact_pan(str(v)) if k == "card_number" else _mask_payload(v))
+                for k, v in data.items()}
+    if isinstance(data, list):
+        return [_mask_payload(item) for item in data]
+    return data
+
