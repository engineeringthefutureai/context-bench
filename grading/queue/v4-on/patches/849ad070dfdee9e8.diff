--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from ..errors import Conflict
+
+
+class InsufficientStock(Conflict):
+    """Requested quantity exceeds the on-hand quantity."""
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,19 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold qty units of sku for an order.
+
+        Raises InsufficientStock (a Conflict, answered as HTTP 409) with the
+        requested and available quantities when there is not enough stock;
+        the on-hand quantity is left unchanged in that case.
+        """
+        available = self._on_hand.get(sku, 0)
+        if qty > available:
+            raise InsufficientStock(
+                f"insufficient stock for {sku}",
+                requested=qty,
+                available=available,
+            )
+        self._on_hand[sku] = available - qty
