--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,17 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku`, failing if they are not available."""
+        available = self._on_hand.get(sku, 0)
+        if qty < 0:
+            raise Conflict("Quantity must be non-negative", requested=qty, available=available)
+        if qty > available:
+            raise Conflict(
+                f"Cannot reserve {qty} of {sku}: only {available} available",
+                requested=qty,
+                available=available,
+            )
+        if qty:
+            self._on_hand[sku] = available - qty
