--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,37 @@
+"""Coupon preview for the cart page: what a discount code would save before the shopper applies it.
+
+The saving is computed by the same path that prices the cart page (shopkit.pricing.cart.price_cart)
+with the code applied, so the minimum order value, the exclusions (on-sale items and gift cards for
+percentage codes), printed codes and the per-line spread all behave exactly as they do when the
+shopper actually applies the code. A code that would not apply -- unknown, inactive or below the
+minimum -- saves nothing and comes back as 0."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str | None,
+                   coupons: dict[str, Coupon] | None, engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime, *, tier: str = "standard", member: bool = False,
+                   promotions=(), tax_classes: dict[str, str] | None = None,
+                   currency: str | None = None) -> int:
+    """Return the saving in cents the code would give on this cart, or 0 when the code wouldn't
+    apply.
+
+    Prices the cart exactly as the cart page does and reports the coupon's own share of the
+    discount (price_cart's coupon_discount_cents), so automatic promotions already applied to the
+    lines are taken into account. A rejected code (unknown, inactive, below the minimum) is not an
+    error in a preview: it simply saves 0.
+    """
+    if not code:
+        return 0
+    cart = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                      tier=tier, member=member, coupon_code=code, coupons=coupons,
+                      promotions=promotions, tax_classes=tax_classes, currency=currency)
+    return cart.coupon_discount_cents
