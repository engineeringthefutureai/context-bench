--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,18 @@
+"""Duration parsing for limits, SLAs and scheduling windows."""
+import re
+
+# Hours before minutes, each unit at most once: "2h", "45m", "1h30m" ("H"/"M" too, and with or
+# without the space between the parts). Anything that doesn't fit exactly is a caller error.
+_DURATION_RE = re.compile(r"(?:(\d+)h)?\s*(?:(\d+)m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """A human-written duration in whole minutes, e.g. parse_duration("1h 30m") -> 90."""
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, not {type(text).__name__}")
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"bad duration {text!r}")
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
