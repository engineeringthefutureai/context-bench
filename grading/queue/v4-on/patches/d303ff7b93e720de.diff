--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,37 @@
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from shopkit.warehouse.sites import Site
+
+# Carrier service an express wave needs at the dock (see Site.services).
+_EXPRESS_CARRIER_SERVICE = "air"
+
+
+def express_available(skus: Iterable[str], sites: Iterable[Site], hazmat_skus: Iterable[str]) -> bool:
+    """Whether the warehouse would ship an order with ``skus`` by express.
+
+    Checkout uses this to decide whether to offer express delivery, so the
+    answer must match what warehouse.waves would actually do: an order only
+    goes into an express wave when it can be routed to a dock that ships by
+    air (``Site.services``). Stock is not considered here -- ``sites`` are
+    the sites that can already ship the order.
+
+    Orders containing hazardous goods are never waved express: they ship by
+    ground only, so any SKU in ``hazmat_skus`` makes express unavailable
+    regardless of the sites' services.
+    """
+    skus = frozenset(skus)
+    if not skus:
+        return False
+    if skus & frozenset(hazmat_skus):
+        return False
+    return any(_EXPRESS_CARRIER_SERVICE in site.services for site in sites)
+
+
+def __getattr__(name):
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
+
+
+def __dir__():
+    return ["express_available"]
