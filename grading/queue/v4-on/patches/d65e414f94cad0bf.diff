--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,44 @@
+"""Linking order references that customers type into support messages.
+
+Customers write the same reference many ways ("so 2019 123", "SO-2019-000123",
+"ORD_1A2B3C4D5E6F"), so we pull the candidates out of the text and let
+parseOrderRef decide what is a real reference; each one is returned in the form
+the shop writes it (see order_engine.formatOrderRef)."""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+_CANDIDATES = re.compile(
+    r"\b(?:ord_[0-9a-f]+|(?:[A-Za-z]+[-\s])?\d{4}[-\s]?\d+)\b",
+    re.IGNORECASE,
+)
+
+
+def _normalize(kind: str, year: int | None, seq: int | str) -> str:
+    if kind == "ord":
+        return str(seq)
+    return formatOrderRef(kind, year, seq)
+
+
+def order_refs(text: str) -> list[str]:
+    """Order references mentioned in a customer message.
+
+    Returned in the order they first appear, without duplicates, each written
+    the way the shop writes that kind of reference ("SO-2019-000123",
+    "ord_1a2b3c4d5e6f", "INV-2026-0001"). Anything parseOrderRef rejects
+    (bad kind, year before 2017, ...) is left out."""
+    if text is None:
+        return []
+    found: list[str] = []
+    seen: set[str] = set()
+    for m in _CANDIDATES.finditer(text):
+        parsed = parseOrderRef(m.group(0))
+        if parsed is None:
+            continue
+        ref = _normalize(*parsed)
+        if ref not in seen:
+            seen.add(ref)
+            found.append(ref)
+    return found
