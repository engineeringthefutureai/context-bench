--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,37 @@
+"""Parsing of human-written durations such as "2h" or "1h 30m".
+
+Only hours and minutes are supported (see parse_duration); any other unit is
+rejected so that "30s" or "1d" is never silently misread as something else.
+"""
+
+from __future__ import annotations
+
+import re
+
+__all__ = ["parse_duration"]
+
+# One optional "Nh" part followed by one optional "Nm" part, in that order.
+# Whitespace is allowed around the whole text and between the two parts, but a
+# number is always glued to its unit letter. "h" must precede "m" and each
+# unit may appear at most once; anything the pattern does not cover (empty
+# text, other units, a missing number, "-1h", "1.5h", "1h 30m 45m", ...)
+# fails to match and is reported as a ValueError by parse_duration().
+_DURATION_RE = re.compile(r"\s*(?P<hours>[0-9]+h)?\s*(?P<minutes>[0-9]+m)?\s*", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse *text* such as "2h", "45m", "1h30m" or "1h 30m" into whole minutes.
+
+    Hours come before minutes and each unit may appear at most once; unit
+    letters are case-insensitive and surrounding whitespace is ignored.
+
+    Raises:
+        ValueError: if *text* is empty or does not consist of an integer
+            hours part, an integer minutes part, or both, in that order.
+    """
+    match = _DURATION_RE.fullmatch(text)
+    if match is None or (match["hours"] is None and match["minutes"] is None):
+        raise ValueError(f"invalid duration {text!r}: expected hours and/or minutes, e.g. '2h' or '1h 30m'")
+    hours = int(match["hours"][:-1]) if match["hours"] else 0
+    minutes = int(match["minutes"][:-1]) if match["minutes"] else 0
+    return hours * 60 + minutes
