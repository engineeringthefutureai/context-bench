+"""Point-of-sale amount calculations for cash and card payments."""
+
+__all__ = ["amount_due"]
+
+_CARD = "card"
+_CASH = "cash"
+
+# National cash rounding increments, in cents. Canadian cash amounts are
+# rounded to the nearest 5 cents: 1-2 cents down, 3-7 cents to 5 cents, and
+# 8-9 cents up.
+_CASH_ROUNDING = {
+    "CAD": 5,
+}
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Return the amount, in cents, the cashier should ask the customer to pay.
+
+    Card payments pay the exact total. Cash payments follow the national
+    cash amount rules for the currency; currencies without a defined cash
+    rounding increment are charged in exact cents.
+    """
+    if isinstance(total_cents, bool) or not isinstance(total_cents, int):
+        raise TypeError("total_cents must be an integer number of cents")
+    if total_cents < 0:
+        raise ValueError("total_cents must not be negative")
+    if paid_by not in (_CARD, _CASH):
+        raise ValueError("paid_by must be 'card' or 'cash'")
+
+    if paid_by == _CARD:
+        return total_cents
+
+    if not isinstance(currency, str):
+        raise TypeError("currency must be an ISO currency code")
+    normalized_currency = currency.strip().upper()
+    if not normalized_currency:
+        raise ValueError("currency must not be empty")
+
+    increment = _CASH_ROUNDING.get(normalized_currency, 1)
+    return _round_to_increment(total_cents, increment)
+
+
+def _round_to_increment(cents: int, increment: int) -> int:
+    """Round a non-negative cent amount to the nearest cash increment."""
+    if increment <= 1:
+        return cents
+    return (cents + increment // 2) // increment * increment
