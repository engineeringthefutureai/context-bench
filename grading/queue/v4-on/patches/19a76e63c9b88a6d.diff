--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,32 @@
+"""Weights typed in by warehouse staff ('1.5 kg', '3 lb', '12 oz') parsed to whole grams."""
+import re
+from decimal import Decimal, ROUND_HALF_EVEN
+
+# grams per unit; lb and oz are the exact international values (1 lb = 453.59237 g, 1 oz = 1/16 lb)
+_GRAMS_PER = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# an integer or a "."-separated decimal, optional whitespace, then a unit (case-insensitive)
+_WEIGHT_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*(g|kg|lb|oz)\s*\Z", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight typed in by warehouse staff -> whole grams.
+
+    Format: a number (an integer, or a decimal using "." as separator), optional whitespace, then a
+    unit -- g, kg, lb or oz, case-insensitive; leading and trailing whitespace is ignored:
+    '1.5 kg', '5000g', ' 2 LB '. lb and oz use the exact international factors (1 lb = 453.59237 g,
+    1 oz = 28.349523125 g). The result is rounded to the nearest gram, half to even (as in
+    pricing.currency).
+
+    Raises ValueError for anything else, including a missing number or unit, an unknown unit,
+    negative values and "," as decimal separator."""
+    m = _WEIGHT_RE.match(text)
+    if m is None:
+        raise ValueError(f"bad weight {text!r}")
+    grams = Decimal(m.group(1)) * _GRAMS_PER[m.group(2).lower()]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_EVEN))
