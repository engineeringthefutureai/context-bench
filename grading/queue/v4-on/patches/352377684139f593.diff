--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,31 @@
+"""Why partner order events are arriving late: the holds the webhook worker applies before sending.
+
+`deliver_pending` (api.webhook_delivery) re-checks every due delivery each run and can hold one
+back. The only hold that depends on just the event and its order is the fraud-review hold, which is
+what partners ask about; the other delays (retries, rate limits, per-order sequencing) depend on
+endpoint and queue state that is not available here."""
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None, under_review: Callable[[str], bool] | None) -> str | None:
+    """Reason the webhook worker is holding `event` for `order_id` right now, or None if it sends.
+
+    Mirrors the review hold in deliver_pending: events about an order that is in fraud review are
+    held until the review clears, so partners (ERP, 3PL) don't start fulfilling an order we may
+    still cancel -- except the ALWAYS_DELIVER events, which go out regardless. An `under_review`
+    lookup that raises counts as in review: the worker fails closed rather than shipping an order
+    that turns out to be fraudulent.
+    """
+    if not order_id or under_review is None or event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        reviewing = True
+    if reviewing:
+        return f"order {order_id} is in fraud review; {event} is held until the review clears"
+    return None
