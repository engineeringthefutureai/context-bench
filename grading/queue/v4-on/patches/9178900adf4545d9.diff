--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,31 @@
+"""Compact duration parsing: "2h", "45m", "1h30m" -> whole minutes."""
+
+import re
+
+# Hours before minutes, each unit at most once, digits only, units
+# case-insensitive; whitespace allowed around and between the parts.
+_DURATION_RE = re.compile(
+    r"\s*(?:(?P<hours>\d+)h\s*)?(?:(?P<minutes>\d+)m)?\s*",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a compact duration such as "2h", "45m" or "1h30m" into whole minutes.
+
+    Hours come before minutes, each unit appears at most once, units are
+    case-insensitive and surrounding whitespace is ignored. Anything else
+    (empty text, other units, a missing number, minutes before hours,
+    negative numbers) raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    match = _DURATION_RE.fullmatch(text)
+    if match is None or (match["hours"] is None and match["minutes"] is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    minutes = 0
+    if match["hours"] is not None:
+        minutes += int(match["hours"]) * 60
+    if match["minutes"] is not None:
+        minutes += int(match["minutes"])
+    return minutes
