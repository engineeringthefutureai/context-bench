+"""Warehouse labels built from ERP/finance item numbers."""
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Build the text for a pallet label.
+
+    items is a list of (sku, qty) pairs, kept in the order given. Each line shows the
+    finance system's item number for the SKU and the quantity: "<item number> x<qty>".
+    """
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{int(qty)}")
+    return "\n".join(lines)
