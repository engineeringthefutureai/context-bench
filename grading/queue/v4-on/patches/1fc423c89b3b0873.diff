+    def restocking_fee_cents(self, order: Order) -> int:
+        """Restocking fee in cents: RESTOCKING_FEE_PCT of the refund for changed-mind returns,
+        0 for every other reason. Rounded the way the order engine rounds its other
+        percentage amounts (tax, discounts), i.e. dollars via roundMoney."""
+        if self.reason != "changed_mind":
+            return 0
