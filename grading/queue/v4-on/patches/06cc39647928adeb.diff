--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,20 @@
+"""Duration parsing for schedule/SLA fields: "1h 30m" -> 90 whole minutes."""
+import re
+
+# Hours first, then minutes, each at most once and case-insensitive ("2h", "45m", "1h30m").
+_DURATION_RE = re.compile(r"^(?:(\d+)h)?\s*(?:(\d+)m)?$")
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes in `text`, e.g. "2h" -> 120, "45m" -> 45, "1h 30m" -> 90.
+
+    Hours come before minutes and each unit appears at most once; units are
+    case-insensitive and surrounding whitespace is ignored. Anything else
+    (empty text, other units, a missing number, minutes before hours, negative
+    numbers) raises ValueError."""
+    match = _DURATION_RE.match(text.strip().lower())
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
