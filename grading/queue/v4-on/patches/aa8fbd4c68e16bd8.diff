--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,35 @@
+import re
+from decimal import Decimal, ROUND_HALF_UP
+
+# Exact grams per unit. lb and oz use the international avoirdupois values
+# (1 lb = 453.59237 g, 1 oz = 28.349523125 g).
+_G_PER_UNIT = {
+    "g": Decimal("1"),
+    "kg": Decimal("1000"),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# A number (integer or "."-decimal), optional whitespace, then a unit. No sign
+# and no trailing junk are allowed; digits and whitespace are ASCII only.
+_WEIGHT_RE = re.compile(
+    r"\s*([0-9]+(?:\.[0-9]+)?)\s*(kg|g|lb|oz)\s*",
+    re.IGNORECASE | re.ASCII,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Package weight typed in by warehouse staff, in whole grams. Accepts a
+    number (integer or "."-decimal), optional whitespace and a unit (g, kg, lb
+    or oz, case-insensitive), e.g. "1.5 kg" -> 1500. Leading and trailing
+    whitespace is ignored and the result is rounded to the nearest gram.
+    Raises ValueError for anything else, including a missing number, a missing
+    or unknown unit, a negative value and "," as decimal separator."""
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    amount, unit = match.groups()
+    grams = Decimal(amount) * _G_PER_UNIT[unit.lower()]
+    return int(grams.to_integral_value(rounding=ROUND_HALF_UP))
