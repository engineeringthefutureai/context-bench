+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Total units moved per ISO week, in chronological order."""
+    totals: dict[str, int] = {}
+    for entry in transfers:
+        week = iso_week_label(entry.at.date())
+        totals[week] = totals.get(week, 0) + entry.qty
+    return {week: totals[week] for week in sorted(totals)}
