@@ -0,0 +1,17 @@
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Text for a warehouse pallet label.
+
+    The pallet scanner reads the finance system's item numbers, not shop SKUs, so each
+    line is "<item number> x<qty>" with the item number from :func:`toErpSku`. The first
+    line is "PALLET <pallet_id>" and the items are printed in the order given. A SKU that
+    has no ERP item number is an error and propagates the ValueError from toErpSku.
+    """
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
