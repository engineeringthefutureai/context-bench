--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,40 @@
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+from shopkit.payouts.batching import Rollover, build_payout_batch
+from shopkit.payouts.holds import HoldBook
+from shopkit.payouts.models import Adjustment, Earning, Seller
+
+
+def preview_payout(
+    seller: Seller,
+    earnings: list[Earning],
+    adjustments: list[Adjustment],
+    period_start: date,
+    period_end: date,
+    holds: HoldBook,
+    rollover: Rollover,
+) -> tuple[str, int]:
+    """Return the status and net cents this seller's payout would get for the period.
+
+    The weekly batch is run against copies of the hold book and rollover, so previewing does
+    not place or release holds and does not consume or carry forward balances. If the weekly
+    batch would skip the seller (for example suspended, closed, or no FX rate), the skip
+    reason is returned with 0 cents.
+    """
+    result = build_payout_batch(
+        [seller],
+        list(earnings or []),
+        list(adjustments or []),
+        period_start,
+        period_end,
+        holds=copy.deepcopy(holds),
+        rollover=copy.deepcopy(rollover),
+    )
+
+    payout = next((p for p in result.payouts if p.seller_id == seller.id), None)
+    if payout is not None:
+        return payout.status, payout.net_cents
+    return result.skipped.get(seller.id, "skipped"), 0
