--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,43 @@
+"""Preview the saving a discount code would give before it is applied."""
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(
+    items: list[CartItem],
+    products: dict[str, Product],
+    code: str | None,
+    coupons: dict[str, Coupon] | None,
+    engine: PricingEngine,
+    ship_to: Address,
+    weight_g: int,
+    at: datetime,
+) -> int:
+    """Return the saving in cents that *code* would give on this cart.
+
+    The cart is priced with the same call the cart page uses (``price_cart``),
+    so the preview matches what the shopper would actually be charged and can
+    never drift from the cart's coupon handling (minimum order, sale-item
+    exclusions, fixed vs. percent values, max uses, ...).  Returns 0 when the
+    code would not apply: no code, an empty cart, or an unknown, inactive,
+    exhausted or below-minimum code.
+    """
+    if not items or not code:
+        return 0
+    cart = price_cart(
+        items,
+        products,
+        engine=engine,
+        ship_to=ship_to,
+        weight_g=weight_g,
+        at=at,
+        coupon_code=code,
+        coupons=coupons,
+    )
+    return cart.coupon_discount_cents
