+"""Read-only preview of refund settlement: where a refund of an amount would go.
+
+Support agents use this to tell a customer, *before* pressing Refund, where the money would come
+back to (card, store credit or gift card). It mirrors the destination split in
+payments.settlement.settle_refund but must never mutate any payment or otherwise refund
+anything -- it only reads and computes.
+"""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+from shopkit.utils.dates import utc_now
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                        today: date | None = None) -> dict[str, int]:
+    """Return {"card", "store_credit", "gift_card"} with the cents a refund of `amount_cents`
+    for `order_id` would settle into each destination.
+
+    The split follows payments.settlement.settle_refund exactly: the amount is divided across the
+    order's captured payments in proportion to what is still refundable on each (cards before
+    gift cards, remainder to the earliest-listed payment), then each share is routed by payment
+    method and age. Nothing is refunded and no payment is modified.
+    """
+    today = today or utc_now().date()
+
+    # Same validation as settle_refund: fail clearly on an amount that could not be refunded.
+    if amount_cents <= 0:
+        raise ShopError("refund amount must be positive", order_id=order_id)
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}", order_id=order_id,
+                             requested=amount_cents, refundable=refundable)
+
+    # Proportional split across the captured payments, cards before gift cards, remainder to the
+    # earliest-listed payment. Mirrors the block in settle_refund -- keep the two in sync.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    # Route each share by payment method and age, as settle_refund does.
+    dest = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            dest["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            dest["store_credit"] += share
+        else:
+            dest["card"] += share
+    return dest
