+"""Till amounts for cash and card payments.
+
+Card payments are always for the exact total. Cash payments follow the national
+cash-amount rule for the currency; in Canada (CAD) cash amounts are rounded to
+the nearest 5 cents.
+"""
+from __future__ import annotations
+
+_CARD = "card"
+_CASH = "cash"
+
+# National cash-amount rounding steps, in cents.
+_CASH_ROUNDING_STEPS = {
+    "CAD": 5,  # Canada: cash amounts are rounded to the nearest 5 cents.
+}
+
+
+def _round_to_step(cents: int, step: int) -> int:
+    """Round a non-negative amount in cents to the nearest multiple of `step`."""
+    if cents <= 0:
+        return 0
+    return ((cents + step // 2) // step) * step
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """The amount the cashier asks the customer to pay, in cents.
+
+    `paid_by` must be "card" or "cash". Card payments pay `total_cents` exactly.
+    Cash payments are rounded to the currency's national cash-amount rule when
+    one is known; otherwise the exact total is used.
+    """
+    if paid_by not in (_CARD, _CASH):
+        raise ValueError("paid_by must be 'card' or 'cash'")
+    if total_cents <= 0:
+        return 0
+    if paid_by == _CARD:
+        return total_cents
+    step = _CASH_ROUNDING_STEPS.get(currency)
+    if step is None:
+        return total_cents
+    return _round_to_step(total_cents, step)
