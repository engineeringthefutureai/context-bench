--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,15 @@
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: list[str], sites: list[Site], hazmat_skus: frozenset[str]) -> bool:
+    """Whether the warehouse would put an order containing `skus` into an express wave.
+
+    Mirrors the service decision in warehouse.waves.allocate_wave: an order containing any
+    hazmat SKU is downgraded to a standard wave (hazmat can only go by ground, express leaves
+    by air), and an order with no lines or no site that could ship it is never waved at all.
+    """
+    if not skus or not sites:
+        return False
+    return not any(sku in hazmat_skus for sku in skus)
