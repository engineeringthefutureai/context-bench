--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,28 @@
+"""Weight parsing for warehouse-entered package weights."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact grams per unit, kept as decimal strings so the conversion has no float artifacts.
+GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# An integer or "."-decimal, optional whitespace, then the unit. Nothing else matches:
+# no sign, no "," separator, no scientific notation, no other unit.
+_WEIGHT_RE = re.compile(r"(\d+(?:\.\d+)?)[ \t]*(g|kg|lb|oz)", re.IGNORECASE | re.ASCII)
+
+
+def parse_weight(text: str) -> int:
+    """Package weight in whole grams from staff-entered text, e.g. "1.5 kg" -> 1500,
+    "16 oz" -> 454. The number is an integer or "."-decimal, the unit is g, kg, lb or oz
+    (case-insensitive); surrounding whitespace is ignored and the result rounds to the
+    nearest gram, half up. Raises ValueError for a missing number or unit, an unknown unit,
+    negative values, "," as decimal separator, or any other malformed input."""
+    m = _WEIGHT_RE.fullmatch(text.strip())
+    if m is None:
+        raise ValueError(f"invalid weight {text!r}")
+    number, unit = m.group(1), m.group(2).lower()
+    return int((Decimal(number) * GRAMS_PER_UNIT[unit]).quantize(Decimal(1), rounding=ROUND_HALF_UP))
