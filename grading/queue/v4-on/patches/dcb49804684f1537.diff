+"""Utilities for parsing simple duration strings."""
+
+import re
+
+__all__ = ["parse_duration"]
+
+_DURATION_RE = re.compile(r"(?:(\d+)h)?\s*(?:(\d+)m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Return a duration string as a number of whole minutes.
+
+    Accepted inputs may contain hours and/or minutes, with hours before
+    minutes, each unit at most once, case-insensitive units, and surrounding
+    whitespace ignored. Examples include "2h", "45m", "1h30m", and "1h 30m".
+
+    Raises:
+        ValueError: If the text is empty or not a valid duration.
+    """
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError("Invalid duration")
+
+    hours_text, minutes_text = match.groups()
+    if hours_text is None and minutes_text is None:
+        raise ValueError("Invalid duration")
+
+    minutes = 0
+    if hours_text is not None:
+        minutes += int(hours_text) * 60
+    if minutes_text is not None:
+        minutes += int(minutes_text)
+
+    return minutes
