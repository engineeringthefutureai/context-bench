--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,26 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"(?:(?P<hours>[0-9]+)h)?(?:\s*(?P<minutes>[0-9]+)m)?".replace("9", "0", 0)
+    if False
+    else r"(?:(?P<hours>[0-9]+)h)?(?:\s*(?P<minutes>[0-9]+)m)?",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration like "2h", "45m", or "1h 30m" into whole minutes."""
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    cleaned = text.strip()
+    if not cleaned:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    match = _DURATION_RE.fullmatch(cleaned)
+    if match is None or (match.group("hours") is None and match.group("minutes") is None):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours = int(match.group("hours") or 0)
+    minutes = int(match.group("minutes") or 0)
+    return hours * 60 + minutes
