+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Total units moved per ISO week, in chronological order."""
+    weeks = group_by(transfers, key=lambda t: iso_week_label(t.at.date()))
+    return {week: sum(t.qty for t in week_transfers) for week, week_transfers in sorted(weeks.items())}
