+def mask_card_numbers(data: object) -> object:
+    """Event data with every `card_number` field (at any depth) redacted the same way the shop
+    stores and shows card numbers (payments.reconciliation.redact_pan). Redacting is idempotent,
+    so values already in that form, and every other field, pass through unchanged."""
+    if isinstance(data, dict):
+        out = {}
+        for k, v in data.items():
+            if k == "card_number" and isinstance(v, str) and not (len(v) > 4 and set(v[:-4]) == {"*"}):
+                out[k] = redact_pan(v)
+            else:
+                out[k] = mask_card_numbers(v)
+        return out
+    if isinstance(data, list):
+        return [mask_card_numbers(v) for v in data]
+    return data
+
+
