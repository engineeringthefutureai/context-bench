+from shopkit.core.pricing import cashRoundCents
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Return the amount, in cents the cashier should ask the customer to pay.
+
+    Card payments are settled at the exact total. Cash payments are rounded
+    using the same national cash-rounding rules used elsewhere in the shop.
+    """
+    method = paid_by.strip().lower() if isinstance(paid_by, str) else paid_by
+
+    if method == "card":
+        return total_cents
+
+    if method == "cash":
+        if not isinstance(currency, str) or not currency.strip():
+            raise ValueError("currency must be a non-empty string")
+        return cashRoundCents(total_cents, currency.strip().upper())
+
+    raise ValueError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
