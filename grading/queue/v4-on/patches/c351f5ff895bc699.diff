+def _feature_flags(env: dict[str, str]) -> dict[str, bool]:
+    prefix = "SHOPKIT_FLAG_"
+    return {name[len(prefix):].lower(): value.strip().lower() in _TRUE_VALUES
+            for name, value in env.items() if name.startswith(prefix)}
