--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,27 @@
+"""Partner-facing answers to "why did my event arrive late?"."""
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None,
+                  under_review: Callable[[str], bool] | None) -> str | None:
+    """Why the webhook worker would hold `event` for `order_id` right now, or None when it
+    would send it normally.
+
+    Mirrors the fraud-review hold in `deliver_pending`: events about an order that is in
+    review wait until the review clears, while ALWAYS_DELIVER events (cancellations,
+    refunds) go out regardless, so partners always learn an order is off.
+    """
+    if not order_id or under_review is None or event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        # deliver_pending fails closed when the review lookup breaks; so does this answer.
+        return "order in fraud review (review lookup failed, holding by default)"
+    if reviewing:
+        return "order in fraud review"
+    return None
