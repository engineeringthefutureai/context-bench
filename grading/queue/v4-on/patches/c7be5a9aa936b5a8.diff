--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.inventory.lots import NotEnoughStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,12 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order by lowering its available quantity.
+        Raises NotEnoughStock without changing anything if there is not enough available."""
+        available = self._on_hand.get(sku, 0)
+        if available < qty:
+            raise NotEnoughStock(f"not enough {sku}", sku=sku, requested=qty,
+                                 available=available)
+        self._on_hand[sku] = available - qty
