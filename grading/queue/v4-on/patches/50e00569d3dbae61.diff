--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,54 @@
+"""Preview a seller's payout for a period without changing anything.
+
+The preview re-runs the same ``build_payout_batch`` logic the weekly payout run
+uses, but on private copies of the hold book and rollover balances, so holds
+that would be released and balances that would be carried forward are left
+exactly as they were for the real run.
+"""
+
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+from shopkit.payouts.batching import Rollover, build_payout_batch
+from shopkit.payouts.holds import HoldBook
+from shopkit.payouts.models import Adjustment, Earning, Seller
+
+
+def preview_payout(
+    seller: Seller,
+    earnings: list[Earning],
+    adjustments: list[Adjustment],
+    period_start: date,
+    period_end: date,
+    holds: HoldBook,
+    rollover: Rollover,
+) -> tuple[str, int]:
+    """Return ``(status, net_cents)`` for this seller's payout in the period.
+
+    The values are exactly what the weekly batch would produce for this seller
+    for ``period_start``..``period_end``.  The preview is side-effect free:
+    ``holds`` and ``rollover`` are copied before the batch runs, so released
+    holds and carried balances stay as they were.
+    """
+    seller_earnings = [e for e in earnings if e.seller_id == seller.id]
+    seller_adjustments = [a for a in adjustments if a.seller_id == seller.id]
+
+    result = build_payout_batch(
+        [seller],
+        seller_earnings,
+        seller_adjustments,
+        period_start,
+        period_end,
+        holds=copy.deepcopy(holds),
+        rollover=copy.deepcopy(rollover),
+    )
+
+    for payout in result.payouts:
+        if payout.seller_id == seller.id:
+            return payout.status, payout.net_cents
+
+    # No payout was produced (suspended seller, nothing to pay, ...): report
+    # the batch's reason and a zero amount, since nothing goes out this period.
+    return result.skipped.get(seller.id, "skipped"), 0
