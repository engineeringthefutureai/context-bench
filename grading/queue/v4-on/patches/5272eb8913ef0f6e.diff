--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+import re
+
+_DURATION_RE = re.compile(r"(?P<hours>[0-9]+h)?\s*(?P<minutes>[0-9]+m)?")
+
+
+def parse_duration(text: str) -> int:
+    """Parse hours and/or minutes such as ``2h``, ``45m`` or ``1h 30m`` into whole minutes."""
+    match = _DURATION_RE.fullmatch(text.strip().lower())
+    if match is None or (match.group("hours") is None and match.group("minutes") is None):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    minutes = 0
+    hours = match.group("hours")
+    if hours is not None:
+        minutes += int(hours[:-1]) * 60
+
+    minutes_part = match.group("minutes")
+    if minutes_part is not None:
+        minutes += int(minutes_part[:-1])
+
+    return minutes
