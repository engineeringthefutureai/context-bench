--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,41 @@
+"""Partner-facing answers to "why are my order events arriving late?".
+
+`explain_delay` mirrors the decision the delivery worker
+(api.webhook_delivery.deliver_pending) makes for a delivery: the same condition that
+holds the delivery back on every run yields a short reason here; anything the worker
+would send normally yields None."""
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None,
+                  under_review: Callable[[str], bool] | None) -> str | None:
+    """Short reason the webhook worker would hold this event back right now, or None if
+    it would send it normally.
+
+    `event` is the webhook event name (e.g. "order.paid"); `order_id` is the order the
+    event is about (None when the event carries no order). `under_review(order_id)` says
+    whether that order is in fraud review - the same callable the worker receives in
+    deliver_pending.
+
+    The worker holds back events about an order that is in fraud review until the review
+    clears, so partners do not start fulfilling an order we may still cancel. Cancellations
+    and refunds (ALWAYS_DELIVER) are sent regardless: partners must learn that an order is
+    off. A review lookup error means "held" here too, because the worker fails closed -
+    better late than shipped to a fraudster. Events not tied to an order, and runs with no
+    review lookup, are never held for this reason.
+    """
+    if not event:
+        raise ValueError("event must be a non-empty webhook event name")
+    if order_id is None or under_review is None or event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        return "order is in fraud review (review lookup failed; held until it succeeds)"
+    if reviewing:
+        return "order is in fraud review; event is held until the review clears"
+    return None
