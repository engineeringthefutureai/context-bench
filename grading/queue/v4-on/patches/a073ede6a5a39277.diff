--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,37 @@
+"""Parse short duration strings into whole minutes."""
+
+import re
+
+__all__ = ["parse_duration"]
+
+_HOURS = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m)?", re.IGNORECASE)
+_MINUTES = re.compile(r"([0-9]+)m", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Return the number of minutes in a duration string.
+
+    Valid strings contain only an optional hours part followed by an
+    optional minutes part, e.g. ``"2h"``, ``"45m"``, ``"1h30m"`` or
+    ``"1h 30m"``. Unit letters are case-insensitive and surrounding
+    whitespace is ignored.
+
+    Raises:
+        ValueError: If ``text`` is not a valid duration string.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    candidate = text.strip()
+
+    hours_match = _HOURS.fullmatch(candidate)
+    if hours_match is not None:
+        hours = int(hours_match.group(1))
+        minutes = int(hours_match.group(2) or 0)
+        return hours * 60 + minutes
+
+    minutes_match = _MINUTES.fullmatch(candidate)
+    if minutes_match is not None:
+        return int(minutes_match.group(1))
+
+    raise ValueError(f"invalid duration: {text!r}")
