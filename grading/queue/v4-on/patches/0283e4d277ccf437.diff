--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,28 @@
+"""Parsing helpers for shorthand durations."""
+
+import re
+
+_DURATION_RE = re.compile(
+    r"\s*(?:(\d+)h)?(?:\s*(\d+)m)?\s*",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse an hours/minutes duration such as ``2h`` or ``1h 30m`` into minutes.
+
+    Only whole hours and minutes are accepted, with hours before minutes and
+    each unit used at most once. Raises ValueError for anything else.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    match = _DURATION_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours, minutes = match.groups()
+    if hours is None and minutes is None:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    return int(hours or 0) * 60 + int(minutes or 0)
