--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class NotEnoughStock(Conflict):
+    """A reservation exceeds on-hand stock; stock is left unchanged."""
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,19 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order, lowering the available quantity.
+
+        Raises ValueError if qty is not positive, and NotEnoughStock (409) with the
+        `requested` and `available` quantities if stock is short; on failure
+        nothing is changed.
+        """
+        if qty <= 0:
+            raise ValueError("qty must be positive")
+        on_hand = self._on_hand.get(sku, 0)
+        if qty > on_hand:
+            raise NotEnoughStock(
+                f"Not enough stock for {sku}", requested=qty, available=on_hand
+            )
+        self._on_hand[sku] = on_hand - qty
