--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+"""Parsing of simple human durations ("1h30m") into whole minutes."""
+import re
+
+_DURATION = re.compile(r"\s*(?:([0-9]+)h)?\s*(?:([0-9]+)m)?\s*", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes in `text`.
+
+    Accepts hours and/or minutes, hours before minutes, each unit at most once,
+    e.g. "2h", "45m", "1h30m" or "1h 30m". Units are case-insensitive and
+    surrounding whitespace is ignored. Anything else raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    match = _DURATION.fullmatch(text)
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group(1) or 0)
+    minutes = int(match.group(2) or 0)
+    return hours * 60 + minutes
