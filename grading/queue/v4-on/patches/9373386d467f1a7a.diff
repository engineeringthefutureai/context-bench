--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,45 @@
+import re
+
+_GRAMS_PER_UNIT = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (453_592_37, 100_000),
+    "oz": (28_349_523_125, 1_000_000_000),
+}
+
+_WEIGHT_RE = re.compile(
+    r"^(?P<number>[0-9]+(?:\.[0-9]+)?|\.[0-9]+)\s*(?P<unit>g|kg|lb|oz)$",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Return the whole-gram weight for a warehouse-typed weight string.
+
+    Accepts a non-negative integer or decimal followed by g, kg, lb or oz,
+    with optional whitespace between the number and the unit.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    match = _WEIGHT_RE.match(text.strip())
+    if match is None:
+        raise ValueError("weight must be a non-negative number followed by g, kg, lb, or oz")
+
+    number = match.group("number")
+    unit = match.group("unit").lower()
+
+    if "." in number:
+        whole, _, frac = number.partition(".")
+        numerator = int((whole or "0") + frac)
+        denominator = 10 ** len(frac)
+    else:
+        numerator = int(number)
+        denominator = 1
+
+    factor_numerator, factor_denominator = _GRAMS_PER_UNIT[unit]
+    denominator *= factor_denominator
+    numerator *= factor_numerator
+
+    # Round half up: floor(x + 1/2) for x = numerator / denominator.
+    return (2 * numerator + denominator) // (2 * denominator)
