--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,35 @@
+"""Parsing of human-written durations, e.g. "2h", "45m", "1h30m" or "1h 30m".
+
+Only whole hours and/or whole minutes are accepted: hours come before
+minutes, each unit appears at most once, the unit letters are
+case-insensitive and surrounding whitespace is ignored. Anything else
+raises ValueError, so a typo can never silently become a different
+duration.
+"""
+from __future__ import annotations
+
+import re
+
+# Hours, then minutes, each at most once and only in that order. Whitespace
+# may separate the two parts ("1h 30m") but not a number from its unit.
+_DURATION_RE = re.compile(r"(?:(\d+)h)?\s*(?:(\d+)m)?", re.IGNORECASE | re.ASCII)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration into whole minutes: '2h' -> 120, '45m' -> 45,
+    '1h30m' -> 90, '1h 30m' -> 90. Units are case-insensitive and
+    surrounding whitespace is ignored.
+
+    Raises ValueError for anything else: empty text, other units, a
+    missing number, minutes before hours, a unit used twice, and
+    negative or fractional numbers."""
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    s = text.strip()
+    if not s:
+        raise ValueError("empty duration")
+    m = _DURATION_RE.fullmatch(s)
+    if m is None:
+        raise ValueError(f"bad duration {text!r}")
+    hours, minutes = m.groups()
+    return (int(hours) if hours else 0) * 60 + (int(minutes) if minutes else 0)
