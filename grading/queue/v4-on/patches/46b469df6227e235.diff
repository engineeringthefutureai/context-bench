--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.inventory.lots import NotEnoughStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,15 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku`, lowering what available() reports.
+        Raises NotEnoughStock without changing anything when on hand is
+        insufficient, so the API answers 409 with `requested`/`available`."""
+        if qty < 1:
+            raise ValueError("qty must be >= 1")
+        available = self.available(sku)
+        if available < qty:
+            raise NotEnoughStock(f"only {available} x {sku} in stock", sku=sku,
+                                 requested=qty, available=available)
+        self._on_hand[sku] = available - qty
