--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,17 @@
+import re
+
+
+_DURATION_RE = re.compile(
+    r"\s*(?:(?P<hours>[0-9]+)h(?:\s*(?P<minutes>[0-9]+)m)?|(?P<minutes_only>[0-9]+)m)\s*",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a string like ``1h30m``, ``2h``, or ``45m`` into whole minutes."""
+    match = _DURATION_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group("hours") or 0)
+    minutes = int(match.group("minutes") or match.group("minutes_only") or 0)
+    return hours * 60 + minutes
