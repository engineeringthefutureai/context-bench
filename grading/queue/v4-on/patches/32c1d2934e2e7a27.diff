--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,43 @@
+"""Parsing helpers for physical units entered by warehouse staff."""
+
+import re
+from decimal import Decimal
+
+_WEIGHT_RE = re.compile(
+    r"\s*(?P<number>[0-9]+(?:\.[0-9]+)?)\s*(?P<unit>g|kg|lb|oz)\s*",
+    re.IGNORECASE,
+)
+
+# Exact gram equivalents as (numerator, denominator) to keep rounding integer-based.
+_GRAMS_PER_UNIT = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight such as ``"1.5 kg"`` and return whole grams.
+
+    The input must be a non-negative integer or dot-separated decimal,
+    optional whitespace, and one of ``g``, ``kg``, ``lb`` or ``oz``.
+    Leading and trailing whitespace is ignored. The result is rounded to
+    the nearest gram, with halfway values rounding up. ``ValueError`` is
+    raised for any other input.
+    """
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"Invalid weight: {text!r}")
+
+    number = match.group("number")
+    unit = match.group("unit").lower()
+
+    # Decimal().as_integer_ratio() gives the exact decimal value as a rational.
+    numerator, denominator = Decimal(number).as_integer_ratio()
+
+    numerator *= _GRAMS_PER_UNIT[unit][0]
+    denominator *= _GRAMS_PER_UNIT[unit][1]
+
+    # For non-negative values, this is floor(value + 0.5), i.e. half rounds up.
+    return (2 * numerator + denominator) // (2 * denominator)
