--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,39 @@
+"""Preview what a discount code would save on a cart, before it is applied.
+
+The shopper enters a code at checkout and wants to see how much it would
+take off the order total without committing to it. Rather than re-deriving
+the discount, the preview prices the cart through the same price_cart the
+cart page uses - once without the code and once with it - so the number
+shown is exactly the drop in the total the shopper would see.
+"""
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product],
+                   code: str | None, coupons: dict[str, Coupon] | None,
+                   engine: PricingEngine, ship_to: Address, weight_g: int,
+                   at: datetime) -> int:
+    """Saving in cents that `code` would give on this cart.
+
+    Priced exactly as the cart page prices it: the order total with the code
+    applied minus the total without it, so sales, price lists, tax and
+    shipping are all in exactly as the shopper would see them (standard
+    tier, non-member). A code that would not apply no discount - unknown, expired,
+    over its use limit or below its minimum order - leaves the total
+    unchanged, so the saving is 0.
+    """
+    if not items or not code or not coupons:
+        return 0
+    base = price_cart(items, products, engine=engine, ship_to=ship_to,
+                      weight_g=weight_g, at=at)
+    with_code = price_cart(items, products, engine=engine, ship_to=ship_to,
+                           weight_g=weight_g, at=at,
+                           coupon_code=code, coupons=coupons)
+    return base.total_cents - with_code.total_cents
