+def _mask_card_numbers(value: object) -> object:
+    """Return a copy of event data with any ``card_number`` field masked using the shop's redaction."""
+    if isinstance(value, dict):
+        masked = {}
+        for key, item in value.items():
+            if key == "card_number" and isinstance(item, str):
+                masked[key] = redact_pan(item)
+            else:
+                masked[key] = _mask_card_numbers(item)
+        return masked
+    if isinstance(value, list):
+        return [_mask_card_numbers(item) for item in value]
+    return value
+
