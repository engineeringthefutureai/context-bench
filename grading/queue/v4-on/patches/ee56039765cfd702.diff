--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,28 @@
+import re
+
+_HOURS_MINUTES_RE = re.compile(r"([0-9]+)h(?:\s*([0-9]+)m)?", re.IGNORECASE)
+_MINUTES_RE = re.compile(r"([0-9]+)m", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse an hours and/or minutes duration string into whole minutes.
+
+    Accepts forms such as "2h", "45m", "1h30m", and "1h 30m". Units are
+    case-insensitive and surrounding whitespace is ignored. Anything else
+    raises ValueError.
+    """
+    s = text.strip()
+    if not s:
+        raise ValueError("invalid duration")
+
+    match = _HOURS_MINUTES_RE.fullmatch(s)
+    if match:
+        hours = int(match.group(1))
+        minutes = int(match.group(2) or 0)
+        return hours * 60 + minutes
+
+    match = _MINUTES_RE.fullmatch(s)
+    if match:
+        return int(match.group(1))
+
+    raise ValueError("invalid duration")
