+from shopkit.core.pricing import cashRoundCents
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Return the amount the cashier asks the customer to pay, in cents.
+
+    Card payments pay the exact total. Cash payments are rounded using the
+    shop's cash-rounding rules, currently the same way cash is treated elsewhere.
+    """
+    if paid_by == "card":
+        return int(total_cents)
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    raise ValueError("paid_by must be 'card' or 'cash'")
