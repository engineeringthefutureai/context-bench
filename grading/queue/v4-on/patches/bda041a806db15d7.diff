+# Banks settle card refunds in five business days after the refund is issued.
+BANK_SETTLEMENT_DAYS = 5
+# The shop's usual business-day calendar: weekdays, minus the days the shop is closed.
+# (month, day) pairs, so the closures apply in every year.
+SHOP_CLOSED_DAYS = frozenset({(1, 1), (12, 25)})
+
+
+def _is_business_day(day: date) -> bool:
+    return day.weekday() < 5 and (day.month, day.day) not in SHOP_CLOSED_DAYS
+
+
+def expected_arrival(refund: Refund) -> date:
+    """When the money should show on the customer's card: five business days after the day the
+    refund was issued, on the shop's business-day calendar (weekends and the days the shop is closed
+    don't count)."""
+    day = refund.at.date()
+    days = BANK_SETTLEMENT_DAYS
+    while days > 0:
+        day += timedelta(days=1)
+        if _is_business_day(day):
+            days -= 1
+    return day
