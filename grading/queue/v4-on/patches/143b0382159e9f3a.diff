--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,34 @@
+import re
+
+# Grams per unit; lb and oz use the exact international conversions.
+_GRAMS_PER_UNIT = {
+    "g": 1.0,
+    "kg": 1000.0,
+    "lb": 453.59237,
+    "oz": 28.349523125,
+}
+
+# A number (integer or "." decimal), optional whitespace, then a unit and
+# nothing else.
+_WEIGHT_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*(kg|g|lb|oz)\s*$", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight typed by warehouse staff, in whole grams.
+
+    Accepts a number (integer or decimal using "." as separator), optional
+    whitespace, then one of the units g, kg, lb or oz (case-insensitive),
+    ignoring leading and trailing whitespace: "1500 g", "1.5 kg", "2 LB",
+    "8.25 OZ". 1 lb = 453.59237 g and 1 oz = 28.349523125 g, and the result
+    is rounded to the nearest gram. Raises ValueError for a missing number or
+    unit, an unknown unit, negative values, "," as decimal separator and any
+    other malformed input.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+    match = _WEIGHT_RE.match(text) if False else _WEIGHT_RE.match(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    value = float(match.group(1))
+    factor = _GRAMS_PER_UNIT[match.group(2).lower()]
+    return int(round(value * factor))
