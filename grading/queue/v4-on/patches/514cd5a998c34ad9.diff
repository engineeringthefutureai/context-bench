--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,45 @@
+"""Shipping option checks: what delivery options can be offered for a cart."""
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from shopkit.warehouse.sites import Site
+
+_EXPRESS_SERVICES = frozenset({"express", "air"})
+
+
+def _site_supports_express(site: Site) -> bool:
+    services = getattr(site, "services", ()) or ()
+    if isinstance(services, str):
+        services = (services,)
+    return any(service in _EXPRESS_SERVICES for service in services)
+
+
+def express_available(skus: Iterable[str], sites: Iterable[Site],
+                       hazmat_skus: Iterable[str] | None = None) -> bool:
+    """Return True if a cart with these SKUs would be allocated to an express wave.
+
+    Express is not offered for an empty cart, when no candidate site is supplied, when any SKU is
+    dangerous goods (allocate_wave downgrades hazmat orders to standard), or when no candidate site
+    has an express/air service.
+    """
+    if skus is None or sites is None:
+        return False
+
+    if isinstance(skus, str):
+        skus = (skus,)
+    skus = tuple(skus)
+    if not skus:
+        return False
+
+    if hazmat_skus is None:
+        hazmat = frozenset()
+    elif isinstance(hazmat_skus, str):
+        hazmat = frozenset((hazmat_skus,))
+    else:
+        hazmat = frozenset(hazmat_skus)
+
+    if any(sku in hazmat for sku in skus):
+        return False
+
+    return any(_site_supports_express(site) for site in sites)
