--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,44 @@
+import re
+
+# Exact factors from one unit to grams, stored as (numerator, denominator) so
+# conversion stays exact for large inputs.
+_UNITS_TO_GRAMS = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45_359_237, 100_000),
+    "oz": (28_349_523_125, 1_000_000_000),
+}
+
+_WEIGHT_RE = re.compile(
+    r"([0-9]+(?:\.[0-9]+)?|\.[0-9]+)\s*(g|kg|lb|oz)",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a staff-typed weight such as "1.5 kg" into whole grams.
+
+    Accepts an integer or decimal number (decimal separator is "."), optional
+    whitespace, and one of g, kg, lb or oz (case-insensitive). The result is
+    rounded half-up to the nearest gram. Any other input raises ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError("invalid weight")
+
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+
+    number, unit = match.groups()
+    if "." in number:
+        whole, frac = number.split(".", 1)
+        scale = len(frac)
+        numerator = int(whole + frac) if whole else int(frac)
+    else:
+        numerator = int(number)
+        scale = 0
+
+    factor_num, factor_den = _UNITS_TO_GRAMS[unit.lower()]
+    denominator = (10 ** scale) * factor_den
+    numerator *= factor_num
+    return (numerator + denominator // 2) // denominator
