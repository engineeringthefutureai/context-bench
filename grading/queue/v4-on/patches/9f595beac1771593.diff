--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,17 @@
+from shopkit.errors import Conflict
+
+
+class InsufficientStock(Conflict):
+    """409 business error for reserving more stock than is available."""
+
+    def __init__(self, sku: str, requested: int, available: int) -> None:
+        super().__init__(f"{sku}: only {available} in stock")
+        self.sku = sku
+        self.requested = requested
+        self.available = available
+        self.details = {"requested": requested, "available": available}
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +23,12 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku`, lowering available stock by that amount."""
+        if qty < 1:
+            raise ValueError("qty must be >= 1")
+        available = self.available(sku)
+        if available < qty:
+            raise InsufficientStock(sku, qty, available)
+        self._on_hand[sku] = available - qty
