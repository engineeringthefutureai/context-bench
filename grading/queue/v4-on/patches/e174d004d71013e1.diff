+"""Cash till amount calculations for pop-up stores.
+
+Card payments are charged exactly; cash payments are rounded the way the shop already
+treats cash amounts elsewhere.
+"""
+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+
+_PAYMENT_METHODS = ("card", "cash")
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Return the amount, in cents, the cashier should ask the customer to pay.
+
+    ``paid_by`` must be ``"card"`` or ``"cash"``. Card payments pay the exact total;
+    cash payments are rounded using the shop's cash rules for ``currency``.
+    """
+    if paid_by not in _PAYMENT_METHODS:
+        raise ValueError(f"paid_by must be one of {_PAYMENT_METHODS}, got {paid_by!r}")
+
+    if paid_by == "card":
+        return total_cents
+
+    return cashRoundCents(total_cents, currency)
