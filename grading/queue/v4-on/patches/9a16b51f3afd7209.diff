+def _mask_card_numbers(data: Any) -> Any:
+    """Event data with every `card_number` value masked by redact_pan — the same masking the shop
+    uses to store and show card numbers. All other values pass through unchanged."""
+    if isinstance(data, dict):
+        return {key: redact_pan(value) if key == "card_number" and isinstance(value, str)
+                else _mask_card_numbers(value)
+                for key, value in data.items()}
+    if isinstance(data, list):
+        return [_mask_card_numbers(item) for item in data]
+    return data
