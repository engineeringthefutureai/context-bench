--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,70 @@
+"""Where a refund would go, before the agent presses Refund.
+
+refund_destinations() computes the same destination split that
+payments.settlement.settle_refund() applies to the same amount on the same payments, without
+touching anything: no provider call, no payment refund, no ledger entry. The admin screen shows it
+next to the Refund button so the agent can tell the customer the card / store credit / gift card
+split before it happens.
+"""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+from shopkit.utils.dates import utc_now
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                        today: date | None = None) -> dict[str, int]:
+    """Where a refund of amount_cents (goods + tax + shipping) for order_id would go back to.
+
+    Same split as settle_refund: the amount goes across the order's captured payments in
+    proportion to what is still refundable on each, with the leftover cents to the card payments
+    first (so a gift card never gets more than its share). A gift card payment's share goes back to a
+    gift card; a card payment's share goes back to the card, except when the payment is older
+    than CARD_REFUND_MAX_AGE_DAYS - the card networks refuse those, so settle_refund books them
+    as store credit.
+
+    Returns {"card": int, "store_credit": int, "gift_card": int}. Pure preview: nothing is
+    refunded and no payment is changed. Raises the same errors as settle_refund for an amount it
+    could not settle (non-positive, no captured payment, more than is refundable)."""
+    today = today or utc_now().date()
+    if amount_cents <= 0:
+        raise ShopError("refund amount must be positive", order_id=order_id)
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}", order_id=order_id,
+                             requested=amount_cents, refundable=refundable)
+
+    # identical split to settle_refund: cards sort before gift cards, so the leftover cents land
+    # on the oldest card payment first, capped at what is still refundable on each payment
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    out = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            out["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            out["store_credit"] += share
+        else:
+            out["card"] += share
+    return out
