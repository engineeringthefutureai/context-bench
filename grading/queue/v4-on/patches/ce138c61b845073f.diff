+++ b/shopkit/shipping/options.py
@@ -0,0 +1,19 @@
+"""Delivery options offered at checkout, derived from the same rules the warehouse allocates by.
+
+The wave engine (warehouse.waves.allocate_wave) puts an express order into an express wave unless it
+contains a hazmat SKU: express leaves by air, and dangerous goods only go by ground (such an order is
+downgraded to a standard wave instead). Nothing else keeps an order out of an express wave, so checkout
+may offer express exactly when the candidate sites would ship the cart and no cart SKU is classed as
+dangerous goods."""
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus, sites: list[Site], hazmat_skus) -> bool:
+    """True when the warehouse would put an order with these SKUs into an express wave.
+
+    skus: the cart's SKUs; sites: the warehouse sites that could ship the order; hazmat_skus: the SKUs
+    classed as dangerous goods (ground only, never an express wave). False when there is no site that
+    could ship the order, the cart has no SKUs, or any cart SKU is hazmat."""
+    if not sites or not skus:
+        return False
+    return not any(sku in hazmat_skus for sku in set(skus))
