+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Total units moved in each ISO week, ordered chronologically.
+
+    Weeks are labelled ``YYYY-Www`` to match the other dashboards.
+    """
+    totals: dict[str, int] = {}
+    for item in transfers:
+        at = item.at
+        if at.tzinfo is not None:
+            at = at.astimezone(timezone.utc)
+        iso_year, iso_week, _ = at.isocalendar()
+        label = f"{iso_year}-W{iso_week:02d}"
+        totals[label] = totals.get(label, 0) + item.qty
+    return dict(sorted(totals.items()))
