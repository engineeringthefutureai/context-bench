--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,19 @@
+"""Duration text helpers for SLAs, shipping estimates and support windows."""
+import re
+
+# Hours and/or minutes, hours first, each unit at most once, any case,
+# optional whitespace between parts: "2h", "45m", "1h30m", "1h 30m".
+_DURATION_RE = re.compile(r"(?P<hours>\d+h)?\s*(?P<minutes>\d+m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes for a duration written as hours and/or minutes.
+    "2h" -> 120, "45m" -> 45, "1h30m" -> 90. Raises ValueError for anything
+    else: empty text, other units, a missing number, minutes before hours,
+    negative numbers or a repeated unit."""
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None or (match.group("hours") is None and match.group("minutes") is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(match.group("hours")[:-1]) if match.group("hours") else 0
+    minutes = int(match.group("minutes")[:-1]) if match.group("minutes") else 0
+    return hours * 60 + minutes
