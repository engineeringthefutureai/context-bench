+def _redact_card_numbers(data: Any) -> Any:
+    """Copy of `data` with every `card_number` field masked via redact_pan, the same way the shop
+    stores and shows card numbers. Other values pass through unchanged."""
+    if isinstance(data, dict):
+        out: dict[Any, Any] = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, str):
+                out[key] = redact_pan(value)
+            else:
+                out[key] = _redact_card_numbers(value)
+        return out
+    if isinstance(data, (list, tuple)):
+        return [_redact_card_numbers(value) for value in data]
+    return data
+
