--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,32 @@
+"""Delivery options offered at checkout.
+
+Checkout may only offer a delivery service the warehouse will actually honour: the predicates in
+this module mirror the rules warehouse.waves.allocate_wave applies when it decides which wave an
+order goes into, so a service is advertised only when an order placed with it would really be
+waved that way."""
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: Iterable[str] | None, sites: Iterable[Site] | None,
+                      hazmat_skus: frozenset[str] | None = None) -> bool:
+    """Whether an express order containing these SKUs would go into an express wave.
+
+    Mirrors the express path of warehouse.waves.allocate_wave: an order holding any hazmat SKU is
+    downgraded to a standard wave (hazmat may only travel by ground, express leaves by air), and
+    an order no site can ship is skipped and never waved at all. In every other case an express
+    order is waved as express.
+
+    skus: the cart's SKUs; with nothing in the cart there is no order to wave, so express is not
+        available.
+    sites: the warehouse sites that could ship the order (country filtering is the caller's).
+    hazmat_skus: the SKUs classed as dangerous goods.
+    """
+    skus = list(skus) if skus else []
+    sites = list(sites) if sites else []
+    if not skus or not sites:
+        return False
+    return not any(sku in (hazmat_skus or ()) for sku in skus)
