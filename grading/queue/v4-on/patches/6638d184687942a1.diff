--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"(?P<hours>[0-9]+)h(?:\s*(?P<minutes>[0-9]+)m)?|(?P<minutes_only>[0-9]+)m",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse an hour/minute duration such as "2h", "45m", "1h30m" or "1h 30m".
+
+    Returns the duration in whole minutes. Hours must come before minutes, each
+    unit may appear at most once, units are case-insensitive, and surrounding
+    whitespace is ignored. Anything else raises ValueError.
+    """
+    m = _DURATION_RE.fullmatch(text.strip())
+    if not m:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(m["hours"] or 0)
+    minutes = int(m["minutes"] or m["minutes_only"] or 0)
+    return hours * 60 + minutes
