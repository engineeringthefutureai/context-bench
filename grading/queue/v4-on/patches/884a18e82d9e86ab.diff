+"""Amounts the cashier asks for at the cash till.
+
+The pop-up stores take card or cash only. Card settles for the exact
+total; cash settles for the national cash amount, rounded exactly the
+way the shop already rounds cash elsewhere (``cashRoundCents`` in
+``shopkit.core.pricing``).
+"""
+
+from shopkit.core.pricing import cashRoundCents
+from shopkit.errors import ShopError
+
+__all__ = ["CARD", "CASH", "UnknownPaymentMethod", "amount_due"]
+
+CARD = "card"
+CASH = "cash"
+
+
+class UnknownPaymentMethod(ShopError):
+    """``paid_by`` is neither card nor cash."""
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Amount the cashier asks the customer to pay, in cents.
+
+    ``card`` settles for the exact ``total_cents``. ``cash`` settles for
+    the cash amount allowed in ``currency`` under that country's cash
+    rules, the same way the shop rounds cash elsewhere (for example the
+    nearest 5 cents in Canada, where pennies no longer exist).
+
+    Raises
+    ------
+    ShopError
+        If ``total_cents`` is not a non-negative whole number of cents.
+    UnknownPaymentMethod
+        If ``paid_by`` is not ``"card"`` or ``"cash"``.
+    """
+    if isinstance(total_cents, bool) or not isinstance(total_cents, int):
+        raise ShopError("total_cents must be a whole number of cents")
+    if total_cents < 0:
+        raise ShopError("total_cents must not be negative")
+    if paid_by == CARD:
+        return total_cents
+    if paid_by == CASH:
+        return cashRoundCents(total_cents, currency)
+    raise UnknownPaymentMethod(f"unsupported payment method: {paid_by!r}")
