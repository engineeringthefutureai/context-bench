--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,29 @@
+"""Unit helpers for shipping: warehouse staff type weights in, the system keeps whole grams."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact international avoirdupois conversions; grams is the unit of record for shipping.
+GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# A number (integer or decimal, "." only -- never ","), optional whitespace, then a unit.
+_WEIGHT_RE = re.compile(r"(?P<number>\d+(?:\.\d+)?)\s*(?P<unit>g|kg|lb|oz)", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight as typed by warehouse staff, in whole grams.
+
+    A number (integer or decimal with "." separator), optional whitespace, then a unit g,
+    kg, lb or oz (case-insensitive); leading and trailing whitespace is ignored.
+    parse_weight("2.5 kg") -> 2500, parse_weight("1lb") -> 454, parse_weight("16 OZ") -> 454.
+    Rounds to the nearest gram. Raises ValueError on a missing number or unit, an unknown
+    unit, a negative value or "," as the decimal separator."""
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    grams = Decimal(match["number"]) * GRAMS_PER_UNIT[match["unit"].lower()]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
