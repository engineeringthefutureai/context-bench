--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,26 @@
+"""Delivery options offered at checkout.
+
+Checkout may only offer a delivery option the warehouse can actually keep, so
+these checks mirror the wave allocation in warehouse.waves.allocate_wave, which
+puts every order into one wave per site and service (express | standard)."""
+from __future__ import annotations
+
+from collections.abc import Collection, Iterable
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: Iterable[str], sites: Iterable[Site], hazmat_skus: Collection[str]) -> bool:
+    """Whether the warehouse would put an order with these SKUs into an express wave.
+
+    `skus` are the cart's SKUs, `sites` the warehouse sites that could ship the
+    order (already filtered for stock and country) and `hazmat_skus` the SKUs
+    classed as dangerous goods. Express leaves by air, so at least one of the
+    sites must offer air service; an order containing a hazmat SKU is
+    downgraded to a standard wave and never ships express.
+    """
+    if not skus:
+        return False                     # an order with no lines is not allocated to any wave
+    if any(sku in hazmat_skus for sku in skus):
+        return False                     # hazmat only goes by ground
+    return any("air" in site.services for site in sites)
