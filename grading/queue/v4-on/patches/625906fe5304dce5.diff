+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,20 @@
+"""Pallet labels for the warehouse scanner.
+
+The scanner reads the finance system's item numbers, not our SKUs, so every
+item on a label is rendered as its ERP item number.
+"""
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Build the label text for a pallet.
+
+    The first line is ``PALLET <pallet_id>`` followed by one line per item,
+    ``<item number> x<qty>``, in the order given. The item number is the one
+    the finance system (ERP) knows the product by.
+    """
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
