--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,42 @@
+"""Find the order references a customer mentioned in a message and write each one the way
+the shop writes that kind of reference everywhere else, so support can turn them into links:
+"so 2019 123" and "SO-2019-000123" -> "SO-2019-000123", "ORD_1A2B3C4D5E6F" -> "ord_1a2b3c4d5e6f".
+"""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# What an order reference can look like inside a message: the old form (SO/SOB + year +
+# sequence, case ignored, parts separated by dashes, spaces or nothing, sequence 1-6 digits)
+# and the new storefront id. The trailing (?!\w) keeps us from reading a reference out of a
+# longer token ("SO-2019-123abc" and "ord_1a2b3c4d5e6f7" are not references). Every
+# candidate is still validated with parseOrderRef, the shop's own definition of a valid
+# reference (e.g. no years before 2017, exactly 12 hex for the new ids).
+_REF_CANDIDATES = re.compile(
+    r"\b(?:SOB?[\s-]*\d{4}[\s-]*\d{1,6}|ord_[0-9a-fA-F]{12})(?!\w)",
+    re.IGNORECASE,
+)
+
+
+def order_refs(text: str) -> list[str]:
+    """Order references mentioned in text, in the order they first appear, without
+    duplicates, each written the canonical way the shop writes that kind of reference
+    (order_engine.formatOrderRef): "so 2019 123" -> "SO-2019-000123",
+    "sob 2020 45" -> "SOB-2020-000045", "ORD_1A2B3C4D5E6F" -> "ord_1a2b3c4d5e6f".
+    Text that isn't a valid order reference is left out."""
+    if not text:
+        return []
+    found: list[str] = []
+    seen: set[str] = set()
+    for m in _REF_CANDIDATES.finditer(text):
+        parsed = parseOrderRef(m.group(0))
+        if parsed is None:
+            continue
+        kind, year, seq = parsed
+        ref = formatOrderRef(kind, year, seq)
+        if ref not in seen:
+            seen.add(ref)
+            found.append(ref)
+    return found
