--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,26 @@
+import re
+
+_HOURS_OR_MINUTES_RE = re.compile(
+    r"\s*(?P<hours>[0-9]+)[hH](?:\s*(?P<minutes>[0-9]+)[mM])?\s*"
+)
+_MINUTES_RE = re.compile(
+    r"\s*(?P<minutes>[0-9]+)[mM]\s*"
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string such as "1h30m" into whole minutes."""
+    if not isinstance(text, str):
+        raise ValueError("duration text must be a string")
+
+    match = _HOURS_OR_MINUTES_RE.fullmatch(text)
+    if match is not None:
+        hours = int(match.group("hours"))
+        minutes = int(match.group("minutes") or 0)
+        return hours * 60 + minutes
+
+    match = _MINUTES_RE.fullmatch(text)
+    if match is not None:
+        return int(match.group("minutes"))
+
+    raise ValueError(f"invalid duration: {text!r}")
