+"""Checkout-side shipping decisions (what checkout may offer the customer)."""
--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: Iterable[str], sites: Iterable[Site],
+                      hazmat_skus: Iterable[str] = frozenset()) -> bool:
+    """Whether the warehouse would put an order with these SKUs into an express wave.
+
+    Mirrors the structural decisions of warehouse.waves.allocate_wave (stock
+    availability is not part of this check, no stock is passed in): the cart
+    needs lines; an order containing any hazmat SKU is allocated only from
+    ground sites and downgraded to a standard wave, so it is never express;
+    and express leaves by air, so at least one of the sites that could ship
+    the order must have air service.
+    """
+    skus = list(skus)
+    if not skus:
+        return False
+    hazmat = frozenset(hazmat_skus)
+    if any(sku in hazmat for sku in skus):
+        return False
+    return any("air" in s.services for s in sites)
