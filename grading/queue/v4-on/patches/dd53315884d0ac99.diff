--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,27 @@
+"""Duration parsing helpers for estimates and forms."""
+import re
+
+_DURATION_RE = re.compile(
+    r"\s*(?:(?P<hours>[0-9]+)h)?\s*(?:(?P<minutes>[0-9]+)m)?\s*",
+    re.IGNORECASE,
+)
+_MINUTES_PER_HOUR = 60
+
+
+def parse_duration(text: str) -> int:
+    """Parse an hours/minutes string into a whole number of minutes.
+
+    Accepts forms such as "2h", "45m", "1h30m" and "1h 30m". Hours must come
+    before minutes, each unit may appear at most once, and units are
+    case-insensitive. Surrounding whitespace is ignored. Raises ValueError
+    for anything else.
+    """
+    match = _DURATION_RE.fullmatch(text)
+    if match is None or (
+        match.group("hours") is None and match.group("minutes") is None
+    ):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours = int(match.group("hours") or "0")
+    minutes = int(match.group("minutes") or "0")
+    return hours * _MINUTES_PER_HOUR + minutes
