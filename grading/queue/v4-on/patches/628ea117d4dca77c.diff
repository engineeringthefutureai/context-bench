+"""Cash till for the pop-up stores (Canada opens with cash on hand).
+
+`amount_due` is what the cashier asks the customer for: the exact total on card, or the till's cash
+amount under `paid_by` == "cash". Cash amounts follow the national cash rules the shop already uses
+elsewhere (core.pricing.cashRoundCents: the penny is dropped in Canada, other currencies unchanged).
+"""
+from __future__ import annotations
+
+from shopkit.core.pricing import cashRoundCents
+from shopkit.errors import ShopError
+
+PAID_BY_CARD = "card"
+PAID_BY_CASH = "cash"
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Amount in cents the cashier asks the customer to pay for a sale of `total_cents` in `currency`.
+
+    Card payments pay the exact total; cash payments are rounded the way the till must (penny
+    withdrawn in Canada: CAD 103 cents is asked as 105; other currencies come back unchanged)."""
+    method = (paid_by or "").strip().lower()
+    if method == PAID_BY_CARD:
+        return int(total_cents)
+    if method == PAID_BY_CASH:
+        return cashRoundCents(int(total_cents), (currency or "").strip().upper())
+    raise ShopError(f"unknown payment method {paid_by!r}, expected {PAID_BY_CARD!r} or {PAID_BY_CASH!r}",
+                    paid_by=paid_by)
