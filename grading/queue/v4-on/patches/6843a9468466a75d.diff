--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class NotEnoughStock(Conflict):
+    pass
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,15 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku`, lowering its availability. If there aren't enough units,
+        raises NotEnoughStock (409) with `requested` and `available` and changes nothing."""
+        if qty < 0:
+            raise ValueError("qty must be non-negative")
+        if qty:
+            available = self.available(sku)
+            if available < qty:
+                raise NotEnoughStock(f"not enough {sku}", sku=sku, requested=qty,
+                                     available=available)
+            self._on_hand[sku] = available - qty
