--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,19 @@
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: Iterable[str], sites: Iterable[Site], hazmat_skus: frozenset[str]) -> bool:
+    """Whether the warehouse would put an order with these SKUs into an express wave.
+
+    Mirrors the rules in warehouse.waves.allocate_wave: an order containing any hazmat SKU is
+    never put into an express wave (hazmat only ships by ground, express leaves by air), and an
+    express wave can only come from a site whose dock offers an air service."""
+    skus = list(skus)
+    if not skus:
+        return False                      # an order with no lines is not allocated at all
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in site.services for site in sites)
