+def wmsStatusLabel(wmsCode):
+    """short English label for a WMS callback status (phone-order screen).
+    Case-insensitive, surrounding spaces ignored; anything else (incl. None) is 'Unknown'."""
+    if not isinstance(wmsCode, str):
+        return "Unknown"
+    return {
+        WMS_STATUS_RECEIVED: "Received",
+        WMS_STATUS_ALLOCATED: "Allocated",
+        WMS_STATUS_PICKING: "Picking",
+        WMS_STATUS_PACKED: "Packed",
+        WMS_STATUS_DISPATCHED: "Dispatched",
+        WMS_STATUS_SHORT: "Short pick",
+        WMS_STATUS_CANCELLED: "Cancelled",
+        WMS_STATUS_HOLD: "On hold",
+    }.get(wmsCode.strip().upper(), "Unknown")
+
