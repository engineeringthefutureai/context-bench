--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,28 @@
+"""Coupon preview: the saving a discount code would give before the shopper applies it.
+
+The preview re-prices the cart with the code, exactly as the cart page does (price_cart), and
+reports the coupon's share of the discount. The rest of the quote (tax, shipping, promotions)
+is thrown away and nothing is applied or persisted."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str | None,
+                   coupons: dict[str, Coupon] | None, engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """How many cents `code` would save on this cart, priced the same way as the cart page, or 0
+    when the code wouldn't apply (not recognised, not active, minimum order not met, or nothing
+    eligible, e.g. everything on sale for a percentage code). Printed codes are honoured exactly
+    as in the cart. The cart is only priced in memory; the code is not applied to anything."""
+    if not code:
+        return 0
+    priced = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g,
+                        at=at, coupon_code=code, coupons=coupons)
+    return priced.coupon_discount_cents
