--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class NotEnoughStock(Conflict):
+    """409: a request exceeds available stock; body carries requested/available."""
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,17 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order, lowering what is available.
+
+        Raises NotEnoughStock (API 409, with `requested` and `available` in the
+        error body) without changing anything when the stock is not enough.
+        """
+        if qty < 1:
+            raise ValueError("qty must be >= 1")
+        avail = self.available(sku)
+        if avail < qty:
+            raise NotEnoughStock(f"only {avail} x {sku} available",
+                                 sku=sku, requested=qty, available=avail)
+        self._on_hand[sku] = avail - qty
