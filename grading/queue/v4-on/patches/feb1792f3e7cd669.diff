+def _redact_card_number(value: object) -> object:
+    if isinstance(value, str):
+        return redact_pan(value)
+    if isinstance(value, int) and not isinstance(value, bool):
+        return redact_pan(str(value))
+    return value
+
+
+def _mask_card_numbers(data: object) -> object:
+    """Copy event data, redacting any `card_number` fields before it goes to a partner."""
+    if isinstance(data, dict):
+        out: dict = {}
+        for key, value in data.items():
+            if key == "card_number":
+                value = _redact_card_number(value)
+            out[key] = _mask_card_numbers(value)
+        return out
+    if isinstance(data, (list, tuple)):
+        return [_mask_card_numbers(value) for value in data]
+    return data
+
