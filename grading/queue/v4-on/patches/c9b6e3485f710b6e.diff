+    def restocking_fee_cents(self, order: Order) -> int:
+        """Restocking fee in cents: 12.5% of the refund for changed-mind returns,
+        0 for every other reason. Rounded half-up, the same way the shop rounds
+        its other percentage amounts (tax, discounts)."""
+        if self.reason != "changed_mind":
+            return 0
+        fee = Decimal(self.refund_cents(order)) * RESTOCKING_FEE_PERCENT / Decimal(100)
+        return int(fee.quantize(Decimal("1"), rounding=ROUND_HALF_UP))
