--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,29 @@
+"""What a discount code would save on a cart, shown before the shopper applies it.
+
+The preview must agree with the numbers on the cart page, so it prices the cart with price_cart
+exactly as the cart page does and reports that coupon discount; 0 means the code wouldn't apply
+(unknown or not a printed code, outside its validity window, under its minimum order, or nothing
+eligible to discount)."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str,
+                   coupons: dict[str, Coupon], engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """The saving in cents that `code` would give on this cart, calculated exactly as the cart
+    page (price_cart) calculates it: engine unit prices, then the coupon's exclusions (no sale
+    items or gift cards for percentage codes) and minimum order check. Returns 0 when the code
+    wouldn't apply."""
+    if not code:
+        return 0
+    priced = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g,
+                        at=at, coupon_code=code, coupons=coupons)
+    return priced.coupon_discount_cents
