--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,30 @@
+import re
+
+_HOURS_WITH_MINUTES = re.compile(
+    r"(?P<hours>[0-9]+[hH])(?:\s*(?P<minutes>[0-9]+[mM]))?",
+    re.IGNORECASE,
+)
+_MINUTES_ONLY = re.compile(r"(?P<minutes>[0-9]+[mM])", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration like '2h', '45m', '1h30m' or '1h 30m' into whole minutes."""
+    if not isinstance(text, str):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    cleaned = text.strip()
+    if not cleaned:
+        raise ValueError("invalid duration: empty string")
+
+    match = _HOURS_WITH_MINUTES.fullmatch(cleaned)
+    if match:
+        hours = int(match.group("hours")[:-1])
+        minutes_text = match.group("minutes")
+        minutes = int(minutes_text[:-1]) if minutes_text else 0
+        return hours * 60 + minutes
+
+    match = _MINUTES_ONLY.fullmatch(cleaned)
+    if match:
+        return int(match.group("minutes")[:-1])
+
+    raise ValueError(f"invalid duration: {text!r}")
