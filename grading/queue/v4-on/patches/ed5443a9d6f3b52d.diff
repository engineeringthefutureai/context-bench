--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,27 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Reserve qty units of sku, lowering the available quantity.
+
+        Raises Conflict if there is not enough stock available.
+        """
+        if qty < 0:
+            raise Conflict(
+                "quantity to reserve must be non-negative",
+                requested=qty,
+                available=self.available(sku),
+            )
+        if qty == 0:
+            return
+
+        available = self.available(sku)
+        if available < qty:
+            raise Conflict(
+                "insufficient stock",
+                requested=qty,
+                available=available,
+            )
+
+        self._on_hand[sku] = available - qty
