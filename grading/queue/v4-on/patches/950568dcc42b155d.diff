--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,31 @@
+import re
+
+_DURATION_RE = re.compile(
+    r"(?:(?P<hours>[0-9]+)[hH])?\s*(?:(?P<minutes>[0-9]+)[mM])?"
+)
+
+
+def parse_duration(text: str) -> int:
+    """Return the number of whole minutes in a duration string.
+
+    Accepts hours and/or minutes, e.g. ``2h``, ``45m``, ``1h30m``, or
+    ``1h 30m``. Hours must come before minutes, each unit may appear at most
+    once, units are case-insensitive, and surrounding whitespace is ignored.
+    Raises ``ValueError`` for any other input.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("duration must not be empty")
+
+    match = _DURATION_RE.fullmatch(stripped)
+    if match is None or (
+        match.group("hours") is None and match.group("minutes") is None
+    ):
+        raise ValueError("invalid duration")
+
+    hours = int(match.group("hours")) if match.group("hours") is not None else 0
+    minutes = int(match.group("minutes")) if match.group("minutes") is not None else 0
+    return hours * 60 + minutes
