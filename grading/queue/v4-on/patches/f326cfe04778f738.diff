--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,28 @@
+"""Preview of what a discount code would save on a cart, before the shopper applies it."""
+
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str | None,
+                   coupons: dict[str, Coupon] | None, engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """Saving in cents that applying `code` would give on this cart. The cart is priced twice with
+    price_cart -- exactly as the cart page does, so printed codes, sale-item exclusions, minimums,
+    per-line tax and the discounted shipping total all come out the same -- and the difference of
+    the two totals is returned: what the shopper would actually pay less. 0 when the code wouldn't
+    apply (unknown, inactive, below the minimum, empty cart, ...)."""
+    base = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at)
+    if not code or not base.lines:
+        return 0
+    applied = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                         coupon_code=code, coupons=coupons)
+    # a valid code never raises the total; clamp so a future pricing rule can't show a negative saving
+    return max(0, base.total_cents - applied.total_cents)
