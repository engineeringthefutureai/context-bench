+    def restocking_fee_cents(self, order: Order) -> int:
+        """Restocking fee in cents: 12.5% of the refund amount for changed-mind
+        returns, 0 for every other reason.
+
+        Rounded half-up to whole cents with the same epsilon the shop uses for
+        its other percentage amounts (tax, discounts, see roundMoney in
+        core.order_engine), so e.g. a 36c changed-mind refund carries a 5c fee.
+        """
+        if self.reason != "changed_mind":
+            return 0
+        refund = self.refund_cents(order)
+        return round(refund * RESTOCKING_FEE_PCT / 100.0 + 0.0000001)
+
 
