+    def restocking_fee_cents(self, order: Order) -> int:
+        # changed-mind returns pay a 12.5% restocking fee on the refund; other reasons are free
+        if self.reason != "changed_mind":
+            return 0
+        refund = self.refund_cents(order)
+        # round like the shop's other percentage money amounts (tax, discounts): half-up to the cent
+        fee = Decimal(refund) * RESTOCKING_FEE_PERCENT / Decimal(100)
+        return int(fee.to_integral_value(rounding=ROUND_HALF_UP))
