 """Card gateway adapter. The real provider is behind `charge`; tests use FakeGateway."""
+import secrets
+
 from shopkit.errors import ShopError
 from shopkit.payments.models import AUTHORIZED, CAPTURED, FAILED, Payment
 from shopkit.payments.reconciliation import redact_pan
 from shopkit.utils.ids import new_id
+
+# Customer-facing code alphabet: uppercase letters and digits with the easily
+# confused glyphs (0/O, 1/I, L) left out, so a reference typed from a printed
+# invoice or dictated over the phone comes through clean.
+_TRANSFER_REFERENCE_ALPHABET = "ABCDEFGHJKMNPQRSTUVWXYZ23456789"
+
+
+def transfer_reference() -> str:
+    """A fresh bank-transfer reference, e.g. '7KPD-M29X-4QRW'.
+
+    Three dash-separated groups of four characters (12 in total), in the same
+    style as the shop's other customer-facing codes.
+    """
+    return "-".join(
+        "".join(secrets.choice(_TRANSFER_REFERENCE_ALPHABET) for _ in range(4))
+        for _ in range(3)
+    )
 
 
 class PaymentDeclined(ShopError):
