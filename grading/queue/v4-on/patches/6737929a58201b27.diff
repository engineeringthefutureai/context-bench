+# -*- coding: utf-8 -*-
+#
+# Till-side payment rules for the pop-up stores: what the cashier asks the customer for.
+#
+from shopkit.core.pricing import cashRoundCents
+
+CARD, CASH = "card", "cash"
+PAID_BY = (CARD, CASH)
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """The amount in cents the cashier asks the customer to pay.
+
+    "card": the exact total - card payments are never rounded.
+    "cash": cash can only be given in the coins and notes the currency actually has, so the
+        amount follows the national rules for cash amounts, the same way the shop already
+        rounds cash elsewhere (core.pricing.cashRoundCents: CAD to the nearest 5 cents under
+        the penny-withdrawal rule, other currencies unchanged; symmetric for negatives)."""
+    if paid_by not in PAID_BY:
+        raise ValueError(f"paid_by is card or cash: {paid_by!r}")
+    cents = int(total_cents)
+    if paid_by == CASH:
+        return cashRoundCents(cents, currency)
+    return cents
