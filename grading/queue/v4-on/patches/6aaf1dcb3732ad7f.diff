--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict, ShopError
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,18 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold stock for checkout.
+
+        Raises ShopError for a negative quantity and Conflict (409) with `requested` and
+        `available` details when there is not enough stock; stock is left unchanged then.
+        """
+        if qty < 0:
+            raise ShopError("Invalid quantity", sku=sku, requested=qty)
+        if qty == 0:
+            return
+        available = self.available(sku)
+        if qty > available:
+            raise Conflict("Not enough stock", requested=qty, available=available)
+        self._on_hand[sku] = available - qty
