--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,24 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Reserve `qty` units of `sku`, lowering on-hand stock.
+
+        Raises:
+            ValueError: If `qty` is negative.
+            Conflict: If `qty` exceeds available stock. The error details include
+                `requested` and `available`.
+        """
+        if qty < 0:
+            raise ValueError("qty must be non-negative")
+
+        available_qty = self.available(sku)
+        if qty > available_qty:
+            raise Conflict(
+                f"Not enough stock for {sku}",
+                requested=qty,
+                available=available_qty,
+            )
+        if qty:
+            self._on_hand[sku] = available_qty - qty
