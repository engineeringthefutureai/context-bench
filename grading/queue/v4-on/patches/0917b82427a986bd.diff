--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,29 @@
+"""Explain webhook delays that can be answered from the event and order alone.
+
+The webhook worker holds back events about orders that are in fraud review
+(see shopkit.api.webhook_delivery). This module turns that into a short reason
+for partners/support.
+"""
+from __future__ import annotations
+
+from shopkit.api import webhook_delivery
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Return a reason if the webhook worker would hold `event` back now, else None.
+
+    Mirrors the fraud-review hold in webhook_delivery.deliver_pending: events
+    with no order id, and events in ALWAYS_DELIVER, are sent normally; a failed
+    review lookup fails closed and is reported as a hold.
+    """
+    if not order_id or under_review is None:
+        return None
+    if event in webhook_delivery.ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception as e:
+        return f"held: fraud review lookup failed ({type(e).__name__})"
+    if reviewing:
+        return "held: order is in fraud review"
+    return None
