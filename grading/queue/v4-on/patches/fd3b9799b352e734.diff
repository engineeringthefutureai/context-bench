--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,50 @@
+"""Parsing utilities for duration strings."""
+
+import re
+
+__all__ = ["parse_duration"]
+
+_DURATION_RE = re.compile(
+    r"(?:(?P<hours>\d+)h)?\s*(?:(?P<minutes>\d+)m)?",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration string into whole minutes.
+
+    Valid inputs consist of an hours component, a minutes component, or both,
+    e.g. ``2h``, ``45m``, ``1h30m``, and ``1h 30m``. Hours must come before
+    minutes, each unit may appear at most once, units are case-insensitive,
+    and surrounding whitespace is ignored.
+
+    Args:
+    ----
+    text:
+        The duration string to parse.
+
+    Returns
+    -------
+    int
+        The duration in whole minutes.
+
+    Raises
+    ------
+    ValueError
+        If ``text`` is not a valid duration string.
+    """
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"Invalid duration: {text!r}")
+
+    hours_text = match.group("hours")
+    minutes_text = match.group("minutes")
+    if hours_text is None and minutes_text is None:
+        raise ValueError(f"Invalid duration: {text!r}")
+
+    hours = int(hours_text) if hours_text is not None else 0
+    minutes = int(minutes_text) if minutes_text is not None else 0
+    return hours * 60 + minutes
