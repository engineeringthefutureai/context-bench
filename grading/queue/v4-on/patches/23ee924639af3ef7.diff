--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,40 @@
+import re
+
+_WEIGHT_RE = re.compile(
+    r"(\d+(?:\.\d+)?)\s*(kg|lb|oz|g)",
+    re.IGNORECASE,
+)
+
+_GRAMS_PER_UNIT = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Parse a warehouse-entered weight and return whole grams.
+
+    Accepts an integer or dot-separated decimal, optional whitespace, and a
+    unit of g, kg, lb or oz (case-insensitive). Rounds half-up to the nearest
+    gram. Raises ValueError for malformed input, unknown units, negative
+    values and comma decimal separators.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"bad weight {text!r}")
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"bad weight {text!r}")
+
+    number, unit = match.groups()
+    whole, _, frac = number.partition(".")
+
+    numerator = int(whole + frac)
+    denominator = 10 ** len(frac)
+
+    unit_numerator, unit_denominator = _GRAMS_PER_UNIT[unit.lower()]
+    numerator *= unit_numerator
+    denominator *= unit_denominator
+
+    return (2 * numerator + denominator) // (2 * denominator)
