--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,5 +1,8 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
-    """On-hand quantities per SKU."""
+    """Available quantities per SKU, lowered by reservations."""
 
     def __init__(self):
         self._on_hand: dict[str, int] = {}
@@ -9,3 +12,18 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku`, lowering its available quantity.
+
+        Raises Conflict (409) without changing anything when stock is short.
+        """
+        have = self._on_hand.get(sku, 0)
+        if qty > have:
+            raise Conflict(
+                f"only {have} of {sku} available, {qty} requested",
+                sku=sku,
+                requested=qty,
+                available=have,
+            )
+        self._on_hand[sku] = have - qty
