+def _mask_card_number(data):
+    """Event data as it may leave the shop: a card_number field is masked with redact_pan (the
+    same masking used for stored and shown card numbers); every other field is unchanged. The
+    original payload is never mutated."""
+    if isinstance(data, dict):
+        value = data.get("card_number")
+        if isinstance(value, (str, int)) and not isinstance(value, bool):
+            return {**data, "card_number": redact_pan(str(value))}
+    return data
+
