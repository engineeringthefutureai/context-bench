--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,35 @@
+from __future__ import annotations
+
+import copy
+from datetime import date
+
+from shopkit.payouts.batching import Rollover, build_payout_batch
+from shopkit.payouts.holds import HoldBook
+from shopkit.payouts.models import Adjustment, Earning, Seller
+from shopkit.pricing.currency import RateTable
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment],
+                   period_start: date, period_end: date, holds: HoldBook, rollover: Rollover,
+                   rates: RateTable | None = None) -> tuple[str, int]:
+    """What the seller's payout would get for [period_start, period_end] (inclusive).
+
+    Returns ``(status, net_cents)`` exactly as the weekly batch would treat this
+    seller: lines held inside the return window, holds released from earlier
+    periods, adjustments, reserve, backup withholding, the minimum-payout rule
+    and FX conversion all apply.
+
+    To stay read-only the batch is re-run for this seller alone, on deep copies
+    of ``holds`` and ``rollover``: nothing is placed, released or carried, so the
+    shared state is left exactly as it was. A seller the batch skips (suspended
+    or closed, or a foreign-currency payout with no usable rate) gets no payout;
+    the reason from the batch's skip list is returned with a net of 0.
+    """
+    sandbox_holds = copy.deepcopy(holds)
+    sandbox_rollover = copy.deepcopy(rollover)
+    result = build_payout_batch([seller], earnings, adjustments, period_start, period_end,
+                                holds=sandbox_holds, rollover=sandbox_rollover, rates=rates)
+    for payout in result.payouts:
+        if payout.seller_id == seller.id:
+            return payout.status, payout.net_cents
+    return result.skipped.get(seller.id, "skipped"), 0
