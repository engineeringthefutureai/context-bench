--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,50 @@
+import re
+
+_UNIT_GRAMS = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+_WEIGHT_RE = re.compile(
+    r"\s*(\d+(?:\.\d+)?|\.\d+)\s*(kg|lb|oz|g)\s*",
+    re.IGNORECASE | re.ASCII,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a weight string into whole grams.
+
+    The input must be a non-negative and consist of an integer or decimal
+    number followed by one of the units g, kg, lb, or oz. Whitespace before,
+    after, and between the number and unit is ignored. The result is rounded
+    to the nearest gram.
+
+    Raises:
+        ValueError: If the text is malformed, has a missing or unknown unit,
+            is negative, or uses a non-"." decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"Invalid weight: {text!r}")
+
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"Invalid weight: {text!r}")
+
+    number, unit = match.groups()
+    factor_num, factor_den = _UNIT_GRAMS[unit.lower()]
+
+    whole, _, frac = number.partition(".")
+    if not whole:
+        whole = "0"
+
+    scale = 10 ** len(frac)
+    numerator = int(whole) * scale + int(frac or 0)
+    denominator = scale
+
+    scaled_numerator = numerator * factor_num
+    scaled_denominator = denominator * factor_den
+
+    # Round half up to the nearest whole gram.
+    return (2 * scaled_numerator + scaled_denominator) // (2 * scaled_denominator)
