--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,18 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order.
+
+        Raises ValueError for a non-positive quantity and Conflict when the SKU cannot cover
+        `qty`; the Conflict carries `sku`, `requested`, and `available` details for the API.
+        """
+        if qty < 1:
+            raise ValueError("qty must be >= 1")
+        available = self.available(sku)
+        if available < qty:
+            error = Conflict(f"not enough {sku}")
+            error.details = {"sku": sku, "requested": qty, "available": available}
+            raise error
+        self._on_hand[sku] = available - qty
