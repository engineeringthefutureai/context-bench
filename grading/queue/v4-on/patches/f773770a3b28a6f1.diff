--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,123 @@
+"""Payout preview: what a seller's payout for a period would look like if the weekly batch ran
+now, shown to the seller before finance runs it.
+
+It mirrors build_payout_batch's per-seller rules one for one - input checks, the period window,
+commission with the full-refund commission return, holds for lines still inside the return
+window, released holds, adjustments, reserve, carried balance, backup withholding, the
+minimum-payout and negative-balance rollover, and FX conversion with the FX fee - so the
+amount is exactly what the batch would produce.
+
+A preview changes nothing: it never places or releases holds and never takes or writes a
+rollover balance, so running previews does not alter what the real batch will do."""
+from __future__ import annotations
+
+from datetime import date, timedelta
+
+from shopkit.config import SETTINGS
+from shopkit.payouts.batching import BACKUP_WITHHOLDING_BP, FX_FEE_BP, MIN_PAYOUT_CENTS, Rollover
+from shopkit.payouts.holds import RETURN_WINDOW_DAYS, HoldBook
+from shopkit.payouts.models import (CLOSING, CLOSED, DRAFT, ROLLED_OVER, SUSPENDED, Adjustment, Earning, Payout,
+                                    PayoutLine, Seller)
+from shopkit.pricing.currency import RateTable, RateUnavailable
+from shopkit.utils.numbers import apply_rate
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment],
+                   period_start: date, period_end: date, holds: HoldBook, rollover: Rollover,
+                   *, rates: RateTable | None = None,
+                   seller_country: dict[str, str] | None = None) -> tuple[str, int]:
+    """The status and net amount (cents) of `seller`'s payout for [period_start, period_end] if the
+    weekly batch ran on this data now.
+
+    Same inputs and same per-seller rules as build_payout_batch (pass the same holds book, rollover
+    balances and rate table the batch will use). Read-only: holds and rollover are only read, never
+    placed, released, taken or written.
+
+    rates: rate table for converted payouts; without it, a non-shop-currency seller is reported the
+    way the batch treats one without rates - nothing paid this period, the net carries forward.
+    seller_country: seller id -> country for backup withholding; unknown sellers count as US, as in
+    the batch."""
+    if seller.status in (SUSPENDED, CLOSED):
+        # The batch skips such sellers entirely (skipped[seller.id] = seller.status): no payout,
+        # nothing carried.
+        return seller.status, 0
+
+    # --- input checks, same as the batch (INC-2340 / INC-2377) --------------------------------------
+    valid = [e for e in earnings if e.seller_id == seller.id
+             and e.gross_cents >= 0 and e.refunded_cents >= 0 and e.refunded_cents <= e.gross_cents]
+    seen: set[tuple[str, str, str]] = set()
+    deduped = []
+    for e in valid:
+        key = (e.seller_id, e.order_id, e.sku)
+        if key in seen:
+            continue
+        seen.add(key)
+        deduped.append(e)
+
+    # Same period window as the batch: undelivered earnings always count, delivered ones must fall
+    # in [period_start - 366 days, period_end] (INC-2291: undelivered lines are not dropped).
+    in_period = [e for e in deduped
+                 if e.delivered_on is None or period_start - timedelta(days=366) <= e.delivered_on <= period_end]
+
+    payout = Payout(f"preview_{seller.id}_{period_end:%Y%m%d}", seller.id, period_start, period_end,
+                    seller.payout_currency)
+
+    # --- lines ---------------------------------------------------------------------------------------
+    held_now = 0
+    for e in sorted(in_period, key=lambda e: (e.order_id, e.sku)):
+        commission = apply_rate(e.gross_cents, seller.commission_bp / 100)
+        net = e.gross_cents - commission - e.refunded_cents
+        if e.refunded_cents and e.refunded_cents == e.gross_cents:
+            # full refund: the commission is given back to the seller too (marketplace terms §7.2)
+            net = 0
+            commission = 0
+        payout.lines.append(PayoutLine(e.order_id, e.gross_cents, commission, e.refunded_cents, net))
+        within_window = e.delivered_on is None or e.delivered_on + timedelta(days=RETURN_WINDOW_DAYS) > period_end
+        if within_window and net > 0:
+            held_now += net        # the batch would place a hold here; the preview only counts it
+    payout.held_cents = held_now
+
+    # --- released holds, adjustments, reserve, carried balance -----------------------------------------
+    # holds.releasable() is read-only: the batch releases the same holds (release marks them,
+    # releasable only lists them), so the amount is identical without mutating the book.
+    released = sum(h.amount_cents for h in holds.releasable(seller.id, period_end))
+    adj_total = sum(a.amount_cents for a in adjustments if a.seller_id == seller.id)
+    payout.adjustments_cents = adj_total + released
+    if seller.reserve_bp:
+        payout.reserve_cents = apply_rate(payout.gross_cents, seller.reserve_bp / 100)
+    payout.carried_in_cents = rollover.balances.get(seller.id, 0)
+
+    # --- backup withholding ---------------------------------------------------------------------------
+    # US sellers without a tax id get 24% of the period's net line amounts withheld (not of carried
+    # balances or adjustments).
+    country = (seller_country or {}).get(seller.id, "US")
+    if country == "US" and not seller.tax_id.strip():
+        line_net = sum(l.net_cents for l in payout.lines) - payout.held_cents
+        if line_net > 0:
+            payout.adjustments_cents -= apply_rate(line_net, BACKUP_WITHHOLDING_BP / 100)
+
+    # --- minimum payout and negative balances -----------------------------------------------------------
+    # The batch puts these amounts into the rollover; the preview only reports that they would be.
+    net = payout.net_cents
+    if net < 0:
+        payout.status = ROLLED_OVER
+    elif net < MIN_PAYOUT_CENTS and seller.status != CLOSING:
+        payout.status = ROLLED_OVER
+    else:
+        payout.status = DRAFT
+
+    # --- currency --------------------------------------------------------------------------------------
+    shop_currency = SETTINGS.default_currency
+    if payout.status == DRAFT and seller.payout_currency != shop_currency:
+        if rates is None:
+            # The batch skips the payout and carries the (unconverted) net forward without a rate
+            # table, so the seller sees nothing paid this period.
+            return ROLLED_OVER, net
+        try:
+            converted = rates.convert(net, shop_currency, seller.payout_currency, period_end)
+        except RateUnavailable:
+            return ROLLED_OVER, net
+        fee = apply_rate(converted, FX_FEE_BP / 100)
+        payout.adjustments_cents -= net - (converted - fee)     # same bookkeeping as the batch
+
+    return payout.status, payout.net_cents
