--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,32 @@
+"""Units typed in by warehouse staff, e.g. package weights on the shipping floor."""
+
+import re
+from decimal import Decimal, ROUND_HALF_UP
+
+# Grams per unit; lb and oz use the exact international (avoirdupois) definitions.
+_GRAMS_PER = {
+    "g": Decimal("1"),
+    "kg": Decimal("1000"),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+_WEIGHT_RE = re.compile(r"\s*([0-9]+(?:\.[0-9]+)?)\s*(g|kg|lb|oz)\s*", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight typed in by staff, in whole grams.
+
+    A number (integer or decimal using "." as separator) with optional
+    whitespace, then a unit g, kg, lb or oz (case-insensitive), e.g.
+    "1250 g", "2.5 kg", "1 LB". Leading and trailing whitespace is ignored.
+    Raises ValueError for anything else: a missing or unknown unit, a
+    negative or malformed number, or "," as the decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"unparseable weight: {text!r}")
+    grams = Decimal(match.group(1)) * _GRAMS_PER[match.group(2).lower()]
+    return int(grams.to_integral_value(rounding=ROUND_HALF_UP))
