--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,30 @@
+"""Preview what a discount code would save before the shopper applies it.
+
+The preview prices the cart with price_cart -- the same path the cart page uses
+-- and reports that run's coupon discount, so the number can never drift from
+what the cart would actually show.
+"""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str | None,
+                   coupons: dict[str, Coupon] | None, engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """Saving in cents that *code* would give on this cart, or 0 if it wouldn't apply.
+
+    Calculated exactly as the cart page does: price_cart with the same inputs.
+    The coupon step's discount (after the sale/gift-card exclusions, the active
+    window and the minimum order value checks) is the number returned; codes
+    that are rejected simply yield 0, as does a code-less or empty cart.
+    """
+    cart = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                      coupon_code=code, coupons=coupons)
+    return cart.coupon_discount_cents
