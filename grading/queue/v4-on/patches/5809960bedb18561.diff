@@ -1,4 +1,18 @@
+import re
+import unicodedata
+
 from dataclasses import dataclass
+
+
+def _slugify_title(title: str) -> str:
+    value = "" if title is None else str(title)
+    value = (
+        unicodedata.normalize("NFKD", value)
+        .encode("ascii", "ignore")
+        .decode("ascii")
+    )
+    value = re.sub(r"[^a-z0-9]+", "-", value.lower())
+    return value.strip("-")
 
 
 @dataclass
