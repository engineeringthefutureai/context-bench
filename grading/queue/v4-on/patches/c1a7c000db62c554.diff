+"""Read-only preview of refund destinations for the support desk.
+
+Support wants to tell a customer, before pressing Refund, where the money will go back to.
+refund_destinations() replays the planning half of payments.settlement.settle_refund() -- same
+captured-payment filter, same proportional split, same 180-day card rule -- and reports the
+result without touching the provider, the journal, the ledger or any Payment: it never refunds.
+"""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+from shopkit.utils.dates import utc_now
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                        today: date | None = None) -> dict[str, int]:
+    """Where a refund of amount_cents for order_id would go: cents back to the card, to store
+    credit and to a new gift card, under exactly the rules settle_refund uses: captured
+    payments only, split in proportion to what is still refundable on each (leftover cents
+    to card payments first), card payments older than CARD_REFUND_MAX_AGE_DAYS to store
+    credit, gift card payments to a new gift card.
+
+    Raises the same ShopError / RefundTooLarge errors settle_refund would raise for amounts
+    it would refuse. Pure read: no provider call, no journal entry, no ledger, payments
+    unchanged.
+    """
+    today = today or utc_now().date()
+    if amount_cents <= 0:
+        raise ShopError("refund amount must be positive", order_id=order_id)
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}",
+                             order_id=order_id, requested=amount_cents, refundable=refundable)
+
+    # Same ordering and split as settle_refund: cards first, weights = refundable_cents,
+    # leftover cents to the earlier (card) payments so a gift card never gets more than
+    # its share.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    out = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            out["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            out["store_credit"] += share
+        else:
+            out["card"] += share
+    return out
