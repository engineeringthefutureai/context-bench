--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,52 @@
+"""Helpers for converting human-typed unit values."""
+
+import re
+from fractions import Fraction
+
+_WEIGHT_RE = re.compile(
+    r"\s*(?P<number>\d+(?:\.\d+)?|\.\d+)\s*(?P<unit>g|kg|lb|oz)\s*",
+    re.IGNORECASE,
+)
+
+_GRAMS_PER_UNIT = {
+    "g": Fraction(1),
+    "kg": Fraction(1000),
+    "lb": Fraction(45359237, 100000),
+    "oz": Fraction(28349523125, 1000000000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Return the weight described by ``text`` in whole grams.
+
+    The input must be a non-negative integer or decimal number followed by
+    optional whitespace and one of ``g``, ``kg``, ``lb``, or ``oz``
+    (case-insensitive). Leading and trailing whitespace is ignored. The
+    result is rounded to the nearest gram, with halves rounded up.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError("invalid weight")
+
+    number_text = match.group("number")
+    unit = match.group("unit").lower()
+
+    if "." in number_text:
+        integer_part, fractional_part = number_text.split(".")
+        value = Fraction(
+            int((integer_part or "0") + fractional_part),
+            10 ** len(fractional_part),
+        )
+    else:
+        value = Fraction(int(number_text))
+
+    value *= _GRAMS_PER_UNIT[unit]
+
+    quotient, remainder = divmod(value.numerator, value.denominator)
+    if 2 * remainder >= value.denominator:
+        quotient += 1
+
+    return int(quotient)
