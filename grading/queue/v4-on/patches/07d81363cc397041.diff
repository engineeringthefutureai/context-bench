@@ -1,3 +1,6 @@
+from shopkit.errors import InsufficientStock, ShopError
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,22 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku`.
+
+        On success the available quantity is lowered by `qty`. If the request is for
+        more than what is available, nothing changes and InsufficientStock is raised
+        (HTTP 409) with `requested` and `available` in the error details.
+        """
+        available = self.available(sku)
+        if qty < 0:
+            raise ShopError("qty must be non-negative", requested=qty, available=available)
+        if qty > available:
+            raise InsufficientStock(
+                f"not enough stock for {sku}",
+                requested=qty,
+                available=available,
+            )
+        if qty:
+            self._on_hand[sku] = available - qty
