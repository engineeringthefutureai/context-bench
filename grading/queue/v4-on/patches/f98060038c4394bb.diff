--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,28 @@
+"""Checkout-facing checks on which delivery options the warehouse can actually honour.
+
+These mirror the rules in warehouse.waves.allocate_wave as far as checkout can tell: stock
+availability is checked separately (short stock backorders, it never changes the service).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: Iterable[str], sites: Iterable[Site],
+                      hazmat_skus: frozenset[str] = frozenset()) -> bool:
+    """True if an order with `skus` (SKU strings, or a {sku: qty} mapping) from `sites` would be
+    allocated into an express wave.
+
+    Express is not offered when allocation would not honour it: an order containing any
+    dangerous-goods SKU is downgraded to a standard wave (and only ships from ground docks), so it
+    never enters an express wave; and express leaves by air, so at least one candidate site has to
+    have the air service available at the dock.
+    """
+    if not skus:
+        return False
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in site.services for site in sites)
