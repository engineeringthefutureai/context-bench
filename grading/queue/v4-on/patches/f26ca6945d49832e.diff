--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,28 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` of `sku`, lowering available stock.
+
+        Raises Conflict if the SKU cannot cover the requested quantity. The
+        error details expose `requested` and `available` for the API body.
+        """
+        if qty < 0:
+            raise Conflict(
+                f"Cannot reserve a negative quantity for {sku}",
+                requested=qty,
+                available=self._on_hand.get(sku, 0),
+            )
+        if qty == 0:
+            return
+
+        available_qty = self._on_hand.get(sku, 0)
+        if available_qty < qty:
+            raise Conflict(
+                f"Insufficient stock for {sku}",
+                requested=qty,
+                available=available_qty,
+            )
+
+        self._on_hand[sku] = available_qty - qty
