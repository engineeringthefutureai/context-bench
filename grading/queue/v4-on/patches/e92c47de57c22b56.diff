--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,29 @@
+import re
+
+_PART = re.compile(r"([0-9]+)([hm])", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Duration in whole minutes for compact strings, e.g. "2h" -> 120, "1h 30m" -> 90.
+
+    Hours come before minutes and each unit appears at most once; units are
+    case-insensitive and surrounding whitespace is ignored. Anything else
+    (empty text, other units, missing numbers, minutes before hours, negative
+    or decimal values) raises ValueError."""
+    if not isinstance(text, str):
+        raise ValueError("duration must be a string")
+    clean = text.strip()
+    parts = _PART.findall(clean)
+    if not parts or _PART.sub(" ", clean).strip():
+        raise ValueError("invalid duration; expected forms like '2h', '45m' or '1h30m'")
+    minutes = 0
+    seen_units = set()
+    for digits, unit in parts:
+        key = unit.lower()
+        if key in seen_units:
+            raise ValueError(f"invalid duration: '{unit}' unit appears more than once")
+        if key == "h" and "m" in seen_units:
+            raise ValueError("invalid duration: minutes cannot come before hours")
+        seen_units.add(key)
+        minutes += int(digits) * (60 if key == "h" else 1)
+    return minutes
