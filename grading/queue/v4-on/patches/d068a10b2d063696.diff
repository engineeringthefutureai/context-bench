--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict, ShopError
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,14 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` of `sku` for a checkout, lowering what `available` reports.
+        Fails with a 409 conflict carrying the requested and available quantities
+        when stock is short; nothing changes in that case."""
+        if qty < 1:
+            raise ShopError(f"{sku}: quantity must be at least 1", sku=sku)
+        available = self._on_hand.get(sku, 0)
+        if available < qty:
+            raise Conflict(f"only {available} of {sku} available", requested=qty, available=available)
+        self._on_hand[sku] = available - qty
