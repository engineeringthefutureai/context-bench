@@ -0,0 +1,21 @@
+"""Pallet labels for the warehouse.
+
+The new pallet scanner reads the finance system's item numbers, not our SKUs,
+so a pallet label prints the item number the finance system (the ERP) knows
+each product by rather than the shop SKU.
+"""
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Text for a pallet label.
+
+    The first line is ``PALLET <pallet_id>``; each following line is one item,
+    ``<item number> x<qty>``, in the order given, where the item number is the
+    one the finance system knows the product by.
+    """
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
