+"""Point-of-sale till for the pop-up stores.
+
+Works out how much the cashier asks a customer to pay at the counter.
+"""
+
+from shopkit.core.pricing import cashRoundCents
+
+__all__ = ["amount_due"]
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """The amount the cashier asks the customer to pay, in cents.
+
+    paid_by is "card" or "cash". A card payment settles at exactly total_cents.
+    A cash payment is rounded to a whole coin under the national cash rules for
+    currency (Canada withdrew the penny in 2013, so CAD rounds to the nearest
+    nickel), the same way the shop treats cash elsewhere.
+    """
+    if paid_by == "card":
+        return total_cents
+    if paid_by == "cash":
+        return cashRoundCents(total_cents, currency)
+    raise ValueError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
