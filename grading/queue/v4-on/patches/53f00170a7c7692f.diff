+def _redact(value: object) -> object:
+    """Copy of `value` with every `card_number` field masked the way the shop masks card
+    numbers elsewhere (redact_pan); all other fields go out unchanged."""
+    if isinstance(value, dict):
+        redacted = {}
+        for key, item in value.items():
+            if key == "card_number" and isinstance(item, str):
+                redacted[key] = redact_pan(item)
+            else:
+                redacted[key] = _redact(item)
+        return redacted
+    if isinstance(value, (list, tuple)):
+        return [_redact(item) for item in value]
+    return value
+
