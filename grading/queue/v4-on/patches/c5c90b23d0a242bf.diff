--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,48 @@
+from __future__ import annotations
+
+import copy
+from collections.abc import Iterable
+from datetime import date
+
+from shopkit.payouts.batching import Rollover, build_payout_batch
+from shopkit.payouts.holds import HoldBook
+from shopkit.payouts.models import CLOSED, DRAFT, SUSPENDED, Adjustment, Earning, Seller
+
+
+def preview_payout(
+    seller: Seller,
+    earnings: Iterable[Earning] | None,
+    adjustments: Iterable[Adjustment] | None,
+    period_start: date,
+    period_end: date,
+    holds: HoldBook | None = None,
+    rollover: Rollover | None = None,
+) -> tuple[str, int]:
+    """Return the status and net cents a weekly payout batch would produce.
+
+    The holds book and rollover balances are copied first so a preview never
+    changes state that the real batch will later use.
+    """
+    safe_holds = copy.deepcopy(holds) if holds is not None else HoldBook()
+    safe_rollover = copy.deepcopy(rollover) if rollover is not None else Rollover()
+
+    result = build_payout_batch(
+        [seller],
+        list(earnings) if earnings is not None else [],
+        list(adjustments) if adjustments is not None else [],
+        period_start,
+        period_end,
+        holds=safe_holds,
+        rollover=safe_rollover,
+    )
+
+    for payout in result.payouts:
+        if payout.seller_id == seller.id:
+            return payout.status, payout.net_cents
+
+    status = getattr(seller, "status", None)
+    if status == CLOSED:
+        return CLOSED, 0
+    if status == SUSPENDED:
+        return SUSPENDED, 0
+    return DRAFT, 0
