+
+    def add_line(self, sku: str, qty: int, unit_cents: int) -> OrderLine:
+        """Add a line, merging with an existing line for the same SKU and unit price."""
+        key = normalize_sku(sku)
+        for line in self.lines:
+            if normalize_sku(line.sku) == key and line.unit_cents == unit_cents:
+                line.qty += qty
+                return line
+
+        line = OrderLine(sku=sku, qty=qty, unit_cents=unit_cents)
+        self.lines.append(line)
+        return line
