--- /dev/null
+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,17 @@
+"""Pallet labels for the new pallet scanner. The scanner reads the finance ERP's item numbers,
+not shop SKUs, so items are printed with their ERP item numbers (shopkit.core.erp.toErpSku)."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Label text for one pallet: 'PALLET <pallet_id>' then one line per item,
+    '<ERP item number> x<qty>', in the order given.
+
+    items is a list of (sku, qty); the sku is translated to the ERP item number the finance
+    system knows it by. Invalid skus raise ValueError (from toErpSku)."""
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
