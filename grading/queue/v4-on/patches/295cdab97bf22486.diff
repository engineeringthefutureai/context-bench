--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class ReserveFailed(Conflict):
+    """A reservation cannot be made because not enough stock is available."""
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,21 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` from on-hand stock.
+
+        Raises ReserveFailed (409) with `requested` and `available` when there is
+        not enough stock; nothing is changed in that case.
+        """
+        if qty < 1:
+            raise ValueError("qty must be >= 1")
+        available = self.available(sku)
+        if available < qty:
+            raise ReserveFailed(
+                f"only {available} x {sku} available",
+                sku=sku,
+                requested=qty,
+                available=available,
+            )
+        self._on_hand[sku] = available - qty
