--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,37 @@
+"""Helpers for compact duration strings such as '2h' counts, e.g. '2h' or '1h 30m'."""
+
+import re
+
+# At most one hours part and one minutes part, hours first.  Only the
+# separator between the two parts may contain whitespace; the caller strips
+# the ends, so anything else in the text is rejected by fullmatch.
+_DURATION = re.compile(
+    r"(?:(?P<hours>[0-9]+)h)?\s*(?:(?P<minutes>[0-9]+)m)?",
+    re.IGNORECASE,
+)
+
+
+def parse_duration(text: str) -> int:
+    """Parse a duration of hours and/or minutes into whole minutes.
+
+    Accepted forms: '2h', '45m', '1h30m', '1h 30m'.  Hours come before
+    minutes, each unit appears at most once, units are case-insensitive and
+    surrounding whitespace is ignored.  Anything else (empty text, unknown
+    units, a missing or negative number, minutes before hours) raises
+    ValueError.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    match = _DURATION.fullmatch(text.strip())
+    if match is None or (
+        match.group("hours") is None and match.group("minutes") is None
+    ):
+        raise ValueError(
+            f"invalid duration {text!r}: expected hours and/or minutes, e.g. '1h30m'"
+        )
+    minutes = 0
+    if match.group("hours") is not None:
+        minutes += int(match.group("hours")) * 60
+    if match.group("minutes") is not None:
+        minutes += int(match.group("minutes"))
+    return minutes
