--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,67 @@
+"""Parsing helpers for shipping weights."""
+
+from __future__ import annotations
+
+import re
+
+_WEIGHT_RE = re.compile(
+    r"(?P<number>[0-9]+(?:\.[0-9]+)?|\.[0-9]+)\s*(?P<unit>g|kg|lb|oz)",
+    re.IGNORECASE,
+)
+
+# Exact fractional grams per unit.
+_UNIT_FACTORS = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+
+def parse_weight(text: str) -> int:
+    """Return the package weight in whole grams.
+
+    Accepts a non-negative integer or decimal number followed by one of the
+    units g, kg, lb or oz. Raises ValueError for anything else.
+    """
+    if not isinstance(text, str):
+        raise ValueError("weight must be a string")
+
+    match = _WEIGHT_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError("invalid weight")
+
+    number_text = match.group("number")
+    unit = match.group("unit").lower()
+
+    value, scale = _decimal_parts(number_text)
+    if value == 0:
+        return 0
+
+    factor_numerator, factor_denominator = _UNIT_FACTORS[unit]
+    numerator = value * factor_numerator
+    denominator = (10 ** scale) * factor_denominator
+
+    whole, remainder = divmod(numerator, denominator)
+    if remainder * 2 >= denominator:
+        whole += 1
+
+    return whole
+
+
+def _decimal_parts(number_text: str) -> tuple[int, int]:
+    """Return (value, scale) such that value / 10**scale is the exact number."""
+    integer_text, dot, fractional_text = number_text.partition(".")
+    if dot:
+        fractional_text = fractional_text.rstrip("0")
+        if fractional_text:
+            digits = (integer_text or "0") + fractional_text
+            value = int(digits)
+            scale = len(fractional_text)
+        else:
+            value = int(integer_text or "0")
+            scale = 0
+    else:
+        value = int(integer_text)
+        scale = 0
+    return value, scale
