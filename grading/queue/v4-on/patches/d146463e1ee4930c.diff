--- /dev/null
+++ b/shopkit/pos/till.py
@@ -0,0 +1,48 @@
+"""Point-of-sale helpers for physical cash tills."""
+
+# Cash amounts must be expressible using the coins available in the country.
+# Canadian dollars are rounded to the nearest 5 cents; other currencies are
+# treated as having 1-cent cash increments unless a different rule is added.
+_CASH_INCREMENTS_CENTS = {
+    "CAD": 5,
+}
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Return the amount in cents that the cashier asks the customer to pay.
+
+    Card payments always ask for the exact total. Cash payments are rounded
+    to the nearest amount that can be paid in cash for the currency.
+    """
+    if isinstance(total_cents, bool) or not isinstance(total_cents, int):
+        raise TypeError("total_cents must be an integer number of cents")
+    if total_cents < 0:
+        raise ValueError("total_cents must be non-negative")
+
+    if not isinstance(currency, str):
+        raise TypeError("currency must be a string")
+    if not currency.strip():
+        raise ValueError("currency must be a non-empty currency code")
+
+    if not isinstance(paid_by, str):
+        raise TypeError("paid_by must be a string")
+    method = paid_by.strip().lower()
+    if method not in {"card", "cash"}:
+        raise ValueError("paid_by must be 'card' or 'cash'")
+
+    if method == "card":
+        return total_cents
+
+    increment = _CASH_INCREMENTS_CENTS.get(currency.strip().upper(), 1)
+    return _round_to_nearest_multiple(total_cents, increment)
+
+
+def _round_to_nearest_multiple(value: int, multiple: int) -> int:
+    """Round a non-negative integer to the nearest multiple of ``multiple``."""
+    if multiple <= 1:
+        return value
+
+    quotient, remainder = divmod(value, multiple)
+    if 2 * remainder > multiple:
+        quotient += 1
+    return quotient * multiple
