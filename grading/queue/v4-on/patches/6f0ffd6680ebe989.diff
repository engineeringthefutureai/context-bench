+def expected_arrival(refund: Refund) -> date:
+    """Return the expected card-credit date.
+
+    Banks take five business days after the refund issue date, using the shop's
+    business-day calendar.
+    """
+    day = refund.at.date()
+    remaining = 5
+    while remaining:
+        day += timedelta(days=1)
+        if is_business_day(day):
+            remaining -= 1
+    return day
