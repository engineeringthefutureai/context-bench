+"""Order-reference linking for the support desk.
+
+``order_refs`` finds the order references in a customer's message so they can
+be turned into links: each reference comes back the way the shop writes that
+kind of reference (``order_engine.formatOrderRef``), in the order it is first
+mentioned, without duplicates. Customers type references loosely ("so 2019
+123", "SO-2019-000123", "ORD_1A2B3C4D5E6F"), so every candidate span is
+validated with ``order_engine.parseOrderRef`` and anything the shop would not
+accept is left out.
+"""
+
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# Longest a reference can be in words: KIND YEAR SEQ (e.g. "so 2019 123").
+_MAX_SPAN = 3
+
+# Punctuation customers tack onto a reference: "SO-2019-000123," or "(SO-2019-000123)".
+_EDGE_PUNCT = re.compile(r"^\W+|\W+$")
+
+
+def order_refs(text: str) -> list[str]:
+    """Order references mentioned in ``text``, canonical and deduplicated.
+
+    Returns each reference the way the shop writes it, in the order it is
+    first mentioned. Text that is not a valid order reference is ignored.
+    """
+    tokens = []
+    for raw in (text or "").split():
+        token = _EDGE_PUNCT.sub("", raw)
+        if token:
+            tokens.append(token)
+
+    refs: list[str] = []
+    seen: set[str] = set()
+    i, n = 0, len(tokens)
+    while i < n:
+        match = None
+        for end in range(i, min(i + _MAX_SPAN, n)):
+            parsed = parseOrderRef(" ".join(tokens[i : end + 1]))
+            if parsed is not None:
+                match = (parsed, end)
+                break
+        if match is None:
+            i += 1
+            continue
+        parsed, end = match
+        ref = formatOrderRef(*parsed)
+        if ref not in seen:
+            seen.add(ref)
+            refs.append(ref)
+        i = end + 1
+    return refs
