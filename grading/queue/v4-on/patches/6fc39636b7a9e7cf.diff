@@ -0,0 +1,17 @@
+"""Pallet labels for the warehouse's pallet scanner.
+
+The scanner reads the finance system's (ERP) item numbers, not the shop SKUs, so every line is
+printed with the ERP item number (shopkit.core.erp.toErpSku)."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Label text for a pallet: a 'PALLET <pallet_id>' line, then one '<item number> x<qty>' line
+    per item, in the order given, where the item number is the one the finance system knows the
+    product by (the ERP item number, not the shop SKU)."""
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
