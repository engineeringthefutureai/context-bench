--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,30 @@
+"""Unit conversions for values typed in by warehouse staff, e.g. package weights on intake scans."""
+import re
+from decimal import Decimal
+
+# Exact factors to grams (1 lb = 453.59237 g, 1 oz = 28.349523125 g by definition).
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+_WEIGHT_RE = re.compile(r"^(\d+(?:\.\d+)?)([a-zA-Z]+)$")
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams. Accepts an integer or decimal ("."), optional whitespace,
+    then a unit (g, kg, lb, oz), case-insensitive, e.g. "2.5 kg" -> 2500.
+    Raises ValueError for anything else, including missing number/unit, unknown units,
+    negative values and "," as decimal separator."""
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+    match = _WEIGHT_RE.match(text.strip().replace(" ", ""))
+    if not match:
+        raise ValueError(f"invalid weight: {text!r}")
+    number, unit = match.groups()
+    factor = _GRAMS_PER_UNIT.get(unit.lower())
+    if factor is None:
+        raise ValueError(f"unknown unit in weight: {text!r}")
+    return int((Decimal(number) * factor).quantize(Decimal(1)))
