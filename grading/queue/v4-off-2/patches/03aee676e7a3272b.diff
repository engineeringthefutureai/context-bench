     @property
     def total_cents(self) -> int:
         return sum(line.total_cents for line in self.lines)
+
+    def add_line(self, sku: str, qty: int, unit_cents: int) -> OrderLine:
+        """Add a line for `sku`. If the order already has a line with the same SKU and the
+        same unit price, its quantity is increased; otherwise a new line is appended.
+        Returns the line that was touched."""
+        if qty < 1:
+            raise ShopError(f"{sku}: quantity must be at least 1")
+        if unit_cents < 0:
+            raise ShopError(f"{sku}: negative price")
+        for line in self.lines:
+            if line.sku == sku and line.unit_cents == unit_cents:
+                line.qty += qty
+                return line
+        line = OrderLine(sku, qty, unit_cents)
+        self.lines.append(line)
+        return line
