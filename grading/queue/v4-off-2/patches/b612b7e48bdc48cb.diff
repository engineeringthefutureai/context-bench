+def _mask_card_numbers(data):
+    """Copy of the payload with any `card_number` value masked the way the shop stores and shows
+    card numbers. Values that are not strings stay as-is; all other fields go out unchanged."""
+    if isinstance(data, dict):
+        return {k: (redact_pan(v) if k == "card_number" and isinstance(v, str) else _mask_card_numbers(v))
+                for k, v in data.items()}
+    if isinstance(data, list):
+        return [_mask_card_numbers(v) for v in data]
+    return data
