--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,23 @@
+"""Shipping options offered at checkout, mirroring what the warehouse will actually do.
+
+Checkout must never promise a service the wave engine (shopkit.warehouse.waves.allocate_wave)
+won't honour: offering express when the order will end up in a standard wave mis-quotes the
+delivery time to the customer. These helpers restate the allocation rules in a form checkout
+can call without running the full allocation."""
+from __future__ import annotations
+
+
+def express_available(skus, sites, hazmat_skus) -> bool:
+    """Whether the warehouse would put an order containing ``skus`` into an express wave.
+
+    ``skus`` are the cart's SKUs (any iterable of sku codes), ``sites`` the warehouse sites
+    (``warehouse.sites.Site``) that could ship the order, and ``hazmat_skus`` the SKUs classed
+    as dangerous goods.
+
+    Express leaves by air, so it is only possible when (a) the order contains no hazmat SKU
+    (hazmat ships by ground only and allocate_wave downgrades such orders to standard) and
+    (b) at least one of the sites offers air service. Returns True only when both hold.
+    """
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in s.services for s in sites)
