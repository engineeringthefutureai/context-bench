--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,52 @@
+"""Preview of where a refund would go, before the agent presses Refund.
+
+Mirrors the destination split that payments.settlement.settle_refund uses, but is strictly
+read-only: it never talks to the provider, books nothing, and does not mutate any payment."""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                        today: date | None = None) -> dict[str, int]:
+    """Where a refund of `amount_cents` for `order_id` would be settled.
+
+    Returns {"card": ..., "store_credit": ..., "gift_card": ...} in cents, split exactly the way
+    settle_refund would settle it. This only previews the split; it refunds nothing and mutates
+    no payment. `today` drives the 180-day card-window check (defaults to the current date)."""
+    today = today or date.today()
+    dest = {"card": 0, "store_credit": 0, "gift_card": 0}
+
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        return dest
+
+    total_weight = sum(p.refundable_cents for p in captured)
+    if total_weight <= 0:
+        return dest
+
+    # Same order as settle_refund: cards first, then gift cards, by payment date.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    shares = [amount_cents * p.refundable_cents // total_weight for p in ordered]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            dest["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            dest["store_credit"] += share
+        else:
+            dest["card"] += share
+    return dest
