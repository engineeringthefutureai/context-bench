+"""Pallet labels for the warehouse scanners. The scanners read the finance system's item numbers,
+not our SKUs, so labels are printed with the ERP item number for each product."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items) -> str:
+    """Label text for a pallet: `PALLET <pallet_id>`, then one line per (sku, qty) in the order
+    given, `<item number> x<qty>`, where the item number is the finance system's (ERP) number."""
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
