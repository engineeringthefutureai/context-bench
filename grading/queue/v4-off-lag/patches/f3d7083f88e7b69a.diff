--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.errors import Conflict
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,13 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold stock for an order by lowering the available quantity of ``sku``.
+
+        If there isn't enough stock, nothing changes and a Conflict is raised
+        carrying the requested and available quantities."""
+        available = self.available(sku)
+        if qty > available:
+            raise Conflict(f"insufficient stock for {sku}", requested=qty, available=available)
+        self._on_hand[sku] = available - qty
