--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,42 @@
+"""Parse human-written durations ("2h", "45m", "1h30m", "1h 30m") into whole minutes."""
+import re
+
+# Optional hours part, then optional minutes part, in that order. Each part is digits immediately
+# followed by its unit; the only whitespace allowed is between the two parts.
+_HOURS = re.compile(r"(\d+)[hH]")
+_MINUTES = re.compile(r"(\d+)[mM]")
+
+
+def _take(text: str, pattern: re.Pattern) -> tuple[int, str] | tuple[None, None]:
+    """Consume `pattern` anchored at the start of `text`; return (value, remainder) or (None, None)."""
+    match = pattern.match(text)
+    if match is None:
+        return (None, None)
+    return int(match.group(1)), text[match.end():]
+
+
+def parse_duration(text: str) -> int:
+    """Duration in whole minutes. Hours come before minutes, each unit at most once, units are
+    case-insensitive, surrounding whitespace is ignored. Anything else raises ValueError.
+    parse_duration("2h") -> 120; parse_duration("1h 30m") -> 90; parse_duration("45m") -> 45."""
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError(f"invalid duration: {text!r}")
+
+    hours, rest = _take(stripped, _HOURS)
+    if hours is None:
+        # No hours; the whole thing must be minutes.
+        minutes, tail = _take(stripped, _MINUTES)
+        if minutes is None or tail:
+            raise ValueError(f"invalid duration: {text!r}")
+        return minutes
+
+    # Had hours; remainder (if any) must be exactly a minutes part after zero or one space.
+    if rest:
+        if rest[0] == " ":
+            rest = rest[1:]
+        minutes, tail = _take(rest, _MINUTES)
+        if minutes is None or tail:
+            raise ValueError(f"invalid duration: {text!r}")
+        return hours * 60 + minutes
+    return hours * 60
