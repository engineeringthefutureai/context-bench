+def test_restocking_fee_changed_mind():
+    # refund 1000 cents -> 12.5% = 125; refund 500 cents -> 62.5 rounds half-up to 63
+    a = open_return(ORDER, date(2026, 11, 1), {"A": 1}, "changed_mind", today=date(2026, 11, 2))
+    b = open_return(ORDER, date(2026, 11, 1), {"B": 1}, "changed_mind", today=date(2026, 11, 2))
+    assert a.refund_cents(ORDER) == 1000 and a.restocking_fee_cents(ORDER) == 125
+    assert b.refund_cents(ORDER) == 500 and b.restocking_fee_cents(ORDER) == 63
+
+
