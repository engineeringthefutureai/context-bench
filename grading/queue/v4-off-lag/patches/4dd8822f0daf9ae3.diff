+
+
+def test_label_text_us_weight_in_pounds():
+    to = Address("Ann Lee", "1 Main St", "Austin", "78701", "US", region="TX")
+    text = label_text(Parcel("o1", 1, [("ab-1", 2)]), to, parcels_total=2, weight_g=1500)
+    assert "Weight: 3.31 lb" in text
+    # weight line sits right after the order/parcel line, before the item lines
+    lines = text.split("\n")
+    assert lines.index("Weight: 3.31 lb") == lines.index("Order o1  parcel 1/2") + 1
+    assert lines[-1] == "AB1 x2"
+
+
+def test_label_text_other_country_keeps_kilograms():
+    to = Address("Bob Smith", "1 Rue de Rivoli", "Paris", "75001", "FR")
+    text = label_text(Parcel("o1", 1, [("ab-1", 2)]), to, parcels_total=2, weight_g=1500)
+    assert "Weight: 1.5 kg" in text
+    assert "lb" not in text
+
+
+def test_label_text_no_weight_when_omitted():
+    to = Address("Ann Lee", "1 Main St", "Austin", "78701", "US", region="TX")
+    text = label_text(Parcel("o1", 1, [("ab-1", 2)]), to, parcels_total=2)
+    assert "Weight:" not in text
