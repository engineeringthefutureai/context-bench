+def test_refund_expected_arrival_counts_business_days():
+    from shopkit.payments.refunds import Refund, expected_arrival
+
+    issued_friday = datetime(2026, 11, 20)  # a Friday
+    assert expected_arrival(Refund("P1", 100, "damaged", at=issued_friday)) == date(2026, 11, 27)
+    # issued the business day before the 12/25 holiday: 12/25, 12/26 skipped
+    issued_dec_24 = datetime(2026, 12, 24)
+    assert expected_arrival(Refund("P1", 100, "damaged", at=issued_dec_24)) == date(2027, 1, 4)
+
