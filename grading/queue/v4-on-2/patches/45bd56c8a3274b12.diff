+def export_orders_csv(orders: list[Order]) -> str:
+    """CSV export for finance: one row per order line.
+
+    Product codes are canonicalized like everywhere else (normalize_sku) and
+    line totals are formatted as shown on customer invoices.
+    """
+    buffer = io.StringIO()
+    writer = csv.writer(buffer)
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for order in orders:
+        for line in order.lines:
+            writer.writerow(
+                [
+                    order.id,
+                    normalize_sku(line.sku),
+                    line.qty,
+                    format_money(line.total_cents, order.currency),
+                ]
+            )
+    return buffer.getvalue()
