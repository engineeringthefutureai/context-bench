--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,21 @@
+"""Duration text helpers: "hours and/or minutes" strings as whole minutes."""
+import re
+
+# Hours come before minutes, each unit at most once; whitespace between the two
+# units is optional. The single-unit branch keeps "45m" valid and rejects a
+# bare "m" or a number with no unit.
+_DURATION_RE = re.compile(r"(?:([0-9]+)h(?:\s*([0-9]+)m)?)|(?:([0-9]+)m)", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """The whole minutes in a duration like "2h", "45m", "1h30m" or "1h 30m".
+    Units are case-insensitive and surrounding whitespace is ignored; anything
+    else (empty text, other units, a missing number, minutes before hours,
+    negative numbers) raises ValueError.
+    parse_duration("1h 30m") -> 90; parse_duration("2H") -> 120."""
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = match.group(1)
+    minutes = match.group(2) or match.group(3)
+    return int(hours or 0) * 60 + int(minutes or 0)
