--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,35 @@
+"""Explain to partners why a webhook event about an order has not reached them yet.
+
+Supports partner support with the one case where the webhook worker
+(api.webhook_delivery.deliver_pending) deliberately holds a delivery: the fraud review hold."""
+from __future__ import annotations
+
+from typing import Callable
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+UnderReview = Callable[[str], bool]
+
+
+def explain_delay(event: str, order_id: str | None, under_review: UnderReview | None) -> str | None:
+    """Short reason the webhook worker would hold back `event` about `order_id` right now, or
+    None when it would send it normally.
+
+    Mirrors the fraud review hold in webhook_delivery.deliver_pending: events about an order in
+    fraud review are held until the review clears, so partners (ERP, 3PL) don't start fulfilling
+    an order we may still cancel. As in the worker:
+    - events in ALWAYS_DELIVER (order.cancelled, refund.settled) go out even for orders under
+      review: partners must learn that an order is off.
+    - events with no `order_id` are not order-scoped, so review never holds them.
+    - the lookup fails closed: if `under_review` raises, the event is reported as held (the
+      worker holds it too). Better late than shipped to a fraudster.
+    """
+    if not order_id or under_review is None or event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        return "fraud review lookup failed; holding (fail closed)"
+    if reviewing:
+        return "order is in fraud review; held until the review clears"
+    return None
