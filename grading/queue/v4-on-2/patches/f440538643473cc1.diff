+"""Amounts a cashier asks the customer at the till.
+
+Card payments are settled for the exact total; cash payments follow the national rules
+for cash amounts (pennies were withdrawn in Canada in 2013, so cash in CAD is rounded to
+the nearest 5 cents), the same way the shop treats cash elsewhere.
+"""
+
+from shopkit.core.pricing import cashRoundCents
+
+__all__ = ["amount_due", "CASH", "CARD"]
+
+CASH = "cash"
+CARD = "card"
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    """Amount in cents the cashier asks the customer to pay for a sale of `total_cents`.
+
+    `paid_by` is "card" or "cash". Card payments pay the exact total; cash is rounded per
+    the national cash rules (to the nearest 5 cents in CAD, unchanged otherwise), the same
+    as `shopkit.core.pricing.cashRoundCents`.
+    """
+    if not isinstance(total_cents, int) or isinstance(total_cents, bool):
+        raise ValueError(f"total_cents must be an int, got {total_cents!r}")
+    if total_cents < 0:
+        raise ValueError("total_cents must be >= 0")
+    if not isinstance(currency, str) or not currency.isalpha() or len(currency) != 3:
+        raise ValueError(f"currency must be a 3-letter code, got {currency!r}")
+    method = paid_by.lower() if isinstance(paid_by, str) else paid_by
+    if method == CARD:
+        return total_cents
+    if method == CASH:
+        return cashRoundCents(total_cents, currency.upper())
+    raise ValueError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
