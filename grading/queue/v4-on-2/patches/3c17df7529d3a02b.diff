+def _sanitize(payload: dict) -> dict:
+    """Mask a card_number before it leaves the shop, the same way card numbers are stored
+    and shown everywhere else; every other field goes out unchanged."""
+    if not isinstance(payload, dict) or not isinstance(payload.get("card_number"), str):
+        return payload
+    masked = dict(payload)
+    masked["card_number"] = redact_pan(payload["card_number"])
+    return masked
