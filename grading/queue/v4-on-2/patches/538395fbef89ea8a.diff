@@ -1,3 +1,6 @@
+from shopkit.errors import InsufficientStock, ShopError
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,18 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for an order, lowering the available quantity.
+
+        Raises `InsufficientStock` (a 409) without changing stock when there are
+        not enough units available."""
+        if qty < 0:
+            raise ShopError(f"cannot reserve a negative quantity of {sku}")
+        on_hand = self._on_hand.get(sku, 0)
+        if qty > on_hand:
+            raise InsufficientStock(
+                f"cannot reserve {qty} of {sku}: only {on_hand} available",
+                requested=qty, available=on_hand,
+            )
+        self._on_hand[sku] = on_hand - qty
