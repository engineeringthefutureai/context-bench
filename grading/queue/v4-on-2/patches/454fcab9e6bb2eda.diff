--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,23 @@
+"""Parsing of human-written durations, e.g. "2h" or "1h 30m", into whole minutes."""
+import re
+
+# Hours before minutes, each unit at most once, applied to stripped text so whitespace is
+# only allowed around or between the parts. "1h 30m", "1H30M" and "45m" all match.
+_DURATION_RE = re.compile(r"(?:(\d+)h)?\s*(?:(\d+)m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """The duration in whole minutes: "2h" -> 120, "45m" -> 45, "1h30m" (or "1h 30m") -> 90.
+    Hours come before minutes, each unit at most once, units are case-insensitive and
+    surrounding whitespace is ignored. Anything else (empty text, other units, a missing
+    number, minutes before hours, negative numbers) raises ValueError."""
+    match = _DURATION_RE.fullmatch(text.strip())
+    if match is None or (match.group(1) is None and match.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours, minutes = match.groups()
+    total = 0
+    if hours is not None:
+        total += int(hours) * 60
+    if minutes is not None:
+        total += int(minutes)
+    return total
