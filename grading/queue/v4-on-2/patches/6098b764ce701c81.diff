--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,126 @@
+"""Preview of a seller's next payout, without running the batch (INC-2291).
+
+Mirrors build_payout_batch's per-seller rules -- line validation and dedupe, commission and
+refunds, holds for orders still inside the return window, released holds, adjustments, reserve,
+carry-over, backup withholding, the minimum payout and FX conversion -- so finance and sellers
+can see the status and net amount the weekly batch would produce for a period.
+
+Read-only on purpose: holds are evaluated instead of placed, releasable holds are summed instead
+of released, and the rollover balance is read instead of taken, so previewing changes nothing
+for the real batch."""
+from __future__ import annotations
+
+import logging
+from datetime import date, timedelta
+
+from shopkit.config import SETTINGS, Settings
+from shopkit.payouts.batching import (BACKUP_WITHHOLDING_BP, FX_FEE_BP, MIN_PAYOUT_CENTS, Rollover)
+from shopkit.payouts.holds import RETURN_WINDOW_DAYS, HoldBook
+from shopkit.payouts.models import (CLOSING, CLOSED, DRAFT, ROLLED_OVER, SUSPENDED, Adjustment,
+                                    Earning, Payout, PayoutLine, Seller)
+from shopkit.pricing.currency import RateTable, RateUnavailable
+from shopkit.utils.numbers import apply_rate
+
+log = logging.getLogger(__name__)
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment],
+                   period_start: date, period_end: date, holds: HoldBook, rollover: Rollover,
+                   *, rates: RateTable | None = None, settings: Settings = SETTINGS,
+                   paid_lines: set[tuple[str, str, str]] | None = None,
+                   seller_country: dict[str, str] | None = None) -> tuple[str, int]:
+    """What this seller's payout would get for [period_start, period_end], exactly as the weekly
+    payout would treat it. Returns (status, net_cents).
+
+    Same inputs as build_payout_batch for one seller. ``paid_lines`` and ``seller_country`` keep
+    the preview faithful to a real batch; they default to the batch defaults. The net is in the
+    seller's payout currency when a conversion applies, otherwise in the shop currency.
+    Suspended and closed sellers get no payout at all. Nothing is changed: no holds are placed
+    or released, no rollover balance is taken."""
+    if seller.status in (SUSPENDED, CLOSED):
+        log.debug("INC-2291 preview seller %s skipped (%s)", seller.id, seller.status)
+        return seller.status, 0
+
+    # --- input checks, same as the batch ------------------------------------------------------------
+    valid: list[Earning] = []
+    for e in earnings:
+        if e.seller_id != seller.id:
+            continue
+        if e.gross_cents < 0 or e.refunded_cents < 0:
+            continue
+        if e.refunded_cents > e.gross_cents:
+            continue
+        valid.append(e)
+
+    # --- INC-2377 dedupe: already-paid and in-batch duplicate lines, keep the first ------------------
+    dry_run_dedupe = settings.flag("payout_dedupe_dry_run")
+    paid_lines = paid_lines if paid_lines is not None else set()
+    seen: set[tuple[str, str, str]] = set()
+    in_period = []
+    for e in valid:
+        key = (e.seller_id, e.order_id, e.sku)
+        if key in paid_lines and not dry_run_dedupe:
+            continue
+        if key in seen:
+            if not dry_run_dedupe:
+                continue
+        else:
+            seen.add(key)
+        in_period.append(e)
+
+    # delivered long before the period (more than a year) is not in it; undelivered still is
+    in_period = [e for e in in_period
+                 if e.delivered_on is None or period_start - timedelta(days=366) <= e.delivered_on <= period_end]
+
+    # --- lines, commission, refunds, holds (held amounts are evaluated, not placed) ------------------
+    payout = Payout(f"preview_{seller.id}_{period_end:%Y%m%d}", seller.id, period_start, period_end,
+                    seller.payout_currency)
+    held_now = 0
+    for e in sorted(in_period, key=lambda e: (e.order_id, e.sku)):
+        commission = apply_rate(e.gross_cents, seller.commission_bp / 100)
+        net = e.gross_cents - commission - e.refunded_cents
+        if e.refunded_cents and e.refunded_cents == e.gross_cents:
+            # full refund: the commission is given back to the seller too (marketplace terms §7.2)
+            net = 0
+            commission = 0
+        payout.lines.append(PayoutLine(e.order_id, e.gross_cents, commission, e.refunded_cents, net))
+        within_window = e.delivered_on is None or e.delivered_on + timedelta(days=RETURN_WINDOW_DAYS) > period_end
+        if within_window and net > 0:
+            held_now += net
+    payout.held_cents = held_now
+
+    # --- released holds (summed, not marked released), adjustments, reserve, carry-over --------------
+    released = sum(h.amount_cents for h in holds.releasable(seller.id, period_end))
+    adj_total = sum(a.amount_cents for a in adjustments if a.seller_id == seller.id)
+    payout.adjustments_cents = adj_total + released
+    if seller.reserve_bp:
+        payout.reserve_cents = apply_rate(payout.gross_cents, seller.reserve_bp / 100)
+    payout.carried_in_cents = rollover.balances.get(seller.id, 0)
+
+    # --- backup withholding: US sellers without a tax id ---------------------------------------------
+    country = (seller_country or {}).get(seller.id, "US")
+    if country == "US" and not seller.tax_id.strip():
+        line_net = sum(l.net_cents for l in payout.lines) - payout.held_cents
+        if line_net > 0:
+            payout.adjustments_cents -= apply_rate(line_net, BACKUP_WITHHOLDING_BP / 100)
+
+    # --- minimum payout, negative balances, currency ---------------------------------------------------
+    # Same outcomes as the batch: negative or below-minimum balances are not paid, they roll over;
+    # closing sellers get paid whatever is left. Without a rate the batch rolls the balance over,
+    # so the preview does too.
+    net = payout.net_cents
+    if net < 0 or (net < MIN_PAYOUT_CENTS and seller.status != CLOSING):
+        log.debug("INC-2291 preview seller %s net=%d rolled over", seller.id, net)
+        return ROLLED_OVER, net
+    if seller.payout_currency != settings.default_currency:
+        if rates is None:
+            log.debug("INC-2291 preview seller %s no rates, net=%d rolled over", seller.id, net)
+            return ROLLED_OVER, net
+        try:
+            converted = rates.convert(net, settings.default_currency, seller.payout_currency, period_end)
+        except RateUnavailable:
+            log.debug("INC-2291 preview seller %s rate unavailable, net=%d rolled over", seller.id, net)
+            return ROLLED_OVER, net
+        net = converted - apply_rate(converted, FX_FEE_BP / 100)
+    log.debug("INC-2291 preview seller %s status=%s net=%d", seller.id, DRAFT, net)
+    return DRAFT, net
