--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class InsufficientStock(Conflict):
+    pass
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,13 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` for a checkout.
+        Raises InsufficientStock (409) without changing anything when there
+        isn't enough on hand."""
+        on_hand = self.available(sku)
+        if on_hand < qty:
+            raise InsufficientStock(f"cannot reserve {qty} of {sku}: only {on_hand} available",
+                                    requested=qty, available=on_hand)
+        self._on_hand[sku] = on_hand - qty
