+def mask_card_numbers(data):
+    """Event data safe to send to a partner: every `card_number` field masked the same way the shop
+    stores and shows card numbers (payments.reconciliation.redact_pan). Other fields unchanged."""
+    if isinstance(data, dict):
+        out = {}
+        for key, value in data.items():
+            if key == "card_number" and isinstance(value, (str, int)) and not isinstance(value, bool):
+                out[key] = redact_pan(str(value))
+            else:
+                out[key] = mask_card_numbers(value)
+        return out
+    if isinstance(data, list):
+        return [mask_card_numbers(value) for value in data]
+    return data
+
+
