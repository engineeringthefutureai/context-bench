--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,20 @@
+"""Duration helpers: parse "hours and minutes" text into whole minutes."""
+import re
+
+# One of: "1h30m" / "1h 30m", a bare "2h", or a bare "45m". Hours come before
+# minutes, each unit at most once, units are case-insensitive.
+_DURATION = re.compile(r"(?:(\d+)h\s*(\d+)m|(\d+)h|(\d+)m)", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Whole minutes in a duration, e.g. "2h" -> 120, "45m" -> 45, "1h 30m" -> 90.
+
+    Surrounding whitespace is ignored; anything else (empty text, other units,
+    a missing number, minutes before hours, negative numbers) raises ValueError.
+    """
+    match = _DURATION.fullmatch(text.strip())
+    if match is None:
+        raise ValueError(f"duration must be hours and/or minutes, e.g. '1h30m': {text!r}")
+    hours = int(match.group(1) or match.group(3) or 0)
+    minutes = int(match.group(2) or match.group(4) or 0)
+    return hours * 60 + minutes
