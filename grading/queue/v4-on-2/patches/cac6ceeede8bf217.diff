--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,15 @@
+import re
+
+_DURATION = re.compile(r"(?:(\d+)h\s*)?(?:(\d+)m)?", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Total minutes in an hours/minutes string: "2h", "45m", "1h30m" or "1h 30m"."""
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    m = _DURATION.fullmatch(text.strip())
+    if m is None or (m.group(1) is None and m.group(2) is None):
+        raise ValueError(f"invalid duration: {text!r}")
+    hours = int(m.group(1) or 0)
+    minutes = int(m.group(2) or 0)
+    return hours * 60 + minutes
