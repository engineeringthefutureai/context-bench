--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,27 @@
+"""Coupon preview: how much a discount code would save on the current cart, before it is applied.
+
+price_cart is the source of truth for how a code discounts a cart (eligibility, on-sale
+exclusions, minimums, printed codes), so the preview prices the same cart with the code and
+reads back the coupon's share of the discount; 0 means the code wouldn't apply."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str | None,
+                   coupons: dict[str, Coupon], engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """Saving in cents that `code` would give on this cart, as the cart page would calculate it.
+
+    The cart is priced with the code applied and nothing else (no automatic promotions, no member
+    price). Returns 0 when the code is missing, unknown, not active, under its minimum, or
+    leaves nothing eligible to discount."""
+    cart = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                      coupon_code=code, coupons=coupons)
+    return cart.coupon_discount_cents
