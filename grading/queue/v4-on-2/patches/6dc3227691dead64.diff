+def transfers_by_week(transfers: Iterable[Transfer]) -> dict[str, int]:
+    """Units moved per dashboard week label (e.g. "2026-W47"), in chronological order."""
+    out: dict[str, int] = {}
+    for t in transfers:
+        label = iso_week_label(t.at.date())
+        out[label] = out.get(label, 0) + t.qty
+    return dict(sorted(out.items()))
