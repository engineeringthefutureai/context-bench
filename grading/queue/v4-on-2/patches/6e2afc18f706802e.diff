--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,31 @@
+"""Order references in customer messages, normalized for support linkification."""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# The two order reference forms as customers type them: a storefront id
+# (ord_<12 hex>, any case) or a sales order reference (SO/SOB, 4-digit year, up to a
+# 6-digit sequence, with dashes, spaces or no separators). parseOrderRef is the final
+# validator, so anything it rejects (bad year, bad hex, wrong shape) is left out.
+_REF_RE = re.compile(r"\b(?:ord_[0-9a-f]{12}|SOB?[- ]*\d{4}[- ]*\d{1,6})\b", re.I)
+
+
+def order_refs(text: str | None) -> list[str]:
+    """Order references mentioned in *text*, in the order they first appear and without
+    duplicates, each written the way the shop writes that kind of reference
+    (see formatOrderRef). Anything that is not a valid order reference is left out."""
+    if not text:
+        return []
+    found: list[str] = []
+    seen: set[str] = set()
+    for match in _REF_RE.finditer(text):
+        parsed = parseOrderRef(match.group(0))
+        if parsed is None:
+            continue
+        ref = formatOrderRef(*parsed)
+        if ref not in seen:
+            seen.add(ref)
+            found.append(ref)
+    return found
