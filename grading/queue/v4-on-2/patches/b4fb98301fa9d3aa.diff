+# -*- coding: utf-8 -*-
+#
+# The cash till: how much the customer pays at the register.
+#
+from shopkit.core.pricing import cashRoundCents
+
+PAID_BY_CARD = "card"
+PAID_BY_CASH = "cash"
+
+
+def amount_due(total_cents, currency, paid_by):
+    """Amount the cashier asks the customer to pay, in cents.
+
+    Card pays the exact total. Cash follows the national rules for cash amounts (penny
+    withdrawn in Canada, 2013): CAD cash totals are rounded to the nearest 5 cents, same
+    rounding the shop applies to cash everywhere else. Other currencies are not rounded.
+    Negative totals (a refund) are handled symmetrically by the same rule.
+
+    Raises ValueError if paid_by is not "card" or "cash".
+    """
+    if paid_by == PAID_BY_CARD:
+        return int(total_cents)
+    if paid_by == PAID_BY_CASH:
+        return cashRoundCents(total_cents, currency)
+    raise ValueError("paid_by must be %r or %r" % (PAID_BY_CARD, PAID_BY_CASH))
