--- /dev/null
+++ b/shopkit/warehouse/labels.py
@@ -0,0 +1,15 @@
+"""Pallet labels for the new scanner: it reads the finance system's item numbers, not our SKUs,
+so each line is printed with the ERP item number (shopkit.core.erp.toErpSku)."""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id, items):
+    """Label text for a pallet: the first line is 'PALLET <pallet_id>', then one
+    '<item number> x<qty>' line per item, in the order given. items is a list of
+    (sku, qty); a SKU the finance system can't number raises ValueError."""
+    lines = ["PALLET %s" % pallet_id]
+    for sku, qty in items:
+        lines.append("%s x%s" % (toErpSku(sku), qty))
+    return "\n".join(lines)
