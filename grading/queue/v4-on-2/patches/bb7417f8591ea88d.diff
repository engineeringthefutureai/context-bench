--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,30 @@
+"""Partner support helper: explain why a webhook event is being held right now.
+
+Mirrors the fraud review hold in api.webhook_delivery.deliver_pending, so support can answer
+"why is this event late" without inspecting the worker."""
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+REASON_IN_REVIEW = "order is in fraud review; event held until the review clears"
+REASON_LOOKUP_FAILED = "fraud review lookup failed; event held (fail closed)"
+
+
+def explain_delay(event: str, order_id: str | None,
+                  under_review: Callable[[str], bool] | None = None) -> str | None:
+    """Why the webhook worker would hold this event back right now, or None if it would send it.
+
+    An event about an order in fraud review is held until the review clears, except
+    ALWAYS_DELIVER events (cancellations and refunds), which go out regardless. A review lookup
+    failure holds the event, fail closed, exactly as the worker does."""
+    if not order_id or under_review is None or event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        return REASON_LOOKUP_FAILED
+    if reviewing:
+        return REASON_IN_REVIEW
+    return None
