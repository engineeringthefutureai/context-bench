--- a/shopkit/inventory/stock.py
+++ b/shopkit/inventory/stock.py
@@ -1,3 +1,6 @@
+from shopkit.inventory.lots import NotEnoughStock
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +12,11 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        """Hold `qty` units of `sku` against an order. Raises NotEnoughStock without
+        changing anything if there isn't enough available."""
+        avail = self.available(sku)
+        if avail < qty:
+            raise NotEnoughStock(f"not enough {sku}", sku=sku, requested=qty, available=avail)
+        self._on_hand[sku] = avail - qty
