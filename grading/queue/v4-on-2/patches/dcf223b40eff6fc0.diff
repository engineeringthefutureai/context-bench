--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,23 @@
+"""Coupon preview for the cart page: how much a code would save the shopper, before it is applied."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str,
+                   coupons: dict[str, Coupon], engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """The saving in cents that `code` would give on this cart, calculated exactly as the cart
+    page does: same unit prices, same exclusions (on-sale items and gift cards for percentage
+    codes), same minimum order value, and printed codes honoured the same way.
+    Returns 0 when the code wouldn't apply: unknown, outside its date window, used up, or an
+    order below the coupon's minimum."""
+    cart = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                      coupon_code=code, coupons=coupons)
+    return cart.coupon_discount_cents
