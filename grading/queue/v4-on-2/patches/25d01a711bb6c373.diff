--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,20 @@
+"""Shipping options shown at checkout. Offers must match what the warehouse can actually do,
+otherwise the order is downgraded or stranded in allocate_wave (see shopkit.warehouse.waves)."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus, sites, hazmat_skus) -> bool:
+    """Whether the warehouse would put an order with these SKUs into an express wave.
+
+    An express order ships by air, so it is available only when one of the sites that could
+    ship the order has air service. Any order containing a hazmat SKU can only go by ground
+    (allocate_wave restricts it to ground sites and downgrades it to a standard wave), so it
+    is never express."""
+    if not skus:
+        return False
+    hazmat = frozenset(hazmat_skus or ())
+    if any(sku in hazmat for sku in skus):
+        return False
+    return any("air" in site.services for site in sites)
