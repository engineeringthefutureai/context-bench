--- /dev/null
+++ b/shopkit/support/refund_info.py
@@ -0,0 +1,66 @@
+"""Refund destination preview: tells a support agent where a refund would go before pressing Refund.
+
+Read-only. Mirrors the destination plan of payments.settlement.settle_refund (proportional split of
+the refundable amounts, leftover cents to cards first, 180-day card limit) without refunding anything."""
+from __future__ import annotations
+
+from datetime import date, datetime
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+from shopkit.utils.dates import utc_now
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment],
+                        today: date | None = None) -> dict[str, int]:
+    """Where a refund of amount_cents for order_id would be settled.
+
+    Returns {"card": ..., "store_credit": ..., "gift_card": ...} in cents, split exactly the way
+    settle_refund would settle it: proportional to each captured payment's remaining refundable
+    cents (cards first, gift cards last), with the payment age deciding card vs store credit and
+    gift-card payments always going back to a gift card. Nothing is refunded and no ledger entry
+    is written. Raises the same errors settle_refund raises for the same inputs.
+    """
+    if amount_cents <= 0:
+        raise ShopError("refund amount must be positive", order_id=order_id)
+    today = today or utc_now().date()
+    if isinstance(today, datetime):
+        today = today.date()
+
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    # same as settle_refund
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(f"refund {amount_cents} exceeds refundable {refundable}", order_id=order_id,
+                             requested=amount_cents, refundable=refundable)
+
+    # Same plan as settle_refund: proportional to refundable, leftover cents to card payments first
+    # (so a gift card never gets more than its share).
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    dests = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            dests["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            dests["store_credit"] += share
+        else:
+            dests["card"] += share
+    return dests
