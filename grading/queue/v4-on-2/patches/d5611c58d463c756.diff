--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,21 @@
+"""Delivery options offered at checkout.
+
+The checkout may only promise a service the warehouse will really use: express parcels leave by
+air, so a candidate site needs air service, and hazmat (lithium batteries and the like) only goes
+by ground, so the wave engine downgrades it to a standard wave (warehouse.waves.allocate_wave)."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: list[str], sites: list[Site], hazmat_skus: frozenset[str]) -> bool:
+    """Whether an order with these SKUs would go into an express wave from one of these sites.
+
+    `skus` are the cart's SKUs, `sites` the warehouse sites that could ship it and `hazmat_skus`
+    the SKUs classed as dangerous goods. False for an empty cart (nothing ships), when any cart
+    SKU is hazmat (express leaves by air) and when no candidate site has air service."""
+    if not skus:
+        return False
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in site.services for site in sites)
