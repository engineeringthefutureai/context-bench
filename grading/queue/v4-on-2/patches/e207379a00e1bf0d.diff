+"""Cash till: the amount the cashier asks the customer to pay."""
+from shopkit.core.pricing import cashRoundCents
+
+_METHODS = ("card", "cash")
+
+
+def amount_due(total_cents, currency, paid_by):
+    """Amount the cashier asks for on a till sale, in cents.
+
+    total_cents: sale total in whole cents (negative for cash refunds).
+    currency: ISO currency code, e.g. "CAD".
+    paid_by: "card" or "cash".
+
+    Card payments pay the exact total (card is NOT rounded). Cash payments
+    follow the national cash rounding rule — the same one the shop applies to
+    cash elsewhere (CAD: penny withdrawn, nearest 5 cents), so a 103-cent CAD
+    cash sale is charged as 105. Raises ValueError for an unknown paid_by.
+    """
+    if paid_by not in _METHODS:
+        raise ValueError(f"paid_by must be 'card' or 'cash', got {paid_by!r}")
+    cents = int(total_cents)
+    if paid_by == "cash":
+        return cashRoundCents(cents, currency)
+    return cents
