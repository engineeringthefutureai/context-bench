--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,30 @@
+"""Weight parsing and unit conversion for values typed in by warehouse staff."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact conversion factors to grams.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+# A number (integer or decimal using "."), optional whitespace, then a unit.
+_WEIGHT_RE = re.compile(r"^(\d+(?:\.\d+)?)(?:[ \t]*([A-Za-z]+))?$")
+
+
+def parse_weight(text: str) -> int:
+    """Weight as typed by staff, in whole grams. A number (integer or "."-decimal, never
+    ","), optional whitespace, then one of g, kg, lb or oz (case-insensitive), e.g.
+    "250g", " 2.5 kg ", "1 LB". 1 lb = 453.59237 g, 1 oz = 28.349523125 g; the result is
+    rounded to the nearest gram (half up): parse_weight("1 lb") -> 454.
+    Raises ValueError for a missing or unknown unit, negative values or any other form."""
+    if not isinstance(text, str):
+        raise ValueError(f"expected a weight string, got {type(text).__name__}")
+    match = _WEIGHT_RE.match(text.strip())
+    if not match or not match.group(2):
+        raise ValueError(f"invalid weight {text!r}: need a number and a unit")
+    factor = _GRAMS_PER_UNIT.get(match.group(2).lower())
+    if factor is None:
+        raise ValueError(f"unknown unit in {text!r}: use g, kg, lb or oz")
+    return int((Decimal(match.group(1)) * factor).quantize(Decimal(1), rounding=ROUND_HALF_UP))
