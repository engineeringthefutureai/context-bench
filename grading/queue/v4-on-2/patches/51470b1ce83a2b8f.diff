--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,32 @@
+import re
+from decimal import Decimal, ROUND_HALF_UP
+
+# Exact conversion factors to grams; Decimal keeps the math exact (no float
+# drift) so "1 lb" and "16 oz" round to the same number of grams.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# An integer or a "."-separated decimal, optional whitespace, then the unit.
+# Case-insensitive; signs, "," as separator and missing parts fail to match.
+_WEIGHT_RE = re.compile(r"\s*(\d+(?:\.\d+)?)\s*(kg|lb|oz|g)\s*", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams, e.g. "1.5 kg" -> 1500, "1 lb" -> 454.
+
+    The number may be an integer or a decimal using "." as separator, and the
+    unit one of g, kg, lb or oz (case-insensitive); surrounding whitespace is
+    ignored. Raises ValueError for anything else, including negative values
+    and "," as the decimal separator.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+    match = _WEIGHT_RE.fullmatch(text)
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    grams = Decimal(match.group(1)) * _GRAMS_PER_UNIT[match.group(2).lower()]
+    return int(grams.to_integral_value(rounding=ROUND_HALF_UP))
