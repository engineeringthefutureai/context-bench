--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,34 @@
+"""Weight parsing for weights typed in by warehouse staff."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact gram equivalents of the units staff type in. Decimal keeps the conversion exact,
+# so 1 lb is always 454 g and 1 oz is always 28 g.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# Unsigned integer or "."-decimal number, optional whitespace, then the unit. No sign (a
+# negative weight is invalid), no "," decimal separator, no extra text.
+_WEIGHT_RE = re.compile(
+    r"^(?P<number>[0-9]+(?:\.[0-9]+)?|\.[0-9]+)\s*(?P<unit>kg|g|lb|oz)$",
+    re.IGNORECASE,
+)
+
+
+def parse_weight(text: str) -> int:
+    """Parse a package weight typed by warehouse staff and return whole grams.
+    The input is an integer or a decimal using "." as separator, optional whitespace, then a
+    unit: g, kg, lb or oz (case-insensitive). 1 lb = 453.59237 g, 1 oz = 28.349523125 g,
+    rounded to the nearest gram.
+    parse_weight("1.5 kg") -> 1500; parse_weight("2lb") -> 908; parse_weight("1 oz") -> 28.
+    Raises ValueError for a missing or unknown unit, a missing number, negative values,
+    "," as decimal separator and other malformed input."""
+    match = _WEIGHT_RE.match(text.strip())
+    if match is None:
+        raise ValueError(f"invalid weight: {text!r}")
+    grams = Decimal(match.group("number")) * _GRAMS_PER_UNIT[match.group("unit").lower()]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
