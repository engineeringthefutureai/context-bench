--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,33 @@
+"""Unit helpers for staff-typed measurements, e.g. package weights on the shipping desk."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+# Exact conversions to grams: kg is metric, lb and oz are defined in exact metric terms.
+_GRAMS_PER_UNIT = {
+    "g": Decimal(1),
+    "kg": Decimal(1000),
+    "lb": Decimal("453.59237"),
+    "oz": Decimal("28.349523125"),
+}
+
+# Number (integer or "d.dd" decimal, "." separator), optional whitespace, then the unit.
+# Anything not matching this is a bad weight: no number, no/unknown unit, a sign, "," or
+# extra characters.
+_WEIGHT_RE = re.compile(r"\s*([0-9]+(?:\.[0-9]+)?)\s?(g|kg|lb|oz)\s*", re.IGNORECASE)
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams, from staff-typed input like "1.2 kg", " 16 oz " or "450G".
+
+    The number is an integer or a decimal with a "." separator, followed by an optional
+    single whitespace and one of the units g, kg, lb or oz (case-insensitive). Leading and
+    trailing whitespace is ignored. Converted at the exact rates 1 lb = 453.59237 g and
+    1 oz = 28.349523125 g, and rounded to the nearest gram: parse_weight("1 lb") -> 454.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"bad weight: expected a string, got {type(text).__name__}")
+    match = _WEIGHT_RE.fullmatch(text)
+    if not match:
+        raise ValueError(f"bad weight {text!r}: expected a number and a unit (g, kg, lb or oz)")
+    grams = Decimal(match.group(1)) * _GRAMS_PER_UNIT[match.group(2).lower()]
+    return int(grams.quantize(Decimal(1), rounding=ROUND_HALF_UP))
