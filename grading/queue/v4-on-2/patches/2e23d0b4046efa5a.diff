--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,21 @@
+"""Delivery-service options offered at checkout.
+
+The promise must match what the warehouse can actually do: whether an order goes into an
+express wave is decided by warehouse.waves.allocate_wave (hazmat never ships express), so
+these checks mirror that logic."""
+from __future__ import annotations
+
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus, sites: list[Site], hazmat_skus: frozenset[str] = frozenset()) -> bool:
+    """Whether the warehouse would put an order with these SKUs into an express wave.
+
+    Express leaves by air, so a site can only serve it when it has air service, and an order
+    containing any dangerous-goods (hazmat) SKU is downgraded to a standard wave (allocate_wave),
+    so it is never express. Empty carts have no service to offer."""
+    if not skus:
+        return False
+    if any(sku in hazmat_skus for sku in skus):
+        return False
+    return any("air" in s.services for s in sites)
