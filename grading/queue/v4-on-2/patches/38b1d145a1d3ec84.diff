--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,35 @@
+"""Order references in free text, for linking customer messages to their orders."""
+from __future__ import annotations
+
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+# What customers actually type: the storefront id (ord_<12 hex>, any case) or the sales
+# order ref (SO-/SOB- prefix, year, sequence) with dashes or spaces between the parts.
+# Every hit is still checked by parseOrderRef (years before 2017, wrong digit counts)
+# and written back in the shop's own spelling by formatOrderRef.
+_REF_CANDIDATE = re.compile(
+    r"\b(?:ord_[0-9a-f]{12}|SOB?[- ]?\d{4}[- ]?\d{1,6})\b",
+    re.IGNORECASE,
+)
+
+
+def order_refs(text: str) -> list[str]:
+    """Order references mentioned in `text`, in the order they first appear, no duplicates.
+
+    Customers type them in all sorts of ways - "so 2019 123", "SO-2019-000123",
+    "ORD_1A2B3C4D5E6F" - and each one comes back the way the shop writes that kind of
+    reference. Anything that is not a valid order reference (invoice numbers, ids with
+    the wrong number of digits, years before 2017) is left out."""
+    refs: list[str] = []
+    seen: set[str] = set()
+    for m in _REF_CANDIDATE.finditer(text or ""):
+        parsed = parseOrderRef(m.group(0))
+        if parsed is None:
+            continue
+        ref = formatOrderRef(*parsed)
+        if ref not in seen:
+            seen.add(ref)
+            refs.append(ref)
+    return refs
