+"""Read-only preview of refund destinations for support agents.
+
+`refund_destinations` answers "where would this refund go?" before the agent presses Refund. It
+mirrors the planning half of payments.settlement.settle_refund exactly (same proportional split,
+same 180-day card window) but never touches any payment, the provider, the journal or the ledger.
+"""
+from __future__ import annotations
+
+from datetime import date
+
+from shopkit.errors import ShopError
+from shopkit.payments.models import CAPTURED, Payment
+from shopkit.payments.refunds import RefundTooLarge
+from shopkit.payments.settlement import CARD_REFUND_MAX_AGE_DAYS
+
+
+def refund_destinations(order_id: str, amount_cents: int, payments: list[Payment], today: date) -> dict[str, int]:
+    """Where a refund of `amount_cents` for `order_id` would be settled: cents going back to the
+    card, to store credit and to a gift card, keyed "card" / "store_credit" / "gift_card".
+
+    The split is computed exactly the way payments.settlement.settle_refund would settle it for
+    `today`: proportional to each captured payment's remaining refundable amount, with card
+    payments refunded back to the card only while they are within CARD_REFUND_MAX_AGE_DAYS (older card
+    payments become store credit) and gift card payments back to a new gift card. This is a
+    preview: it never refunds anything.
+    """
+    if amount_cents <= 0:
+        raise ValueError("refund amount must be positive")
+    captured = [p for p in payments if p.order_id == order_id and p.status == CAPTURED]
+    if not captured:
+        raise ShopError(f"order {order_id} has no captured payment", order_id=order_id)
+    refundable = sum(p.refundable_cents for p in captured)
+    if amount_cents > refundable:
+        raise RefundTooLarge(
+            f"refund {amount_cents} exceeds refundable {refundable}", order_id=order_id,
+            requested=amount_cents, refundable=refundable)
+
+    # Same split as settle_refund: proportional to what is still refundable on each payment,
+    # cards first, leftover cents to the first payments that still have room.
+    ordered = sorted(captured, key=lambda p: (p.method == "gift_card", p.created))
+    weights = [p.refundable_cents for p in ordered]
+    total_weight = sum(weights)
+    shares = [amount_cents * w // total_weight for w in weights]
+    leftover = amount_cents - sum(shares)
+    for i, p in enumerate(ordered):
+        if leftover <= 0:
+            break
+        room = p.refundable_cents - shares[i]
+        give = min(room, leftover)
+        shares[i] += give
+        leftover -= give
+
+    out = {"card": 0, "store_credit": 0, "gift_card": 0}
+    for p, share in zip(ordered, shares):
+        if share <= 0:
+            continue
+        if p.method == "gift_card":
+            out["gift_card"] += share
+        elif (today - p.created.date()).days > CARD_REFUND_MAX_AGE_DAYS:
+            out["store_credit"] += share
+        else:
+            out["card"] += share
+    return out
