@@ -0,0 +1,11 @@
+"""Pallet label content for the warehouse pallet scanner."""
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Label text for a pallet: a `PALLET <pallet_id>` line, then one `<item number> x<qty>`
+    line per item, in the order given. The scanner reads the finance system's item numbers, so
+    each shop SKU is converted with the ERP mapping (toErpSku)."""
+    lines = [f"PALLET {pallet_id}"]
+    lines += [f"{toErpSku(sku)} x{qty}" for sku, qty in items]
+    return "\n".join(lines)
