+def mask_card_number(value):
+    """Copy of `value` with any `card_number` field redacted (payments.reconciliation.redact_pan) —
+    the same masking the shop uses everywhere a card number is stored or shown. Other fields pass
+    through unchanged; dicts and lists are copied, the input is not mutated."""
+    if isinstance(value, dict):
+        masked = {}
+        for key, item in value.items():
+            if key == "card_number" and isinstance(item, (str, int, float)):
+                masked[key] = redact_pan(str(item))
+            else:
+                masked[key] = mask_card_number(item)
+        return masked
+    if isinstance(value, list):
+        return [mask_card_number(item) for item in value]
+    return value
 
 
