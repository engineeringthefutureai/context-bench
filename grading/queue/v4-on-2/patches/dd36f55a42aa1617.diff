+"""Pallet labels for the new warehouse pallet scanner.
+
+The scanner reads the finance system's item numbers, not shop SKUs, so every line on a pallet
+label carries the item number the ERP knows the product by (core.erp.toErpSku).
+"""
+from __future__ import annotations
+
+from shopkit.core.erp import toErpSku
+
+
+def pallet_label(pallet_id: str, items: list[tuple[str, int]]) -> str:
+    """Pallet label text: a 'PALLET <pallet_id>' first line, then one '<item number> x<qty>'
+    line per item, in the order given, each SKU converted to the finance system's item number.
+    Raises ValueError when a SKU can't be mapped to an item number."""
+    lines = [f"PALLET {pallet_id}"]
+    for sku, qty in items:
+        lines.append(f"{toErpSku(sku)} x{qty}")
+    return "\n".join(lines)
