--- /dev/null
+++ b/shopkit/utils/durations.py
@@ -0,0 +1,41 @@
+"""Parsing of compact duration strings such as "1h30m" into whole minutes."""
+import re
+
+# One part of a duration: a whole number followed by its unit letter ("h" or "m",
+# either case), allowing whitespace between the number and the unit and between parts.
+_PART = re.compile(r"(\d+)\s*([hm])\s*", re.IGNORECASE)
+
+
+def parse_duration(text: str) -> int:
+    """Parse hours and/or minutes and return the total in whole minutes.
+
+    Accepted forms are "2h", "45m", "1h30m" and "1h 30m". Hours come before
+    minutes, each unit appears at most once, units are case-insensitive and
+    surrounding whitespace is ignored. Anything else (empty text, other
+    units, a missing number, minutes before hours, negative or fractional
+    numbers) raises ValueError.
+    """
+    stripped = text.strip()
+    if not stripped:
+        raise ValueError("duration must not be empty")
+    parts = list(_PART.finditer(stripped))
+    # Everything the parts do not cover must be whitespace; anything else is
+    # a sign, a decimal point or a foreign unit, and therefore invalid.
+    if not parts or _PART.sub("", stripped).strip():
+        raise ValueError(f"invalid duration: {text!r}")
+    total_minutes = 0
+    saw_hours = False
+    saw_minutes = False
+    for match in parts:
+        amount = int(match.group(1))
+        if match.group(2).lower() == "h":
+            if saw_hours or saw_minutes:
+                raise ValueError(f"invalid duration: {text!r}")
+            saw_hours = True
+            total_minutes += amount * 60
+        else:
+            if saw_minutes:
+                raise ValueError(f"invalid duration: {text!r}")
+            saw_minutes = True
+            total_minutes += amount
+    return total_minutes
