--- /dev/null
+++ b/shopkit/utils/units.py
@@ -0,0 +1,44 @@
+"""Parsing of physical units that warehouse staff type in by hand, e.g. package weights."""
+import re
+
+# Grams per unit as exact (numerator, denominator) fractions; 1 lb = 453.59237 g and
+# 1 oz = 28.349523125 g.
+_GRAMS_PER_UNIT = {
+    "g": (1, 1),
+    "kg": (1000, 1),
+    "lb": (45359237, 100000),
+    "oz": (28349523125, 1000000000),
+}
+
+_WEIGHT_RE = re.compile(r"^([0-9]+(?:\.[0-9]+)?)\s*([A-Za-z]+)$")
+
+
+def parse_weight(text: str) -> int:
+    """Weight in whole grams from staff input such as "1.5 kg", "2 lb", "12 oz" or "450 g".
+    Leading and trailing whitespace is ignored, the unit is case-insensitive, and the result
+    is rounded to the nearest gram. Raises ValueError for a missing or negative number, a
+    missing or unknown unit, and "," as decimal separator."""
+    if not isinstance(text, str):
+        raise ValueError(f"weight must be a string, got {type(text).__name__}")
+    cleaned = text.strip()
+    if not cleaned:
+        raise ValueError("weight must not be empty")
+    if cleaned.startswith("-"):
+        raise ValueError("weight must not be negative")
+    match = _WEIGHT_RE.match(cleaned)
+    if match is None:
+        raise ValueError(f"invalid weight: {cleaned!r}; expected a number followed by g, kg, lb or oz")
+    number, unit = match.group(1), match.group(2).lower()
+    if unit not in _GRAMS_PER_UNIT:
+        raise ValueError(f"unknown unit: {unit!r}; expected g, kg, lb or oz")
+    if "." in number:
+        whole, fraction = number.split(".")
+        scaled = int(whole + fraction)
+        scale = 10 ** len(fraction)
+    else:
+        scaled, scale = int(number), 1
+    numerator, denominator = _GRAMS_PER_UNIT[unit]
+    top = scaled * numerator
+    bottom = scale * denominator
+    # Round top/bottom to the nearest whole gram, halves up (the value is always non-negative).
+    return (2 * top + bottom) // (2 * bottom)
