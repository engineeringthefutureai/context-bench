+def _redacted_payload(payload: dict) -> dict:
+    """Copy of event data safe to send to partners: a card_number field is masked the same way
+    as everywhere else the shop stores or shows card numbers (payments.reconciliation.redact_pan).
+    All other fields go out unchanged."""
+    redacted = dict(payload)
+    if "card_number" in redacted:
+        redacted["card_number"] = redact_pan(str(redacted["card_number"]))
+    return redacted
