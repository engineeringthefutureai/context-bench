+def _redacted_payload(payload: dict) -> dict:
+    """Copy of the payload with card_number masked the same way stored and shown card numbers are
+    (see redact_pan); all other fields go out unchanged."""
+    card = payload.get("card_number")
+    if not isinstance(card, str):
+        return payload
+    redacted = dict(payload)
+    redacted["card_number"] = redact_pan(card)
+    return redacted
