--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,25 @@
+"""Explain why the webhook delivery worker would hold a partner event back right now.
+
+The holding itself happens in api.webhook_delivery.deliver_pending (the fraud review hold); this
+makes the same decision in one line, so partners and support can answer "why is my event late?".
+"""
+from __future__ import annotations
+
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event, order_id, under_review) -> str | None:
+    """Return a short reason when the worker would hold `event` (for `order_id`) back, else None.
+
+    Mirrors the review hold in deliver_pending: events about an order in fraud review are held
+    until the review clears, but ALWAYS_DELIVER events (cancellations, settled refunds) go out
+    regardless. A broken `under_review` lookup fails closed, exactly as the worker does.
+    """
+    if not order_id or under_review is None or event in ALWAYS_DELIVER:
+        return None
+    try:
+        if not under_review(order_id):
+            return None
+    except Exception:
+        return "held: fraud review lookup failed (failing closed)"
+    return "held: order is in fraud review"
