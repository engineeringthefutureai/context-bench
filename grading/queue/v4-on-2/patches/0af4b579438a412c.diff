--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,30 @@
+"""Preview of what a discount code would save on the current cart, before the shopper applies it.
+
+The saving is the drop in the cart page total: the same cart is priced through price_cart once
+plain and once with the code, so line pricing, the percentage-coupon exclusions (sale items,
+gift cards), the minimum order, per-line tax and the free-shipping threshold all come out
+exactly as the cart page shows them. 0 when the code wouldn't apply (unknown, inactive,
+below the minimum order, or nothing left eligible)."""
+from __future__ import annotations
+
+from datetime import datetime
+
+from shopkit.catalog.models import Product
+from shopkit.customers.models import Address
+from shopkit.pricing.cart import CartItem, price_cart
+from shopkit.pricing.engine import PricingEngine
+from shopkit.promotions.coupons import Coupon
+
+
+def coupon_savings(items: list[CartItem], products: dict[str, Product], code: str | None,
+                   coupons: dict[str, Coupon] | None, engine: PricingEngine, ship_to: Address,
+                   weight_g: int, at: datetime) -> int:
+    """The saving in cents that `code` would give on this cart, 0 when the code wouldn't apply."""
+    if not code:
+        return 0
+    plain = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at)
+    with_code = price_cart(items, products, engine=engine, ship_to=ship_to, weight_g=weight_g, at=at,
+                           coupon_code=code, coupons=coupons)
+    # a code that applies only ever lowers the total, except one that tips the subtotal under the
+    # free-shipping threshold; a savings preview is 0 rather than negative in that case
+    return max(0, plain.total_cents - with_code.total_cents)
