diff --color -ruN a/shopkit/inventory/stock.py b/shopkit/inventory/stock.py
--- a/shopkit/inventory/stock.py	2026-11-17 22:01:27.612454383 -0800
+++ b/shopkit/inventory/stock.py	2026-11-17 22:01:27.615207029 -0800
@@ -9,3 +9,9 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        have = self.available(sku)
+        if qty > have:
+            raise ValueError(f"not enough {sku}: requested {qty}, available {have}")
+        self._on_hand[sku] = have - qty
