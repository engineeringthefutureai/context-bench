--- a/shopkit/inventory/stock.py	2026-11-17 22:01:27.620743047 -0800
+++ b/shopkit/inventory/stock.py	2026-11-17 22:01:27.624550573 -0800
@@ -1,3 +1,10 @@
+from shopkit.errors import Conflict
+
+
+class InsufficientStock(Conflict):
+    pass
+
+
 class Stock:
     """On-hand quantities per SKU."""
 
@@ -9,3 +16,9 @@
 
     def available(self, sku: str) -> int:
         return self._on_hand.get(sku, 0)
+
+    def reserve(self, sku: str, qty: int) -> None:
+        have = self.available(sku)
+        if qty > have:
+            raise InsufficientStock(f"not enough {sku}", requested=qty, available=have)
+        self._on_hand[sku] = have - qty
