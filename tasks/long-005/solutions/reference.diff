--- /dev/null
+++ b/shopkit/api/partner_status.py
@@ -0,0 +1,14 @@
+"""Why a partner's webhook event is delayed, for the partner support page."""
+from shopkit.api.webhook_delivery import ALWAYS_DELIVER
+
+
+def explain_delay(event: str, order_id: str | None, under_review) -> str | None:
+    """Mirrors the review hold in api.webhook_delivery.deliver_pending: events about an order in
+    fraud review wait (a failed lookup counts as in review), except ALWAYS_DELIVER events."""
+    if not order_id or event in ALWAYS_DELIVER:
+        return None
+    try:
+        reviewing = bool(under_review(order_id))
+    except Exception:
+        reviewing = True
+    return "held: the order is being reviewed" if reviewing else None
