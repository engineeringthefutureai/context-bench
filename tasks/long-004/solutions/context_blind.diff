--- /dev/null
+++ b/shopkit/pricing/coupon_preview.py
@@ -0,0 +1,12 @@
+from shopkit.promotions.coupons import PERCENT, normalize_code
+from shopkit.utils.numbers import apply_rate
+
+
+def coupon_savings(items, products, code, coupons, engine, ship_to, weight_g, at):
+    coupon = coupons.get(normalize_code(code))
+    if coupon is None:
+        return 0
+    subtotal = sum(engine.line_total(products[i.sku], i.qty, at=at) for i in items)
+    if subtotal < coupon.min_order_cents:
+        return 0
+    return apply_rate(subtotal, coupon.value) if coupon.kind == PERCENT else min(coupon.value, subtotal)
