+def transfers_by_week(transfers: list[Transfer]) -> dict[str, int]:
+    """Units moved per dashboard week, oldest week first."""
+    weeks: dict[str, int] = {}
+    for t in sorted(transfers, key=lambda t: t.at):
+        label = iso_week_label(t.at.date())
+        weeks[label] = weeks.get(label, 0) + t.qty
+    return weeks
