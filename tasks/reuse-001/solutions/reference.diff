+def export_orders_csv(orders):
+    import csv, io
+    from shopkit.money import format_money
+    from shopkit.utils.text import normalize_sku
+    buf = io.StringIO(); w = csv.writer(buf)
+    w.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for o in orders:
+        for l in o.lines:
+            w.writerow([o.id, normalize_sku(l.sku), l.qty, format_money(l.total_cents, o.currency)])
+    return buf.getvalue()
