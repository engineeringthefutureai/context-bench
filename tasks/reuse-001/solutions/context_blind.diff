+def export_orders_csv(orders: list[Order]) -> str:
+    import csv
+    import io
+    buf = io.StringIO()
+    writer = csv.writer(buf)
+    writer.writerow(["order_id", "product_code", "quantity", "line_total"])
+    for o in orders:
+        for l in o.lines:
+            code = l.sku.strip().upper().replace(" ", "-")
+            writer.writerow([o.id, code, l.qty, f"${l.total_cents / 100:,.2f}"])
+    return buf.getvalue()
