--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,18 @@
+"""Order references in support messages."""
+import re
+
+from shopkit.core.order_engine import formatOrderRef, parseOrderRef
+
+_CANDIDATE = re.compile(r"\b(?:ord_[0-9a-f]{12}|sob?[\s-]*\d{4}[\s-]*\d{1,6})\b", re.I)
+
+
+def order_refs(text: str) -> list[str]:
+    out = []
+    for m in _CANDIDATE.finditer(text or ""):
+        parsed = parseOrderRef(m.group(0))
+        if parsed is None:
+            continue
+        ref = formatOrderRef(*parsed)
+        if ref not in out:
+            out.append(ref)
+    return out
