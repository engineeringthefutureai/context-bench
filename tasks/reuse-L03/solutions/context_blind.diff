--- /dev/null
+++ b/shopkit/support/linking.py
@@ -0,0 +1,12 @@
+import re
+
+_REF = re.compile(r"\b(SOB?)[\s-]*(\d{4})[\s-]*(\d{1,6})\b|\b(ord_[0-9a-f]{12})\b", re.I)
+
+
+def order_refs(text):
+    out = []
+    for m in _REF.finditer(text or ""):
+        ref = m.group(4).lower() if m.group(4) else f"{m.group(1).upper()}-{m.group(2)}-{int(m.group(3)):06d}"
+        if ref not in out:
+            out.append(ref)
+    return out
