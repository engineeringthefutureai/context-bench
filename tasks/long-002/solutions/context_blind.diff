@@ -0,0 +1,5 @@
+def refund_destinations(order_id, amount_cents, payments, today):
+    gift = sum(p.refundable_cents for p in payments if p.method == "gift_card")
+    total = sum(p.refundable_cents for p in payments) or 1
+    gift_part = amount_cents * gift // total
+    return {"card": amount_cents - gift_part, "store_credit": 0, "gift_card": gift_part}
