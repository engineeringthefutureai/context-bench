--- /dev/null
+++ b/shopkit/payouts/preview.py
@@ -0,0 +1,18 @@
+"""What a seller's next payout would look like, without touching holds or carried balances."""
+import copy
+from datetime import date
+
+from shopkit.payouts.batching import Rollover, build_payout_batch
+from shopkit.payouts.holds import HoldBook
+from shopkit.payouts.models import Adjustment, Earning, Seller
+
+
+def preview_payout(seller: Seller, earnings: list[Earning], adjustments: list[Adjustment], period_start: date,
+                   period_end: date, holds: HoldBook, rollover: Rollover) -> tuple[str, int]:
+    """(status, net cents) the weekly batch would give this seller; works on copies."""
+    result = build_payout_batch([seller], earnings, adjustments, period_start, period_end,
+                                holds=copy.deepcopy(holds), rollover=copy.deepcopy(rollover))
+    if not result.payouts:
+        return result.skipped.get(seller.id, "skipped"), 0
+    payout = result.payouts[0]
+    return payout.status, payout.net_cents
