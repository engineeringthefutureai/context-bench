@@ -0,0 +1,9 @@
+from shopkit.utils.numbers import apply_rate
+
+
+def preview_payout(seller, earnings, adjustments, period_start, period_end, holds, rollover):
+    net = 0
+    for e in earnings:
+        net += e.gross_cents - apply_rate(e.gross_cents, seller.commission_bp / 100) - e.refunded_cents
+    net += sum(a.amount_cents for a in adjustments) + rollover.balances.get(seller.id, 0)
+    return "draft", net
