+"""Till amounts for the physical stores."""
+from shopkit.core.pricing import cashRoundCents
+
+
+def amount_due(total_cents: int, currency: str, paid_by: str) -> int:
+    if paid_by not in ("card", "cash"):
+        raise ValueError(f"unknown payment method {paid_by!r}")
+    return cashRoundCents(total_cents, currency) if paid_by == "cash" else total_cents
