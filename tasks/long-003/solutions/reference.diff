--- /dev/null
+++ b/shopkit/shipping/options.py
@@ -0,0 +1,10 @@
+"""Delivery options shown at checkout."""
+from shopkit.warehouse.sites import Site
+
+
+def express_available(skus: list[str], sites: list[Site], hazmat_skus: frozenset[str]) -> bool:
+    """An order with dangerous goods is never put into an express wave (warehouse.waves.allocate_wave
+    downgrades it to standard), so express is offered only for carts without them."""
+    if not sites:
+        return False
+    return not any(sku in hazmat_skus for sku in skus)
