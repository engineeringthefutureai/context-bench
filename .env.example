# Copy to .env (gitignored) and fill in. Read by the client when the variable is not set in the environment.
CBENCH_API_KEY=
# Clean mode (cbench run --clean): restarts the model server before every run so its prefix cache is
# cold. A shell command that returns once the old server has stopped (e.g. a systemd or docker
# restart); readiness is then polled. Optional timeout in seconds (default 1200).
CBENCH_RESTART_CMD=
CBENCH_READY_TIMEOUT=
