# Copy to .env (gitignored) and fill in. Read by the client when the variable is not set in the environment.
CBENCH_API_KEY=
# Clean mode (cbench run --clean): makes the model server's prefix cache cold before every run. A shell command that returns once the old server has stopped (e.g. a systemd or docker
# restart); readiness is then polled. Optional timeout in seconds (default 1200).
CBENCH_RESTART_CMD=
CBENCH_READY_TIMEOUT=
# Between restarts, clean mode only drops the prefix cache (vLLM POST /reset_prefix_cache; start vLLM with
# VLLM_SERVER_DEV_MODE=1, else every run restarts). A full restart still happens on the first run, every
# CBENCH_RESTART_EVERY runs (default 25; 1 = always restart), every CBENCH_RESTART_EVERY_L7 runs during L7 and L8
# (default 12; the memory guard restarts sooner: multi-turn runs grow the vLLM workers fast, above all on repo L;
# concurrent sweeps honour it too, draining the runs in flight first), and when this machine's free memory is below
# CBENCH_RESTART_MIN_FREE_MB (default 6000): the reset frees no memory.
CBENCH_RESTART_EVERY=
CBENCH_RESTART_EVERY_L7=
CBENCH_RESTART_MIN_FREE_MB=
